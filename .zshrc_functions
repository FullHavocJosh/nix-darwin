# Helper function: Check if current directory is a git repository
function _check_git_repo() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "✗ Error: Not in a git repository"
    return 1
  fi
  return 0
}

# Helper function: Generate README.md content using AI
function _generate_readme() {
  local file_list=$(find . -maxdepth 1 -type f ! -name ".*" -exec basename {} \;)

  cat <<EOF | opencode run 2>/dev/null
Generate a comprehensive README.md for a directory containing these files:

$file_list

The README should include:
1. A clear description of the purpose of the files in this directory
2. Simple usage examples showing the most basic use case
3. Advanced/customized usage examples showing more complex scenarios
4. Any prerequisites or dependencies
5. Proper markdown formatting

Return ONLY the README.md content, starting with a # heading.
EOF
}

function asc() {
  if [ "$1" = "clear" ]; then
    unset -m "AWS_*"
    echo "✓ AWS environment variables unset"
  else
    eval "$(aws configure export-credentials --profile $1 --format env)"
    export AWS_PROFILE=$1
    echo "✓ AWS environment variables set"
  fi
}

function gpr_func() {
  # Validate git repository
  _check_git_repo || return 1

  # Check if there are files in current directory (not subdirectories) and no README.md
  local files_in_dir=$(find . -maxdepth 1 -type f ! -name "README.md" ! -name ".*" | wc -l)

  if [ "$files_in_dir" -gt 0 ] && [ ! -f "README.md" ]; then
    echo "ℹ No README.md found. Generating one with AI..."

    # Generate README.md using helper function
    local readme_content=$(_generate_readme)

    if [ -n "$readme_content" ]; then
      echo "$readme_content" >README.md
      echo "✓ README.md created"
      git add README.md
      git commit -m "docs: Add README.md"
      echo ""
    else
      echo "⚠ Failed to generate README.md"
    fi
  fi

  # Original gpr functionality
  echo "Select type:"
  echo "  1) feat"
  echo "  2) fix"
  echo -n "Enter choice (1 or 2): "
  read type_choice
  case "$type_choice" in
    1) type_prefix="feat" ;;
    2) type_prefix="fix" ;;
    *)
      echo "✗ Invalid choice. Please select 1 or 2"
      return 1
      ;;
  esac
  echo -n "Branch name: "
  read branch_name
  if [ -z "$branch_name" ]; then
    echo "✗ Branch name cannot be empty"
    return 1
  fi
  git checkout -b "$branch_name" &&
    git commit --allow-empty -m "$branch_name" &&
    git push -u origin "$branch_name" &&
    gh pr create --draft --title "$type_prefix: $branch_name" --body "$(
      cat <<EOF
## Description
$type_prefix: $branch_name

## Tickets
$type_prefix: $branch_name
EOF
    )"
}

function gpc() {
  # Validate git repository
  _check_git_repo || return 1

  # Parse arguments
  local skip_readme=false
  if [ "$1" = "--skip-readme" ]; then
    skip_readme=true
    echo "ℹ Skipping README generation"
  fi

  # Check if there are files in current directory (not subdirectories)
  local files_in_dir=$(find . -maxdepth 1 -type f ! -name "README.md" ! -name ".*" | wc -l)

  if [ "$skip_readme" = false ] && [ "$files_in_dir" -gt 0 ]; then
    if [ ! -f "README.md" ]; then
      echo "ℹ No README.md found. Generating one with AI..."

      # Generate README.md using helper function
      local readme_content=$(_generate_readme)

      if [ -n "$readme_content" ]; then
        echo "$readme_content" >README.md
        echo "✓ README.md created"
        git add README.md
      else
        echo "⚠ Failed to generate README.md"
      fi
    else
      # README.md exists, check if staged changes require README update
      if ! git diff --cached --quiet; then
        echo "ℹ Checking if README.md needs updates based on staged changes..."

        local diff_output=$(git diff --cached)
        local staged_files=$(git diff --cached --name-only)

        # Read current README
        local current_readme=$(cat README.md)

        # Ask OpenCode if README needs updating
        local readme_update=$(
          cat <<EOF | opencode run 2>/dev/null
Review these staged git changes and the current README.md. Determine if the README.md needs to be updated.

STAGED CHANGES:
$diff_output

CURRENT README.md:
$current_readme

If updates are needed, return the COMPLETE updated README.md content with:
1. Updated description reflecting the changes
2. Updated or new usage examples (both simple and advanced)
3. Proper markdown formatting

If NO updates are needed, return exactly: "NO_UPDATE_NEEDED"
EOF
        )

        if [ "$readme_update" != "NO_UPDATE_NEEDED" ] && [ -n "$readme_update" ]; then
          echo "$readme_update" >README.md
          echo "✓ README.md updated based on staged changes"
          git add README.md
        else
          echo "✓ README.md is up to date"
        fi
      fi
    fi
  fi

  # Check if there are staged changes
  if ! git diff --cached --quiet; then
    echo ""
    echo "ℹ Generating commit message with AI..."

    # Get the diff of staged changes
    local diff_output=$(git diff --cached)

    # Use OpenCode to generate commit message
    local commit_msg=$(echo "Review the following git diff and generate a concise, single-sentence commit message that describes the changes. The message should be in imperative mood (e.g., 'Add feature' not 'Added feature'). Return ONLY the commit message, nothing else.\n\n$diff_output" | opencode run 2>/dev/null | tail -1)

    # Check if we got a valid response
    if [ -z "$commit_msg" ]; then
      echo "✗ Error: Failed to generate commit message"
      return 1
    fi

    echo "✓ Commit message: $commit_msg"
    echo ""

    # Commit with the generated message
    git commit -m "$commit_msg"

    if [ $? -eq 0 ]; then
      echo ""
      echo "ℹ Pushing to remote..."
      git push
      if [ $? -eq 0 ]; then
        echo "✓ Successfully pushed to remote"
      else
        echo "✗ Push failed"
        return 1
      fi
    else
      echo "✗ Commit failed, skipping push"
      return 1
    fi
  else
    echo "⚠ No staged changes to commit"
    return 1
  fi
}

function gpa() {
  # Git Partial Add with AI code review

  # Validate git repository
  _check_git_repo || return 1

  # Check if there are ANY changes (staged or unstaged)
  if git diff --quiet && git diff --cached --quiet; then
    echo "⚠ No changes to stage or review"
    return 1
  fi

  # Get list of changed files - properly handle filenames with spaces
  local changed_files=()
  while IFS= read -r file; do
    changed_files+=("$file")
  done < <(git diff --name-only)

  # If there are unstaged changes, let user select what to stage
  if [ ${#changed_files[@]} -gt 0 ]; then
    # Display files with numbers
    echo "Select files to stage and review:"
    echo ""
    local i=1
    for file in "${changed_files[@]}"; do
      echo "  $i) $file"
      ((i++))
    done
    echo "  a) All files"
    echo "  q) Quit"
    echo ""
    echo -n "Enter numbers separated by spaces (e.g., '1 3 5') or 'a' for all: "
    read -r selection

    # Handle selection
    case "$selection" in
      q | Q)
        echo "✓ Cancelled"
        return 0
        ;;
      a | A)
        # Stage all files
        for file in "${changed_files[@]}"; do
          git add "$file"
        done
        ;;
      *)
        # Stage selected files
        local selected_files=()
        for num in $selection; do
          if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#changed_files[@]}" ]; then
            # Note: zsh arrays are 1-indexed by default, so we use $num directly
            local selected_file="${changed_files[$num]}"
            if [ -n "$selected_file" ]; then
              selected_files+=("$selected_file")
            fi
          fi
        done

        if [ ${#selected_files[@]} -eq 0 ]; then
          echo "✗ No valid files selected"
          return 1
        fi

        # Stage each file individually to avoid empty string issues
        for file in "${selected_files[@]}"; do
          git add "$file"
        done
        ;;
    esac
  else
    # No unstaged changes, but there are staged changes - proceed to review them
    echo "ℹ No unstaged changes found, reviewing already-staged changes..."
  fi

  # Check if there are staged changes to review
  if git diff --cached --quiet; then
    echo ""
    echo "⚠ No files are staged for review"
    return 0
  fi

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running AI code review on staged changes..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Get the diff of staged changes
  local diff_output=$(git diff --cached)
  local staged_files=$(git diff --cached --name-only | tr '\n' ', ' | sed 's/,$//')

  # Check if any Terraform files are staged
  local has_terraform=false
  local terraform_review=""
  while IFS= read -r file; do
    if [[ "$file" == *.tf ]]; then
      has_terraform=true
      break
    fi
  done < <(git diff --cached --name-only)

  # Prepare review prompt based on file types
  local review_prompt="Review the following staged git changes for CRITICAL ISSUES AND WARNINGS ONLY:

🔴 **CRITICAL - Must Fix Before Commit:**
1. **Bugs**: Syntax errors, runtime errors, null pointer dereferences, infinite loops
2. **Security Vulnerabilities**: Exposed credentials, SQL injection, command injection, XSS, insecure crypto
3. **Data Loss**: Destructive operations without safeguards, missing transactions, race conditions

🟡 **WARNINGS - Should Consider:**
4. **Security Concerns**: Overly permissive permissions, missing input validation, unsafe eval
5. **Logic Flaws**: Off-by-one errors, incorrect conditionals, missing edge cases
6. **Breaking Changes**: API changes, removed functionality, incompatible updates"

  if [ "$has_terraform" = true ]; then
    review_prompt="$review_prompt

**TERRAFORM-SPECIFIC CRITICAL/WARNING CHECKS** (detected .tf files):
🔴 **Critical**: Hardcoded secrets/keys, publicly exposed resources, destructive changes without lifecycle protection
🟡 **Warnings**: Overly permissive IAM (wildcards in production), missing encryption, expensive resources without justification"
  fi

  # Use OpenCode to perform code review
  local review_result=$(
    cat <<EOF | opencode run 2>/dev/null
$review_prompt

Staged files: $staged_files

Git diff:
$diff_output

**IMPORTANT INSTRUCTIONS:**
- ONLY report 🔴 Critical issues and 🟡 Warnings
- IGNORE minor suggestions, style preferences, and code quality opinions
- Focus on things that will actually break, cause security issues, or have serious consequences
- If there are no critical/warning issues, respond with: "✓ Code review passed - no critical issues or warnings found"

Provide specific, actionable feedback with:
- File name and line numbers
- Issue severity (🔴 Critical or 🟡 Warning ONLY)
- Clear explanation of why this is a problem
- Recommended fix
EOF
  )

  # Display review results
  if [ -n "$review_result" ]; then
    echo "$review_result"
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo ""

    # Ask if user wants to proceed
    echo "Options:"
    echo "  [Y/Enter] Commit and push - automatically runs 'gpc'"
    echo "  [e] Edit - open files to implement fixes, keep staged"
    echo "  [u] Unstage - remove from staging area"
    echo "  [n] Cancel - keep staged but don't proceed"
    echo ""
    echo -n "Your choice: "
    read -r continue_choice

    case "$continue_choice" in
      e | E)
        echo ""
        echo "ℹ Opening staged files in editor..."
        # Get list of staged files - properly handle filenames with spaces
        local files_to_edit=()
        while IFS= read -r file; do
          files_to_edit+=("$file")
        done < <(git diff --cached --name-only)

        # Open in nvim (or fall back to $EDITOR)
        if command -v nvim &>/dev/null; then
          nvim "${files_to_edit[@]}"
        elif [ -n "$EDITOR" ]; then
          $EDITOR "${files_to_edit[@]}"
        else
          echo "✗ No editor found. Set \$EDITOR or install nvim."
          return 1
        fi

        echo ""
        echo "✓ Files edited. Run 'gpa' again to review changes or 'gpc' to commit."
        return 0
        ;;
      n | N)
        echo "ℹ Keeping changes staged. Use 'git restore --staged <file>' to unstage."
        return 0
        ;;
      u | U)
        echo "ℹ Unstaging all changes..."
        git restore --staged .
        echo "✓ All changes unstaged"
        return 0
        ;;
      y | Y | "")
        echo ""
        echo "✓ Proceeding to commit and push..."
        echo ""
        gpc
        return $?
        ;;
      *)
        echo "✗ Invalid choice. Changes remain staged."
        return 1
        ;;
    esac
  else
    echo "⚠ AI review failed or returned no output"
    echo "ℹ Changes remain staged. Review manually before committing."
    return 1
  fi
}

function aidev() {
  # Display simplified menu
  echo "Choose your AI coding assistant:"
  echo "  [ENTER] OpenCode (CoPilot/OpenCodeZen)"
  echo "  [c] Crush (Bedrock/OpenRouter)"
  echo "  [ESC] Quit"
  echo ""
  read -k1 -s choice
  echo
  case $choice in
    $'\n' | '')
      # OpenCode - supports: GitHub Copilot, AWS Bedrock
      echo "Selected: OpenCode"
      echo ""

      # Step 1: Check GitHub Copilot authentication via OpenCode
      echo "Checking GitHub Copilot authentication..."
      if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
        echo "✓ GitHub Copilot authenticated."
      else
        echo "✗ GitHub Copilot not authenticated in OpenCode."
        echo "Starting authentication..."
        echo ""
        echo "Opening GitHub device login page..."
        open "https://github.com/login/device/"
        echo ""
        opencode auth login

        # Verify authentication succeeded
        if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
          echo ""
          echo "✓ Authentication successful! Continuing..."
        else
          echo ""
          echo "✗ Authentication failed or was cancelled."
          return 1
        fi
      fi
      echo ""

      # Step 2: Check AWS Bedrock access (optional - disabled in OpenCode config)
      echo "Checking AWS Bedrock access..."
      if timeout 5 aws bedrock list-foundation-models --region us-east-1 &>/dev/null; then
        echo "✓ AWS Bedrock access confirmed (but disabled in OpenCode config)."
      else
        echo "⚠️  AWS Bedrock access unavailable (continuing with GitHub Copilot only)."
      fi
      echo ""

      # Step 3: Launch OpenCode
      echo "Launching OpenCode..."
      command opencode "$@"
      ;;

    c | C)
      # Crush - supports: AWS Bedrock, OpenRouter (NO GitHub Copilot support)
      echo "Selected: Crush"
      echo ""

      # Check if crush is available
      if ! command -v crush &>/dev/null; then
        echo "✗ Crush not found. Please install it first."
        return 1
      fi

      # Step 1: Check AWS Bedrock access
      echo "Checking AWS Bedrock access..."
      if timeout 5 aws bedrock list-foundation-models --region us-east-1 &>/dev/null; then
        echo "✓ AWS Bedrock access confirmed."
        echo "Setting Crush provider to: bedrock"
        sed -i.bak 's/"provider": "[^"]*"/"provider": "bedrock"/' ~/.config/crush/crush.json
      else
        echo "✗ AWS Bedrock access unavailable."
        echo "Triggering AWS SSO (30s timeout)..."
        if timeout 30 aws sso login --sso-session aws; then
          if timeout 5 aws bedrock list-foundation-models --region us-east-1 &>/dev/null; then
            echo "✓ AWS SSO successful. Bedrock available."
            echo "Setting Crush provider to: bedrock"
            sed -i.bak 's/"provider": "[^"]*"/"provider": "bedrock"/' ~/.config/crush/crush.json
          else
            echo "⚠️  AWS Bedrock still unavailable. Falling back to OpenRouter."
            sed -i.bak 's/"provider": "[^"]*"/"provider": "openrouter"/' ~/.config/crush/crush.json
          fi
        else
          echo "⚠️  AWS SSO timed out or failed. Falling back to OpenRouter."
          sed -i.bak 's/"provider": "[^"]*"/"provider": "openrouter"/' ~/.config/crush/crush.json
        fi
      fi
      echo ""

      # Step 2: Launch Crush
      echo "Launching Crush..."
      command crush "$@"
      ;;

    $'\e')
      echo "Exiting..."
      return 0
      ;;

    *)
      echo "Invalid choice. Please press [ENTER], [c], or [ESC]."
      return 1
      ;;
  esac
}
