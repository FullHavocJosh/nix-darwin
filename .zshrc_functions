# Set environmental variables for AWS
function asc() {
  if [ "$1" = "clear" ]; then
    unset -m "AWS_*"
    echo "AWS environment variables unset"
  else
    eval "$(aws configure export-credentials --profile $1 --format env)"
    export AWS_PROFILE=$1
    echo "AWS environment variables set"
  fi
}

# Smart AI dev launcher with AWS Bedrock fallback
function aidev() {
  # Check AWS Bedrock access
  if aws bedrock list-foundation-models --region us-east-1 &>/dev/null; then
    echo "✓ AWS Bedrock access confirmed. Launching Claude..."
    command claude "$@"
  else
    echo "✗ AWS Bedrock access unavailable."
    echo ""
    echo "Choose an option:"
    echo "  [Enter]  Trigger SSO AWS"
    echo "  [Esc]    Launch Crush using OpenRouter"
    echo "  [q]      Exit"
    echo ""
    read -k1 -s choice
    echo

    case $choice in
      $'\n'|"")
        echo "Triggering AWS SSO..."
        aws sso login --sso-session aws
        if aws bedrock list-foundation-models --region us-east-1 &>/dev/null; then
          echo "✓ SSO AWS successful. Launching Claude..."
          command claude "$@"
        else
          echo "✗ SSO AWS failed or AWS Bedrock unavailable."
          echo "Falling back to Crush using OpenRouter..."
          command crush "$@"
        fi
        ;;
      $'\e')
        echo "Launching Crush using OpenRouter..."
        command crush "$@"
        ;;
      q|Q)
        echo "Exiting..."
        return 0
        ;;
      *)
        echo "Invalid choice. Exiting..."
        return 1
        ;;
    esac
  fi
}
