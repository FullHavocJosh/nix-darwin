# =============================================================================
# Non-Sensitive Environment Variables
# =============================================================================
#
# ⚠️  IMPORTANT SECURITY NOTICE:
#
# This file (.zshrc_envvars_insecure) is TRACKED by git and visible to all
# repository contributors. Only store NON-SENSITIVE environment variables here.
#
# For sensitive data (API keys, tokens, passwords):
#   → Use ~/.zshrc_envvars instead (ignored by git)
#   → Configured automatically via 'aiselect' command
#   → Stored with 600 permissions (owner read/write only)
#
# This file should contain:
#   ✓ AWS regions, profiles (non-sensitive settings)
#   ✓ Default configuration values
#   ✓ Non-sensitive application settings
#
# This file should NOT contain:
#   ✗ API keys, tokens, passwords
#   ✗ Private credentials
#   ✗ Secrets of any kind
#
# =============================================================================

# AWS Environment Variables
export AWS_REGION="us-east-1"
export AWS_PROFILE="services"

# Local LLM endpoint (host:port, no path): this host's own llama-server (loopback only).
# Every host runs its own -- never connect to another device's server. The
# variable keeps its old LLAMA_CPP_HOST name because opencode.json and the
# gpc/gpa/aistack functions read it. llamacpp-local.nix sets it via
# environment.variables (nix-darwin writes it into /etc/zshenv, sourced before
# this file); the ${VAR:-default} form here is required, not cosmetic: this
# file is sourced by .zshrc AFTER /etc/zshenv, so a plain unconditional export
# would silently clobber that value on every new shell.
export LLAMA_CPP_HOST="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}"

