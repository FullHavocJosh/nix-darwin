        return 1
      fi
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      if echo "$extracted" | jq empty 2>/dev/null; then
        echo "$extracted"
        return 0
      fi
      echo "Error: Could not parse AI response as JSON" >&2
      echo "[]"
      return 2
      ;;

    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# Execute AI command via OpenCode agent (full agent capabilities, slower)
# Usage: echo "prompt" | _run_ai_agent ["haiku"|"sonnet"|"opus"]
function _run_ai_agent() {
  local task_type="${1:-sonnet}"
  local model=$(_get_opencode_model "$task_type")
  local prompt=$(cat)
  opencode run --model "$model" "$prompt"
}

function _run_ai_command() {
  _run_ai_direct "$@"
}

function _get_ai_command() {
  local task_type="${1:-sonnet}"
  echo "_run_ai_direct $task_type"
}
# aistack -- 4-tier cost-escalation coding stack.
#
# Tier 0: llama.cpp, via aider (--chat-mode ask, read-only, no edit tools).
#   The zero-interaction/scripted tier: used for every background judgment
#   call throughout this pipeline (and by gpr/gpa/gpc's own security
#   scans/checks, outside aistack entirely) -- never the live entry point.
# Tier 1: llama.cpp, via `pi` (full agent -- read/write/edit/bash/grep/find/
#   ls), live and interactive. The starting point: attempts the task
#   directly, and decides for itself -- not via an external heuristic --
#   whether to escalate, by ending its final reply with a parsed
#   `TIER1_STATUS: done|escalate -- <reason>` marker it's instructed to
#   always include.
# Tier 2: OpenCode Zen free tier -- model opencode/$(_get_free_zen_model),
#   currently big-pickle. Tier 1's worker when a task is too complex or
#   would take too long for tier 1 to finish efficiently. Iterative, under
#   tier 0's judgment (same scripted-judge role as before).
# Tier 3: Claude, via GitHub Copilot -- model
#   github-copilot/$(_get_copilot_claude_model sonnet). Final escalation,
#   single attempt: either tier 2 isn't completing things efficiently, or
#   tier 0 flags tier 2's otherwise-complete result as needing review.
#
# Flow:
#   1. Tier 1 (pi) runs live and interactively, full tool access, seeded
#      with the task as its first message (pi supports an initial message
#      that stays interactive afterward -- no --read-a-seed-file workaround
#      needed the way aider's one-shot --message required for tier 0).
#      Work on it yourself, push back, whatever -- when you exit, the LAST
#      assistant message in that session's JSONL is read back and checked
#      for the status marker.
#   2. No session, or no assistant reply ever landed (exited before any
#      exchange): aborts, no further tiers run -- the tier-1 equivalent of
#      the old "exit before approving a plan" abort path.
#   3. `TIER1_STATUS: done` (or no parseable marker -- tier 1 answering a
#      question, or just not complying with the instruction, isn't treated
#      as a reason to burn tier 2/3): ends successfully here.
#   4. `TIER1_STATUS: escalate -- <reason>`: hands off to tier 2 --
#      task + tier 1's own final reply (which states what it attempted and
#      why) + current `git diff --stat` (whatever tier 1 already changed,
#      if anything -- tier 1 has real edit tools, unlike the old tier 0).
#   5. Tier 2 runs through `opencode run --auto` (full agent mode).
#      --auto is required: this repo's opencode.json has edit/write
#      permission set to "ask", which in headless mode auto-REJECTS every
#      edit/write call with no error -- confirmed live, a plain
#      `opencode run` here cannot touch a single file. --auto approves
#      anything not explicitly denied; the deny rules in opencode.json's
#      permission.bash block (rm -rf /, mkfs, etc) still apply regardless.
#   6. After each tier-2 iteration, tier 0 judges (local-coder-judge):
#      given the task, tier 1's assessment, tier 2's latest output, and a
#      diff snapshot, it returns progressing/stuck/done/regressing.
#      `stuck`/`regressing` two checkpoints in a row (not just once --
#      a single bad checkpoint is noise) escalates to tier 3. A judge-call
#      failure fails open as "progressing" -- an infra hiccup in the
#      monitor isn't a reason to burn the paid tier.
#   7. Tier 2 gets at most 3 iterations total; exhausting them without a
#      `done` verdict also escalates to tier 3.
#   8. Any hard-failure signal (timeout, non-zero exit, a known rate-limit/
#      quota/403 string) at tier 2 escalates immediately, no retry, no wait
#      for the next judge checkpoint.
#   9. A clean tier-2 `done` gets one more tier-0 check: "does this
#      specific result warrant review by a stronger model before being
#      considered complete?" A `review` verdict escalates to tier 3 too,
#      framed in the handoff as a review pass, not a fix -- the "or if
#      tier 2 requires additional review/validation" case.
#  10. Tier 3 gets the full history (task, tier 1's assessment, tier 2's
#      last output, escalation/review reason) and one attempt. Same
#      hard-failure check applies; if it also fails there is nowhere
#      further to go.
#
# What this deliberately does not do (v1 scope, not a bug):
#   - No spend cap on the tier 3 attempt -- only its wall-clock timeout
#     bounds it.
#   - Tier 1's own escalation judgment is trusted, not re-verified -- there
#     is no second model cross-checking whether tier 1 was right to call
#     something too complex (or not complex enough).
#
# Every stage (tier-1 session, each tier-2 attempt, each judge/review
# verdict, an abort, the tier-3 attempt) is logged to
# ~/.cache/nix-darwin-ai/aistack-log.jsonl.
#
# Usage: aistack "<task description>"
function aistack_func() {
  # Defensively local-scope xtrace off, matching gpc_func's guard (see
  # .zshrc_functions_git) for the same symptom class -- harmless either way.
  # Carried over from the previous design; root cause was never confirmed
  # there either (see git history), noting again in case it resurfaces.
  local prev_opts=$-
  setopt local_options
  [[ $prev_opts == *x* ]] && setopt no_xtrace

  # Task is optional: run bare `aistack` with no argument and describe the
  # task live in the pi session instead.
  local task="$1"

  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)

  local cache_dir="$HOME/.cache/nix-darwin-ai"
  mkdir -p "$cache_dir" 2>/dev/null
  local ledger="$cache_dir/aistack-log.jsonl"

  local hard_fail_re='rate.?limit|http.?429|freetiererror|can only be used from within opencode|usage cap|quota exceeded|http.?403'
  local endpoint="${LLAMA_CPP_HOST:-http://localhost:8080}"

  _aistack_log() {
    jq -nc --arg ts "$(date -u +%FT%TZ)" "$@" '{ts:$ts} + $ARGS.named' 2>/dev/null >> "$ledger"
  }
  # ---- Preflight: verify each tier is actually usable before starting ----
  # Tier 1 is mandatory -- no ignore option, aistack has nowhere to start
  # without it. Tiers 2/3 can be explicitly ignored for this run; tier 1
  # is told about it below so its own escalation judgment has accurate
  # information instead of escalating into a dead end.
  local tier2_available=true tier2_unavailable_reason=""
  local tier3_available=true tier3_unavailable_reason=""

  if ! curl -s --max-time 3 "${endpoint}/v1/models" 2>/dev/null | grep -q '"id"'; then
    echo "⚠ Tier 1's llama.cpp server is not reachable at $endpoint."
    if [[ -d "$HOME/.config/llama-cpp" ]]; then
      echo -n "Start it now? [Y/n] "
      local reply
      read -r reply
      if [[ "${reply:l}" != "n" ]]; then
        launchctl kickstart -k "gui/$(id -u)/org.nixos.llama-server-local" 2>/dev/null
        echo -n "Waiting for llama-server to come up"
        local waited=0
        while ! curl -s --max-time 2 "${endpoint}/v1/models" 2>/dev/null | grep -q '"id"'; do
          echo -n "."
          sleep 5
          waited=$((waited + 5))
          [[ $waited -ge 240 ]] && break
        done
        echo ""
      fi
    else
      echo "Not a switchable local server (no ~/.config/llama-cpp) -- start it manually, then re-run aistack."
    fi
    if ! curl -s --max-time 3 "${endpoint}/v1/models" 2>/dev/null | grep -q '"id"'; then
      echo "✗ Tier 1 is required and still unavailable -- aborting."
      unset -f _aistack_log
      return 1
    fi
    echo "✓ Tier 1 (llama.cpp) is up."
  fi

  # No API key anywhere on this host (checked by _validate_opencode_zen,
  # which is a presence check, not a live call) -- skip tier 2 silently, no
  # login prompt. Some hosts (e.g. a work machine) deliberately never get a
  # personal OpenCode Zen key, so asking every run would just be noise.
  if ! _validate_opencode_zen; then
    echo "ℹ Tier 2's OpenCode Zen API key isn't configured on this host -- skipping tier 2, tier 3 (claude-code) is next in line if needed."
    tier2_available=false
    tier2_unavailable_reason="OpenCode Zen API key not configured on this host"
  fi
  if $tier2_available && [[ -z "$(_get_free_zen_model 2>/dev/null)" ]]; then
    echo "⚠ Tier 2's OpenCode Zen free-model discovery failed (credential present, but the live API call to list free models didn't succeed)."
    echo -n "[I]gnore tier 2 for this session / [A]bort: "
    local reply
    read -r reply
    case "${reply:l}" in
      i|ignore)
        tier2_available=false
        tier2_unavailable_reason="OpenCode Zen free-model discovery failed"
        ;;
      *)
        echo "Aborting."
        unset -f _aistack_log
        return 1
        ;;
    esac
  fi

  if ! command -v claude &>/dev/null || ! claude auth status 2>/dev/null | jq -e '.loggedIn == true' >/dev/null 2>&1; then
    echo "⚠ Tier 3's Claude Code is not logged in."
    echo -n "[L]ogin now / [I]gnore tier 3 for this session / [A]bort: "
    local reply
    read -r reply
    case "${reply:l}" in
      l|login)
        claude auth login
        if ! claude auth status 2>/dev/null | jq -e '.loggedIn == true' >/dev/null 2>&1; then
          tier3_available=false
          tier3_unavailable_reason="Claude Code login did not complete"
        fi
        ;;
      i|ignore)
        tier3_available=false
        tier3_unavailable_reason="Claude Code not logged in"
        ;;
      *)
        echo "Aborting."
        unset -f _aistack_log
        return 1
        ;;
    esac
  fi
  echo ""


  # ---- Tier 1: live, interactive, pi + llama.cpp -- the entry point ----
  if ! command -v pi &>/dev/null; then
    echo "✗ pi not installed -- cannot run tier 1's interactive session." >&2
    unset -f _aistack_log
    return 1
  fi

  # Isolated config dir: pi's models.json has no env-var interpolation for
  # baseUrl (only apiKey/headers), so the resolved endpoint is baked in
  # fresh each run rather than relying on a static file -- same reason
  # aider's endpoint is passed as a CLI flag, not hardcoded. Kept separate
  # from ~/.pi/agent so aistack never touches a provider config the user
  # might set up for pi directly.
  local pi_dir="$cache_dir/pi-agent"
  mkdir -p "$pi_dir"
  cat > "$pi_dir/models.json" <<PIEOF
{
  "providers": {
    "llama-cpp": {
      "baseUrl": "${endpoint}/v1",
      "api": "openai-completions",
      "apiKey": "sk-local",
      "models": [ { "id": "local-coder" } ]
    }
  }
}
PIEOF

  local tier2_note="- Tier 2: OpenCode Zen's free tier -- your worker if the task is too\n  complex or would take too long for you to finish efficiently."
  $tier2_available || tier2_note="- Tier 2 is UNAVAILABLE this session ($tier2_unavailable_reason). You have no worker to escalate to for complex tasks."
  local tier3_note="- Tier 3: Claude Code -- the final escalation, either because tier 2\n  isn't completing things efficiently, or because tier 2's result needs\n  additional review."
  $tier3_available || tier3_note="- Tier 3 is UNAVAILABLE this session ($tier3_unavailable_reason).$($tier2_available && echo ' If tier 2 also cannot finish this, there is nowhere further to escalate.')"

  local pi_system_prompt="You are Tier 1 of a cost-tiered coding pipeline running locally (llama.cpp).
- Tier 1 (you): attempt the task directly using your tools.
$tier2_note
$tier3_note

Work on the task yourself when you can. When you are finished -- whether
you completed it, or have decided it needs to go to tier 2 -- end your
FINAL reply with exactly one line, nothing after it:
TIER1_STATUS: done -- <one sentence>
or
TIER1_STATUS: escalate -- <one sentence reason>"

  echo "── Tier 1 (llama-cpp via pi): live session -- exit (Ctrl-D or /exit) when done ──"
  echo ""
  if [[ -n "$task" ]]; then
    echo "TASK: $task"
  else
    echo "No task given -- describe what you want done as your first message below."
  fi
  echo ""
  if [[ -n "$repo_root" ]]; then
    echo "Repo-aware: $repo_root"
  else
    echo "No repo detected in the current directory."
  fi
  $tier2_available || echo "Tier 2 unavailable this session: $tier2_unavailable_reason"
  $tier3_available || echo "Tier 3 unavailable this session: $tier3_unavailable_reason"
  echo "(llama.cpp is a slow local model -- a reply can take a while with"
  echo "nothing visible in between. That's normal, not stuck.)"
  echo ""

  # Isolate this run's session: find -newer against a marker created right
  # before launch, rather than guessing pi's cwd-to-directory-name slug
  # encoding (confirmed live it's not a plain `/`->`-` substitution) --
  # the newest .jsonl under this dedicated dir after the marker is
  # unambiguously this run's, since nothing else writes here.
  local session_marker
  session_marker=$(mktemp "$pi_dir/.run-marker-XXXXXX")

  # --theme makes catppuccin-mocha/catppuccin-latte selectable (via /settings
  # or --use-theme) without forcing them -- default stays unset, which pi
  # resolves to its own "system" theme (queries the terminal's colors and
  # builds a matching palette, falling back to bare ANSI indices only if the
  # terminal reports nothing). That matches the terminal first, catppuccin
  # available as the house fallback, same as every other TUI in this repo.
  local pi_theme_dir="$HOME/.config/pi/themes"
  if [[ -n "$task" ]]; then
    PI_CODING_AGENT_DIR="$pi_dir" pi --provider llama-cpp --model local-coder \
      --no-skills --no-extensions \
      --tools read,write,edit,bash,grep,find,ls \
      --theme "$pi_theme_dir" \
      --append-system-prompt "$pi_system_prompt" \
      "$task"
  else
    PI_CODING_AGENT_DIR="$pi_dir" pi --provider llama-cpp --model local-coder \
      --no-skills --no-extensions \
      --tools read,write,edit,bash,grep,find,ls \
      --theme "$pi_theme_dir" \
      --append-system-prompt "$pi_system_prompt"
  fi

  local session_file
  session_file=$(find "$pi_dir/sessions" -name '*.jsonl' -newer "$session_marker" 2>/dev/null | sort | tail -1)
  rm -f "$session_marker"

  local tier1_final=""
  local had_real_tool_use=false
  if [[ -n "$session_file" && -f "$session_file" ]]; then
    tier1_final=$(jq -rs '
      [.[] | select(.type=="message" and .message.role=="assistant")]
      | last
      | .message.content[]? | select(.type=="text") | .text
    ' "$session_file" 2>/dev/null)
    # Confirms at least one tool call actually executed (a real toolCall
    # JSON object that got a non-error toolResult back), not just text that
    # looks like one -- confirmed live, this model's first attempt at a
    # tool call once leaked as literal `<function=write>...</function>`
    # text instead of a real tool call, and the task silently did not
    # happen despite the model's prose claiming it would.
    if jq -se '[.[] | select(.type=="message" and .message.role=="toolResult" and (.message.isError==false))] | length > 0' "$session_file" 2>/dev/null | grep -q true; then
      had_real_tool_use=true
    fi
  fi

  if [[ -z "$tier1_final" ]]; then
    echo "No reply captured from tier 1 -- aborting, no further tiers run."
    _aistack_log --arg stage aborted --arg mode interactive
    unset -f _aistack_log
    return 1
  fi

  [[ -z "$task" ]] && task="$tier1_final"

  local tier1_status=""
  if echo "$tier1_final" | grep -qiE '^TIER1_STATUS:[[:space:]]*escalate'; then
    tier1_status="escalate"
  elif echo "$tier1_final" | grep -qiE '^TIER1_STATUS:[[:space:]]*done'; then
    tier1_status="done"
  elif $had_real_tool_use; then
    echo "⚠ Tier 1 didn't end with a status marker, but did complete at least one real tool action -- treating as done."
    tier1_status="done"
  else
    echo "⚠ Tier 1 ended without a status marker and no confirmed successful tool use."
    echo "Its last reply may have been malformed (e.g. an unrecognized tool-call format emitted as plain text instead of a real call) or it may have been a question that needed no tool use at all. Its last reply:"
    echo ""
    echo "$tier1_final"
    echo ""
    echo -n "[D]one anyway / [E]scalate to tier 2 / [A]bort: "
    local reply
    read -r reply
    case "${reply:l}" in
      e|escalate) tier1_status="escalate" ;;
      a|abort)
        _aistack_log --arg stage aborted --arg mode interactive
        unset -f _aistack_log
        return 1
        ;;
      *) tier1_status="done" ;;
    esac
  fi

  local tier1_reason
  tier1_reason=$(echo "$tier1_final" | grep -oiE '^TIER1_STATUS:.*' | head -1)
  _aistack_log --arg stage tier1_session --arg status "$tier1_status"

  if [[ "$tier1_status" == "done" ]]; then
    echo "✓ Tier 1 completed. No escalation triggered."
    unset -f _aistack_log
    return 0
  fi

  if ! $tier2_available && ! $tier3_available; then
    echo "✗ Tier 1 wants to escalate, but both tier 2 and tier 3 are unavailable this session -- nothing further to do."
    _aistack_log --arg stage aborted --arg mode "no_tiers_available"
    unset -f _aistack_log
    return 1
  fi


  # ---- Tier 2: execution loop, monitored by tier 0 ----
  echo "⚠ Tier 1 escalating: ${tier1_reason:-no reason given}"
  local tier2_model=""
  local max_iters=3
  local stuck_count=0
  local prompt="ORIGINAL TASK:
$task

TIER 1'S ASSESSMENT:
$tier1_final

Continue this work. The workspace may already contain partial changes
from tier 1 -- check its current state before relying on anything above."
  local escalate_reason=""
  local t2_output=""
  local iter

  if ! $tier2_available; then
    echo "⚠ Tier 2 is unavailable this session ($tier2_unavailable_reason) -- skipping straight to tier 3."
    escalate_reason="tier 2 unavailable this session ($tier2_unavailable_reason)"
  else
  tier2_model="opencode/$(_get_free_zen_model)"
  for iter in 1 2 3; do
    echo "── Tier 2 iter $iter/$max_iters (opencode-free): $tier2_model ──"

    local start_ts=$(date +%s)
    local t2_exit
    t2_output=$(timeout 300s opencode run --auto --model "$tier2_model" "$prompt" 2>&1)
    t2_exit=$?
    _herdr_report_opencode_idle
    local elapsed=$(( $(date +%s) - start_ts ))
    echo "$t2_output"

    local hard_reason=""
    if [[ $t2_exit -eq 124 ]]; then
      hard_reason="timeout after 300s"
    elif [[ $t2_exit -ne 0 ]]; then
      hard_reason="exit code $t2_exit"
    elif echo "$t2_output" | grep -qiE "$hard_fail_re"; then
      hard_reason="hard provider failure signal"
    fi

    _aistack_log --arg stage tier2_attempt --argjson iter "$iter" \
      --argjson exit_code "$t2_exit" --argjson elapsed_s "$elapsed" --arg reason "$hard_reason"

    if [[ -n "$hard_reason" ]]; then
      escalate_reason="$hard_reason"
      break
    fi

    # ---- Tier 0: judge this iteration's progress ----
    echo "── Tier 0 (llama-cpp, judging iter $iter) ──"
    local diff_stat=""
    [[ -n "$repo_root" ]] && diff_stat=$(git -C "$repo_root" diff --stat)
    local judge_prompt="You are monitoring a coding agent's progress on a task.

ORIGINAL TASK:
$task

TIER 1'S ASSESSMENT (why this was escalated to tier 2):
$tier1_final

CODING AGENT'S LATEST OUTPUT (iteration $iter of $max_iters):
$t2_output

WORKSPACE DIFF SO FAR:
$diff_stat

Respond with exactly one word first -- progressing, stuck, done, or
regressing -- optionally followed by a one-line reason. Do not write code."
    local judge_output judge_exit
    judge_output=$(_run_aider_local "local-coder-judge" 180 "$judge_prompt" 2>&1)
    judge_exit=$?

    local verdict="progressing"
    if [[ $judge_exit -eq 0 && -n "$judge_output" ]]; then
      verdict=$(echo "$judge_output" | grep -oiE '^(progressing|stuck|done|regressing)' | head -1 | tr 'A-Z' 'a-z')
      [[ -z "$verdict" ]] && verdict="progressing"
    else
      echo "⚠ Tier 0 judge call failed -- failing open as 'progressing'."
    fi
    echo "Tier 0 verdict: $verdict"
    _aistack_log --arg stage judge --argjson iter "$iter" --arg verdict "$verdict" --argjson judge_exit "$judge_exit"

    case "$verdict" in
      done)
        # One more tier-0 check before calling it final: does this result
        # specifically warrant review by a stronger model? ("...or if tier
        # 2 requires additional review/validation" -- a clean done verdict
        # doesn't rule that out on its own.)
        echo "── Tier 0 (llama-cpp, review check) ──"
        local review_prompt="A coding agent just finished this task:

ORIGINAL TASK:
$task

FINAL OUTPUT:
$t2_output

WORKSPACE DIFF:
$diff_stat

Does this specific result warrant review by a stronger model before being
considered complete (e.g. security-sensitive, high-risk, or unusually
large/complex changes)? Respond with exactly one word: review or done."
        local review_output review_exit review_verdict="done"
        review_output=$(_run_aider_local "local-coder-judge" 180 "$review_prompt" 2>&1)
        review_exit=$?
        if [[ $review_exit -eq 0 && -n "$review_output" ]]; then
          review_verdict=$(echo "$review_output" | grep -oiE '^(review|done)' | head -1 | tr 'A-Z' 'a-z')
          [[ -z "$review_verdict" ]] && review_verdict="done"
        fi
        _aistack_log --arg stage review --arg verdict "$review_verdict"

        if [[ "$review_verdict" == "review" ]]; then
          echo "⚠ Tier 0 requested review of tier 2's completed work."
          escalate_reason="tier 2 completed, but tier 0 flagged the result for review"
          break
        fi

        echo "✓ Tier 0 judged the task complete after tier 2 iteration $iter."
        unset -f _aistack_log
        return 0
        ;;
      stuck|regressing)
        stuck_count=$((stuck_count + 1))
        if [[ $stuck_count -ge 2 ]]; then
          escalate_reason="tier 0 judged $verdict for $stuck_count consecutive checkpoints"
          break
        fi
        ;;
      *)
        stuck_count=0
        ;;
    esac

    if [[ $iter -eq $max_iters ]]; then
      escalate_reason="tier 2 exhausted $max_iters iterations without a done verdict"
      break
    fi

    prompt="ORIGINAL TASK:
$task

TIER 1'S ASSESSMENT:
$tier1_final

PREVIOUS ATTEMPT (iteration $iter) OUTPUT:
$t2_output

Tier 0's assessment: $verdict. Continue this work. The workspace may
already contain partial changes -- check its current state before relying
on anything above."
  done
  fi

  if [[ -z "$escalate_reason" ]]; then
    echo "✓ Tier 2 completed. No further escalation triggered."
    unset -f _aistack_log
    return 0
  fi

  # ---- Tier 3: last resort, single attempt ----
  echo "⚠ Escalating to Tier 3 ($escalate_reason)."
  if ! $tier3_available; then
    echo "✗ Tier 3 (claude-code) is unavailable this session ($tier3_unavailable_reason) -- no further tier to escalate to."
    return 1
  fi
  echo "── Tier 3 (claude-code) ──"
  local tier2_section
  if $tier2_available; then
    tier2_section="TIER 2'S LAST ATTEMPT ($tier2_model):
$t2_output"
  else
    tier2_section="TIER 2 did not run: $tier2_unavailable_reason"
  fi
  local handoff_prompt="ORIGINAL TASK:
$task

TIER 1'S ASSESSMENT:
$tier1_final

$tier2_section

Escalation reason: $escalate_reason

Continue this work. The workspace may already contain partial changes from
previous attempts -- check its current state before relying on anything
described above."

  local t3_output t3_exit
  t3_output=$(timeout 300s claude -p --permission-mode bypassPermissions "$handoff_prompt" 2>&1)
  t3_exit=$?
  echo "$t3_output"

  local t3_reason=""
  if [[ $t3_exit -eq 124 ]]; then
    t3_reason="timeout after 300s"
  elif [[ $t3_exit -ne 0 ]]; then
    t3_reason="exit code $t3_exit"
  elif echo "$t3_output" | grep -qiE "$hard_fail_re"; then
    t3_reason="hard provider failure signal"
  fi
  _aistack_log --arg stage tier3_attempt --argjson exit_code "$t3_exit" --arg reason "$t3_reason"
  unset -f _aistack_log

  if [[ -n "$t3_reason" ]]; then
    echo "✗ Tier 3 also triggered a failure signal ($t3_reason) -- no further tier to escalate to."
    return 1
  fi

  echo "✓ Tier 3 completed."
  return 0
}

# opencode's TUI treats its first positional as the [project] directory, so a
# prompt passed positionally gets cd'd into ("Failed to change directory to
# <cwd>/<prompt>"). Interactive mode must pass it via --prompt; only `run`
# accepts the message positionally.
function _aidev_opencode() {
  local model="$1" print_mode="$2"
  shift 2
  if $print_mode; then
    opencode --model "$model" run "$@"
  elif (( $# > 0 )); then
    opencode --model "$model" --prompt "$*"
  else
    opencode --model "$model"
  fi
}

function aidev() {
  local GREEN='\033[0;32m'
  local NC='\033[0m'

  _ensure_ai_provider || return 1

  local provider=$(_get_ai_provider)

  echo "${GREEN}✓${NC} Provider: $(_provider_display_name "$provider")"

  # Detect -p/--print flag and translate for providers that don't support it.
  # claude uses -p for headless mode; opencode uses `run` as the subcommand.
  local print_mode=false
  local filtered_args=()
  for arg in "$@"; do
    if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
      print_mode=true
    else
      filtered_args+=("$arg")
    fi
  done

  case "$provider" in
    claude-code)
      echo ""
      if $print_mode; then
        claude -p "${filtered_args[@]}"
      else
        claude "${filtered_args[@]}"
      fi
      ;;
    llama-cpp)
      local local_model="llama.cpp/local-coder"
      echo "${GREEN}✓${NC} Model:    ⚪ $(_llamacpp_model_short) → $local_model"
      echo ""
      _aidev_opencode "$local_model" $print_mode "${filtered_args[@]}"
      ;;
    github-copilot)
      # GitHub Copilot via OpenCode
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      _aidev_opencode "$model" $print_mode "${filtered_args[@]}"
      ;;
    opencode)
      # OpenCode Zen - check if a specific model is set in opencode.json
      local model=""
      local config_file="$HOME/.config/opencode/opencode.json"
      if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
        model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
      fi
      
      # Fallback to discovering latest Sonnet if no model is set
      if [[ -z "$model" || "$model" == "null" ]]; then
        model=$(_get_opencode_model "sonnet")
      fi
      
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      _aidev_opencode "$model" $print_mode "${filtered_args[@]}"
      ;;
    *)
      # Unknown provider - fall back to github-copilot
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model (fallback)"
      echo ""
      _aidev_opencode "$model" $print_mode "${filtered_args[@]}"
      ;;
  esac
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

function _validate_opencode_zen() {
  [[ -n "$OPENCODE_ZEN_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars_insecure && return 0
  [[ -f ~/.config/opencode/.env ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.config/opencode/.env && return 0
  # Check auth.json for OpenCode Zen API key (injected by nix-darwin activation)
  if [[ -f ~/.local/share/opencode/auth.json ]] && command -v jq &>/dev/null; then
    local opencode_key=$(jq -r '.opencode.key // empty' ~/.local/share/opencode/auth.json 2>/dev/null)
    [[ -n "$opencode_key" ]] && return 0
  fi
  return 1
}

function _llamacpp_model_tier() {
  local ram_bytes ram_gb
  ram_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
  ram_gb=$(( ram_bytes / 1024 / 1024 / 1024 ))
  echo "qwen2.5-coder-7b Q8 (~8 GB, ${ram_gb} GB device)"
}


# Keep in sync with `localModels` in nix-modules/macos/llamacpp-local.nix --
# id must match exactly, label is just for display.
function _llamacpp_local_model_label() {
  case "$1" in
    qwen3-coder-30b-a3b) echo "Qwen3-Coder-30B-A3B" ;;
    devstral-small-2-24b) echo "Devstral-Small-2-24B" ;;
    *)                 echo "$1" ;;
  esac
}

function _llamacpp_model_short() {
  local state_file="$HOME/.config/llama-cpp/selected-model"
  if [[ -f "$state_file" ]]; then
    _llamacpp_local_model_label "$(cat "$state_file")"
    return
  fi
  echo "${LLAMA_CPP_MODEL_LABEL:-Qwen3-Coder-30B-A3B}"
}


function _validate_llamacpp() {
  local endpoint="${LLAMA_CPP_HOST:-http://localhost:8080}"
  local response
  if [[ "${LOCAL_LLM_BACKEND:-llamacpp}" == "lmstudio" ]]; then
    # LM Studio has no /health (it answers 200 with an error body); /v1/models
    # lists downloaded models whether or not one is loaded, and the server
    # loads LOCAL_LLM_MODEL on the first request.
    local lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
    response=$(curl -s --max-time 3 "${endpoint}/v1/models" 2>/dev/null)
    echo "$response" | grep -q "\"${lms_model}\"" || return 1
    # LM Link also lists other devices' models in /v1/models, and a request for a
    # model key held by a linked device can be served there. Require a copy on
    # this machine's own disk so prompts never leave the host (matters most for
    # the work laptop). Skipped if lms or jq is missing.
    if command -v lms &>/dev/null && command -v jq &>/dev/null; then
      lms ls --json 2>/dev/null | jq -e --arg m "$lms_model" \
        'any(.[]; .modelKey == $m and .deviceIdentifier == null)' >/dev/null || return 1
    fi
    return 0
  fi
  response=$(curl -s --max-time 3 "${endpoint}/health" 2>/dev/null)
  if echo "$response" | grep -q '"status"'; then
    return 0
  fi
  return 1
}

function _validate_claude_code() {
  command -v claude &>/dev/null || return 1
  # API key auth
  [[ -n "$ANTHROPIC_API_KEY" ]] && return 0
  # OAuth session - use `claude auth status` to check if logged in
  if claude auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    return 0
  fi
  return 1
}

# Check internet connectivity using curl or dig (not ping)
function _is_online() {
  if command -v curl &>/dev/null; then
    curl -sf --max-time 2 --connect-timeout 1 https://1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  if command -v dig &>/dev/null; then
    dig +time=1 +tries=1 @1.1.1.1 cloudflare.com >/dev/null 2>&1 && return 0
  fi
  if command -v ping &>/dev/null; then
    ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  return 1
}

function _get_ai_provider() {
  # gpc-local/gpa-local/gpr-local set this to pin the whole resolution chain
  # to llama-cpp for a run, bypassing session/preference files entirely.
  [[ -n "$AI_LOCAL_ONLY" ]] && echo "llama-cpp" && return 0
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local preference_file="$HOME/.ai_provider_preference"
  [[ -f "$session_file" ]] && cat "$session_file" && return 0
  [[ -f "$preference_file" ]] && cat "$preference_file" && return 0
  _validate_claude_code 2>/dev/null && echo "claude-code" && return 0
  echo "github-copilot"
}

# Dispatch validation to the appropriate provider validator
function _validate_provider() {
  case "$1" in
    claude-code)    _validate_claude_code ;;
    github-copilot) _validate_github_copilot ;;
    opencode)       _validate_opencode_zen ;;
    llama-cpp)      _validate_llamacpp ;;
    *)              return 1 ;;
  esac
}

# Ensure a valid provider is set for this session.
# - No session file: auto-detect silently (no cascade, _get_ai_provider handles it).
# - Session file exists but provider is invalid: re-run aiselect cascade.
function _ensure_ai_provider() {
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local RED='\033[0;31m'
  local NC='\033[0m'
  [[ ! -f "$session_file" ]] && return 0
  local provider
  provider=$(cat "$session_file")
  if _validate_provider "$provider" 2>/dev/null; then
    return 0
  fi
  echo "${RED}✗${NC} Provider '$provider' is no longer valid — re-running aiselect..."
  rm -f "$session_file"
  aiselect
}

# Hybrid routing: llama-cpp → cloud escalation
# gpc/gpr always local; gpa escalates to cloud on critical/security findings
# Cloud provider stored in ~/.ai_cloud_provider_preference (separate from main provider).
# Defaults to github-copilot, not anthropic: git-helper cloud escalation should
# never consume the Anthropic/Claude Code API quota, which is reserved for the
# interactive Claude Code session.
function _get_cloud_fallback_provider() {
  local cloud_pref="$HOME/.ai_cloud_provider_preference"
  if [[ -f "$cloud_pref" ]]; then
    cat "$cloud_pref"
  else
    echo "github-copilot"
  fi
}

function _get_cloud_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)

  case $provider in
    github-copilot)
      echo "github-copilot/$(_get_copilot_claude_model "$task_type")"
      ;;
    opencode)
      [[ "$task_type" == "opus"  ]] && echo "opencode/claude-opus-4.5"        && return
      [[ "$task_type" == "haiku" ]] && echo "opencode/claude-3-5-haiku"        && return
      echo "opencode/claude-sonnet-4.5"
      ;;
    anthropic|*)
      [[ "$task_type" == "opus"  ]] && echo "anthropic/claude-opus-4-5"  && return
      [[ "$task_type" == "haiku" ]] && echo "anthropic/claude-haiku-4-5" && return
      echo "anthropic/claude-sonnet-4-6"
      ;;
  esac
}

# Plain-text AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_plain_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_plain_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: OpenCode timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: OpenCode failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
  esac
}

# Structured-JSON AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_direct_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_direct_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include any text before or after it.
If there are no issues, respond with exactly: []
START YOUR RESPONSE NOW WITH [ OR []:"

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: OpenCode timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: OpenCode call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
  esac
}

# Check Claude service status from status.claude.com
# Returns 0 if operational, 1 if there are issues
# Prints status information to stdout
function _check_claude_status() {
  # Use -L to follow redirects
  local status_json=$(curl -sL --max-time 5 https://status.claude.com/api/v2/components.json 2>/dev/null)
  
  # If curl failed or returned empty, assume services are operational (fail open)
  if [[ -z "$status_json" ]] || [[ "$status_json" == *"<html"* ]]; then
    return 0
  fi
  
  # Extract statuses using jq if available, otherwise use grep
  local claude_code_status=""
  local claude_ai_status=""
  local platform_status=""
  
  if command -v jq &>/dev/null; then
    claude_code_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="Claude Code") | .status' 2>/dev/null)
    claude_ai_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="claude.ai") | .status' 2>/dev/null)
    platform_status=$(echo "$status_json" | jq -r '.components[] | select(.name | startswith("platform.claude.com")) | .status' 2>/dev/null)
  else
    # Fallback to grep/sed if jq not available
    claude_code_status=$(echo "$status_json" | grep -o '"name":"Claude Code"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    claude_ai_status=$(echo "$status_json" | grep -o '"name":"claude.ai"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    platform_status=$(echo "$status_json" | grep -o '"name":"platform.claude.com[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
  fi
  
  # Check if any service has issues
  local has_issues=0
  local RED='\033[0;31m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  if [[ "$claude_code_status" == "partial_outage" ]] || [[ "$claude_code_status" == "major_outage" ]] || [[ "$claude_code_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  Claude Code: ${YELLOW}${claude_code_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$claude_ai_status" == "partial_outage" ]] || [[ "$claude_ai_status" == "major_outage" ]] || [[ "$claude_ai_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  claude.ai: ${YELLOW}${claude_ai_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$platform_status" == "partial_outage" ]] || [[ "$platform_status" == "major_outage" ]] || [[ "$platform_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  platform.claude.com: ${YELLOW}${platform_status}${NC}"
    has_issues=1
  fi
  
  if [[ $has_issues -eq 1 ]]; then
    echo "  ${YELLOW}ℹ${NC}  Auth may fail due to service issues. Check https://status.claude.com"
    return 1
  fi
  
  return 0
}

# Check GitHub Copilot service status from githubstatus.com
# Returns 0 if operational, 1 if there are issues
# Prints status information to stdout
function _check_github_copilot_status() {
  local status_json=$(curl -sL --max-time 5 https://www.githubstatus.com/api/v2/components.json 2>/dev/null)
  
  # If curl failed or returned empty, assume services are operational (fail open)
  if [[ -z "$status_json" ]] || [[ "$status_json" == *"<html"* ]]; then
    return 0
  fi
  
  # Extract statuses using jq if available, otherwise use grep
  local copilot_status=""
  local api_status=""
  
  if command -v jq &>/dev/null; then
    copilot_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="Copilot") | .status' 2>/dev/null)
    api_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="API Requests") | .status' 2>/dev/null)
  else
    # Fallback to grep/sed if jq not available
    copilot_status=$(echo "$status_json" | grep -o '"name":"Copilot"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    api_status=$(echo "$status_json" | grep -o '"name":"API Requests"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
  fi
  
  # Check if any service has issues
  local has_issues=0
  local RED='\033[0;31m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  if [[ "$copilot_status" == "partial_outage" ]] || [[ "$copilot_status" == "major_outage" ]] || [[ "$copilot_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  GitHub Copilot: ${YELLOW}${copilot_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$api_status" == "partial_outage" ]] || [[ "$api_status" == "major_outage" ]] || [[ "$api_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  GitHub API: ${YELLOW}${api_status}${NC}"
    has_issues=1
  fi
  
  if [[ $has_issues -eq 1 ]]; then
    echo "  ${YELLOW}ℹ${NC}  Auth may fail due to service issues. Check https://www.githubstatus.com"
    return 1
  fi
  
  return 0
}

function aiselect() {
  local preference_file="$HOME/.ai_provider_preference"

  if [[ "$1" == "--show" ]] || [[ "$1" == "--status" ]]; then
    local current_provider=$(_get_ai_provider)
    local opencode_model=$(_get_opencode_model "sonnet")
    local opencode_haiku_model=$(_get_opencode_model "haiku")
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Current AI Configuration"
    echo "═══════════════════════════════════════════════════════════"
    echo "Active Provider: $(_provider_display_name "$current_provider")"
    echo ""
    echo "Interactive Sessions (aidev):"
    echo "  Mode: Full Claude Code agent with tools"
    if [[ "$current_provider" == "claude-code" ]]; then
      echo "  → claude (direct, uses Claude.ai subscription)"
    else
      echo "  Model: $opencode_model"
      echo "  → claude (provider: $current_provider)"
    fi
    echo ""
    echo "Direct API Functions (fast, lightweight):"
    echo "  Haiku tasks  (commit msgs): $opencode_haiku_model"
    echo "  Sonnet tasks (code review): $opencode_model"
    echo "  Mode: Direct API calls (no agent overhead)"
    echo "  Response time: ~5-15 seconds"
    echo ""
    echo "Command → Model → Mode:"
    if [[ "$current_provider" == "claude-code" ]]; then
      echo "  • aidev                     → claude (direct) → Full Agent"
      echo "  • gpa                       → $opencode_model → Headless review (never Anthropic directly)"
    else
      echo "  • aidev                     → $opencode_model → Full Agent (claude)"
      echo "  • gpa                       → $opencode_model → Headless review"
    fi
    echo "  • gpc (commit messages)     → $opencode_haiku_model → Direct API"
    echo "  • gpa (code review)         → $opencode_model → Direct API"
    echo ""
    if [[ "$current_provider" == "llama-cpp" ]]; then
      local endpoint="${LLAMA_CPP_HOST:-http://localhost:8080}"
      local cloud_provider=$(_get_cloud_fallback_provider)
      local cloud_model=$(_get_cloud_model "sonnet")
      echo ""
      echo "Hybrid Routing (llama-cpp + cloud escalation):"
      echo "  Local endpoint:   $endpoint"
      echo "  Local tier:       $([[ -d "$HOME/.config/llama-cpp" ]] && echo "$(_llamacpp_model_short) (local, switchable via aiselect)" || _llamacpp_model_tier)"
      echo "  Cloud provider:   $cloud_provider"
      echo "  Cloud model:      $cloud_model"
      echo ""
      echo "  gpc  → ⚪ local always  (commit messages)"
      echo "  gpr  → ⚪ local always  (PR creation)"
      echo "  gpa  → ⚪ local (small diffs) → 🟢 Haiku (medium) → 🔵 Sonnet (large or critical/security)"
      echo "  aidev → ⚪ local (claude with llama.cpp, currently: $(_llamacpp_model_short))"
    fi
    echo ""
    echo "Note: Run 'aiselect' to change provider. Changes apply immediately"
    echo "      to all commands (no restart required)."
    echo "═══════════════════════════════════════════════════════════"
    return 0
  fi
  
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  local session_file="/tmp/.ai_provider_session_$(id -u)"

  _aiselect_commit() {
    local new_provider="$1"
    echo "$new_provider" > "$preference_file"
    echo "$new_provider" > "$session_file"
    
    # Clear opencode.json model if it doesn't match the new provider
    # This prevents stale model configs from interfering with provider switching
    local config_file="$HOME/.config/opencode/opencode.json"
    if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
      local current_model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
      if [[ -n "$current_model" && "$current_model" != "null" ]]; then
        # Check if model matches new provider
        local model_matches=false
        case "$new_provider" in
          github-copilot)
            [[ "$current_model" == github-copilot/* ]] && model_matches=true
            ;;
          opencode)
            [[ "$current_model" == opencode/* ]] && model_matches=true
            ;;
          claude-code)
            # Claude Code doesn't use opencode.json, clear it
            model_matches=false
            ;;
          llama-cpp)
            [[ "$current_model" == llama.cpp/* || "$current_model" == llama-cpp/* ]] && model_matches=true
            ;;
        esac
        
        # Clear mismatched model from config
        if ! $model_matches; then
          cp "$config_file" "$config_file.backup"
          jq 'del(.model)' "$config_file" > "$config_file.tmp"
          mv "$config_file.tmp" "$config_file"
        fi
      fi
    fi
  }

  echo "═══════════════════════════════════════════════════════════"
  echo "AI Provider Selection"
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Offline: inform user about limitations
  if ! _is_online; then
    echo "${YELLOW}⚠${NC}  No internet connection detected."
    echo ""
    echo "Cloud AI providers require internet. Available options:"
    echo "  • Wait for internet connection to be restored"
    if _validate_llamacpp; then
      echo "  • llama.cpp is running and can be used for gpc/gpa (limited)"
      echo ""
      echo "Note: llama.cpp cannot run full OpenCode sessions (context limit)"
      echo "      but works for git commit messages and simple code review."
    else
      echo "  • Start llama-server for offline git commit message generation"
      echo ""
      echo "To start llama-server:"
      echo "  brew services start llama-cpp"
    fi
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    return 1
  fi

  # Check availability of all providers
  local claude_code_status="${RED}✗${NC}"
  local claude_code_available=false
  if _validate_claude_code; then
    claude_code_status="${GREEN}✓${NC}"
    claude_code_available=true
  elif command -v claude &>/dev/null; then
    claude_code_status="${YELLOW}⚠${NC}"
  fi

  local github_copilot_status="${RED}✗${NC}"
  local github_copilot_available=false
  if _validate_github_copilot; then
    github_copilot_status="${GREEN}✓${NC}"
    github_copilot_available=true
  fi

  local opencode_zen_status="${RED}✗${NC}"
  local opencode_zen_available=false
  if _validate_opencode_zen; then
    opencode_zen_status="${GREEN}✓${NC}"
    opencode_zen_available=true
  fi

  local llamacpp_status="${RED}✗${NC}"
  local llamacpp_available=false
  if _validate_llamacpp; then
    llamacpp_status="${GREEN}✓${NC}"
    llamacpp_available=true
  fi

  # Display menu
  echo "Select AI Provider:"
  echo ""
  echo "  1) $claude_code_status Anthropic"
  echo "  2) $github_copilot_status GitHub Copilot"
  echo "  3) $opencode_zen_status OpenCode Zen (API key)"
  echo "  4) $llamacpp_status llama.cpp (local: $(_llamacpp_model_short)) -- also usable via aidev/opencode"
  echo ""
  echo "Note: gpc always prefers llama.cpp when reachable, and gpa does too"
  echo "      on hosts that default to local (AI_LOCAL_DEFAULT) -- regardless"
  echo "      of the selection below. That selection only changes which"
  echo "      provider/model aidev and interactive opencode sessions use."
  echo ""
  echo -n "Selection (1-4) [Enter = llama.cpp/Gemma-4, auto-selects in 5s]: "
  read -t 5 -r choice
  echo ""
  local _auto_timeout=false
  if [[ -z "$choice" ]]; then
    choice="4"
    _auto_timeout=true
  fi

  case "$choice" in
    1)
      # Anthropic
      if $claude_code_available; then
        _aiselect_commit "claude-code"
        echo "${GREEN}✓${NC} Using Anthropic"
        echo "═══════════════════════════════════════════════════════════"
        return 0
      elif command -v claude &>/dev/null; then
        echo "Claude Code installed but not authenticated."
        
        # Check Claude service status before attempting login
        _check_claude_status
        
        echo ""
        echo -n "Login to Claude Code? [y/N]: "
        read -r confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
          echo ""
          claude auth login
          echo ""
          if _validate_claude_code; then
            echo "${GREEN}✓${NC} Login successful"
            _aiselect_commit "claude-code"
            echo "═══════════════════════════════════════════════════════════"
            return 0
          else
            echo "${RED}✗${NC} Login failed or incomplete"
            return 1
          fi
        else
          echo "Cancelled."
          return 1
        fi
      else
        echo "${RED}✗${NC} Claude Code not installed"
        echo "Install with: brew install --cask claude-code"
        return 1
      fi
      ;;
    
    2)
      # GitHub Copilot
      if $github_copilot_available; then
        _aiselect_commit "github-copilot"
        echo "${GREEN}✓${NC} Using GitHub Copilot"
        echo "═══════════════════════════════════════════════════════════"
        return 0
      else
        echo "GitHub Copilot not authenticated."
        
        # Check GitHub Copilot service status
        _check_github_copilot_status
        
        echo ""
        echo -n "Login to GitHub Copilot? [y/N]: "
        read -r confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
          echo ""
          if command -v open &>/dev/null; then
            open "https://github.com/login/device"
          fi
          opencode auth login
          echo ""
          if _validate_github_copilot; then
            echo "${GREEN}✓${NC} Login successful"
            _aiselect_commit "github-copilot"
            echo "═══════════════════════════════════════════════════════════"
            return 0
          else
            echo "${RED}✗${NC} Login failed or incomplete"
            return 1
          fi
        else
          echo "Cancelled."
          return 1
        fi
      fi
      ;;
    
    3)
      # OpenCode Zen
      if $opencode_zen_available; then
        _aiselect_commit "opencode"
        
        # Interactive model selection for OpenCode Zen
        echo "═══════════════════════════════════════════════════════════"
        echo "OpenCode Zen Model Selection"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "Select model category:"
        echo "  1) Claude Models (Paid)"
        echo "  2) Free Models"
        echo ""
        echo -n "Selection (1-2): "
        read -r category_choice
        
        local selected_model=""
        
        if [[ "$category_choice" == "1" ]]; then
          echo ""
          echo "Select Claude model:"
          echo "  1) Claude Opus 4.7 (Latest, most capable)"
          echo "  2) Claude Sonnet 4.6 (Latest, balanced)"
          echo "  3) Claude Haiku 4.5 (Latest, fast)"
          echo ""
          echo -n "Selection (1-3): "
          read -r model_choice
          
          case "$model_choice" in
            1) selected_model="opencode/claude-opus-4-7" ;;
            2) selected_model="opencode/claude-sonnet-4-6" ;;
            3) selected_model="opencode/claude-haiku-4-5" ;;
            *) selected_model="opencode/claude-sonnet-4-6" ;;
          esac
        elif [[ "$category_choice" == "2" ]]; then
          echo ""
          echo "Select free model:"
          echo "  1) Big Pickle (Free)"
          echo "  2) DeepSeek V4 Flash (Free)"
          echo "  3) MiniMax M2.5 (Free)"
          echo "  4) Nemotron 3 Super (Free)"
          echo ""
          echo -n "Selection (1-4): "
          read -r model_choice
          
          case "$model_choice" in
            1) selected_model="opencode/big-pickle" ;;
            2) selected_model="opencode/deepseek-v4-flash-free" ;;
            3) selected_model="opencode/minimax-m2.5-free" ;;
            4) selected_model="opencode/nemotron-3-super-free" ;;
            *) selected_model="opencode/big-pickle" ;;
          esac
        else
          # Default to Sonnet if invalid choice
          selected_model="opencode/claude-sonnet-4-6"
        fi
        
        # Update OpenCode config with selected model
        if command -v jq &>/dev/null; then
          local config_file="$HOME/.config/opencode/opencode.json"
          if [[ -f "$config_file" ]]; then
            cp "$config_file" "$config_file.backup"
            jq --arg model "$selected_model" '.model = $model' "$config_file" > "$config_file.tmp"
            mv "$config_file.tmp" "$config_file"
            echo ""
            echo "${GREEN}✓${NC} Model set to: $selected_model"
            echo "${GREEN}✓${NC} Config updated: $config_file"
          fi
        fi
        
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        return 0
      else
        echo "${RED}✗${NC} OpenCode Zen API key not found"
        echo ""
        echo "API key should be automatically injected from Doppler during"
        echo "system activation. If missing, ensure:"
        echo "  1. You've run: darwin-rebuild switch"
        echo "  2. Doppler is authenticated: doppler login"
        echo "  3. Secret exists in Doppler:"
        echo "     doppler secrets --project devices-laptops --config macbookprom2pro"
        echo ""
        echo "Or manually create ~/.config/opencode/.env with:"
        echo "  OPENCODE_ZEN_API_KEY=your_api_key_here"
        return 1
      fi
      ;;
    4)
      # llama.cpp (local llama-server)
      if $llamacpp_available; then
        _aiselect_commit "llama-cpp"

        # Model sub-picker only applies to hosts with a switchable local
        # server (llamacpp-local.nix creates this dir) -- every host runs its
        # own llama.cpp locally, nothing remote to pick on hosts without it.
        local local_cfg_dir="$HOME/.config/llama-cpp"
        if [[ -d "$local_cfg_dir" ]]; then
          local state_file="$local_cfg_dir/selected-model"
          local current_id="qwen3-coder-30b-a3b"
          [[ -f "$state_file" ]] && current_id="$(cat "$state_file")"
          local new_id="$current_id"
          if $_auto_timeout; then
            # No response within 5s on the main menu: default to llama.cpp +
            # Qwen3-Coder-30B-A3B -- both remaining local models are
            # agentic-coding-specialized (localModels in llamacpp-local.nix
            # was pruned to just these two), this one is first/default there.
            new_id="qwen3-coder-30b-a3b"
            echo ""
            echo "No selection in 5s -- defaulting to llama.cpp / $(_llamacpp_local_model_label "$new_id")."
          else
            echo ""
            echo "Select local model (llama-server restarts to switch -- cold start ~1-3 min):"
            echo "  1) Qwen3-Coder-30B-A3B MoE (agentic coding, ~18.6GB, 160K ctx)$([[ "$current_id" == "qwen3-coder-30b-a3b" ]] && echo " ${GREEN}[current]${NC}")"
            echo "  2) Devstral-Small-2-24B (agentic coding, ~14.3GB, 160K ctx)$([[ "$current_id" == "devstral-small-2-24b" ]] && echo " ${GREEN}[current]${NC}")"
            echo ""
            echo -n "Selection (1-2) [Enter = keep current]: "
            read -r model_choice

            case "$model_choice" in
              1) new_id="qwen3-coder-30b-a3b" ;;
              2) new_id="devstral-small-2-24b" ;;
              "") ;;
              *) echo "${YELLOW}⚠${NC} Invalid selection, keeping $(_llamacpp_local_model_label "$current_id")" ;;
            esac
          fi


          if [[ "$new_id" != "$current_id" ]]; then
            echo "$new_id" > "$state_file"
            echo ""
            echo "${GREEN}✓${NC} Switching to $(_llamacpp_local_model_label "$new_id")..."
            if launchctl kickstart -k "gui/$(id -u)/org.nixos.llama-server-local" 2>/dev/null; then
              echo -n "Waiting for llama-server to come up"
              local waited=0
              while ! curl -s --max-time 2 "${LLAMA_CPP_HOST:-http://localhost:8080}/health" 2>/dev/null | grep -q '"status"'; do
                echo -n "."
                sleep 5
                waited=$((waited + 5))
                if [[ $waited -ge 240 ]]; then
                  echo ""
                  echo "${YELLOW}⚠${NC} Still loading after 4 min -- check /tmp/llama-server-local.log"
                  break
                fi
              done
              echo ""
              if curl -s --max-time 2 "${LLAMA_CPP_HOST:-http://localhost:8080}/health" 2>/dev/null | grep -q '"status"'; then
                echo "${GREEN}✓${NC} llama-server ready with $(_llamacpp_local_model_label "$new_id")"
              fi
            else
              echo "${YELLOW}⚠${NC} Could not restart llama-server-local automatically."
              echo "Run manually: launchctl kickstart -k gui/\$(id -u)/org.nixos.llama-server-local"
            fi
          fi
        fi

        echo ""
        echo "${GREEN}✓${NC} Using llama.cpp (local: $(_llamacpp_model_short))"
        echo ""
        echo "aidev/opencode will now use llama.cpp (currently: $(_llamacpp_model_short))."
        echo "gpc/gpr always prefer llama.cpp when reachable regardless of this"
        echo "setting; gpa escalates to cloud on larger diffs or critical findings"
        echo "unless this host defaults gpc/gpa/gpr to local-only (AI_LOCAL_DEFAULT)."
        echo "═══════════════════════════════════════════════════════════"
        return 0
      else
        echo "${RED}✗${NC} llama.cpp server not reachable at ${LLAMA_CPP_HOST:-http://localhost:8080}"
        echo ""
        if [[ -d "$HOME/.config/llama-cpp" ]]; then
          echo "Start it: launchctl kickstart -k gui/\$(id -u)/org.nixos.llama-server-local"
          echo "Then re-run aiselect."
        else
          echo "This host has no local llama.cpp module configured -- add llamacpp-local.nix and rebuild, then re-run aiselect."
        fi
        return 1
      fi
      ;;


    
    *)
      echo "${RED}✗${NC} Invalid selection"
      return 1
      ;;
  esac
}

# Security audit function for AI configuration files
function ai_security_audit() {
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  echo "═══════════════════════════════════════════════════════════"
  echo "AI Configuration Security Audit"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  
  local issues_found=0
  
  # Check ~/.zshrc_envvars permissions
  if [[ -f ~/.zshrc_envvars ]]; then
    # Cross-platform stat command (macOS vs Linux)
    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS
      perms=$(stat -f "%Op" ~/.zshrc_envvars 2>/dev/null | tail -c 4)
    else
      # Linux
      perms=$(stat -c "%a" ~/.zshrc_envvars 2>/dev/null)
    fi
    
    echo "Checking ~/.zshrc_envvars..."
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars'"
      issues_found=$((issues_found + 1))
    fi
    
    # Check if file contains API keys
    if grep -q "API_KEY" ~/.zshrc_envvars; then
      echo "  ${YELLOW}ℹ${NC}  Contains API keys (stored in plain text)"
    fi
  else
    echo "~/.zshrc_envvars: Not found"
  fi
  
  echo ""
  
  if [[ -f ~/.zshrc_envvars_insecure ]] || [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target_file=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null || echo ~/.zshrc_envvars_insecure)

    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      perms=$(stat -f "%Op" "$target_file" 2>/dev/null | tail -c 4)
    else
      perms=$(stat -c "%a" "$target_file" 2>/dev/null)
    fi

    echo "Checking ~/.zshrc_envvars_insecure..."
    if [[ -L ~/.zshrc_envvars_insecure ]]; then
      echo "  ${YELLOW}ℹ${NC}  Symlink to: $target_file"
    fi
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      if [[ -L ~/.zshrc_envvars_insecure ]]; then
        echo "    Recommended: Run 'chmod 600 $target_file'"
      else
        echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars_insecure'"
      fi
      issues_found=$((issues_found + 1))
    fi
    
    if grep -q "API_KEY" "$target_file" 2>/dev/null; then
      echo "  ${RED}✗${NC} Contains API keys (should be in ~/.zshrc_envvars instead)"
      issues_found=$((issues_found + 1))
    fi
  fi
  
  echo ""
  
  if [[ -n "$OPENCODE_ZEN_API_KEY" ]]; then
    echo "Environment variables:"
    echo "  ${GREEN}✓${NC} OPENCODE_ZEN_API_KEY is set"
  fi
  
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    echo "  ${GREEN}✓${NC} OPENROUTER_API_KEY is set"
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  
  if [[ $issues_found -eq 0 ]]; then
    echo "${GREEN}✓${NC} No security issues found"
  else
    echo "${RED}✗${NC} Found $issues_found security issue(s)"
  fi
  
  echo "═══════════════════════════════════════════════════════════"
}

export AI_PROVIDER=$(_get_ai_provider)

function _ensure_envvars_permissions() {
  [[ -f ~/.zshrc_envvars ]] && chmod 600 ~/.zshrc_envvars 2>/dev/null

  if [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null)
    [[ -f "$target" ]] && chmod 600 "$target" 2>/dev/null
  elif [[ -f ~/.zshrc_envvars_insecure ]]; then
    chmod 600 ~/.zshrc_envvars_insecure 2>/dev/null
  fi
}

_ensure_envvars_permissions
