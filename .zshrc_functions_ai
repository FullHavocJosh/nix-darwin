function aiselect() {
  local preference_file="$HOME/.ai_provider_preference"

  if [[ "$1" == "--show" ]] || [[ "$1" == "--status" ]]; then
    local current_provider=$(_get_ai_provider)
    local opencode_model=$(_get_opencode_model "sonnet")
    local opencode_haiku_model=$(_get_opencode_model "haiku")
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Current AI Configuration"
    echo "═══════════════════════════════════════════════════════════"
    echo "Active Provider: $(_provider_display_name "$current_provider")"
    echo ""
    echo "Interactive Sessions (aidev):"
    echo "  Mode: Full Claude Code agent with tools"
    if [[ "$current_provider" == "claude-code" ]]; then
      echo "  → claude (direct, uses Claude.ai subscription)"
    else
      echo "  Model: $opencode_model"
      echo "  → claude (provider: $current_provider)"
    fi
    echo ""
    echo "Direct API Functions (fast, lightweight):"
    echo "  Haiku tasks  (commit msgs): $opencode_haiku_model"
    echo "  Sonnet tasks (code review): $opencode_model"
    echo "  Mode: Direct API calls (no agent overhead)"
    echo "  Response time: ~5-15 seconds"
    echo ""
    echo "Command → Model → Mode:"
    if [[ "$current_provider" == "claude-code" ]]; then
      echo "  • aidev                     → claude (direct) → Full Agent"
      echo "  • gpa                       → $opencode_model → Headless review (never Anthropic directly)"
    else
      echo "  • aidev                     → $opencode_model → Full Agent (claude)"
      echo "  • gpa                       → $opencode_model → Headless review"
    fi
    echo "  • gpc (commit messages)     → $opencode_haiku_model → Direct API"
    echo "  • gpa (code review)         → $opencode_model → Direct API"
    echo ""
    if [[ "$current_provider" == "llama-cpp" ]]; then
      local endpoint="${LLAMA_CPP_HOST:-http://macminim1.rollet.family:8080}"
      local cloud_provider=$(_get_cloud_fallback_provider)
      local cloud_model=$(_get_cloud_model "sonnet")
      echo ""
      echo "Hybrid Routing (llama-cpp + cloud escalation):"
      echo "  Local endpoint:   $endpoint"
      echo "  Local tier:       $([[ -d "$HOME/.config/llama-cpp" ]] && echo "$(_llamacpp_model_short) (local, switchable via aiselect)" || _llamacpp_model_tier)"
      echo "  Cloud provider:   $cloud_provider"
      echo "  Cloud model:      $cloud_model"
      echo ""
      echo "  gpc  → ⚪ local always  (commit messages)"
      echo "  gpr  → ⚪ local always  (PR creation)"
      echo "  gpa  → ⚪ local (small diffs) → 🟢 Haiku (medium) → 🔵 Sonnet (large or critical/security)"
      echo "  aidev → ⚪ local (claude with llama.cpp, currently: $(_llamacpp_model_short))"
    fi
    echo ""
    echo "Note: Run 'aiselect' to change provider. Changes apply immediately"
    echo "      to all commands (no restart required)."
    echo "═══════════════════════════════════════════════════════════"
    return 0
  fi
  
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  local session_file="/tmp/.ai_provider_session_$(id -u)"

  _aiselect_commit() {
    local new_provider="$1"
    echo "$new_provider" > "$preference_file"
    echo "$new_provider" > "$session_file"
    
    # Clear opencode.json model if it doesn't match the new provider
    # This prevents stale model configs from interfering with provider switching
    local config_file="$HOME/.config/opencode/opencode.json"
    if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
      local current_model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
      if [[ -n "$current_model" && "$current_model" != "null" ]]; then
        # Check if model matches new provider
        local model_matches=false
        case "$new_provider" in
          github-copilot)
            [[ "$current_model" == github-copilot/* ]] && model_matches=true
            ;;
          opencode)
            [[ "$current_model" == opencode/* ]] && model_matches=true
            ;;
          claude-code)
            # Claude Code doesn't use opencode.json, clear it
            model_matches=false
            ;;
          llama-cpp)
            [[ "$current_model" == llama.cpp/* || "$current_model" == llama-cpp/* ]] && model_matches=true
            ;;
        esac
        
        # Clear mismatched model from config
        if ! $model_matches; then
          cp "$config_file" "$config_file.backup"
          jq 'del(.model)' "$config_file" > "$config_file.tmp"
          mv "$config_file.tmp" "$config_file"
        fi
      fi
    fi
  }

  echo "═══════════════════════════════════════════════════════════"
  echo "AI Provider Selection"
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Offline: inform user about limitations
  if ! _is_online; then
    echo "${YELLOW}⚠${NC}  No internet connection detected."
    echo ""
    echo "Cloud AI providers require internet. Available options:"
    echo "  • Wait for internet connection to be restored"
    if _validate_llamacpp; then
      echo "  • llama.cpp is running and can be used for gpc/gpa (limited)"
      echo ""
      echo "Note: llama.cpp cannot run full OpenCode sessions (context limit)"
      echo "      but works for git commit messages and simple code review."
    else
      echo "  • Start llama-server for offline git commit message generation"
      echo ""
      echo "To start llama-server:"
      echo "  brew services start llama-cpp"
    fi
    echo ""
    echo "═══════════════════════════════════════════════════════════"
    return 1
  fi

  # Check availability of all providers
  local claude_code_status="${RED}✗${NC}"
  local claude_code_available=false
  if _validate_claude_code; then
    claude_code_status="${GREEN}✓${NC}"
    claude_code_available=true
  elif command -v claude &>/dev/null; then
    claude_code_status="${YELLOW}⚠${NC}"
  fi

  local github_copilot_status="${RED}✗${NC}"
  local github_copilot_available=false
  if _validate_github_copilot; then
    github_copilot_status="${GREEN}✓${NC}"
    github_copilot_available=true
  fi

  local opencode_zen_status="${RED}✗${NC}"
  local opencode_zen_available=false
  if _validate_opencode_zen; then
    opencode_zen_status="${GREEN}✓${NC}"
    opencode_zen_available=true
  fi

  local llamacpp_status="${RED}✗${NC}"
  local llamacpp_available=false
  if _validate_llamacpp; then
    llamacpp_status="${GREEN}✓${NC}"
    llamacpp_available=true
  fi

  # Display menu
  echo "Select AI Provider:"
  echo ""
  echo "  1) $claude_code_status Anthropic"
  echo "  2) $github_copilot_status GitHub Copilot"
  echo "  3) $opencode_zen_status OpenCode Zen (API key)"
  echo "  4) $llamacpp_status llama.cpp (local: $(_llamacpp_model_short)) -- also usable via aidev/opencode"
  echo ""
  echo "Note: gpc always prefers llama.cpp when reachable, and gpa does too"
  echo "      on hosts that default to local (AI_LOCAL_DEFAULT) -- regardless"
  echo "      of the selection below. That selection only changes which"
  echo "      provider/model aidev and interactive opencode sessions use."
  echo ""
  echo -n "Selection (1-4) [Enter = llama.cpp/Gemma-4, auto-selects in 5s]: "
  read -t 5 -r choice
  echo ""
  local _auto_timeout=false
  if [[ -z "$choice" ]]; then
    choice="4"
    _auto_timeout=true
  fi

  case "$choice" in
    1)
      # Anthropic
      if $claude_code_available; then
        _aiselect_commit "claude-code"
        echo "${GREEN}✓${NC} Using Anthropic"
        echo "═══════════════════════════════════════════════════════════"
        return 0
      elif command -v claude &>/dev/null; then
        echo "Claude Code installed but not authenticated."
        
        # Check Claude service status before attempting login
        _check_claude_status
        
        echo ""
        echo -n "Login to Claude Code? [y/N]: "
        read -r confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
          echo ""
          claude auth login
          echo ""
          if _validate_claude_code; then
            echo "${GREEN}✓${NC} Login successful"
            _aiselect_commit "claude-code"
            echo "═══════════════════════════════════════════════════════════"
            return 0
          else
            echo "${RED}✗${NC} Login failed or incomplete"
            return 1
          fi
        else
          echo "Cancelled."
          return 1
        fi
      else
        echo "${RED}✗${NC} Claude Code not installed"
        echo "Install with: brew install --cask claude-code"
        return 1
      fi
      ;;
    
    2)
      # GitHub Copilot
      if $github_copilot_available; then
        _aiselect_commit "github-copilot"
        echo "${GREEN}✓${NC} Using GitHub Copilot"
        echo "═══════════════════════════════════════════════════════════"
        return 0
      else
        echo "GitHub Copilot not authenticated."
        
        # Check GitHub Copilot service status
        _check_github_copilot_status
        
        echo ""
        echo -n "Login to GitHub Copilot? [y/N]: "
        read -r confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
          echo ""
          if command -v open &>/dev/null; then
            open "https://github.com/login/device"
          fi
          opencode auth login
          echo ""
          if _validate_github_copilot; then
            echo "${GREEN}✓${NC} Login successful"
            _aiselect_commit "github-copilot"
            echo "═══════════════════════════════════════════════════════════"
            return 0
          else
            echo "${RED}✗${NC} Login failed or incomplete"
            return 1
          fi
        else
          echo "Cancelled."
          return 1
        fi
      fi
      ;;
    
    3)
      # OpenCode Zen
      if $opencode_zen_available; then
        _aiselect_commit "opencode"
        
        # Interactive model selection for OpenCode Zen
        echo "═══════════════════════════════════════════════════════════"
        echo "OpenCode Zen Model Selection"
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "Select model category:"
        echo "  1) Claude Models (Paid)"
        echo "  2) Free Models"
        echo ""
        echo -n "Selection (1-2): "
        read -r category_choice
        
        local selected_model=""
        
        if [[ "$category_choice" == "1" ]]; then
          echo ""
          echo "Select Claude model:"
          echo "  1) Claude Opus 4.7 (Latest, most capable)"
          echo "  2) Claude Sonnet 4.6 (Latest, balanced)"
          echo "  3) Claude Haiku 4.5 (Latest, fast)"
          echo ""
          echo -n "Selection (1-3): "
          read -r model_choice
          
          case "$model_choice" in
            1) selected_model="opencode/claude-opus-4-7" ;;
            2) selected_model="opencode/claude-sonnet-4-6" ;;
            3) selected_model="opencode/claude-haiku-4-5" ;;
            *) selected_model="opencode/claude-sonnet-4-6" ;;
          esac
        elif [[ "$category_choice" == "2" ]]; then
          echo ""
          echo "Select free model:"
          echo "  1) Big Pickle (Free)"
          echo "  2) DeepSeek V4 Flash (Free)"
          echo "  3) MiniMax M2.5 (Free)"
          echo "  4) Nemotron 3 Super (Free)"
          echo ""
          echo -n "Selection (1-4): "
          read -r model_choice
          
          case "$model_choice" in
            1) selected_model="opencode/big-pickle" ;;
            2) selected_model="opencode/deepseek-v4-flash-free" ;;
            3) selected_model="opencode/minimax-m2.5-free" ;;
            4) selected_model="opencode/nemotron-3-super-free" ;;
            *) selected_model="opencode/big-pickle" ;;
          esac
        else
          # Default to Sonnet if invalid choice
          selected_model="opencode/claude-sonnet-4-6"
        fi
        
        # Update OpenCode config with selected model
        if command -v jq &>/dev/null; then
          local config_file="$HOME/.config/opencode/opencode.json"
          if [[ -f "$config_file" ]]; then
            cp "$config_file" "$config_file.backup"
            jq --arg model "$selected_model" '.model = $model' "$config_file" > "$config_file.tmp"
            mv "$config_file.tmp" "$config_file"
            echo ""
            echo "${GREEN}✓${NC} Model set to: $selected_model"
            echo "${GREEN}✓${NC} Config updated: $config_file"
          fi
        fi
        
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        return 0
      else
        echo "${RED}✗${NC} OpenCode Zen API key not found"
        echo ""
        echo "API key should be automatically injected from Doppler during"
