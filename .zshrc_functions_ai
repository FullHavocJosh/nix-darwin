# Plain-text AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_plain_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_plain_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: OpenCode timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: OpenCode failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    openrouter)
      [[ -z "$OPENROUTER_API_KEY" ]] && { echo "Error: OPENROUTER_API_KEY not set" >&2; return 1; }
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "Error: OpenRouter cloud API returned invalid response" >&2; return 1
      ;;
  esac
}

