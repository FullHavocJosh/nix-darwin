# lumoplan -- tier 0 of aistack: a tool-less pi session whose model is Lumo (Proton), reached through
# the lumo-planner proxy on MacMiniM1 (lumo.nix, README "Lumo tier 0"). Lumo asks for repo files with
# NEED lines and the proxy fetches them from the Mini's home-infrastructure checkout. Nothing here
# edits files or runs tools; hand the plan to aistack/tier 1 to execute it.
#
#   lumoplan [prompt words...]   e.g.  lumoplan plan adding a new ArgoCD app for ntfy
function lumoplan_func() {
  pi --no-tools --no-extensions --no-skills --provider lumo-planner --model lumo-planner "$@"
}

# Tier 0 probe: prints "lumo" when a Lumo planner proxy answers /v1/models, otherwise "local". This machine's own
# proxy (127.0.0.1:8765, no key, lumo.nix) is tried first, then the one on MacMiniM1 with its key, 4 s at most.
# AISTACK_TIER0=local forces local; AISTACK_LUMO_URL / AISTACK_LUMO_KEY override the endpoint and key and skip the
# loopback try (the key otherwise comes from Doppler, as in pi's lumo-planner provider).
function _aistack_tier0() {
  [[ "${AISTACK_TIER0:-auto}" == "local" ]] && { echo local; return 0; }
  # Only an HTTP 200 counts. Anything else (nothing listening, a timeout, 401 from a proxy that wants a key, as on
  # the Mini itself) leaves local_code at something other than 200 and the remote probe below decides.
  local local_code=000
  if [[ -z "${AISTACK_LUMO_URL:-}" ]]; then
    local_code=$(curl -s -m 2 -o /dev/null -w '%{http_code}' http://127.0.0.1:8765/v1/models 2>/dev/null) || local_code=000
  fi
  [[ "$local_code" == "200" ]] && { echo lumo; return 0; }
  local url="${AISTACK_LUMO_URL:-http://macminim1.rollet.family:8765/v1}" key="${AISTACK_LUMO_KEY:-}" code
  local -a auth
  if [[ -z "$key" ]] && command -v doppler >/dev/null; then
    key=$(doppler secrets get LUMO_PLANNER_API_KEY --project FullHavocJosh --config root_macmini --plain 2>/dev/null)
  fi
  [[ -n "$key" ]] && auth=(-H "Authorization: Bearer $key")
  code=$(curl -s -m 4 -o /dev/null -w '%{http_code}' "${auth[@]}" "${url%/}/models" 2>/dev/null)
  [[ "$code" == "200" ]] && echo lumo || echo local
}

# Is the project's GitHub repository private? Prints yes or no. Anything that cannot be confirmed as public (no
# remote, no gh login, offline, not GitHub) counts as private, so code is never sent by accident to a free model that
# may train on it. AISTACK_REPO_PRIVATE=yes|no overrides.
function _aistack_repo_private() {
  [[ "${AISTACK_REPO_PRIVATE:-}" == (yes|no) ]] && { echo "$AISTACK_REPO_PRIVATE"; return 0; }
  local v
  v=$(cd "$1" 2>/dev/null && timeout 10 gh repo view --json isPrivate -q .isPrivate 2>/dev/null)
  [[ "$v" == "false" ]] && echo no || echo yes
}

# aistack -- planner-led coding stack.
#
#   aistack [task words...]      e.g.  aistack make a new mcp server
#   aistack                      then describe the work as pi's first message -- same result
#
# Opens a live pi session (local llama-server model, reasoning on) whose job is to turn what you describe into a
# plan (prd.json + verify.json in the plan dir), get your confirmation, and then run it through Ralph TUI:
#
#   tier 0  Lumo on MacMiniM1              drafts the plan (lumo_consult); falls back to the local model
#           (pi + llama-server, local)        when MacMiniM1 is unreachable. pi stays the coordinator either way:
#                                          it talks to you and calls the ralph_* tools, which Lumo cannot do
#   tier 1  OpenCode Big Pickle (free)     worker: builds each task      (Claude Sonnet when no Zen key)
#   tier 2  Claude Code Sonnet (latest)    read-only reviewer of the plan before anything is built (ralph_review_plan,
#                                          catches what tier 0 missed), fallback worker for a task tier 1 cannot get to
#                                          pass, and a read-only reviewer (security / accuracy / completeness) at the end
#
# Flow: plan (tier 0) -> confirm -> review (tier 2) -> confirm -> build (tier 1) -> review (tier 2)
#
# The run itself is ~/.config/aistack/ralph_driver.py (detached, state under ~/.aistack/<project>/runs/):
# one task at a time through `ralph-tui run`, a task only counts as done when its verify commands exit 0
# (Ralph's own completion marker has false positives), retry then escalate, agents can ask you questions, and
# a failed review pauses for your decision. pi reaches it through the ralph_* MCP tools (ralph_mcp.py).
#
# Nothing aistack-related is written into the repository (no .aistack/, no .ralph-tui/): plan files, runs, reviews and
# Ralph's own state live in ~/.aistack/<project>-<hash> (AISTACK_HOME overrides ~/.aistack). Planning only reads the
# project. In the main checkout of a git repo, a gpr worktree + draft PR is created at the moment you confirm the plan
# (ralph_run does it), and the agents work there; elsewhere they work in the project itself. Nothing is committed:
# use gpc/gpa in that directory when you are happy with the result.
#
# AISTACK_DIR overrides ~/.config/aistack; AISTACK_PI_EXTRA adds pi flags (tests use "-p").
function aistack_func() {
  local task="$*"
  local adir="${AISTACK_DIR:-$HOME/.config/aistack}"
  local cache_dir="$HOME/.cache/nix-darwin-ai"
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}"
  local lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
  local f reply
  # aidev runs this same stack with one difference (_AISTACK_MODE=dev): Claude Code writes the plan (ralph_plan) from the
  # local model's research instead of reviewing a plan the local model wrote. Everything else below is shared.
  local mode="${_AISTACK_MODE:-stack}" stack_name="aistack" variant="" mcp_timeout=200
  local -a need_files
  need_files=(ralph_mcp.py ralph_driver.py task-template.hbs review-template.hbs planner-prompt.md planner-tier0-lumo.md planner-tier0-local.md opencode-auto.sh claude-review.sh claude-work.sh zen_models.py zen-policy.json)
  if [[ "$mode" == "dev" ]]; then
    # ralph_plan waits for one Claude call (AISTACK_PLAN_TIMEOUT_S, 280 s), so pi must wait longer than that
    # ... and before that it asks Lumo (AISTACK_LUMO_TIMEOUT_S, 100 s)
    stack_name="aidev"; variant="-claude"; mcp_timeout=420
    need_files+=(claude-plan.sh planner-prompt-claude.md planner-tier0-lumo-claude.md planner-tier0-local-claude.md)
  fi

  # ---- preflight ---------------------------------------------------------------------------------------------
  for f in $need_files; do
    if [[ ! -e "$adir/$f" ]]; then
      echo "✗ $adir/$f is missing -- run darwin-rebuild so the aistack files are stowed." >&2
      return 1
    fi
  done
  command -v pi >/dev/null || { echo "✗ pi is not installed -- aistack's planner runs in pi." >&2; return 1; }
  command -v python3 >/dev/null || { echo "✗ python3 is not installed." >&2; return 1; }
  command -v jq >/dev/null || { echo "✗ jq is not installed." >&2; return 1; }
  local ralph_bin
  ralph_bin=$(command -v ralph-tui 2>/dev/null || echo "$HOME/.bun/bin/ralph-tui")
  [[ -x "$ralph_bin" ]] || { echo "✗ ralph-tui not found. Install it: bun install -g ralph-tui" >&2; return 1; }

  if ! _validate_llamacpp; then
    echo "✗ The local planner model (llama-server, $lms_model) is not usable at $endpoint." >&2
    echo "  It must listen on this machine's loopback only. Start it: sudo launchctl kickstart -k system/org.nixos.llama-server-local" >&2
    echo "  (the model file is ~/models/Qwen3.5-9B-Q4_K_M.gguf; see ~/models/download.log and /tmp/llama-server-local.error.log)" >&2
    return 1
  fi
  if ! _validate_claude_code 2>/dev/null; then
    echo "✗ Claude Code is not logged in (tier 2: fallback worker and reviewer). Run: claude auth login" >&2
    return 1
  fi

  # Tier 1 is chosen later (it depends on whether the repository is private). Until then, and when no free model
  # exists, Claude Code Sonnet does the building: that is billed, so aistack says so and asks first.
  local worker="claude-work" fallback="claude-work" fallback_attempts=0 zen_model=""
  # Model and effort for every Claude call come from the host profile (work.nix / personal.nix set these).
  local claude_model="${AISTACK_CLAUDE_MODEL:-sonnet}" claude_effort="${AISTACK_CLAUDE_EFFORT:-medium}"
  local claude_label="Claude Code $claude_model, $claude_effort effort"
  local worker_label="$claude_label (billed)" fallback_label="$claude_label (billed)"
  local reviewer="claude-review"

  # ---- project and state ---------------------------------------------------------------------------------------
  # Nothing aistack-related is ever written into the repository: plan files, runs, questions, reviews and Ralph's
  # own state live in ~/.aistack/<project key> (AISTACK_HOME overrides ~/.aistack). Planning only reads the project.
  # In a main checkout the agents' worktree + draft PR is created by ralph_run once you have confirmed the plan.
  local project repo_root wt_mode="none"
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [[ -n "$repo_root" ]]; then
    project="$repo_root"
    if [[ "$(git rev-parse --path-format=absolute --git-dir)" == "$(git rev-parse --path-format=absolute --git-common-dir)" ]]; then
      wt_mode="create"
    fi
  else
    project="$PWD"
  fi
  local aihome="${AISTACK_HOME:-$HOME/.aistack}" aihome_real
  mkdir -p "$aihome" 2>/dev/null
  aihome_real=$(cd "$aihome" 2>/dev/null && pwd -P)
  if [[ -z "$aihome_real" ]] || git -C "$aihome_real" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "✗ $aihome resolves to ${aihome_real:-nowhere}${aihome_real:+, which is inside a git repository}; aistack keeps its files outside repositories." >&2
    echo "  If it is a symlink that stow made into a dotfiles repo, remove just the link (rm $aihome) and run aistack again." >&2
    return 1
  fi
  local state_dir="$aihome_real/${project:t}-$(echo -n "$project" | shasum | cut -c1-10)"

  # ---- tier 0: Lumo on MacMiniM1, or the local model when it is unreachable ------------------------------------
  local tier0 tier0_label
  tier0=$(_aistack_tier0)
  if [[ "$tier0" == "lumo" ]]; then
    tier0_label="Lumo on MacMiniM1, which drafts the plan"
  else
    tier0_label="the local model ($lms_model), because MacMiniM1's Lumo is unreachable"
  fi
  if [[ "$mode" == "dev" ]]; then
    [[ "$tier0" == "lumo" ]] && tier0_label="Lumo adds a draft with online research (this machine's Lumo, else MacMiniM1's)" \
      || tier0_label="no Lumo is reachable, so there is no draft from it"
  fi

  # ---- tier 1: a free Zen model chosen for this repository; Claude (billed) only when there is none ---------------
  local t1_note=""
  if _validate_opencode_zen 2>/dev/null; then
    local private choice
    private=$(_aistack_repo_private "$project")
    choice=$(python3 "$adir/zen_models.py" choose --private "$private" 2>/dev/null)
    if [[ -z "$choice" ]]; then
      echo "⚠ tier 1: could not run $adir/zen_models.py to choose a free model."
    else
      zen_model=$(jq -r '.model // empty' <<<"$choice" 2>/dev/null)
      jq -r '.warnings[]?' <<<"$choice" 2>/dev/null | while IFS= read -r w; do echo "⚠ tier 1: $w"; done
      t1_note=$(jq -r '.notes[0] // empty' <<<"$choice" 2>/dev/null)
    fi
    if [[ -n "$zen_model" ]]; then
      worker="opencode-pickle"; worker_label="OpenCode $zen_model (free)"; fallback_attempts=1
    fi
  else
    echo "⚠ tier 1: OpenCode Zen is not set up on this host (no API key)."
  fi
  if [[ -z "$zen_model" ]]; then
    echo "⚠ Tier 1 has no free model, so $claude_label (billed) would build the tasks as well as review them."
    if [[ "${AISTACK_ASSUME_YES:-}" != "1" ]]; then
      echo -n "Continue with Claude as tier 1? [Y/n] "
      read -r reply
      [[ "${reply:l}" == "n" ]] && return 1
    fi
  fi

  # ---- per-project files ---------------------------------------------------------------------------------------
  mkdir -p "$state_dir/plan" "$state_dir/ralph/.ralph-tui"
  # Ralph always passes --dangerously-skip-permissions to claude; claude-review is wrapped to drop it, and
  # opencode needs --auto after `run` (see the wrappers' comments).
  {
    cat <<TOML
tracker = "json"
maxIterations = 1
iterationDelay = 1000
autoCommit = false
# Ralph only filters *_API_KEY, *_SECRET_KEY and *_SECRET from the agents it launches, so DOPPLER_TOKEN, AWX_TOKEN,
# HETZNER_API_TOKEN and similar exports from ~/.zshrc_personal would reach agents that can run shell commands.
envExclude = ["*_TOKEN", "*_PAT", "*_PASSWORD", "DOPPLER_*"]
defaultAgent = "$worker"

[errorHandling]
strategy = "skip"
maxRetries = 0
retryDelayMs = 3000

[[agents]]
name = "claude-work"
plugin = "claude"
command = "$adir/claude-work.sh"
timeout = 1500000
  [agents.options]
  model = "$claude_model"

[[agents]]
name = "claude-review"
plugin = "claude"
command = "$adir/claude-review.sh"
timeout = 900000
  [agents.options]
  model = "$claude_model"
TOML
    if [[ -n "$zen_model" ]]; then
      cat <<TOML

[[agents]]
name = "opencode-pickle"
plugin = "opencode"
command = "$adir/opencode-auto.sh"
timeout = 1500000
  [agents.options]
  provider = "opencode"
  model = "$zen_model"
TOML
    fi
  } > "$state_dir/ralph/.ralph-tui/config.toml"

  # pi: isolated agent dir (models.json for llama-server, mcp.json for the bridge), regenerated every run.
  local pi_dir="$cache_dir/aistack-pi/$(echo -n "$project" | shasum | cut -c1-10)"
  mkdir -p "$pi_dir"
  jq -n --arg url "${endpoint}/v1" --arg id "$lms_model" \
    '{providers: {llamacpp: {baseUrl: $url, api: "openai-completions", apiKey: "sk-local", models: [{id: $id, reasoning: true}]}}}' \
    > "$pi_dir/models.json"
  local tiers_text="tier 0 ${tier0_label}; tier 1 ${worker_label}; tier 2 $claude_label (billed)"
  [[ "$mode" == "dev" ]] && tiers_text="research local $lms_model; plan $claude_label (billed); build ${worker_label}; review $claude_label (billed)"
  jq -n --arg py "$(command -v python3)" --arg bridge "$adir/ralph_mcp.py" --arg root "$project" \
    --arg worker "$worker" --arg fallback "$fallback" --arg reviewer "$reviewer" --arg fa "$fallback_attempts" \
    --arg ralph "$ralph_bin" --arg tier0 "$tier0" --arg state "$state_dir" --arg wtmode "$wt_mode" --arg reviewmode "${AISTACK_REVIEW_MODE:-batch}" --arg tiers "$tiers_text" --arg to "$mcp_timeout" \
    '{mcpServers: {ralph: {command: $py, args: [$bridge],
       env: {RALPH_MCP_ROOTS: $root, AISTACK_WORKER_AGENT: $worker, AISTACK_FALLBACK_AGENT: $fallback,
             AISTACK_REVIEW_AGENT: $reviewer, AISTACK_FALLBACK_ATTEMPTS: $fa, RALPH_TUI_BIN: $ralph,
             AISTACK_TIER0: $tier0, AISTACK_STATE_DIR: $state, AISTACK_WORKTREE_MODE: $wtmode,
             AISTACK_REVIEW_MODE: $reviewmode, AISTACK_TIERS: $tiers},
       exposure: "direct", timeout: ($to|tonumber),
       description: "Runs the confirmed plan through Ralph: worker agents, verification, retries, review. Poll ralph_status."},
      github: {command: "npx", args: ["-y", "@edjl/github-mcp"], exposure: "direct", timeout: 60,
       description: "Read-only GitHub lookups through the logged-in gh (PRs, files, branches, issues)."}}}' \
    > "$pi_dir/mcp.json"

  local prompt
  prompt=$(<"$adir/planner-prompt$variant.md")
  prompt=${prompt//@@PROJECT@@/$project}
  prompt=${prompt//@@PLAN_DIR@@/$state_dir/plan}
  prompt=${prompt//@@STATE_DIR@@/$state_dir}
  prompt=${prompt//@@WORKER@@/$worker_label}
  prompt=${prompt//@@FALLBACK@@/$fallback_label}
  prompt=${prompt//@@REVIEWER@@/$claude_label (billed)}
  prompt=${prompt//@@TIER0_LABEL@@/$tier0_label}
  prompt=${prompt//@@LOCAL_MODEL@@/$lms_model}
  prompt=${prompt//@@TIER0@@/$(<"$adir/planner-tier0-$tier0$variant.md")}

  echo "── $stack_name ──"
  if [[ "$wt_mode" == "create" ]]; then
    echo "Project: $project (read-only while planning; a git worktree + draft PR is created when you confirm the plan)"
  else
    echo "Project: $project (the agents work here)"
  fi
  echo "aistack files: $state_dir (nothing is written into the repository)"
  if [[ "$mode" == "dev" ]]; then
    echo "Research:  local $lms_model in pi (free)   [$tier0_label]"
    echo "Plan:      $claude_label (BILLED: one call, from the local model's research)"
    echo "Build:     $worker_label${t1_note:+   [$t1_note]}"
    echo "Review:    $claude_label (BILLED: one review for the whole run; builds a task only if it keeps failing)"
    echo "Describe what you want; pi researches it, Claude writes the plan, and you confirm before anything runs."
  else
  if [[ "$tier0" == "lumo" ]]; then
    echo "Tier 0 (plan):       Lumo on MacMiniM1   [pi + $lms_model coordinates; local fallback if Lumo fails]"
  else
    echo "Tier 0 (plan):       local $lms_model   [MacMiniM1's Lumo is unreachable]"
  fi
  echo "Tier 1 (build):      $worker_label${t1_note:+   [$t1_note]}"
  echo "Tier 2 (plan review, fallback, final review): $claude_label (BILLED: one plan review before the build, one review for the whole run)"
  echo "Describe what you want; pi will draft a plan for you to confirm before anything runs."
  fi
  echo "(The local model is slow: a reply can take a while with nothing visible. That is normal.)"
  echo ""

  # pi gets exactly two MCP servers: ralph (this bridge, which also carries lumo_consult) and github. Every other server
  # belongs to OpenCode and Claude Code only. github is allowlisted read-only: pr_create, pr_approve and pr_suggest_change
  # stay invisible to the local model (agents may not create, approve or review PRs; see the gpr/gpa workflow hook).
  local github_tools="mcp__github__github_repos_list,mcp__github__github_file_get,mcp__github__github_branch_list,mcp__github__github_pr_list,mcp__github__github_pr_details,mcp__github__github_pr_changes,mcp__github__github_pr_comments_get,mcp__github__github_issues_list"
  local tools="read,grep,find,ls,write,edit,mcp__ralph__ralph_validate_plan,mcp__ralph__ralph_review_plan,mcp__ralph__ralph_run,mcp__ralph__ralph_status,mcp__ralph__ralph_respond,mcp__ralph__ralph_cancel,mcp__ralph__ralph_runs,$github_tools"
  # lumo_consult only when tier 0 is Lumo; pi's --tools is an allowlist, so a tool missing here is invisible to the model
  # (it was left out once, and the planner then reported "Lumo is unavailable" without ever calling it)
  [[ "$tier0" == "lumo" ]] && tools="$tools,mcp__ralph__lumo_consult"
  local session_name="aistack: plan ${tier0}, review claude, build ${zen_model:-claude}, review claude"
  if [[ "$mode" == "dev" ]]; then
    # The local model hands its research to ralph_plan; it has no ralph_review_plan, because Claude wrote the plan.
    # It also has no write, no edit and no lumo_consult: on its first real run it answered the request itself, never
    # called Lumo, and only the prompt kept its write tool out of the repository. ralph_plan asks Lumo itself, and
    # ralph_update_task is the one way to change the plan (it can only touch the plan files).
    tools=${tools/mcp__ralph__ralph_review_plan/mcp__ralph__ralph_plan,mcp__ralph__ralph_update_task}
    tools=${tools/,write,edit,/,}
    tools=${tools/,mcp__ralph__lumo_consult/}
    # A small model weighs the last thing it read most, so the request itself carries the rules.
    [[ -n "$task" ]] && task="REQUEST FROM THE USER: $task

(Rules for you, the coordinator: do NOT answer this request yourself, however broad it is. Find the relevant code with at most 12 tool calls, then call ralph_plan with the request, your brief and the files that matter. Lumo and Claude Code do the thinking; you report what they return.)"
    session_name="aidev: research local, plan claude, build ${zen_model:-claude}, review claude"
  fi
  local -a extra
  extra=(${=AISTACK_PI_EXTRA})
  (
    cd "$project" || exit 1
    PI_CODING_AGENT_DIR="$pi_dir" pi --provider llamacpp --model "$lms_model" --name "$session_name" --no-skills \
      --append-system-prompt "$prompt" --tools "$tools" "${extra[@]}" ${task:+"$task"}
  )
  local rc=$?

  # ---- after the session ------------------------------------------------------------------------------------------
  local latest st work_dir
  work_dir=$(jq -r '.work_dir // empty' "$state_dir/project.json" 2>/dev/null)
  [[ -z "$work_dir" ]] && work_dir="$project"
  latest=$(/bin/ls -1 "$state_dir/runs" 2>/dev/null | tail -1)
  if [[ -n "$latest" ]]; then
    st=$(jq -r '"\(.state) / \(.phase)"' "$state_dir/runs/$latest/state.json" 2>/dev/null)
    echo ""
    echo "Last run: $latest -- $st"
    case "$st" in
      running*|waiting_user*) echo "It keeps going without pi. Run $stack_name in $project again and ask pi to follow it." ;;
    esac
    [[ -d "$state_dir/reviews" ]] && echo "Review reports: $state_dir/reviews/"
    echo "Changes are uncommitted in $work_dir -- cd there and use gpc/gpa when you are happy."
  fi
  return $rc
}

# opencode v2: the top-level TUI has no --model flag and treats its first positional as the [project] directory.
# Interactive mode uses `opencode mini`, which takes --model and --prompt; only `run` accepts the message
# positionally.
function _aidev_opencode() {
  local model="$1" print_mode="$2"
  shift 2
  if $print_mode; then
    opencode run --model "$model" "$@"
  elif (( $# > 0 )); then
    opencode mini --model "$model" --prompt "$*"
  else
    opencode mini --model "$model"
  fi
}

# aidev -- the default way to get work done: the planner stack with Claude Code used as little as possible.
#
#   aidev [task words...]        e.g.  aidev add a --json flag to the report command
#   aidev                        then describe the work as pi's first message
#   aidev --direct [args...]     the plain interactive session of the selected provider (what aidev used to be)
#   aidev -p "prompt"            one headless call to the selected provider (any flag means --direct)
#
# Who does what:  the local model in pi talks to you, finds the code and follows the run (free);  Lumo adds a draft
# with online research when MacMiniM1 is reachable (free);  Claude Code writes the plan in ONE call from that research
# (ralph_plan + claude-plan.sh);  OpenCode's free model builds;  Claude Code reviews once at the end.
# It is aistack_func with _AISTACK_MODE=dev: same run driver, verify gates, worktree + draft PR and state directory.
function aidev() {
  local a direct=false
  local -a rest
  for a in "$@"; do
    case "$a" in
      --direct) direct=true ;;
      -*) direct=true; rest+=("$a") ;;
      *) rest+=("$a") ;;
    esac
  done
  if $direct; then
    _aidev_direct "${rest[@]}"
    return
  fi
  _AISTACK_MODE=dev aistack_func "${rest[@]}"
}

# The direct session: claude, or opencode with the selected provider's model. Used by `aidev --direct`, `aidev -p`,
# and the gpa/gpc fix helpers, which need a model that edits a file now rather than a planned run.
function _aidev_direct() {
  local GREEN='\033[0;32m'
  local NC='\033[0m'

  _ensure_ai_provider || return 1

  local provider=$(_get_ai_provider)

  echo "${GREEN}✓${NC} Provider: $(_provider_display_name "$provider")"

  # Detect -p/--print flag and translate for providers that don't support it.
  # claude uses -p for headless mode; opencode uses `run` as the subcommand.
  local print_mode=false
  local filtered_args=()
  for arg in "$@"; do
    if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
      print_mode=true
    else
      filtered_args+=("$arg")
    fi
  done

  case "$provider" in
    claude-code)
      echo ""
      if $print_mode; then
        claude -p "${filtered_args[@]}"
      else
        claude "${filtered_args[@]}"
      fi
      ;;
    llama-cpp)
      local local_model="llamacpp/${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
      echo "${GREEN}✓${NC} Model:    ⚪ $(_llamacpp_model_short) → $local_model"
      echo ""
      _aidev_opencode "$local_model" $print_mode "${filtered_args[@]}"
      ;;
    github-copilot)
      # GitHub Copilot via OpenCode
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      _aidev_opencode "$model" $print_mode "${filtered_args[@]}"
      ;;
    opencode)
      # OpenCode Zen - check if a specific model is set in opencode.json
      local model=""
      local config_file="$HOME/.config/opencode/opencode.json"
      if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
        model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
      fi
      
      # Fallback to discovering latest Sonnet if no model is set
      if [[ -z "$model" || "$model" == "null" ]]; then
        model=$(_get_opencode_model "sonnet")
      fi
      
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      _aidev_opencode "$model" $print_mode "${filtered_args[@]}"
      ;;
    *)
      # Unknown provider - fall back to github-copilot
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model (fallback)"
      echo ""
      _aidev_opencode "$model" $print_mode "${filtered_args[@]}"
      ;;
  esac
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

function _validate_opencode_zen() {
  [[ -n "$OPENCODE_ZEN_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars_insecure && return 0
  [[ -f ~/.config/opencode/.env ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.config/opencode/.env && return 0
  # Check auth.json for OpenCode Zen API key (injected by nix-darwin activation)
  if [[ -f ~/.local/share/opencode/auth.json ]] && command -v jq &>/dev/null; then
    local opencode_key=$(jq -r '.opencode.key // empty' ~/.local/share/opencode/auth.json 2>/dev/null)
    [[ -n "$opencode_key" ]] && return 0
  fi
  return 1
}

# Device profile (RAM class, context, KV cache types): ~/.config/llama/profile.sh, the same file the llama-server
# launcher embeds, so the shell and the server agree. Sets LLAMA_RAM_GB, LLAMA_CLASS, LLAMA_CTX_SIZE, LLAMA_KV_K/V.
function _llamacpp_profile_load() {
  local f="${LLAMA_PROFILE_FILE:-$HOME/.config/llama/profile.sh}"
  [[ -r "$f" ]] || return 1
  source "$f" && llama_profile
}

function _llamacpp_model_tier() {
  if _llamacpp_profile_load; then
    echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b} (llama.cpp, ${LLAMA_RAM_GB} GB device, ${LLAMA_CLASS} profile)"
  else
    echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b} (llama.cpp)"
  fi
}

# llamacpp_profile: what the device profile says versus what the running llama-server was started with.
# A mismatch means the server predates the profile: run darwin-rebuild switch (it restarts the launchd job).
function llamacpp_profile() {
  _llamacpp_profile_load || { echo "✗ ~/.config/llama/profile.sh is missing -- run darwin-rebuild so it is stowed." >&2; return 1; }
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}" args run_ctx run_k run_v
  echo "Device:   ${LLAMA_RAM_GB} GB -> ${LLAMA_CLASS}"
  echo "Profile:  ctx=${LLAMA_CTX_SIZE} kv=${LLAMA_KV_K}/${LLAMA_KV_V}"
  args=$(ps -axo command | grep '[l]lama-server --model' | head -1)
  if [[ -z "$args" ]]; then echo "Running:  no llama-server process"; return 0; fi
  run_ctx=$(sed -n 's/.*--ctx-size \([0-9]*\).*/\1/p' <<<"$args")
  run_k=$(sed -n 's/.*--cache-type-k \([a-z0-9_]*\).*/\1/p' <<<"$args")
  run_v=$(sed -n 's/.*--cache-type-v \([a-z0-9_]*\).*/\1/p' <<<"$args")
  echo "Running:  ctx=${run_ctx:-?} kv=${run_k:-?}/${run_v:-?} ($endpoint)"
  if [[ "$run_ctx" == "$LLAMA_CTX_SIZE" && "$run_k" == "$LLAMA_KV_K" && "$run_v" == "$LLAMA_KV_V" ]]; then
    echo "✓ running server matches the profile"
  else
    echo "⚠ running server differs from the profile: darwin-rebuild switch restarts it with the profile"
  fi
}


# Name kept for the callers; the local model is now whatever LOCAL_LLM_MODEL
# names (set in llamacpp-local.nix).
function _llamacpp_model_short() {
  echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
}


function _validate_llamacpp() {
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}"
  local lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
  # Local AI only ever talks to llama-server on this machine's loopback. Reject
  # any other host (a stray LLAMA_CPP_HOST pointing at another device, a LAN
  # address, a hostname) before sending a prompt anywhere.
  case "$endpoint" in
    http://127.0.0.1:*|http://localhost:*|http://\[::1\]:*) ;;
    *) return 1 ;;
  esac
  # llama-server answers /v1/models with its --alias; it only lists the model
  # once it is loaded and ready.
  curl -s --max-time 3 "${endpoint}/v1/models" 2>/dev/null | grep -q "\"${lms_model}\""
}

function _validate_claude_code() {
  command -v claude &>/dev/null || return 1
  # API key auth
  [[ -n "$ANTHROPIC_API_KEY" ]] && return 0
  # OAuth session - use `claude auth status` to check if logged in
  if claude auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    return 0
  fi
  return 1
}

# Check internet connectivity using curl or dig (not ping)
function _is_online() {
  if command -v curl &>/dev/null; then
    curl -sf --max-time 2 --connect-timeout 1 https://1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  if command -v dig &>/dev/null; then
    dig +time=1 +tries=1 @1.1.1.1 cloudflare.com >/dev/null 2>&1 && return 0
  fi
  if command -v ping &>/dev/null; then
    ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  return 1
}

function _get_ai_provider() {
  # gpc-local/gpa-local/gpr-local set this to pin the whole resolution chain
  # to llama-cpp for a run, bypassing session/preference files entirely.
  [[ -n "$AI_LOCAL_ONLY" ]] && echo "llama-cpp" && return 0
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local preference_file="$HOME/.ai_provider_preference"
  [[ -f "$session_file" ]] && cat "$session_file" && return 0
  [[ -f "$preference_file" ]] && cat "$preference_file" && return 0
  _validate_claude_code 2>/dev/null && echo "claude-code" && return 0
  echo "github-copilot"
}

# Dispatch validation to the appropriate provider validator
function _validate_provider() {
  case "$1" in
    claude-code)    _validate_claude_code ;;
    github-copilot) _validate_github_copilot ;;
    opencode)       _validate_opencode_zen ;;
    llama-cpp)      _validate_llamacpp ;;
    *)              return 1 ;;
  esac
}

# Ensure a valid provider is set for this session.
# - No session file: auto-detect silently (no cascade, _get_ai_provider handles it).
# - Session file exists but provider is invalid: re-run aiselect cascade.
function _ensure_ai_provider() {
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local RED='\033[0;31m'
  local NC='\033[0m'
  [[ ! -f "$session_file" ]] && return 0
  local provider
  provider=$(cat "$session_file")
  if _validate_provider "$provider" 2>/dev/null; then
    return 0
  fi
  echo "${RED}✗${NC} Provider '$provider' is no longer valid — re-running aiselect..."
  rm -f "$session_file"
  aiselect
}

# Hybrid routing: llama-cpp → cloud escalation
# gpc/gpr always local; gpa escalates to cloud on critical/security findings
# Cloud provider stored in ~/.ai_cloud_provider_preference (separate from main provider).
# Defaults to github-copilot, not anthropic: git-helper cloud escalation should
# never consume the Anthropic/Claude Code API quota, which is reserved for the
# interactive Claude Code session.
function _get_cloud_fallback_provider() {
  local cloud_pref="$HOME/.ai_cloud_provider_preference"
  if [[ -f "$cloud_pref" ]]; then
    cat "$cloud_pref"
  else
    echo "github-copilot"
  fi
}

function _get_cloud_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)

  case $provider in
    github-copilot)
      echo "github-copilot/$(_get_copilot_claude_model "$task_type")"
      ;;
    opencode)
      [[ "$task_type" == "opus"  ]] && echo "opencode/claude-opus-4.5"        && return
      [[ "$task_type" == "haiku" ]] && echo "opencode/claude-3-5-haiku"        && return
      echo "opencode/claude-sonnet-4.5"
      ;;
    anthropic|*)
      [[ "$task_type" == "opus"  ]] && echo "anthropic/claude-opus-4-5"  && return
      [[ "$task_type" == "haiku" ]] && echo "anthropic/claude-haiku-4-5" && return
      echo "anthropic/claude-sonnet-4-6"
      ;;
  esac
}

# Plain-text AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_plain_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_plain_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: OpenCode timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: OpenCode failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
  esac
}

# Structured-JSON AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_direct_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_direct_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include any text before or after it.
If there are no issues, respond with exactly: []
START YOUR RESPONSE NOW WITH [ OR []:"

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: OpenCode timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: OpenCode call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
  esac
}

# Check Claude service status from status.claude.com
# Returns 0 if operational, 1 if there are issues
# Prints status information to stdout
function _check_claude_status() {
  # Use -L to follow redirects
  local status_json=$(curl -sL --max-time 5 https://status.claude.com/api/v2/components.json 2>/dev/null)
  
  # If curl failed or returned empty, assume services are operational (fail open)
  if [[ -z "$status_json" ]] || [[ "$status_json" == *"<html"* ]]; then
    return 0
  fi
  
  # Extract statuses using jq if available, otherwise use grep
  local claude_code_status=""
  local claude_ai_status=""
  local platform_status=""
  
  if command -v jq &>/dev/null; then
    claude_code_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="Claude Code") | .status' 2>/dev/null)
    claude_ai_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="claude.ai") | .status' 2>/dev/null)
    platform_status=$(echo "$status_json" | jq -r '.components[] | select(.name | startswith("platform.claude.com")) | .status' 2>/dev/null)
  else
    # Fallback to grep/sed if jq not available
    claude_code_status=$(echo "$status_json" | grep -o '"name":"Claude Code"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    claude_ai_status=$(echo "$status_json" | grep -o '"name":"claude.ai"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    platform_status=$(echo "$status_json" | grep -o '"name":"platform.claude.com[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
  fi
  
  # Check if any service has issues
  local has_issues=0
  local RED='\033[0;31m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  if [[ "$claude_code_status" == "partial_outage" ]] || [[ "$claude_code_status" == "major_outage" ]] || [[ "$claude_code_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  Claude Code: ${YELLOW}${claude_code_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$claude_ai_status" == "partial_outage" ]] || [[ "$claude_ai_status" == "major_outage" ]] || [[ "$claude_ai_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  claude.ai: ${YELLOW}${claude_ai_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$platform_status" == "partial_outage" ]] || [[ "$platform_status" == "major_outage" ]] || [[ "$platform_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  platform.claude.com: ${YELLOW}${platform_status}${NC}"
    has_issues=1
  fi
  
  if [[ $has_issues -eq 1 ]]; then
    echo "  ${YELLOW}ℹ${NC}  Auth may fail due to service issues. Check https://status.claude.com"
    return 1
  fi
  
  return 0
}

