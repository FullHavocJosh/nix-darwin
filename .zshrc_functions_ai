# Ensure secure permissions on environment variable files
function _ensure_envvars_permissions() {
  # Check and fix ~/.zshrc_envvars (sensitive data)
  if [[ -f ~/.zshrc_envvars ]]; then
    chmod 600 ~/.zshrc_envvars 2>/dev/null
  fi
  
  # Check and fix ~/.zshrc_envvars_insecure (non-sensitive, but good practice)
  # Follow symlink if it exists
  if [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null)
    if [[ -f "$target" ]]; then
      chmod 600 "$target" 2>/dev/null
    fi
  elif [[ -f ~/.zshrc_envvars_insecure ]]; then
    chmod 600 ~/.zshrc_envvars_insecure 2>/dev/null
  fi
}

# Run permission check on shell startup (silent)
_ensure_envvars_permissions
