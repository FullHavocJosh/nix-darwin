          grep -v "^# OpenCode Zen API key" ~/.zshrc_envvars.tmp > ~/.zshrc_envvars.tmp2
          mv ~/.zshrc_envvars.tmp2 ~/.zshrc_envvars
          rm -f ~/.zshrc_envvars.tmp
        fi
        
        # Add to ~/.zshrc_envvars with proper escaping
        echo "" >> ~/.zshrc_envvars
        echo "# OpenCode Zen API key (added $(date '+%Y-%m-%d %H:%M:%S'))" >> ~/.zshrc_envvars
        echo "export OPENCODE_API_KEY=\"${opencode_api_key}\"" >> ~/.zshrc_envvars
        
        # Set restrictive permissions
        chmod 600 ~/.zshrc_envvars
        
