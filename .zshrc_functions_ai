# Check Claude service status from status.claude.com
# Returns 0 if operational, 1 if there are issues
# Prints status information to stdout
function _check_claude_status() {
  # Use -L to follow redirects
  local status_json=$(curl -sL --max-time 5 https://status.claude.com/api/v2/components.json 2>/dev/null)
  
  # If curl failed or returned empty, assume services are operational (fail open)
  if [[ -z "$status_json" ]] || [[ "$status_json" == *"<html"* ]]; then
    return 0
  fi
  
  # Extract statuses using jq if available, otherwise use grep
  local claude_code_status=""
  local claude_ai_status=""
  local platform_status=""
  
  if command -v jq &>/dev/null; then
    claude_code_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="Claude Code") | .status' 2>/dev/null)
    claude_ai_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="claude.ai") | .status' 2>/dev/null)
    platform_status=$(echo "$status_json" | jq -r '.components[] | select(.name | startswith("platform.claude.com")) | .status' 2>/dev/null)
  else
    # Fallback to grep/sed if jq not available
    claude_code_status=$(echo "$status_json" | grep -o '"name":"Claude Code"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    claude_ai_status=$(echo "$status_json" | grep -o '"name":"claude.ai"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    platform_status=$(echo "$status_json" | grep -o '"name":"platform.claude.com[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
  fi
  
  # Check if any service has issues
  local has_issues=0
  local RED='\033[0;31m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  if [[ "$claude_code_status" == "partial_outage" ]] || [[ "$claude_code_status" == "major_outage" ]] || [[ "$claude_code_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  Claude Code: ${YELLOW}${claude_code_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$claude_ai_status" == "partial_outage" ]] || [[ "$claude_ai_status" == "major_outage" ]] || [[ "$claude_ai_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  claude.ai: ${YELLOW}${claude_ai_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$platform_status" == "partial_outage" ]] || [[ "$platform_status" == "major_outage" ]] || [[ "$platform_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  platform.claude.com: ${YELLOW}${platform_status}${NC}"
    has_issues=1
  fi
  
  if [[ $has_issues -eq 1 ]]; then
    echo "  ${YELLOW}ℹ${NC}  Auth may fail due to service issues. Check https://status.claude.com"
    return 1
  fi
  
  return 0
}

