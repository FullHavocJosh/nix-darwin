      # chrome and any markdown fence, but the array-extraction regex stays
      # as a safety net in case the model wraps the array in stray prose.
      local json_extracted=$(echo "$aider_output" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      if echo "$json_extracted" | jq empty 2>/dev/null; then
