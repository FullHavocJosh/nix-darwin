# HELPER: Execute AI command with plain text output (for commit messages, etc.)
# Usage: echo "prompt" | _run_ai_plain ["haiku"|"sonnet"|"opus"]
# Returns plain text response without JSON parsing
function _run_ai_plain() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    anthropic | github-copilot)
      # Both anthropic and github-copilot route through opencode run
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      
      echo "$result"
      return 0
      ;;
      
    opencode)
      if [[ -z "$OPENCODE_API_KEY" ]]; then
        echo "Error: OPENCODE_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenCode API returned invalid response" >&2
      return 1
      ;;
      
    openrouter)
      if [[ -z "$OPENROUTER_API_KEY" ]]; then
        echo "Error: OPENROUTER_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenRouter API returned invalid response" >&2
      return 1
      ;;
      
    llama-cpp)
      # llama-server exposes an OpenAI-compatible /v1/chat/completions endpoint
      local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
      local model_name="${model#llama-cpp/}"

      # Truncate prompt to ~6000 chars to keep it fast for plain-text tasks
      # (commit messages only need a representative sample of the diff)
      local truncated_prompt="${prompt:0:6000}"
      local prompt_len=${#prompt}
      if [ $prompt_len -gt 6000 ]; then
        truncated_prompt="${truncated_prompt}
... [diff truncated at 6000 chars for speed — ${prompt_len} total]"
      fi

      local result=$(curl -s "${endpoint}/v1/chat/completions" \
        --max-time 60 \
        --connect-timeout 5 \
        -H "Content-Type: application/json" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$truncated_prompt" | jq -Rs .)}],
          \"temperature\": 0.2,
          \"max_tokens\": 256
        }" 2>/dev/null)

      local curl_exit=$?
      if [ $curl_exit -eq 28 ]; then
        echo "Error: llama-server timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: llama-server not reachable (is llama-server running?)" >&2
        return 1
      fi

      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi

      # Surface the actual error from llama-server if present
      local server_error=$(echo "$result" | jq -r '.error.message' 2>/dev/null)
      if [[ -n "$server_error" && "$server_error" != "null" ]]; then
        echo "Error: llama-server: $server_error" >&2
      else
        echo "Error: llama-server returned invalid response" >&2
      fi
      return 1
      ;;

    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# PRIMARY FUNCTION: Execute AI command with direct API call (lightweight, fast)
# Usage: echo "prompt" | _run_ai_direct ["haiku"|"sonnet"|"opus"]
# This is the recommended function for all AI tasks that don't need agent capabilities
# - Respects aiselect provider configuration
# - Makes direct API calls (no agent overhead)
# - Typical response time: 5-15 seconds
# - Supports: GitHub Copilot, OpenCode, OpenRouter
# NOTE: This function expects JSON array responses. For plain text, use _run_ai_plain
function _run_ai_direct() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    anthropic | github-copilot)
      # Both anthropic and github-copilot route through opencode run
      # We can't make direct API calls, so use opencode run via stdin
      
      local model_name="$model"  # Keep full model name with prefix
      
      # Add a VERY strong instruction to output ONLY JSON with explicit format
      local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include:
- Any conversational text before the JSON
- Any explanations after the JSON  
- Any markdown code blocks or backticks
- Any commentary or notes

Your entire response must be valid JSON starting with [ and ending with ].
If there are no issues to report, respond with exactly: []

Example of CORRECT response format:
[{\"file\":\"example.tf\",\"severity\":\"Critical\",\"issue\":\"Hardcoded secret\",\"recommendation\":\"Use variable\"}]

Example of INCORRECT response (DO NOT DO THIS):
Here are the issues I found:
\`\`\`json
[{...}]
\`\`\`
Let me know if you need anything else!

START YOUR RESPONSE NOW WITH [ OR []:"
      
      # Use opencode run with stdin to avoid issues with special characters
      # Timeout after 90s (longer than direct API but acceptable)
      local result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model_name" 2>&1)
      local exit_code=$?
      
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        if [[ -n "$result" ]]; then
          echo "Output: $(echo "$result" | head -c 200)" >&2
        fi
        return 1
      fi
      
      # Extract JSON more efficiently - single strategy that handles most cases
      if [[ -n "$result" ]]; then
        # Strategy: Extract from first [ to last ] (handles wrapped JSON)
        local extracted=$(echo "$result" | perl -0777 -pe 's/^[^\[]*(\[.*\])[^\]]*$/$1/s' | head -c 50000)
        
        # Validate it's proper JSON
        if echo "$extracted" | jq empty 2>/dev/null; then
          echo "$extracted"
          return 0
        fi
        
        # Soft failure: Could not parse response
        # Exit code 2 = unparseable output (user should be warned)
        echo "Error: Could not parse AI response as JSON" >&2
        echo "[]"
        return 2
      fi
      
      echo "Error: OpenCode returned empty response" >&2
      return 1
      ;;
      
    opencode)
      # Use curl with OpenCode API
      if [[ -z "$OPENCODE_API_KEY" ]]; then
        echo "Error: OPENCODE_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#opencode/}"
      
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 \
        --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local curl_exit=$?
      
      if [ $curl_exit -eq 28 ]; then
        echo "Error: OpenCode API timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: OpenCode API network error (curl exit code: $curl_exit)" >&2
        return 1
      fi
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenCode API returned invalid response" >&2
      return 1
      ;;
      
    openrouter)
      # Use curl with OpenRouter API
      if [[ -z "$OPENROUTER_API_KEY" ]]; then
        echo "Error: OPENROUTER_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#openrouter/}"
      
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 \
        --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local curl_exit=$?
      
      if [ $curl_exit -eq 28 ]; then
        echo "Error: OpenRouter API timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: OpenRouter API network error (curl exit code: $curl_exit)" >&2
        return 1
      fi
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenRouter API returned invalid response" >&2
      return 1
      ;;
      
    llama-cpp)
      # llama-server exposes an OpenAI-compatible /v1/chat/completions endpoint
      local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
      local model_name="${model#llama-cpp/}"

      # Truncate prompt to ~4000 chars (~1000 tokens) to keep inference fast (~10s).
      # Each additional 1000 tokens adds ~20s on 7B Q8; code review JSON is short.
      local truncated_prompt="${prompt:0:4000}"
      local prompt_len=${#prompt}
      if [ $prompt_len -gt 4000 ]; then
        truncated_prompt="${truncated_prompt}
... [diff truncated at 4000 chars — ${prompt_len} total]"
      fi

      local result=$(curl -s "${endpoint}/v1/chat/completions" \
        --max-time 60 \
        --connect-timeout 5 \
        -H "Content-Type: application/json" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$truncated_prompt" | jq -Rs .)}],
          \"temperature\": 0.1,
          \"max_tokens\": 256
        }" 2>/dev/null)

      local curl_exit=$?
      if [ $curl_exit -eq 28 ]; then
        echo "Error: llama-server timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: llama-server not reachable (is llama-server running?)" >&2
        return 1
      fi

      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        # Extract JSON array from the response (same strategy as anthropic branch)
        local json_extracted=$(echo "$extracted" | perl -0777 -pe 's/^[^\[]*(\[.*\])[^\]]*$/$1/s' | head -c 50000)
        if echo "$json_extracted" | jq empty 2>/dev/null; then
          echo "$json_extracted"
          return 0
        fi
        # Soft failure: response not parseable as JSON
        echo "Error: Could not parse llama-server response as JSON" >&2
        echo "[]"
        return 2
      fi

      echo "Error: llama-server returned invalid response" >&2
      return 1
      ;;

    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# LEGACY FUNCTION: Execute AI command with OpenCode agent (slower, full agent capabilities)
# Usage: echo "prompt" | _run_ai_agent ["haiku"|"sonnet"|"opus"]
# Only use this when you need full agent capabilities (file editing, tool use, etc.)
# - Uses OpenCode's full agent framework
# - Typical response time: 60-300+ seconds
# - For simple queries, use _run_ai_direct instead
# NOTE: This is kept for backward compatibility and special cases like auto-fix
function _run_ai_agent() {
  local task_type="${1:-sonnet}"
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Always use OpenCode (it supports all providers including GitHub Copilot)
  # OpenCode run takes the prompt as a positional argument
  opencode run --model "$model" "$prompt"
}

# DEPRECATED ALIAS: Use _run_ai_direct for new code
# This is kept for backward compatibility only
function _run_ai_command() {
  _run_ai_direct "$@"
}

# DEPRECATED: Get AI command based on provider preference (use _run_ai_direct instead)
# This is kept for backward compatibility but should be replaced
# Usage: _get_ai_command ["haiku"|"sonnet"|"opus"]
function _get_ai_command() {
  local task_type="${1:-sonnet}"
  echo "_run_ai_direct $task_type"
}

# Launch OpenCode with the selected provider/model
# This replaces the 'aidev' alias to dynamically select model based on aiselect preference
function aidev() {
  local provider=$(_get_ai_provider)
  
  # Colors for terminal output
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m' # No Color
  
  # If no preference is set and we're offline, auto-select llama-cpp
  if ! _is_online; then
    if [[ "$provider" != "llama-cpp" ]]; then
      echo "${YELLOW}⚠${NC}  No internet connection detected."
      if _validate_llamacpp; then
        echo "   Switching to llama-cpp (local) for this session."
        echo ""
        provider="llama-cpp"
      else
        echo "${RED}✗${NC} Offline and llama-server is not running. Cannot start aidev."
        echo "   Start llama-server or connect to the internet and try again."
        return 1
      fi
    fi
  fi

  # llama-cpp: launch opencode with the local-coder model via llama.cpp provider
  if [[ "$provider" == "llama-cpp" ]]; then
    if ! _validate_llamacpp; then
      echo "${RED}✗${NC} llama-server is not running at http://127.0.0.1:8080"
      echo "   Start it first: launchctl kickstart -k gui/\$(id -u)/llama-server"
      return 1
    fi
    local local_model="llama.cpp/local-coder"
    echo "${GREEN}✓${NC} Provider: llama-cpp (local)"
    echo "${GREEN}✓${NC} Model:    ⚪ $(_llamacpp_model_short) → $local_model"
    echo ""
    opencode --model "$local_model" "$@"
    return $?
  fi

  local auth_valid=false
  local _aidev_validate() {
    case $provider in
      anthropic)    _validate_anthropic ;;
      github-copilot) _validate_github_copilot ;;
      opencode)     _validate_opencode_zen ;;
      openrouter)   _validate_openrouter ;;
      *)            return 1 ;;
    esac
  }
  
  if _aidev_validate; then
    auth_valid=true
  else
    echo "${RED}✗${NC} Provider '$provider' is not available or not authenticated"
    echo ""
    echo "Options:"
    echo "  [a] Run aiselect to configure or switch provider"
    echo "  [c] Continue anyway (may fail)"
    echo "  [q] Quit"
    echo ""
    echo -n "Your choice: "
    
    local choice
    read -k1 choice
    echo ""
    echo ""
    
    case $choice in
      a | A)
        aiselect
        # Re-read provider in case user switched it
        provider=$(_get_ai_provider)
        if ! _aidev_validate; then
          echo "${RED}✗${NC} Provider '$provider' still not valid. Aborting."
          return 1
        fi
        ;;
      c | C)
        echo "${YELLOW}⚠${NC}  Continuing without valid authentication..."
        echo ""
        ;;
      q | Q | $'\e')
        echo "Cancelled"
        return 1
        ;;
      *)
        echo "${RED}✗${NC} Invalid choice. Aborting."
        return 1
        ;;
    esac
  fi
  
  # Resolve the model for the current provider
  local model
  model=$(_get_opencode_model "sonnet")
  if [[ -z "$model" ]]; then
    echo "${RED}✗${NC} Could not determine model for provider: $provider"
    return 1
  fi
  
  echo "${GREEN}✓${NC} Provider: $provider"
  echo "${GREEN}✓${NC} Model:    $model"
  echo ""
  
  opencode --model "$model" "$@"
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  # Fallback: Check gh CLI authentication
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

# Validate OpenCode Zen API key
function _validate_opencode_zen() {
  # Check for OpenCode API key in environment
  if [[ -n "$OPENCODE_API_KEY" ]]; then
    return 0
  fi
  
  # Check if key is in .zshrc_envvars (not tracked by git)
  if [[ -f ~/.zshrc_envvars ]]; then
    if grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars; then
      return 0
    fi
  fi
  
  # Also check .zshrc_envvars_insecure (for non-sensitive configs, not tracked by git)
  if [[ -f ~/.zshrc_envvars_insecure ]]; then
    if grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars_insecure; then
      return 0
    fi
  fi
  
  return 1
}

# Validate OpenRouter API key
function _validate_openrouter() {
  # Check for OpenRouter API key in environment
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    return 0
  fi
  
  # Check if key is in .zshrc_envvars (not tracked by git)
  if [[ -f ~/.zshrc_envvars ]]; then
    if grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars; then
      return 0
    fi
  fi
  
  # Also check .zshrc_envvars_insecure (for non-sensitive configs, not tracked by git)
  if [[ -f ~/.zshrc_envvars_insecure ]]; then
    if grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars_insecure; then
      return 0
    fi
  fi
  
  return 1
}

# Helper: return a human-readable string for the model tier this machine will use.
# Mirrors the RAM thresholds in the llama-server-launcher wrapper script in packages.nix.
# Usage: _llamacpp_model_tier
function _llamacpp_model_tier() {
  local ram_bytes ram_gb
  ram_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
  ram_gb=$(( ram_bytes / 1024 / 1024 / 1024 ))
  echo "qwen2.5-coder-7b Q8 (~8 GB, ${ram_gb} GB device)"
}

# Short model name for display in gpa batch headers
function _llamacpp_model_short() {
  echo "Qwen2.5-Coder-7B"
}

# Validate llama.cpp server availability
# Checks that llama-server is reachable and has a model loaded
function _validate_llamacpp() {
  local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
  # Health check: /health returns {"status":"ok"} when model is loaded
  local response
  response=$(curl -s --max-time 3 "${endpoint}/health" 2>/dev/null)
  if echo "$response" | grep -q '"status"'; then
    return 0
  fi
  return 1
}

# Validate Anthropic provider availability via OpenCode
# Checks that opencode can list models for the anthropic provider
function _validate_anthropic() {
  if ! command -v opencode &>/dev/null; then
    return 1
  fi
  # If opencode can list at least one claude model for anthropic, the provider is available
  local models
  models=$(opencode models anthropic 2>/dev/null | grep -i "claude")
  [[ -n "$models" ]]
}

# Check internet connectivity by pinging 1.1.1.1
# Returns 0 if online, 1 if offline
function _is_online() {
  ping -c1 -W1 1.1.1.1 >/dev/null 2>&1
}

# Helper function to get current AI provider preference
function _get_ai_provider() {
  local preference_file="$HOME/.ai_provider_preference"
  
  # If preference file doesn't exist, default to Anthropic
  if [[ ! -f "$preference_file" ]]; then
    echo "anthropic"
    return 0
  fi
  
  # Read and return the preference
  cat "$preference_file"
}

# =============================================================================
# Hybrid Routing: local (llama-cpp) → cloud escalation
# =============================================================================
#
# When the active provider is llama-cpp, gpa/gpc/gpr run locally for all
# routine tasks. If gpa's local review raises a Critical+security finding,
# it escalates that batch to the configured cloud provider for a deeper look.
#
# Cloud provider is stored separately in ~/.ai_cloud_provider_preference so
# switching to llama-cpp doesn't lose your previous cloud setup.
# Set it via: aiselect (the llama-cpp flow prompts you to choose a cloud provider)
#
# Flow:
#   gpc  → always local (commit messages never need cloud quality)
#   gpr  → always local (templated PR creation)
#   gpa  → local first; Critical+security finding → escalate to cloud Sonnet
#          local hard failure → fall back to cloud automatically
# =============================================================================

# Get the configured cloud escalation provider (used when main provider is llama-cpp)
function _get_cloud_fallback_provider() {
  local cloud_pref="$HOME/.ai_cloud_provider_preference"
  if [[ -f "$cloud_pref" ]]; then
    cat "$cloud_pref"
  else
    echo "anthropic"  # sensible default
  fi
}

# Get the cloud model string for a given task type, ignoring the active provider.
# Always reads from the cloud fallback provider preference.
function _get_cloud_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)

  case $provider in
    github-copilot)
      [[ "$task_type" == "opus"  ]] && echo "github-copilot/claude-opus-4.5"  && return
      [[ "$task_type" == "haiku" ]] && echo "github-copilot/claude-haiku-4.5" && return
      echo "github-copilot/claude-sonnet-4.5"
      ;;
    opencode)
      [[ "$task_type" == "opus"  ]] && echo "opencode/claude-opus-4.5"        && return
      [[ "$task_type" == "haiku" ]] && echo "opencode/claude-3-5-haiku"        && return
      echo "opencode/claude-sonnet-4.5"
      ;;
    openrouter)
      [[ "$task_type" == "opus"  ]] && echo "openrouter/anthropic/claude-opus-4.5"   && return
      [[ "$task_type" == "haiku" ]] && echo "openrouter/anthropic/claude-3.5-haiku"  && return
      echo "openrouter/anthropic/claude-sonnet-4.5"
      ;;
    anthropic|*)
      [[ "$task_type" == "opus"  ]] && echo "anthropic/claude-opus-4-5"  && return
      [[ "$task_type" == "haiku" ]] && echo "anthropic/claude-haiku-4-5" && return
      echo "anthropic/claude-sonnet-4-5"
      ;;
  esac
}

# Execute a plain-text AI call unconditionally against the cloud fallback provider.
# Used for escalation from llama-cpp when the active provider IS llama-cpp.
# Usage: echo "prompt" | _run_ai_plain_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_plain_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    opencode)
      [[ -z "$OPENCODE_API_KEY" ]] && { echo "Error: OPENCODE_API_KEY not set" >&2; return 1; }
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "Error: OpenCode cloud API returned invalid response" >&2; return 1
      ;;
    openrouter)
      [[ -z "$OPENROUTER_API_KEY" ]] && { echo "Error: OPENROUTER_API_KEY not set" >&2; return 1; }
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "Error: OpenRouter cloud API returned invalid response" >&2; return 1
      ;;
  esac
}

# Execute a structured-JSON AI call unconditionally against the cloud fallback provider.
# Used for escalation from llama-cpp when the active provider IS llama-cpp.
# Usage: echo "prompt" | _run_ai_direct_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_direct_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include any text before or after it.
If there are no issues, respond with exactly: []
START YOUR RESPONSE NOW WITH [ OR []:"

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/^[^\[]*(\[.*\])[^\]]*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
    opencode)
      [[ -z "$OPENCODE_API_KEY" ]] && { echo "Error: OPENCODE_API_KEY not set" >&2; return 1; }
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$json_prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "[]"; return 1
      ;;
    openrouter)
      [[ -z "$OPENROUTER_API_KEY" ]] && { echo "Error: OPENROUTER_API_KEY not set" >&2; return 1; }
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$json_prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "[]"; return 1
      ;;
  esac
}

# AI Provider Selection - System-wide provider preference
# Stores selection in ~/.ai_provider_preference
function aiselect() {
  local preference_file="$HOME/.ai_provider_preference"
  
  # If called with --show or --status, just display current provider
  if [[ "$1" == "--show" ]] || [[ "$1" == "--status" ]]; then
    local current_provider=$(_get_ai_provider)
    local opencode_model=$(_get_opencode_model "sonnet")
    local opencode_haiku_model=$(_get_opencode_model "haiku")
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Current AI Configuration"
    echo "═══════════════════════════════════════════════════════════"
    echo "Active Provider: $current_provider"
    echo ""
    echo "Interactive Sessions (aidev):"
    echo "  Model: $opencode_model"
    echo "  Mode: Full OpenCode agent with tools"
    echo "  → Launched with -m flag based on aiselect preference"
    echo ""
    echo "Direct API Functions (fast, lightweight):"
    echo "  Haiku tasks  (commit msgs): $opencode_haiku_model"
    echo "  Sonnet tasks (code review): $opencode_model"
    echo "  Mode: Direct API calls (no agent overhead)"
    echo "  Response time: ~5-15 seconds"
    echo ""
    echo "Command → Model → Mode:"
    echo "  • aidev                     → $opencode_model → Full Agent (opencode)"
    echo "  • gpc (commit messages)     → $opencode_haiku_model → Direct API"
    echo "  • gpa (code review)         → $opencode_model → Direct API"
    echo ""
    if [[ "$current_provider" == "llama-cpp" ]]; then
      local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
      local cloud_provider=$(_get_cloud_fallback_provider)
      local cloud_model=$(_get_cloud_model "sonnet")
      echo ""
      echo "Hybrid Routing (llama-cpp + cloud escalation):"
      echo "  Local endpoint:   $endpoint"
      echo "  Local tier:       $(_llamacpp_model_tier)"
      echo "  Cloud provider:   $cloud_provider"
      echo "  Cloud model:      $cloud_model"
      echo ""
      echo "  gpc  → ⚪ local always  (commit messages)"
      echo "  gpr  → ⚪ local always  (PR creation)"
      echo "  gpa  → ⚪ local (small diffs) → 🟢 Haiku (medium) → 🔵 Sonnet (large or critical/security)"
      echo "  aidev → ⚪ local (opencode with llama.cpp/local-coder)"
    fi
    echo ""
    echo "Note: Run 'aiselect' to change provider. Changes apply immediately"
    echo "      to all commands (no restart required)."
    echo "═══════════════════════════════════════════════════════════"
    return 0
  fi
  
  # Colors for terminal output
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m' # No Color
  
  # If offline, auto-select llama-cpp and skip the menu
  if ! _is_online; then
    echo "${YELLOW}⚠${NC}  No internet connection detected."
    if _validate_llamacpp; then
      echo "   Auto-selecting llama-cpp (local) — offline mode."
      echo "llama-cpp" > "$preference_file"
      echo ""
      echo "${GREEN}✓${NC} Provider set to: llama-cpp (offline)"
      echo "   Run 'aidev' to start an interactive session with the local model."
      return 0
    else
      echo "${RED}✗${NC} Offline and llama-server is not running."
      echo "   Start llama-server or connect to the internet and try again."
      return 1
    fi
  fi

  # Run validations
  echo "Checking AI provider availability..."
  echo ""
  
  local anthropic_valid=false
  local github_valid=false
  local opencode_valid=false
  local openrouter_valid=false
  local llamacpp_valid=false

  # Validate Anthropic (via OpenCode)
  if _validate_anthropic; then
    anthropic_valid=true
    echo "${GREEN}✓${NC} Anthropic available via OpenCode"
    echo ""
  else
    echo "${YELLOW}⚠${NC}  Anthropic not available via OpenCode"
    echo "   Ensure OpenCode is installed and has the Anthropic provider configured"
    echo ""
  fi
  
  # Validate GitHub Copilot
  if _validate_github_copilot; then
    github_valid=true
  else
    # Offer to authenticate
