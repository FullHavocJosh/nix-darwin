        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode failed (exit $exit_code)" >&2
        return 1
      fi
      
      # Extract JSON array from response
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      if echo "$extracted" | jq empty 2>/dev/null; then
        echo "$extracted"
        return 0
      fi
      
      echo "[]"
      return 2
      ;;
      
    llama-cpp)
      # Truncate prompt to ~4000 chars (~1000 tokens) to keep prompt processing
      # reasonable -- this controls INPUT size, independent of the generous
      # output max_tokens (4096, see .config/aider/model-settings.yml's
      # openai/local-coder-review entry) gpa's security review wants for
      # thorough multi-finding output.
      local truncated_prompt="${prompt:0:4000}"
      local prompt_len=${#prompt}
