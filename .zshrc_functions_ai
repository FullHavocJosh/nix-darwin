# Plain-text AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_plain_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_plain_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    opencode)
      [[ -z "$OPENCODE_API_KEY" ]] && { echo "Error: OPENCODE_API_KEY not set" >&2; return 1; }
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "Error: OpenCode cloud API returned invalid response" >&2; return 1
      ;;
    openrouter)
      [[ -z "$OPENROUTER_API_KEY" ]] && { echo "Error: OPENROUTER_API_KEY not set" >&2; return 1; }
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "Error: OpenRouter cloud API returned invalid response" >&2; return 1
      ;;
  esac
}

# Structured-JSON AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_direct_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_direct_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include any text before or after it.
If there are no issues, respond with exactly: []
START YOUR RESPONSE NOW WITH [ OR []:"

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/^[^\[]*(\[.*\])[^\]]*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
    opencode)
      [[ -z "$OPENCODE_API_KEY" ]] && { echo "Error: OPENCODE_API_KEY not set" >&2; return 1; }
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$json_prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "[]"; return 1
      ;;
    openrouter)
      [[ -z "$OPENROUTER_API_KEY" ]] && { echo "Error: OPENROUTER_API_KEY not set" >&2; return 1; }
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$json_prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "[]"; return 1
      ;;
  esac
}

function aiselect() {
  local preference_file="$HOME/.ai_provider_preference"

  if [[ "$1" == "--show" ]] || [[ "$1" == "--status" ]]; then
    local current_provider=$(_get_ai_provider)
    local opencode_model=$(_get_opencode_model "sonnet")
    local opencode_haiku_model=$(_get_opencode_model "haiku")
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Current AI Configuration"
    echo "═══════════════════════════════════════════════════════════"
    echo "Active Provider: $current_provider"
    echo ""
    echo "Interactive Sessions (aidev):"
    echo "  Mode: Full Claude Code agent with tools"
    if [[ "$current_provider" == "claude-code" ]]; then
      echo "  → claude (direct, uses Claude.ai subscription)"
    else
      echo "  Model: $opencode_model"
      echo "  → claude (provider: $current_provider)"
    fi
    echo ""
    echo "Direct API Functions (fast, lightweight):"
    echo "  Haiku tasks  (commit msgs): $opencode_haiku_model"
    echo "  Sonnet tasks (code review): $opencode_model"
    echo "  Mode: Direct API calls (no agent overhead)"
    echo "  Response time: ~5-15 seconds"
    echo ""
    echo "Command → Model → Mode:"
    if [[ "$current_provider" == "claude-code" ]]; then
      echo "  • aidev                     → claude (direct) → Full Agent"
      echo "  • gpa                       → claude --print → Headless review (opencode fallback)"
    else
      echo "  • aidev                     → $opencode_model → Full Agent (claude)"
      echo "  • gpa                       → $opencode_model → Headless review"
    fi
    echo "  • gpc (commit messages)     → $opencode_haiku_model → Direct API"
    echo "  • gpa (code review)         → $opencode_model → Direct API"
    echo ""
    if [[ "$current_provider" == "llama-cpp" ]]; then
      local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
      local cloud_provider=$(_get_cloud_fallback_provider)
      local cloud_model=$(_get_cloud_model "sonnet")
      echo ""
      echo "Hybrid Routing (llama-cpp + cloud escalation):"
      echo "  Local endpoint:   $endpoint"
      echo "  Local tier:       $(_llamacpp_model_tier)"
      echo "  Cloud provider:   $cloud_provider"
      echo "  Cloud model:      $cloud_model"
      echo ""
      echo "  gpc  → ⚪ local always  (commit messages)"
      echo "  gpr  → ⚪ local always  (PR creation)"
      echo "  gpa  → ⚪ local (small diffs) → 🟢 Haiku (medium) → 🔵 Sonnet (large or critical/security)"
      echo "  aidev → ⚪ local (claude with llama.cpp/local-coder)"
    fi
    echo ""
    echo "Note: Run 'aiselect' to change provider. Changes apply immediately"
    echo "      to all commands (no restart required)."
    echo "═══════════════════════════════════════════════════════════"
    return 0
  fi
  
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  local session_file="/tmp/.ai_provider_session_$(id -u)"

  _aiselect_commit() {
    echo "$1" > "$preference_file"
    echo "$1" > "$session_file"
  }

  echo "═══════════════════════════════════════════════════════════"
  echo "AI Provider Setup"
  echo "═══════════════════════════════════════════════════════════"

  # Offline: skip straight to llama-cpp
  if ! _is_online; then
    echo "${YELLOW}⚠${NC}  No internet connection detected."
    if _validate_llamacpp; then
      echo "${GREEN}✓${NC} Using llama-cpp (local, offline)"
      _aiselect_commit "llama-cpp"
      echo "═══════════════════════════════════════════════════════════"
      return 0
    else
      echo "${RED}✗${NC} Offline and llama-server is not running. Cannot proceed."
      echo "═══════════════════════════════════════════════════════════"
      return 1
    fi
  fi

  # ── Step 1/4: Claude Code ──────────────────────────────────────
  echo ""
  echo "[ 1/4 ] Claude Code"
  if _validate_claude_code; then
    echo "  ${GREEN}✓${NC} Session found"
    echo -n "  [enter] Use Claude Code   [esc] Check GitHub Copilot → "
    _read_key; echo ""
    if [[ "$_KEY" != $'\e' ]]; then
      _aiselect_commit "claude-code"
      echo ""
      echo "═══════════════════════════════════════════════════════════"
      return 0
    fi
  elif command -v claude &>/dev/null; then
    echo "  ${YELLOW}⚠${NC}  Installed but not signed in"
    echo -n "  [enter] Login to Claude Code   [esc] Skip to GitHub Copilot → "
    _read_key; echo ""
    if [[ "$_KEY" != $'\e' ]]; then
      echo ""
      claude auth login
      echo ""
      if _validate_claude_code; then
        echo "  ${GREEN}✓${NC} Login successful — proceeding with Claude Code"
        _aiselect_commit "claude-code"
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        return 0
      else
        echo "  ${RED}✗${NC} Login incomplete — continuing to GitHub Copilot"
      fi
    fi
  else
    echo "  ${YELLOW}⚠${NC}  Not installed (brew install --cask claude-code)"
  fi

  # ── Step 2/4: GitHub Copilot ───────────────────────────────────
  echo ""
  echo "[ 2/4 ] GitHub Copilot"
  if _validate_github_copilot; then
    echo "  ${GREEN}✓${NC} Session found"
    echo -n "  [enter] Use GitHub Copilot   [esc] Check OpenCode Zen → "
    _read_key; echo ""
    if [[ "$_KEY" != $'\e' ]]; then
      _aiselect_commit "github-copilot"
      echo ""
      echo "═══════════════════════════════════════════════════════════"
      return 0
    fi
  else
    echo "  ${YELLOW}⚠${NC}  Not authenticated"
    echo -n "  [enter] Login to GitHub Copilot   [esc] Skip to OpenCode Zen → "
    _read_key; echo ""
    if [[ "$_KEY" != $'\e' ]]; then
      echo ""
      if command -v open &>/dev/null; then
        open "https://github.com/login/device"
      fi
      opencode auth login
      echo ""
      if _validate_github_copilot; then
        echo "  ${GREEN}✓${NC} Login successful — proceeding with GitHub Copilot"
        _aiselect_commit "github-copilot"
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        return 0
      else
        echo "  ${RED}✗${NC} Login incomplete — continuing to OpenCode Zen"
      fi
    fi
  fi

  # ── Step 3/4: OpenCode Zen (API key) ───────────────────────────
  echo ""
  echo "[ 3/4 ] OpenCode Zen (API key)"
  if _validate_opencode_zen; then
    echo "  ${GREEN}✓${NC} API key found"
    echo -n "  [enter] Use OpenCode Zen   [esc] Check OpenRouter → "
    _read_key; echo ""
    if [[ "$_KEY" != $'\e' ]]; then
      _aiselect_commit "opencode"
      echo ""
      echo "═══════════════════════════════════════════════════════════"
      return 0
    fi
  else
    echo "  ${YELLOW}⚠${NC}  No OPENCODE_API_KEY found — add to ~/.zshrc_envvars to enable"
  fi

  # ── Step 4/4: OpenRouter (API key) ─────────────────────────────
  echo ""
  echo "[ 4/4 ] OpenRouter (API key)"
  if _validate_openrouter; then
    echo "  ${GREEN}✓${NC} API key found"
    echo -n "  [enter] Use OpenRouter   [esc] No more providers → "
    _read_key; echo ""
    if [[ "$_KEY" != $'\e' ]]; then
      _aiselect_commit "openrouter"
      echo ""
      echo "═══════════════════════════════════════════════════════════"
      return 0
    fi
  else
    echo "  ${YELLOW}⚠${NC}  No OPENROUTER_API_KEY found — add to ~/.zshrc_envvars to enable"
  fi

  # ── No providers available ─────────────────────────────────────
  echo ""
  echo "${RED}✗${NC} No AI providers available."
  echo "   To add API key access, set in ~/.zshrc_envvars (git-ignored, chmod 600):"
  echo "     export OPENCODE_API_KEY=\"...\""
  echo "     export OPENROUTER_API_KEY=\"...\""
  echo "═══════════════════════════════════════════════════════════"
  return 1

}

# Security audit function for AI configuration files
function ai_security_audit() {
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  echo "═══════════════════════════════════════════════════════════"
  echo "AI Configuration Security Audit"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  
  local issues_found=0
  
  # Check ~/.zshrc_envvars permissions
  if [[ -f ~/.zshrc_envvars ]]; then
    # Cross-platform stat command (macOS vs Linux)
    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS
      perms=$(stat -f "%Op" ~/.zshrc_envvars 2>/dev/null | tail -c 4)
    else
      # Linux
      perms=$(stat -c "%a" ~/.zshrc_envvars 2>/dev/null)
    fi
    
    echo "Checking ~/.zshrc_envvars..."
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars'"
      issues_found=$((issues_found + 1))
    fi
    
    # Check if file contains API keys
    if grep -q "API_KEY" ~/.zshrc_envvars; then
      echo "  ${YELLOW}ℹ${NC}  Contains API keys (stored in plain text)"
    fi
  else
    echo "~/.zshrc_envvars: Not found"
  fi
  
  echo ""
  
  if [[ -f ~/.zshrc_envvars_insecure ]] || [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target_file=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null || echo ~/.zshrc_envvars_insecure)

    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      perms=$(stat -f "%Op" "$target_file" 2>/dev/null | tail -c 4)
    else
      perms=$(stat -c "%a" "$target_file" 2>/dev/null)
    fi

    echo "Checking ~/.zshrc_envvars_insecure..."
    if [[ -L ~/.zshrc_envvars_insecure ]]; then
      echo "  ${YELLOW}ℹ${NC}  Symlink to: $target_file"
    fi
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      if [[ -L ~/.zshrc_envvars_insecure ]]; then
        echo "    Recommended: Run 'chmod 600 $target_file'"
      else
        echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars_insecure'"
      fi
      issues_found=$((issues_found + 1))
    fi
    
    if grep -q "API_KEY" "$target_file" 2>/dev/null; then
      echo "  ${RED}✗${NC} Contains API keys (should be in ~/.zshrc_envvars instead)"
      issues_found=$((issues_found + 1))
    fi
  fi
  
  echo ""
  
  if [[ -n "$OPENCODE_API_KEY" ]]; then
    echo "Environment variables:"
    echo "  ${GREEN}✓${NC} OPENCODE_API_KEY is set"
  fi
  
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    echo "  ${GREEN}✓${NC} OPENROUTER_API_KEY is set"
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  
  if [[ $issues_found -eq 0 ]]; then
    echo "${GREEN}✓${NC} No security issues found"
  else
    echo "${RED}✗${NC} Found $issues_found security issue(s)"
  fi
  
  echo "═══════════════════════════════════════════════════════════"
}

export AI_PROVIDER=$(_get_ai_provider)

function _ensure_envvars_permissions() {
  [[ -f ~/.zshrc_envvars ]] && chmod 600 ~/.zshrc_envvars 2>/dev/null

  if [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null)
    [[ -f "$target" ]] && chmod 600 "$target" 2>/dev/null
  elif [[ -f ~/.zshrc_envvars_insecure ]]; then
    chmod 600 ~/.zshrc_envvars_insecure 2>/dev/null
  fi
}

_ensure_envvars_permissions
