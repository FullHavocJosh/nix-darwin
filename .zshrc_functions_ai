# Secrets: ~/.zshrc_envvars (git-ignored, chmod 600)
# Non-sensitive config: ~/.zshrc_envvars_insecure (tracked by git)

# Helper function: Clean OpenCode CLI output by removing ANSI codes and prompts
# Usage: _clean_opencode_output <output>
function _clean_opencode_output() {
  local output="$1"
  # Strip ANSI escape codes (use perl for better escape sequence handling)
  output=$(echo "$output" | perl -pe 's/\e\[[0-9;]*m//g')
  # Remove OpenCode CLI prompt lines (e.g., "> build · claude-haiku-4.5")
  # and extract only content lines (non-empty, non-prompt)
  output=$(echo "$output" | grep -v '^> ' | grep -v '^[[:space:]]*$')
  echo "$output"
}

# Read a single keypress into the named variable.
# After ESC, drains any buffered ANSI escape-sequence tail (e.g. ESC [ from
# arrow keys) so the next read is not poisoned by leftover bytes.
function _read_key() {
  # Reads one keypress into the global _KEY.
  # If ESC is pressed, drains any buffered ANSI tail bytes (e.g. ESC [ from
  # arrow keys) so subsequent reads are not poisoned by leftover input.
  read -k1 _KEY
  if [[ "$_KEY" == $'\e' ]]; then
    local _drain
    read -k10 -t 0.1 _drain 2>/dev/null || true
  fi
}

# Discover latest Claude model for a provider
# Usage: _discover_latest_model <provider> <model_type>  (model_type: sonnet|haiku|opus)
function _discover_latest_model() {
  local provider="$1"
  local model_type="$2"

  local models
  models=$(opencode models "$provider" 2>/dev/null)
  [[ -z "$models" ]] && return 1

  local filtered_models
  filtered_models=$(echo "$models" | grep -i "$model_type")
  [[ -z "$filtered_models" ]] && return 1

  # Exclude dated variants (-20241022) and -latest aliases
  local base_models
  base_models=$(echo "$filtered_models" | grep -Ev -- '-[0-9]{8}$|-latest$')
  [[ -z "$base_models" ]] && base_models="$filtered_models"

  echo "$base_models" | sort -V | tail -1
}

# Discover the latest active Claude model for a given tier on GitHub Copilot,
# using `opencode models --verbose`'s family/status/release_date metadata
# instead of a plain name sort — a bare version-string sort put "sonnet-4.5"
# ahead of "sonnet-5" and this is exactly the class of bug that left
# claude-sonnet-4.5 hardcoded for months after GitHub removed it from the
# catalog. "-fast" variants share their sibling's release_date but trade
# quality for speed, so they only win a tie, never outrank a newer release.
# Usage: _discover_latest_copilot_claude_model <haiku|sonnet|opus>
# Prints the bare model id (e.g. "claude-opus-5"); returns 1 on any failure
# (network, opencode missing, catalog shape changed) so callers can fall back.
function _discover_latest_copilot_claude_model() {
  local tier="$1"
  local raw
  raw=$(timeout 10 opencode models --verbose github-copilot 2>/dev/null)
  [[ -z "$raw" ]] && return 1

  local script='
import sys, json, re

tier = sys.argv[1]
text = sys.stdin.read()
# opencode prints a bare "provider/model-id" label line before each JSON
# block; strip those so the rest decodes as back-to-back JSON objects.
lines = [l for l in text.splitlines() if not re.match(r"^[\w.-]+/[\w.-]+$", l)]
blob = "\n".join(lines)

decoder = json.JSONDecoder()
models = []
rest = blob
while True:
    rest = rest.lstrip()
    if not rest:
        break
    try:
        obj, idx = decoder.raw_decode(rest)
    except ValueError:
        break
    models.append(obj)
    rest = rest[idx:]

family = "claude-" + tier
candidates = [m for m in models if m.get("family") == family and m.get("status") == "active"]
if not candidates:
    sys.exit(1)

def sort_key(m):
    is_fast = "fast" in m.get("name", "").lower()
    return (m.get("release_date", ""), not is_fast)

print(max(candidates, key=sort_key)["id"])
'
  python3 -c "$script" "$tier" <<< "$raw"
}

# Cached wrapper around _discover_latest_copilot_claude_model — the discovery
# call is a real network round-trip (~1.5s), too slow to pay on every gpc/gpa
# invocation. Refreshes at most once per day per tier; falls back to a stale
# cache (better than nothing) and finally to a hardcoded last-known-good model
# if discovery fails outright (network down, opencode missing, catalog shape
# changed) — this must never be the thing that breaks gpc/gpa.
# Usage: _get_copilot_claude_model <haiku|sonnet|opus>
function _get_copilot_claude_model() {
  local tier="$1"
  local cache_dir="$HOME/.cache/nix-darwin-ai"
  local cache_file="$cache_dir/github-copilot-claude-${tier}.txt"
  local ttl=86400
  local fallback
  case "$tier" in
    haiku) fallback="claude-haiku-4.5" ;;
    opus)  fallback="claude-opus-5" ;;
    *)     fallback="claude-sonnet-5" ;;
  esac

  mkdir -p "$cache_dir" 2>/dev/null

  if [[ -f "$cache_file" ]]; then
    local age=$(( $(date +%s) - $(stat -f %m "$cache_file" 2>/dev/null || echo 0) ))
    if [[ $age -lt $ttl ]]; then
      cat "$cache_file"
      return 0
    fi
  fi

  local discovered
  discovered=$(_discover_latest_copilot_claude_model "$tier" 2>/dev/null)
  if [[ -n "$discovered" ]]; then
    echo "$discovered" > "$cache_file"
    echo "$discovered"
    return 0
  fi

  # Discovery failed: prefer a stale cache over the hardcoded fallback.
  if [[ -f "$cache_file" ]]; then
    cat "$cache_file"
  else
    echo "$fallback"
  fi
}

# Returns a human-readable provider name with proper capitalisation.
function _provider_display_name() {
  case "$1" in
    claude-code)    echo "Anthropic" ;;
    github-copilot) echo "GitHub Copilot" ;;
    opencode)       echo "OpenCode" ;;
    llama-cpp)      echo "llama.cpp" ;;
    *)              echo "$1" ;;
  esac
}

# Returns the model tier display string (with version numbers) for a provider.
# Usage: _model_tier_display <provider>
function _model_tier_display() {
  local provider="${1:-$(_get_ai_provider)}"
  
  case "$provider" in
    claude-code|github-copilot)
      # Built from live/cached discovery (_get_copilot_claude_model), not a
      # version string typed into this file — that's what let claude-sonnet-4.5
      # sit here silently for months after GitHub retired it.
      local h="${$(_get_copilot_claude_model haiku)#claude-haiku-}"
      local s="${$(_get_copilot_claude_model sonnet)#claude-sonnet-}"
      local o="${$(_get_copilot_claude_model opus)#claude-opus-}"
      local suffix=""
      [[ "$provider" == "claude-code" ]] && suffix=" (Copilot)"
      echo "🟢 Haiku ${h}${suffix} | 🔵 Sonnet ${s}${suffix} | 🔴 Opus ${o}${suffix}"
      ;;
    opencode)
      # Check if using a free model
      if _is_opencode_free_model; then
        local model=$(_get_current_opencode_model)
        local model_name="${model#opencode/}"
        # Capitalize first letter and replace hyphens with spaces
        model_name=$(echo "$model_name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')
        echo "⚪ $model_name (Free)"
      else
        echo "🟢 Haiku 4.5 | 🔵 Sonnet 4.6 | 🔴 Opus 4.7"
      fi
      ;;
    llama-cpp|llama.cpp)
      echo "⚪ $(_llamacpp_model_short) (local)"
      ;;
    *)
      echo "🟢 Haiku | 🔵 Sonnet | 🔴 Opus"
      ;;
  esac
}

function _get_opencode_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)

  # Special case: OpenCode with free model - always return the configured free model
  if [[ "$provider" == "opencode" ]] && _is_opencode_free_model; then
    _get_current_opencode_model
    return 0
  fi

  # Special case: llama.cpp - always return the local model
  if [[ "$provider" == "llama-cpp" ]] || [[ "$provider" == "llama.cpp" ]]; then
    echo "llama.cpp/local-coder"
    return 0
  fi

  # GitHub Copilot: skip auto-discovery (4.6 listed but not actually supported)
  # Claude Code: skip auto-discovery — all tiers route via Copilot, never Anthropic directly
  if [[ "$provider" != "github-copilot" ]] && [[ "$provider" != "claude-code" ]]; then
    local model=""
    if [[ "$task_type" == "haiku" ]]; then
      model=$(_discover_latest_model "$provider" "haiku")
    elif [[ "$task_type" == "opus" ]]; then
      model=$(_discover_latest_model "$provider" "opus")
    else
      model=$(_discover_latest_model "$provider" "sonnet")
    fi
    if [[ -n "$model" ]]; then
      echo "$model"
      return 0
    fi
  fi

  case $provider in
    github-copilot)
      # Always the latest active model per tier (cached ~1 day) — see
      # _get_copilot_claude_model. A hardcoded version string is exactly what
      # left claude-sonnet-4.5 in place for months after GitHub retired it.
      echo "github-copilot/$(_get_copilot_claude_model "$task_type")"
      ;;
    opencode)
      # OpenCode Zen: Use latest available Claude models with hyphens (claude-haiku-4-5)
      # Note: Models available via API but may not appear in `opencode models` due to CLI bug
      if [[ "$task_type" == "haiku" ]]; then
        echo "opencode/claude-haiku-4-5"
      elif [[ "$task_type" == "opus" ]]; then
        # Latest Opus: 4.7 > 4.6 > 4.5
        echo "opencode/claude-opus-4-7"
      else
        # Latest Sonnet: 4.6 > 4.5 > 4
        echo "opencode/claude-sonnet-4-6"
      fi
      ;;
    claude-code)
      # All tiers route via GitHub Copilot, never Anthropic directly — the
      # user's Anthropic/Claude Code quota is reserved for the interactive
      # Claude Code session, not consumed by git-helper automation. Always
      # the latest active model per tier — see _get_copilot_claude_model.
      echo "github-copilot/$(_get_copilot_claude_model "$task_type")"
      ;;
    llama-cpp|llama.cpp)
      echo "llama.cpp/local-coder"
      ;;
    *)
      echo "github-copilot/$(_get_copilot_claude_model sonnet)"
      ;;
  esac
}

# Check if the current OpenCode Zen model is a free tier model
# Returns 0 (true) if free model, 1 (false) if Claude/paid model
function _is_opencode_free_model() {
  local provider=$(_get_ai_provider)
  [[ "$provider" != "opencode" ]] && return 1
  
  local config_file="$HOME/.config/opencode/opencode.json"
  [[ ! -f "$config_file" ]] && return 1
  
  local model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
  [[ -z "$model" ]] && return 1
  
  # OpenCode Zen suffixes every free-tier model id with "-free", except its
  # rotating stealth model "big-pickle" -- matched by suffix instead of a
  # hardcoded id whitelist because the free roster rotates: ids that used to
  # be here (deepseek-v4-flash-free, minimax-m2.5-free/m2.7-free,
  # nemotron-3-super-free, qwen3.6-plus-free) are gone from the catalog as
  # of 2026-09-29, replaced by a different set. A whitelist goes stale
  # silently; a suffix match self-adapts.
  case "$model" in
    opencode/big-pickle|opencode/*-free)
      return 0  # Is a free model
      ;;
    *)
      return 1  # Is a Claude/paid model
      ;;
  esac
}

# Discover free-tier (cost 0) OpenCode Zen models that support tool calls
# (required for the agentic edit/bash loop) and pick the best one for a
# coding agent. Prefers "big-pickle" when present and active -- Zen's own
# stealth model, purpose-built for coding agents and reported to punch above
# its weight in independent agentic-coding tests, vs. general-purpose free
# models like Space Bunny that benchmark better for code *review* than for
# driving an edit/bash tool loop. Falls back to the most recently released
# free+toolcall model otherwise, since the models.dev catalog carries no
# benchmark field to rank on directly.
# Prints a bare model id (e.g. "big-pickle"); returns 1 on any failure
# (network, opencode missing, catalog shape changed) so callers fall back.
function _discover_best_free_zen_model() {
  local raw
  raw=$(timeout 15 opencode models --verbose opencode 2>/dev/null)
  [[ -z "$raw" ]] && return 1

  local script='
import sys, json, re

text = sys.stdin.read()
lines = [l for l in text.splitlines() if not re.match(r"^[\w.-]+/[\w.-]+$", l)]
blob = "\n".join(lines)

decoder = json.JSONDecoder()
models = []
rest = blob
while True:
    rest = rest.lstrip()
    if not rest:
        break
    try:
        obj, idx = decoder.raw_decode(rest)
    except ValueError:
        break
    models.append(obj)
    rest = rest[idx:]

free = [
    m for m in models
    if m.get("status") == "active"
    and m.get("cost", {}).get("input") == 0
    and m.get("cost", {}).get("output") == 0
    and m.get("capabilities", {}).get("toolcall")
]
if not free:
    sys.exit(1)

pickle = [m for m in free if m["id"] == "big-pickle"]
best = pickle[0] if pickle else max(free, key=lambda m: m.get("release_date", ""))
print(best["id"])
'
  python3 -c "$script" <<< "$raw"
}

# Cached wrapper around _discover_best_free_zen_model -- same pattern as
# _get_copilot_claude_model. Refreshes at most once a day; falls back to a
# stale cache, then to the hardcoded "big-pickle" fallback, if discovery
# fails outright.
# Usage: _get_free_zen_model
function _get_free_zen_model() {
  local cache_dir="$HOME/.cache/nix-darwin-ai"
  local cache_file="$cache_dir/opencode-zen-free.txt"
  local ttl=86400
  local fallback="big-pickle"

  mkdir -p "$cache_dir" 2>/dev/null

  if [[ -f "$cache_file" ]]; then
    local age=$(( $(date +%s) - $(stat -f %m "$cache_file" 2>/dev/null || echo 0) ))
    if [[ $age -lt $ttl ]]; then
      cat "$cache_file"
      return 0
    fi
  fi

  local discovered
  discovered=$(_discover_best_free_zen_model 2>/dev/null)
  if [[ -n "$discovered" ]]; then
    echo "$discovered" > "$cache_file"
    echo "$discovered"
    return 0
  fi

  # Discovery failed: prefer a stale cache over the hardcoded fallback.
  if [[ -f "$cache_file" ]]; then
    cat "$cache_file"
  else
    echo "$fallback"
  fi
}

# Get the current OpenCode model from config
# Returns the model string or empty if not found
function _get_current_opencode_model() {
  local provider=$(_get_ai_provider)
  [[ "$provider" != "opencode" ]] && return 1
  
  local config_file="$HOME/.config/opencode/opencode.json"
  [[ ! -f "$config_file" ]] && return 1
  
  jq -r '.model // empty' "$config_file" 2>/dev/null
}

# Check if provider supports multiple model tiers (Haiku/Sonnet/Opus)
# Returns 0 if multi-tier support available, 1 if single model only
function _supports_multi_tier() {
  local provider=$(_get_ai_provider)
  
  case "$provider" in
    claude-code|github-copilot)
      return 0  # Both support Haiku/Sonnet/Opus (all routed via GitHub Copilot)
      ;;
    opencode)
      # OpenCode supports multi-tier ONLY if using a Claude model (not free)
      _is_opencode_free_model && return 1 || return 0
      ;;
    llama-cpp|llama.cpp)
      return 1  # Single model only
      ;;
    *)
      return 1  # Unknown provider, assume single model
      ;;
  esac
}

# Check if provider supports Opus tier
# Returns 0 if Opus available, 1 if not
function _supports_opus() {
  local provider=$(_get_ai_provider)
  
  case "$provider" in
    claude-code)
      return 0  # Claude Code supports Opus (routed via GitHub Copilot, not Anthropic directly)
      ;;
    github-copilot)
      return 0  # Opus (4.7/4.7-fast/4.8/4.8-fast/5) confirmed available 2026-09-16
      ;;
    opencode)
      # OpenCode Zen supports Opus only with Claude models
      _is_opencode_free_model && return 1 || return 0
      ;;
    *)
      return 1  # Default: no Opus
      ;;
  esac
}

# AI Command Execution Functions

# `opencode run` is one-shot/headless: it never emits a session.idle event and
# (contrary to an earlier assumption) doesn't reliably fire a
# server.instance.disposed plugin event either. herdr's opencode plugin
# (.config/opencode/plugins/herdr-agent-state.js) registered a session for it
# on startup, but there's no TUI session to return to once the process exits,
# so release the agent registration entirely instead of leaving a stale/idle
# entry behind. Call this right after every `opencode run` invocation.
function _herdr_report_opencode_idle() {
  [[ -z "$HERDR_PANE_ID" || -z "$HERDR_SOCKET_PATH" ]] && return 0
  command -v herdr &>/dev/null || return 0
  herdr pane release-agent "$HERDR_PANE_ID" --source herdr:opencode --agent opencode --seq "$(($(date +%s) * 1000000))" >/dev/null 2>&1
}

# Strips Aider's own chrome (version/model/repo banner, the trailing
# "Tokens: N sent, M received." line), a leaked <think>...</think> block, and
# a markdown code fence wrapping the answer -- GLM in particular wraps JSON
# responses in ```json ... ```, the same fence-stripping gpc/gpa's old
# direct-curl path already needed.
#
# The <think> strip is needed despite model-settings.yml's
# chat_template_kwargs.enable_thinking=false: on the currently loaded model
# (GLM-4.7-Flash via llama-server --reasoning-format none) that setting does
# not stop the block from appearing in the response content -- only removing
# it from a separate reasoning_content field would, and this server config
# doesn't split it out. Verified live: every local-coder-plan/-judge call so
# far has emitted one. The second rule (no closing tag) covers a thinking
# block truncated by max_tokens before it could close -- nothing after an
# unclosed <think> is a usable answer either.
function _aider_extract_response() {
  perl -0777 -pe '
    s/^Warning:.*\n//mg;
    s/^You can skip this check.*\n//mg;
    s/^https:\/\/aider\.chat.*\n//mg;
    s/^Aider v.*\n//mg;
    s/^Model: .*\n//mg;
    s/^Git repo:.*\n//mg;
    s/^Repo-map:.*\n//mg;
    s/^Added .* to the chat.*\n//mg;
    s/^Tokens: .* sent, .* received\.\s*\n?//mg;
    s/<think>.*?<\/think>\s*//is;
    s/<think>.*$//is;
    s/^\s*```(?:json)?\s*\n//;
    s/\n?```\s*$//;
    s/^\s+//;
    s/\s+$//;
  '
}

# Runs a one-shot, read-only (--chat-mode ask, no file attached, no git
# operations) Aider query against the local llama-server and prints the
# model's cleaned text response. The prompt is passed as the message body,
# not a --read file, matching how gpc/gpa already embed the diff directly in
# the prompt text rather than pointing at a file on disk.
#
# Usage: _run_aider_local <model-alias> <timeout-seconds> <prompt>
# Returns: 0 on success (stdout = cleaned response), 1 on failure (stderr =
# error message matching the same "timeout"/"not reachable" wording the old
# direct-curl branches used, since gpc/gpa's own retry loop greps for those).
function _run_aider_local() {
  local model_alias="$1"
  local timeout_secs="$2"
  local prompt="$3"
  local endpoint="${LLAMA_CPP_HOST:-http://macminim1.rollet.family:8080}"
  local settings_file="$HOME/.config/aider/model-settings.yml"

  if ! command -v aider &>/dev/null; then
    echo "Error: aider not installed" >&2
    return 1
  fi

  local raw_output
  raw_output=$(timeout "${timeout_secs}s" aider \
    --model "openai/$model_alias" \
    --openai-api-base "${endpoint}/v1" \
    --openai-api-key "sk-local" \
    --model-settings-file "$settings_file" \
    --no-git \
    --yes-always \
    --chat-mode ask \
    --no-pretty \
    --no-check-update \
    --no-analytics \
    --no-show-model-warnings \
    --no-detect-urls \
    --input-history-file /tmp/.aider-local-input-history \
    --chat-history-file /tmp/.aider-local-chat-history.md \
    --message "$prompt" 2>&1)
  local exit_code=$?

  if [ $exit_code -eq 124 ]; then
    echo "Error: llama-server timeout after ${timeout_secs}s" >&2
    return 1
  elif [ $exit_code -ne 0 ]; then
    if echo "$raw_output" | grep -qi "connection\|connect\|refused"; then
      echo "Error: llama-server not reachable (is llama-server running?)" >&2
    else
      echo "Error: aider failed (exit code: $exit_code): $raw_output" >&2
    fi
    return 1
  fi

  local extracted=$(echo "$raw_output" | _aider_extract_response)
  if [[ -n "$extracted" ]]; then
    echo "$extracted"
    return 0
  fi

  echo "Error: aider returned empty response" >&2
  return 1
}


# Execute AI command with plain text output (for commit messages, etc.)
# Usage: echo "prompt" | _run_ai_plain ["haiku"|"sonnet"|"opus"]
function _run_ai_plain() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      echo "$result"
      return 0
      ;;

    opencode)
      # Use OpenCode CLI for all opencode provider requests
      # This handles authentication and API endpoints correctly
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      echo "$result"
      return 0
      ;;
      
    claude-code)
      # All tiers route via opencode+Copilot — never claude --print — so this
      # never touches the Anthropic API directly. _get_opencode_model always
      # returns a github-copilot/* model for this provider (see above); the
      # direct-Anthropic branch this used to have for the opus tier is gone
      # on purpose, not an oversight.
      local result exit_code
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      exit_code=$?
      _herdr_report_opencode_idle
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      echo "$result"
      return 0
      ;;

    llama-cpp)
      # Truncate prompt to ~6000 chars to keep it fast for plain-text tasks
      # (commit messages only need a representative sample of the diff)
      local truncated_prompt="${prompt:0:6000}"
      local prompt_len=${#prompt}
      if [ $prompt_len -gt 6000 ]; then
        truncated_prompt="${truncated_prompt}
... [diff truncated at 6000 chars for speed — ${prompt_len} total]"
      fi

      # Routed through Aider instead of a direct curl call -- Aider handles
      # response extraction robustly (its own --chat-mode ask flow), so this
      # replaces what used to be a hand-rolled curl+jq+perl chain here (raw
      # newline JSON parsing, <think> block stripping, markdown fence
      # stripping all lived in this branch and each had its own real bug
      # fixed earlier). The chat_template_kwargs.enable_thinking=false fix is
      # preserved via .config/aider/model-settings.yml's openai/local-coder-commit
      # entry instead of being inlined in the request body here.
      _run_aider_local "local-coder-commit" 60 "$truncated_prompt"
      return $?
      ;;


    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# Execute AI command with direct API call (returns JSON array)
# Usage: echo "prompt" | _run_ai_direct ["haiku"|"sonnet"|"opus"]
function _run_ai_direct() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    github-copilot)
      local model_name="$model"
      local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include:
- Any conversational text before the JSON
- Any explanations after the JSON
- Any markdown code blocks or backticks
- Any commentary or notes

Your entire response must be valid JSON starting with [ and ending with ].
If there are no issues to report, respond with exactly: []

Example of CORRECT response format:
[{\"file\":\"example.tf\",\"severity\":\"Critical\",\"issue\":\"Hardcoded secret\",\"recommendation\":\"Use variable\"}]

Example of INCORRECT response (DO NOT DO THIS):
Here are the issues I found:
\`\`\`json
[{...}]
\`\`\`
Let me know if you need anything else!

START YOUR RESPONSE NOW WITH [ OR []:"

      local result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model_name" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle

      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        if [[ -n "$result" ]]; then
          echo "Output: $(echo "$result" | head -c 200)" >&2
        fi
        return 1
      fi

      # Extract JSON more efficiently - single strategy that handles most cases
      if [[ -n "$result" ]]; then
        # Strategy: Extract from first [ to last ] (handles wrapped JSON)
        local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)

        # Validate it's proper JSON
        if echo "$extracted" | jq empty 2>/dev/null; then
          echo "$extracted"
          return 0
        fi

        # Soft failure: Could not parse response
        # Exit code 2 = unparseable output (user should be warned)
        echo "Error: Could not parse AI response as JSON" >&2
        echo "[]"
        return 2
      fi

      echo "Error: OpenCode returned empty response" >&2
      return 1
      ;;

    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local model_name="$model"
      local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include:
- Any conversational text before the JSON
- Any explanations after the JSON  
- Any markdown code blocks or backticks
- Any commentary or notes

Your entire response must be valid JSON starting with [ and ending with ].
If there are no issues to report, respond with exactly: []
"
      
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode failed (exit $exit_code)" >&2
        return 1
      fi
      
      # Extract JSON array from response
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      if echo "$extracted" | jq empty 2>/dev/null; then
        echo "$extracted"
        return 0
      fi
      
      echo "[]"
      return 2
      ;;
      
    llama-cpp)
      # Truncate prompt to ~4000 chars (~1000 tokens) to keep prompt processing
      # reasonable -- this controls INPUT size, independent of the generous
      # output max_tokens (4096, see .config/aider/model-settings.yml's
      # openai/local-coder-review entry) gpa's security review wants for
      # thorough multi-finding output.
      local truncated_prompt="${prompt:0:4000}"
      local prompt_len=${#prompt}
      if [ $prompt_len -gt 4000 ]; then
        truncated_prompt="${truncated_prompt}
... [diff truncated at 4000 chars — ${prompt_len} total]"
      fi

      # Routed through Aider instead of a direct curl call -- see the matching
      # comment in _run_ai_plain's llama-cpp branch. 240s (not the old 90s,
      # calibrated for a much smaller/faster 7B model on remote hardware):
      # measured live against GLM-4.7-Flash locally, a ~1.6k-token review
      # prompt took 191s end to end.
      local aider_output
      aider_output=$(_run_aider_local "local-coder-review" 240 "$truncated_prompt")
      local aider_exit=$?
      if [ $aider_exit -ne 0 ]; then
        echo "$aider_output" >&2
        return 1
      fi

      # Extract JSON array from the response (same strategy as the other
      # provider branches) -- _run_aider_local already stripped Aider's own
      # chrome and any markdown fence, but the array-extraction regex stays
      # as a safety net in case the model wraps the array in stray prose.
      local json_extracted=$(echo "$aider_output" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      if echo "$json_extracted" | jq empty 2>/dev/null; then
        echo "$json_extracted"
        return 0
      fi

      # Soft failure: response not parseable as JSON
      echo "Error: Could not parse aider response as JSON" >&2
      echo "[]"
      return 2
      ;;


    claude-code)
      local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include:
- Any conversational text before the JSON
- Any explanations after the JSON
- Any markdown code blocks or backticks
- Any commentary or notes

Your entire response must be valid JSON starting with [ and ending with ].
If there are no issues to report, respond with exactly: []

Example of CORRECT response format:
[{\"file\":\"example.tf\",\"severity\":\"Critical\",\"issue\":\"Hardcoded secret\",\"recommendation\":\"Use variable\"}]

START YOUR RESPONSE NOW WITH [ OR []:"

      # All tiers route via opencode+Copilot — never claude --print — so this
      # never touches the Anthropic API directly. _get_opencode_model always
      # returns a github-copilot/* model for this provider (see above); the
      # direct-Anthropic branch this used to have for the opus tier is gone
      # on purpose, not an oversight.
      local result exit_code
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      exit_code=$?
      _herdr_report_opencode_idle
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      if echo "$extracted" | jq empty 2>/dev/null; then
        echo "$extracted"
        return 0
      fi
      echo "Error: Could not parse AI response as JSON" >&2
      echo "[]"
      return 2
      ;;

    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# Execute AI command via OpenCode agent (full agent capabilities, slower)
# Usage: echo "prompt" | _run_ai_agent ["haiku"|"sonnet"|"opus"]
function _run_ai_agent() {
  local task_type="${1:-sonnet}"
  local model=$(_get_opencode_model "$task_type")
  local prompt=$(cat)
  opencode run --model "$model" "$prompt"
}

function _run_ai_command() {
  _run_ai_direct "$@"
}

function _get_ai_command() {
  local task_type="${1:-sonnet}"
  echo "_run_ai_direct $task_type"
}
# aistack -- tiered cost-escalation coding stack with a real supervisor.
#
# Tier 0: llama.cpp, via aider (--chat-mode ask, read-only, no edit tools).
#   Plans once at the start, then re-judges tier 1's progress after every
#   iteration. Tier 0 never edits the workspace itself -- it only plans and
#   monitors. (Earlier draft ran tier 0 through `opencode run` in full agent
#   mode; that deadlocked for 600s on a trivial prompt because the agent-mode
#   system/tool-schema prompt is expensive to prefill on this local model.
#   aider's ask-mode calls are the same path gpc/gpa already use for local-
#   model commit messages and reviews, and are proven fast.)
# Tier 1: OpenCode Zen free tier -- model opencode/$(_get_free_zen_model),
#   currently big-pickle. Does the actual editing, iteratively, under tier
#   0's supervision.
# Tier 2: Claude, via GitHub Copilot -- model
#   github-copilot/$(_get_copilot_claude_model sonnet), same routing
#   convention as every other "claude-code" invocation in this file. Last
#   resort, single attempt.
#
# Flow:
#   1. Tier 0 plans (local-coder-plan): produces the directive tier 1 works
#      from. If tier 0 itself fails to respond, the raw task is used as the
#      directive instead -- planning failure degrades gracefully, it doesn't
#      block the pipeline.
#   2. Tier 1 runs the directive through `opencode run --auto` (full agent
#      mode -- edit/write/bash tools). --auto is required: this repo's
#      opencode.json has edit/write permission set to "ask", which in
#      headless mode auto-REJECTS every edit/write call with no error --
#      confirmed live, a plain `opencode run` here cannot touch a single
#      file. --auto approves anything not explicitly denied; the deny rules
#      in opencode.json's permission.bash block (rm -rf /, mkfs, etc) still
#      apply regardless of --auto.
#   3. After each iteration, tier 0 judges (local-coder-judge): given the
#      task, the directive, tier 1's latest output, and a `git diff --stat`
#      snapshot, it returns one of progressing/stuck/done/regressing. `done`
#      ends the run successfully. `stuck`/`regressing` two checkpoints in a
#      row (not just once -- a single bad checkpoint is noise) escalates to
#      tier 2. If the judge call itself fails, that fails open as
#      "progressing" -- an infra hiccup in the monitor isn't a reason to burn
#      the paid tier.
#   4. Tier 1 gets at most 3 iterations total; exhausting them without a
#      `done` verdict also escalates to tier 2.
#   5. Any hard-failure signal (timeout, non-zero exit, a known rate-limit/
#      quota/403 string) at tier 1 escalates immediately, no retry, no wait
#      for the next judge checkpoint -- these are infrastructure failures,
#      not quality judgments the judge is positioned to make.
#   6. Tier 2 gets the full history (task, directive, tier 1's last output,
#      escalation reason) and one attempt. Same hard-failure check applies;
#      if it also fails there is nowhere further to go.
#
# What this deliberately does not do (v1 scope, not a bug):
#   - No spend cap on the tier 2 attempt -- only its wall-clock timeout
#     bounds it.
#   - Tier 0 never edits, even if it judges itself capable of the whole task
#     in one step -- every task goes through at least one tier-1 iteration.
#     A future version could let tier 0 short-circuit trivial tasks; this one
#     always delegates.
#
# Every stage (plan, each tier-1 attempt, each judge verdict, the tier-2
# attempt) is logged to ~/.cache/nix-darwin-ai/aistack-log.jsonl.
#
# Usage: aistack "<task description>"
function aistack_func() {
  # Defensively local-scope xtrace off, matching gpc_func's guard (see
  # .zshrc_functions_git) for the same symptom class -- harmless either way.
  # It did NOT fix the actual issue: a stray dump of this function's own
  # local variables (plan_prompt=, plan_output=, plan_exit=) still leaks into
  # stdout on the second loop iteration of the plan-approval loop, verified
  # live with this guard in place. It carries no `+file:line>` prefix, so it
  # is probably not zsh xtrace at all despite the resemblance; root cause
  # unconfirmed. Left in place as a real, open, cosmetic issue -- it has not
  # affected correctness in any live run so far (output, ledger, and return
  # code have all been right regardless), so it's not blocking, but do not
  # claim it is fixed.
  local prev_opts=$-
  setopt local_options
  [[ $prev_opts == *x* ]] && setopt no_xtrace

  # Task is optional: run bare `aistack` with no argument and describe the
  # task live in the chat instead -- tier 0 is already a live conversation,
  # so requiring it as a shell arg up front was redundant with that.
  local task="$1"

  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)

  local cache_dir="$HOME/.cache/nix-darwin-ai"
  mkdir -p "$cache_dir" 2>/dev/null
  local ledger="$cache_dir/aistack-log.jsonl"

  local hard_fail_re='rate.?limit|http.?429|freetiererror|can only be used from within opencode|usage cap|quota exceeded|http.?403'

  _aistack_log() {
    jq -nc --arg ts "$(date -u +%FT%TZ)" "$@" '{ts:$ts} + $ARGS.named' 2>/dev/null >> "$ledger"
  }

  # ---- Tier 0: plan, live and interactively ----
  # Drops into a real interactive `aider` session against llama.cpp -- same
  # backend/model as the headless local-coder-plan calls, just live: you
  # talk it through with the model instead of getting one scripted round.
  # --chat-mode ask keeps it read-only (consistent with tier 0 never editing
  # anywhere else in this pipeline), but is otherwise a normal aider chat --
  # push back, ask it to reconsider, whatever; there is no menu.
  #
  # aider's --message forces a one-shot non-interactive send, so it can't
  # also seed the chat and then stay interactive -- the task/pipeline
  # context is printed to the terminal instead, and the first real message
  # is typed by hand.
  #
  # The hand-off doesn't need tier 0 to have write-tool access: aider
  # already logs the conversation to --chat-history-file as a side effect of
  # chatting, in ask mode same as any other. When you exit (Ctrl-D or
  # /exit), the LAST assistant reply in that file becomes tier 1's
  # directive. Exiting before getting a reply you're happy with -- or before
  # chatting at all -- aborts; no tiers run.
  #
  # If a task was given, it's seeded into the model's actual context via
  # --read, not just printed to the terminal: printing alone only tells the
  # human, and verified live, a human reply that doesn't restate the task
  # produces a generic answer disconnected from it -- tier 1 went and
  # explored the repo instead of creating the requested file, on a
  # directive that said "analyze the provided code" with no code ever
  # having been provided. --read makes the task part of the model's context
  # from the first turn regardless of what's typed. With no task given,
  # the seed instead tells the model to ask what you want done.
  local endpoint="${LLAMA_CPP_HOST:-http://macminim1.rollet.family:8080}"
  local settings_file="$HOME/.config/aider/model-settings.yml"
  local chat_history_file="$cache_dir/aistack-plan-chat-$$.md"
  local seed_file="$cache_dir/aistack-plan-seed-$$.md"
  rm -f "$chat_history_file" "$seed_file"

  if ! command -v aider &>/dev/null; then
    echo "✗ aider not installed -- cannot run tier 0's interactive planning session." >&2
    unset -f _aistack_log
    return 1
  fi

  local task_section
  if [[ -n "$task" ]]; then
    task_section="## Task

$task"
  else
    task_section="## Task

Not given yet -- ask the user what they'd like done, then help plan it."
  fi

  cat > "$seed_file" <<SEEDEOF
# aistack tier 0 -- planning context

You are the planning/supervising stage of a cost-tiered coding pipeline:
- Tier 0 (you): llama.cpp, local, free. Plan and supervise only, never edit.
- Tier 1: OpenCode Zen's free tier. Does the actual editing.
- Tier 2: Claude via GitHub Copilot. Paid, last resort.

$task_section

Discuss this task with the user and refine a plan together. When they are
happy with it, your LAST reply before they exit should be the final
directive for tier 1: what to do, any constraints, and how to check success.
SEEDEOF

  echo "── Tier 0 (llama-cpp): live planning session -- exit (Ctrl-D or /exit) when you're happy with the plan ──"
  echo ""
  if [[ -n "$task" ]]; then
    echo "TASK: $task"
  else
    echo "No task given -- describe what you want done as your first message below."
  fi
  echo ""
  echo "Talking to llama.cpp. It plans and supervises; OpenCode Zen's free tier"
  echo "does the actual editing; Claude via GitHub Copilot is the paid last"
  echo "resort. Describe the task, push back on its plan, ask it to revise --"
  echo "whatever its last reply says before you exit becomes tier 1's directive."
  echo "(llama.cpp is a slow local model -- after you send a message, a reply can"
  echo "take a while with nothing visible in between. That's normal, not stuck.)"
  echo ""

  # Inside a repo, let aider see it: dropping --no-git gets a real repo-map
  # (structure/symbols, auto-built by aider, no --read needed for it) instead
  # of tier 0 answering repo questions from the task text alone. Confirmed
  # live without this: asked "what's the purpose of this repo?", it guessed
  # from the directory name in the question and falsely claimed the guess
  # came from the attached seed file, which has no repo content at all.
  # Outside a repo there's nothing to map, so --no-git stays (also avoids
  # aider searching upward for an enclosing repo it shouldn't touch).
  #
  # --map-tokens raised from aider's 1024 default: confirmed live on a real
  # 222-file repo, 1024 tokens wasn't enough for the map to include the root
  # flake.nix at all, and tier 0 confidently answered "no Nix profiles
  # present" in a repo that's entirely Nix config. 2048 is aider's own
  # documented ceiling ("map-tokens > 2048 is not recommended -- too much
  # irrelevant code can confuse LLMs", seen live when this was set to 4096)
  # -- not a measured minimum, just the most aider itself endorses.
  local -a git_flags
  if [[ -n "$repo_root" ]]; then
    git_flags=(--map-tokens 2048)
    echo "Repo-aware: $repo_root"
  else
    git_flags=(--no-git)
    echo "No repo detected in the current directory -- tier 0 has no repo context."
  fi
  echo ""

  aider \
    --model "openai/local-coder-plan" \
    --openai-api-base "${endpoint}/v1" \
    --openai-api-key "sk-local" \
    --model-settings-file "$settings_file" \
    "${git_flags[@]}" \
    --chat-mode ask \
    --yes-always \
    --no-show-model-warnings \
    --no-check-update \
    --no-analytics \
    --no-detect-urls \
    --read "$seed_file" \
    --chat-history-file "$chat_history_file" \
    --input-history-file /tmp/.aider-local-input-history

  rm -f "$seed_file"

  local directive=""
  if [[ -f "$chat_history_file" ]]; then
    local last_reply
    last_reply=$(perl -ne '
      if (/^#### /) { $collecting = 0; @buf = (); next; }
      if (/^> Tokens:/) { $collecting = 0; next; }
      $collecting = 1;
      push @buf, $_ if $collecting;
      END { print @buf }
    ' "$chat_history_file")
    directive=$(echo "$last_reply" | _aider_extract_response)
    rm -f "$chat_history_file"
  fi

  if [[ -n "$directive" ]]; then
    # No task was given up front -- the directive agreed live in chat is the
    # closest thing to one now, and later tier1/judge/tier2 prompts all
    # reference $task (e.g. "ORIGINAL TASK: $task"); backfill it rather than
    # leave those blank.
    [[ -z "$task" ]] && task="$directive"
    echo ""
    echo "Directive for tier 1:"
    echo "$directive"
    _aistack_log --arg stage plan --arg mode interactive
  else
    echo "No usable reply captured -- aborting before tier 1."
    _aistack_log --arg stage aborted --arg mode interactive
    unset -f _aistack_log
    return 1
  fi

  # ---- Tier 1: execution loop, monitored by tier 0 ----
  local tier1_model="opencode/$(_get_free_zen_model)"
  local max_iters=3
  local stuck_count=0
  local prompt="$directive"
  local escalate_reason=""
  local t1_output=""
  local iter

  for iter in 1 2 3; do
    echo "── Tier 1 iter $iter/$max_iters (opencode-free): $tier1_model ──"

    local start_ts=$(date +%s)
    local t1_exit
    t1_output=$(timeout 300s opencode run --auto --model "$tier1_model" "$prompt" 2>&1)
    t1_exit=$?
    _herdr_report_opencode_idle
    local elapsed=$(( $(date +%s) - start_ts ))
    echo "$t1_output"

    local hard_reason=""
    if [[ $t1_exit -eq 124 ]]; then
      hard_reason="timeout after 300s"
    elif [[ $t1_exit -ne 0 ]]; then
      hard_reason="exit code $t1_exit"
    elif echo "$t1_output" | grep -qiE "$hard_fail_re"; then
      hard_reason="hard provider failure signal"
    fi

    _aistack_log --arg stage tier1_attempt --argjson iter "$iter" \
      --argjson exit_code "$t1_exit" --argjson elapsed_s "$elapsed" --arg reason "$hard_reason"

    if [[ -n "$hard_reason" ]]; then
      escalate_reason="$hard_reason"
      break
    fi

    # ---- Tier 0: judge this iteration's progress ----
    echo "── Tier 0 (llama-cpp, judging iter $iter) ──"
    local diff_stat=""
    [[ -n "$repo_root" ]] && diff_stat=$(git -C "$repo_root" diff --stat)
    local judge_prompt="You are monitoring a coding agent's progress on a task.

ORIGINAL TASK:
$task

DIRECTIVE GIVEN TO THE CODING AGENT:
$directive

CODING AGENT'S LATEST OUTPUT (iteration $iter of $max_iters):
$t1_output

WORKSPACE DIFF SO FAR:
$diff_stat

Respond with exactly one word first -- progressing, stuck, done, or
regressing -- optionally followed by a one-line reason. Do not write code."
    local judge_output judge_exit
    judge_output=$(_run_aider_local "local-coder-judge" 180 "$judge_prompt" 2>&1)
    judge_exit=$?

    local verdict="progressing"
    if [[ $judge_exit -eq 0 && -n "$judge_output" ]]; then
      verdict=$(echo "$judge_output" | grep -oiE '^(progressing|stuck|done|regressing)' | head -1 | tr 'A-Z' 'a-z')
      [[ -z "$verdict" ]] && verdict="progressing"
    else
      echo "⚠ Tier 0 judge call failed -- failing open as 'progressing'."
    fi
    echo "Tier 0 verdict: $verdict"
    _aistack_log --arg stage judge --argjson iter "$iter" --arg verdict "$verdict" --argjson judge_exit "$judge_exit"

    case "$verdict" in
      done)
        echo "✓ Tier 0 judged the task complete after tier 1 iteration $iter."
        unset -f _aistack_log
        return 0
        ;;
      stuck|regressing)
        stuck_count=$((stuck_count + 1))
        if [[ $stuck_count -ge 2 ]]; then
          escalate_reason="tier 0 judged $verdict for $stuck_count consecutive checkpoints"
          break
        fi
        ;;
      *)
        stuck_count=0
        ;;
    esac

    if [[ $iter -eq $max_iters ]]; then
      escalate_reason="tier 1 exhausted $max_iters iterations without a done verdict"
      break
    fi

    prompt="ORIGINAL TASK:
$task

DIRECTIVE:
$directive

PREVIOUS ATTEMPT (iteration $iter) OUTPUT:
$t1_output

Tier 0's assessment: $verdict. Continue this work. The workspace may
already contain partial changes -- check its current state before relying
on anything above."
  done

  if [[ -z "$escalate_reason" ]]; then
    echo "✓ Tier 1 completed. No escalation triggered."
    unset -f _aistack_log
    return 0
  fi

  # ---- Tier 2: last resort, single attempt ----
  echo "⚠ Escalating to Tier 2 ($escalate_reason)."
  local tier2_model="github-copilot/$(_get_copilot_claude_model sonnet)"
  echo "── Tier 2 (claude-code): $tier2_model ──"
  local handoff_prompt="ORIGINAL TASK:
$task

DIRECTIVE:
$directive

TIER 1'S LAST ATTEMPT ($tier1_model):
$t1_output

Escalation reason: $escalate_reason

Continue this work. The workspace may already contain partial changes from
previous attempts -- check its current state before relying on anything
described above."

  local t2_output t2_exit
  t2_output=$(timeout 300s opencode run --auto --model "$tier2_model" "$handoff_prompt" 2>&1)
  t2_exit=$?
  _herdr_report_opencode_idle
  echo "$t2_output"

  local t2_reason=""
  if [[ $t2_exit -eq 124 ]]; then
    t2_reason="timeout after 300s"
  elif [[ $t2_exit -ne 0 ]]; then
    t2_reason="exit code $t2_exit"
  elif echo "$t2_output" | grep -qiE "$hard_fail_re"; then
    t2_reason="hard provider failure signal"
  fi
  _aistack_log --arg stage tier2_attempt --argjson exit_code "$t2_exit" --arg reason "$t2_reason"
  unset -f _aistack_log

  if [[ -n "$t2_reason" ]]; then
    echo "✗ Tier 2 also triggered a failure signal ($t2_reason) -- no further tier to escalate to."
    return 1
  fi

  echo "✓ Tier 2 completed."
  return 0
}

function aidev() {
  local GREEN='\033[0;32m'
  local NC='\033[0m'

  _ensure_ai_provider || return 1

  local provider=$(_get_ai_provider)

  echo "${GREEN}✓${NC} Provider: $(_provider_display_name "$provider")"

  # Detect -p/--print flag and translate for providers that don't support it.
  # claude uses -p for headless mode; opencode uses `run` as the subcommand.
  local print_mode=false
  local filtered_args=()
  for arg in "$@"; do
    if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
      print_mode=true
    else
      filtered_args+=("$arg")
    fi
  done

  case "$provider" in
    claude-code)
      echo ""
      if $print_mode; then
        claude -p "${filtered_args[@]}"
      else
        claude "${filtered_args[@]}"
      fi
      ;;
    llama-cpp)
      local local_model="llama.cpp/local-coder"
      echo "${GREEN}✓${NC} Model:    ⚪ $(_llamacpp_model_short) → $local_model"
      echo ""
      if $print_mode; then
        opencode --model "$local_model" run "${filtered_args[@]}"
      else
        opencode --model "$local_model" "${filtered_args[@]}"
      fi
      ;;
    github-copilot)
      # GitHub Copilot via OpenCode
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      if $print_mode; then
        opencode --model "$model" run "${filtered_args[@]}"
      else
        opencode --model "$model" "${filtered_args[@]}"
      fi
      ;;
    opencode)
      # OpenCode Zen - check if a specific model is set in opencode.json
      local model=""
      local config_file="$HOME/.config/opencode/opencode.json"
      if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
        model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
      fi
      
      # Fallback to discovering latest Sonnet if no model is set
      if [[ -z "$model" || "$model" == "null" ]]; then
        model=$(_get_opencode_model "sonnet")
      fi
      
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      if $print_mode; then
        opencode --model "$model" run "${filtered_args[@]}"
      else
        opencode --model "$model" "${filtered_args[@]}"
      fi
      ;;
    *)
      # Unknown provider - fall back to github-copilot
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model (fallback)"
      echo ""
      if $print_mode; then
        opencode --model "$model" run "${filtered_args[@]}"
      else
        opencode --model "$model" "${filtered_args[@]}"
      fi
      ;;
  esac
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

function _validate_opencode_zen() {
  [[ -n "$OPENCODE_ZEN_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars_insecure && return 0
  [[ -f ~/.config/opencode/.env ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.config/opencode/.env && return 0
  # Check auth.json for OpenCode Zen API key (injected by nix-darwin activation)
  if [[ -f ~/.local/share/opencode/auth.json ]] && command -v jq &>/dev/null; then
    local opencode_key=$(jq -r '.opencode.key // empty' ~/.local/share/opencode/auth.json 2>/dev/null)
    [[ -n "$opencode_key" ]] && return 0
  fi
  return 1
}

function _llamacpp_model_tier() {
  local ram_bytes ram_gb
  ram_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
  ram_gb=$(( ram_bytes / 1024 / 1024 / 1024 ))
  echo "qwen2.5-coder-7b Q8 (~8 GB, ${ram_gb} GB device)"
}


# Keep in sync with `localModels` in nix-modules/macos/llamacpp-local.nix --
# id must match exactly, label is just for display.
function _llamacpp_local_model_label() {
  case "$1" in
    qwen3-coder-30b-a3b) echo "Qwen3-Coder-30B-A3B" ;;
    devstral-small-2-24b) echo "Devstral-Small-2-24B" ;;
    *)                 echo "$1" ;;
  esac
}

function _llamacpp_model_short() {
  local state_file="$HOME/.config/llama-cpp/selected-model"
  if [[ -f "$state_file" ]]; then
    _llamacpp_local_model_label "$(cat "$state_file")"
    return
  fi
  echo "${LLAMA_CPP_MODEL_LABEL:-Qwen3-Coder-30B-A3B}"
}


function _validate_llamacpp() {
  local endpoint="${LLAMA_CPP_HOST:-http://macminim1.rollet.family:8080}"
  local response
  response=$(curl -s --max-time 3 "${endpoint}/health" 2>/dev/null)
  if echo "$response" | grep -q '"status"'; then
    return 0
  fi
  return 1
}

function _validate_claude_code() {
  command -v claude &>/dev/null || return 1
  # API key auth
  [[ -n "$ANTHROPIC_API_KEY" ]] && return 0
  # OAuth session - use `claude auth status` to check if logged in
  if claude auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    return 0
  fi
  return 1
}

# Check internet connectivity using curl or dig (not ping)
function _is_online() {
  if command -v curl &>/dev/null; then
    curl -sf --max-time 2 --connect-timeout 1 https://1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  if command -v dig &>/dev/null; then
    dig +time=1 +tries=1 @1.1.1.1 cloudflare.com >/dev/null 2>&1 && return 0
  fi
  if command -v ping &>/dev/null; then
    ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  return 1
}

function _get_ai_provider() {
  # gpc-local/gpa-local/gpr-local set this to pin the whole resolution chain
  # to llama-cpp for a run, bypassing session/preference files entirely.
  [[ -n "$AI_LOCAL_ONLY" ]] && echo "llama-cpp" && return 0
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local preference_file="$HOME/.ai_provider_preference"
  [[ -f "$session_file" ]] && cat "$session_file" && return 0
  [[ -f "$preference_file" ]] && cat "$preference_file" && return 0
  _validate_claude_code 2>/dev/null && echo "claude-code" && return 0
  echo "github-copilot"
}

# Dispatch validation to the appropriate provider validator
function _validate_provider() {
  case "$1" in
    claude-code)    _validate_claude_code ;;
    github-copilot) _validate_github_copilot ;;
    opencode)       _validate_opencode_zen ;;
    llama-cpp)      _validate_llamacpp ;;
    *)              return 1 ;;
  esac
}

# Ensure a valid provider is set for this session.
# - No session file: auto-detect silently (no cascade, _get_ai_provider handles it).
# - Session file exists but provider is invalid: re-run aiselect cascade.
function _ensure_ai_provider() {
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local RED='\033[0;31m'
  local NC='\033[0m'
  [[ ! -f "$session_file" ]] && return 0
  local provider
  provider=$(cat "$session_file")
  if _validate_provider "$provider" 2>/dev/null; then
    return 0
  fi
  echo "${RED}✗${NC} Provider '$provider' is no longer valid — re-running aiselect..."
  rm -f "$session_file"
  aiselect
}

# Hybrid routing: llama-cpp → cloud escalation
# gpc/gpr always local; gpa escalates to cloud on critical/security findings
# Cloud provider stored in ~/.ai_cloud_provider_preference (separate from main provider).
# Defaults to github-copilot, not anthropic: git-helper cloud escalation should
# never consume the Anthropic/Claude Code API quota, which is reserved for the
# interactive Claude Code session.
function _get_cloud_fallback_provider() {
  local cloud_pref="$HOME/.ai_cloud_provider_preference"
  if [[ -f "$cloud_pref" ]]; then
    cat "$cloud_pref"
  else
    echo "github-copilot"
  fi
}

function _get_cloud_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)

  case $provider in
    github-copilot)
      echo "github-copilot/$(_get_copilot_claude_model "$task_type")"
      ;;
    opencode)
      [[ "$task_type" == "opus"  ]] && echo "opencode/claude-opus-4.5"        && return
      [[ "$task_type" == "haiku" ]] && echo "opencode/claude-3-5-haiku"        && return
      echo "opencode/claude-sonnet-4.5"
      ;;
    anthropic|*)
      [[ "$task_type" == "opus"  ]] && echo "anthropic/claude-opus-4-5"  && return
      [[ "$task_type" == "haiku" ]] && echo "anthropic/claude-haiku-4-5" && return
      echo "anthropic/claude-sonnet-4-6"
      ;;
  esac
}

# Plain-text AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_plain_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_plain_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: OpenCode timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: OpenCode failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
  esac
}

# Structured-JSON AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_direct_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_direct_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include any text before or after it.
If there are no issues, respond with exactly: []
START YOUR RESPONSE NOW WITH [ OR []:"

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
    opencode)
      # Use OpenCode CLI for all opencode provider requests
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      [ $exit_code -eq 124 ] && { echo "Error: OpenCode timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: OpenCode call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
  esac
}

# Check Claude service status from status.claude.com
# Returns 0 if operational, 1 if there are issues
# Prints status information to stdout
function _check_claude_status() {
  # Use -L to follow redirects
  local status_json=$(curl -sL --max-time 5 https://status.claude.com/api/v2/components.json 2>/dev/null)
  
  # If curl failed or returned empty, assume services are operational (fail open)
  if [[ -z "$status_json" ]] || [[ "$status_json" == *"<html"* ]]; then
    return 0
  fi
  
  # Extract statuses using jq if available, otherwise use grep
  local claude_code_status=""
  local claude_ai_status=""
  local platform_status=""
  
  if command -v jq &>/dev/null; then
    claude_code_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="Claude Code") | .status' 2>/dev/null)
    claude_ai_status=$(echo "$status_json" | jq -r '.components[] | select(.name=="claude.ai") | .status' 2>/dev/null)
    platform_status=$(echo "$status_json" | jq -r '.components[] | select(.name | startswith("platform.claude.com")) | .status' 2>/dev/null)
  else
    # Fallback to grep/sed if jq not available
    claude_code_status=$(echo "$status_json" | grep -o '"name":"Claude Code"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    claude_ai_status=$(echo "$status_json" | grep -o '"name":"claude.ai"[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
    platform_status=$(echo "$status_json" | grep -o '"name":"platform.claude.com[^}]*"status":"[^"]*"' | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
  fi
  
  # Check if any service has issues
  local has_issues=0
  local RED='\033[0;31m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  if [[ "$claude_code_status" == "partial_outage" ]] || [[ "$claude_code_status" == "major_outage" ]] || [[ "$claude_code_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  Claude Code: ${YELLOW}${claude_code_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$claude_ai_status" == "partial_outage" ]] || [[ "$claude_ai_status" == "major_outage" ]] || [[ "$claude_ai_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  claude.ai: ${YELLOW}${claude_ai_status}${NC}"
    has_issues=1
  fi
  
  if [[ "$platform_status" == "partial_outage" ]] || [[ "$platform_status" == "major_outage" ]] || [[ "$platform_status" == "degraded_performance" ]]; then
    echo "  ${RED}⚠${NC}  platform.claude.com: ${YELLOW}${platform_status}${NC}"
    has_issues=1
  fi
  
  if [[ $has_issues -eq 1 ]]; then
    echo "  ${YELLOW}ℹ${NC}  Auth may fail due to service issues. Check https://status.claude.com"
    return 1
  fi
  
  return 0
}

