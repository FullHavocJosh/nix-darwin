# Secrets: ~/.zshrc_envvars (git-ignored, chmod 600)
# Non-sensitive config: ~/.zshrc_envvars_insecure (tracked by git)

# Helper function: Clean OpenCode CLI output by removing ANSI codes and prompts
# Usage: _clean_opencode_output <output>
function _clean_opencode_output() {
  local output="$1"
  # Strip ANSI escape codes (use perl for better escape sequence handling)
  output=$(echo "$output" | perl -pe 's/\e\[[0-9;]*m//g')
  # Remove OpenCode CLI prompt lines (e.g., "> build · claude-haiku-4.5")
  # and extract only content lines (non-empty, non-prompt)
  output=$(echo "$output" | grep -v '^> ' | grep -v '^[[:space:]]*$')
  echo "$output"
}

# Read a single keypress into the named variable.
# After ESC, drains any buffered ANSI escape-sequence tail (e.g. ESC [ from
# arrow keys) so the next read is not poisoned by leftover bytes.
function _read_key() {
  # Reads one keypress into the global _KEY.
  # If ESC is pressed, drains any buffered ANSI tail bytes (e.g. ESC [ from
  # arrow keys) so subsequent reads are not poisoned by leftover input.
  read -k1 _KEY
  if [[ "$_KEY" == $'\e' ]]; then
    local _drain
    read -k10 -t 0.1 _drain 2>/dev/null || true
  fi
}

# Discover latest Claude model for a provider
# Usage: _discover_latest_model <provider> <model_type>  (model_type: sonnet|haiku|opus)
function _discover_latest_model() {
  local provider="$1"
  local model_type="$2"

  local models
  models=$(opencode models "$provider" 2>/dev/null)
  [[ -z "$models" ]] && return 1

  local filtered_models
  filtered_models=$(echo "$models" | grep -i "$model_type")
  [[ -z "$filtered_models" ]] && return 1

  # Exclude dated variants (-20241022) and -latest aliases
  local base_models
  base_models=$(echo "$filtered_models" | grep -Ev -- '-[0-9]{8}$|-latest$')
  [[ -z "$base_models" ]] && base_models="$filtered_models"

  echo "$base_models" | sort -V | tail -1
}

# Discover the latest active Claude model for a given tier on GitHub Copilot,
# using `opencode models --verbose`'s family/status/release_date metadata
# instead of a plain name sort — a bare version-string sort put "sonnet-4.5"
# ahead of "sonnet-5" and this is exactly the class of bug that left
# claude-sonnet-4.5 hardcoded for months after GitHub removed it from the
# catalog. "-fast" variants share their sibling's release_date but trade
# quality for speed, so they only win a tie, never outrank a newer release.
# Usage: _discover_latest_copilot_claude_model <haiku|sonnet|opus>
# Prints the bare model id (e.g. "claude-opus-5"); returns 1 on any failure
# (network, opencode missing, catalog shape changed) so callers can fall back.
function _discover_latest_copilot_claude_model() {
  local tier="$1"
  local raw
  raw=$(timeout 10 opencode models --verbose github-copilot 2>/dev/null)
  [[ -z "$raw" ]] && return 1

  local script='
import sys, json, re

tier = sys.argv[1]
text = sys.stdin.read()
# opencode prints a bare "provider/model-id" label line before each JSON
# block; strip those so the rest decodes as back-to-back JSON objects.
lines = [l for l in text.splitlines() if not re.match(r"^[\w.-]+/[\w.-]+$", l)]
blob = "\n".join(lines)

decoder = json.JSONDecoder()
models = []
rest = blob
while True:
    rest = rest.lstrip()
    if not rest:
        break
    try:
        obj, idx = decoder.raw_decode(rest)
    except ValueError:
        break
    models.append(obj)
    rest = rest[idx:]

family = "claude-" + tier
candidates = [m for m in models if m.get("family") == family and m.get("status") == "active"]
if not candidates:
    sys.exit(1)

def sort_key(m):
    is_fast = "fast" in m.get("name", "").lower()
    return (m.get("release_date", ""), not is_fast)

print(max(candidates, key=sort_key)["id"])
'
  python3 -c "$script" "$tier" <<< "$raw"
}

# Cached wrapper around _discover_latest_copilot_claude_model — the discovery
# call is a real network round-trip (~1.5s), too slow to pay on every gpc/gpa
# invocation. Refreshes at most once per day per tier; falls back to a stale
# cache (better than nothing) and finally to a hardcoded last-known-good model
# if discovery fails outright (network down, opencode missing, catalog shape
# changed) — this must never be the thing that breaks gpc/gpa.
# Usage: _get_copilot_claude_model <haiku|sonnet|opus>
function _get_copilot_claude_model() {
  local tier="$1"
  local cache_dir="$HOME/.cache/nix-darwin-ai"
  local cache_file="$cache_dir/github-copilot-claude-${tier}.txt"
  local ttl=86400
  local fallback
  case "$tier" in
    haiku) fallback="claude-haiku-4.5" ;;
    opus)  fallback="claude-opus-5" ;;
    *)     fallback="claude-sonnet-5" ;;
  esac

  mkdir -p "$cache_dir" 2>/dev/null

  if [[ -f "$cache_file" ]]; then
    local age=$(( $(date +%s) - $(stat -f %m "$cache_file" 2>/dev/null || echo 0) ))
    if [[ $age -lt $ttl ]]; then
      cat "$cache_file"
      return 0
    fi
  fi

  local discovered
  discovered=$(_discover_latest_copilot_claude_model "$tier" 2>/dev/null)
  if [[ -n "$discovered" ]]; then
    echo "$discovered" > "$cache_file"
    echo "$discovered"
    return 0
  fi

  # Discovery failed: prefer a stale cache over the hardcoded fallback.
  if [[ -f "$cache_file" ]]; then
    cat "$cache_file"
  else
    echo "$fallback"
  fi
}

# Returns a human-readable provider name with proper capitalisation.
function _provider_display_name() {
  case "$1" in
    claude-code)    echo "Anthropic" ;;
    github-copilot) echo "GitHub Copilot" ;;
    opencode)       echo "OpenCode" ;;
    llama-cpp)      echo "llama.cpp" ;;
    *)              echo "$1" ;;
  esac
}

# Returns the model tier display string (with version numbers) for a provider.
# Usage: _model_tier_display <provider>
function _model_tier_display() {
  local provider="${1:-$(_get_ai_provider)}"
  
  case "$provider" in
    claude-code|github-copilot)
      # Built from live/cached discovery (_get_copilot_claude_model), not a
      # version string typed into this file — that's what let claude-sonnet-4.5
      # sit here silently for months after GitHub retired it.
      local h="${$(_get_copilot_claude_model haiku)#claude-haiku-}"
      local s="${$(_get_copilot_claude_model sonnet)#claude-sonnet-}"
      local o="${$(_get_copilot_claude_model opus)#claude-opus-}"
      local suffix=""
      [[ "$provider" == "claude-code" ]] && suffix=" (Copilot)"
      echo "🟢 Haiku ${h}${suffix} | 🔵 Sonnet ${s}${suffix} | 🔴 Opus ${o}${suffix}"
      ;;
    opencode)
      # Check if using a free model
      if _is_opencode_free_model; then
        local model=$(_get_current_opencode_model)
        local model_name="${model#opencode/}"
        # Capitalize first letter and replace hyphens with spaces
        model_name=$(echo "$model_name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')
        echo "⚪ $model_name (Free)"
      else
        echo "🟢 Haiku 4.5 | 🔵 Sonnet 4.6 | 🔴 Opus 4.7"
      fi
      ;;
    llama-cpp|llama.cpp)
      echo "⚪ $(_llamacpp_model_short) (local)"
      ;;
    *)
      echo "🟢 Haiku | 🔵 Sonnet | 🔴 Opus"
      ;;
  esac
}

function _get_opencode_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)

  # Special case: OpenCode with free model - always return the configured free model
  if [[ "$provider" == "opencode" ]] && _is_opencode_free_model; then
    _get_current_opencode_model
    return 0
  fi

  # Special case: llama.cpp - always return the local model
  if [[ "$provider" == "llama-cpp" ]] || [[ "$provider" == "llama.cpp" ]]; then
    echo "llama.cpp/local-coder"
    return 0
  fi

  # GitHub Copilot: skip auto-discovery (4.6 listed but not actually supported)
  # Claude Code: skip auto-discovery — all tiers route via Copilot, never Anthropic directly
  if [[ "$provider" != "github-copilot" ]] && [[ "$provider" != "claude-code" ]]; then
    local model=""
    if [[ "$task_type" == "haiku" ]]; then
      model=$(_discover_latest_model "$provider" "haiku")
    elif [[ "$task_type" == "opus" ]]; then
      model=$(_discover_latest_model "$provider" "opus")
    else
      model=$(_discover_latest_model "$provider" "sonnet")
    fi
    if [[ -n "$model" ]]; then
      echo "$model"
      return 0
    fi
  fi

  case $provider in
    github-copilot)
      # Always the latest active model per tier (cached ~1 day) — see
      # _get_copilot_claude_model. A hardcoded version string is exactly what
      # left claude-sonnet-4.5 in place for months after GitHub retired it.
      echo "github-copilot/$(_get_copilot_claude_model "$task_type")"
      ;;
    opencode)
      # OpenCode Zen: Use latest available Claude models with hyphens (claude-haiku-4-5)
      # Note: Models available via API but may not appear in `opencode models` due to CLI bug
      if [[ "$task_type" == "haiku" ]]; then
        echo "opencode/claude-haiku-4-5"
      elif [[ "$task_type" == "opus" ]]; then
        # Latest Opus: 4.7 > 4.6 > 4.5
        echo "opencode/claude-opus-4-7"
      else
        # Latest Sonnet: 4.6 > 4.5 > 4
        echo "opencode/claude-sonnet-4-6"
      fi
      ;;
    claude-code)
      # All tiers route via GitHub Copilot, never Anthropic directly — the
      # user's Anthropic/Claude Code quota is reserved for the interactive
      # Claude Code session, not consumed by git-helper automation. Always
      # the latest active model per tier — see _get_copilot_claude_model.
      echo "github-copilot/$(_get_copilot_claude_model "$task_type")"
      ;;
    llama-cpp|llama.cpp)
      echo "llama.cpp/local-coder"
      ;;
    *)
      echo "github-copilot/$(_get_copilot_claude_model sonnet)"
      ;;
  esac
}

# Check if the current OpenCode Zen model is a free tier model
# Returns 0 (true) if free model, 1 (false) if Claude/paid model
function _is_opencode_free_model() {
  local provider=$(_get_ai_provider)
  [[ "$provider" != "opencode" ]] && return 1
  
  local config_file="$HOME/.config/opencode/opencode.json"
  [[ ! -f "$config_file" ]] && return 1
  
  local model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
  [[ -z "$model" ]] && return 1
  
  # OpenCode Zen suffixes every free-tier model id with "-free", except its
  # rotating stealth model "big-pickle" -- matched by suffix instead of a
  # hardcoded id whitelist because the free roster rotates: ids that used to
  # be here (deepseek-v4-flash-free, minimax-m2.5-free/m2.7-free,
  # nemotron-3-super-free, qwen3.6-plus-free) are gone from the catalog as
  # of 2026-09-29, replaced by a different set. A whitelist goes stale
  # silently; a suffix match self-adapts.
  case "$model" in
    opencode/big-pickle|opencode/*-free)
      return 0  # Is a free model
      ;;
    *)
      return 1  # Is a Claude/paid model
      ;;
  esac
}

# Discover free-tier (cost 0) OpenCode Zen models that support tool calls
# (required for the agentic edit/bash loop) and pick the best one for a
# coding agent. Prefers "big-pickle" when present and active -- Zen's own
# stealth model, purpose-built for coding agents and reported to punch above
# its weight in independent agentic-coding tests, vs. general-purpose free
# models like Space Bunny that benchmark better for code *review* than for
# driving an edit/bash tool loop. Falls back to the most recently released
# free+toolcall model otherwise, since the models.dev catalog carries no
# benchmark field to rank on directly.
# Prints a bare model id (e.g. "big-pickle"); returns 1 on any failure
# (network, opencode missing, catalog shape changed) so callers fall back.
function _discover_best_free_zen_model() {
  local raw
  raw=$(timeout 15 opencode models --verbose opencode 2>/dev/null)
  [[ -z "$raw" ]] && return 1

  local script='
import sys, json, re

text = sys.stdin.read()
lines = [l for l in text.splitlines() if not re.match(r"^[\w.-]+/[\w.-]+$", l)]
blob = "\n".join(lines)

decoder = json.JSONDecoder()
models = []
rest = blob
while True:
    rest = rest.lstrip()
    if not rest:
        break
    try:
        obj, idx = decoder.raw_decode(rest)
    except ValueError:
        break
    models.append(obj)
    rest = rest[idx:]

free = [
    m for m in models
    if m.get("status") == "active"
    and m.get("cost", {}).get("input") == 0
    and m.get("cost", {}).get("output") == 0
    and m.get("capabilities", {}).get("toolcall")
]
if not free:
    sys.exit(1)

pickle = [m for m in free if m["id"] == "big-pickle"]
best = pickle[0] if pickle else max(free, key=lambda m: m.get("release_date", ""))
print(best["id"])
'
  python3 -c "$script" <<< "$raw"
}

# Cached wrapper around _discover_best_free_zen_model -- same pattern as
# _get_copilot_claude_model. Refreshes at most once a day; falls back to a
# stale cache, then to the hardcoded "big-pickle" fallback, if discovery
# fails outright.
# Usage: _get_free_zen_model
function _get_free_zen_model() {
  local cache_dir="$HOME/.cache/nix-darwin-ai"
  local cache_file="$cache_dir/opencode-zen-free.txt"
  local ttl=86400
  local fallback="big-pickle"

  mkdir -p "$cache_dir" 2>/dev/null

  if [[ -f "$cache_file" ]]; then
    local age=$(( $(date +%s) - $(stat -f %m "$cache_file" 2>/dev/null || echo 0) ))
    if [[ $age -lt $ttl ]]; then
      cat "$cache_file"
      return 0
    fi
  fi

  local discovered
  discovered=$(_discover_best_free_zen_model 2>/dev/null)
  if [[ -n "$discovered" ]]; then
    echo "$discovered" > "$cache_file"
    echo "$discovered"
    return 0
  fi

  # Discovery failed: prefer a stale cache over the hardcoded fallback.
  if [[ -f "$cache_file" ]]; then
    cat "$cache_file"
  else
    echo "$fallback"
  fi
}

# Get the current OpenCode model from config
# Returns the model string or empty if not found
function _get_current_opencode_model() {
  local provider=$(_get_ai_provider)
  [[ "$provider" != "opencode" ]] && return 1
  
  local config_file="$HOME/.config/opencode/opencode.json"
  [[ ! -f "$config_file" ]] && return 1
  
  jq -r '.model // empty' "$config_file" 2>/dev/null
}

# Check if provider supports multiple model tiers (Haiku/Sonnet/Opus)
# Returns 0 if multi-tier support available, 1 if single model only
function _supports_multi_tier() {
  local provider=$(_get_ai_provider)
  
  case "$provider" in
    claude-code|github-copilot)
      return 0  # Both support Haiku/Sonnet/Opus (all routed via GitHub Copilot)
      ;;
    opencode)
      # OpenCode supports multi-tier ONLY if using a Claude model (not free)
      _is_opencode_free_model && return 1 || return 0
      ;;
    llama-cpp|llama.cpp)
      return 1  # Single model only
      ;;
    *)
      return 1  # Unknown provider, assume single model
      ;;
  esac
}

# Check if provider supports Opus tier
# Returns 0 if Opus available, 1 if not
function _supports_opus() {
  local provider=$(_get_ai_provider)
  
  case "$provider" in
    claude-code)
      return 0  # Claude Code supports Opus (routed via GitHub Copilot, not Anthropic directly)
      ;;
    github-copilot)
      return 0  # Opus (4.7/4.7-fast/4.8/4.8-fast/5) confirmed available 2026-09-16
      ;;
    opencode)
      # OpenCode Zen supports Opus only with Claude models
      _is_opencode_free_model && return 1 || return 0
      ;;
    *)
      return 1  # Default: no Opus
      ;;
  esac
}

# AI Command Execution Functions

# `opencode run` is one-shot/headless: it never emits a session.idle event and
# (contrary to an earlier assumption) doesn't reliably fire a
# server.instance.disposed plugin event either. herdr's opencode plugin
# (.config/opencode/plugins/herdr-agent-state.js) registered a session for it
# on startup, but there's no TUI session to return to once the process exits,
# so release the agent registration entirely instead of leaving a stale/idle
# entry behind. Call this right after every `opencode run` invocation.
function _herdr_report_opencode_idle() {
  [[ -z "$HERDR_PANE_ID" || -z "$HERDR_SOCKET_PATH" ]] && return 0
  command -v herdr &>/dev/null || return 0
  herdr pane release-agent "$HERDR_PANE_ID" --source herdr:opencode --agent opencode --seq "$(($(date +%s) * 1000000))" >/dev/null 2>&1
}

# Strips Aider's own chrome (version/model/repo banner, the trailing
# "Tokens: N sent, M received." line) and a markdown code fence wrapping the
# answer -- GLM in particular wraps JSON responses in ```json ... ```, the
# same fence-stripping gpc/gpa's old direct-curl path already needed.
function _aider_extract_response() {
  perl -0777 -pe '
    s/^Warning:.*\n//mg;
    s/^You can skip this check.*\n//mg;
    s/^https:\/\/aider\.chat.*\n//mg;
    s/^Aider v.*\n//mg;
    s/^Model: .*\n//mg;
    s/^Git repo:.*\n//mg;
    s/^Repo-map:.*\n//mg;
    s/^Added .* to the chat.*\n//mg;
    s/^Tokens: .* sent, .* received\.\s*\n?//mg;
    s/^\s*```(?:json)?\s*\n//;
    s/\n?```\s*$//;
    s/^\s+//;
    s/\s+$//;
  '
}

# Runs a one-shot, read-only (--chat-mode ask, no file attached, no git
# operations) Aider query against the local llama-server and prints the
# model's cleaned text response. The prompt is passed as the message body,
# not a --read file, matching how gpc/gpa already embed the diff directly in
# the prompt text rather than pointing at a file on disk.
#
# Usage: _run_aider_local <model-alias> <timeout-seconds> <prompt>
# Returns: 0 on success (stdout = cleaned response), 1 on failure (stderr =
# error message matching the same "timeout"/"not reachable" wording the old
# direct-curl branches used, since gpc/gpa's own retry loop greps for those).
function _run_aider_local() {
  local model_alias="$1"
  local timeout_secs="$2"
  local prompt="$3"
  local endpoint="${LLAMA_CPP_HOST:-http://macminim1.rollet.family:8080}"
  local settings_file="$HOME/.config/aider/model-settings.yml"

  if ! command -v aider &>/dev/null; then
    echo "Error: aider not installed" >&2
    return 1
  fi

  local raw_output
  raw_output=$(timeout "${timeout_secs}s" aider \
    --model "openai/$model_alias" \
    --openai-api-base "${endpoint}/v1" \
    --openai-api-key "sk-local" \
    --model-settings-file "$settings_file" \
    --no-git \
    --yes-always \
    --chat-mode ask \
    --no-pretty \
    --no-check-update \
    --no-analytics \
    --no-show-model-warnings \
    --no-detect-urls \
    --input-history-file /tmp/.aider-local-input-history \
    --chat-history-file /tmp/.aider-local-chat-history.md \
    --message "$prompt" 2>&1)
  local exit_code=$?

  if [ $exit_code -eq 124 ]; then
    echo "Error: llama-server timeout after ${timeout_secs}s" >&2
    return 1
  elif [ $exit_code -ne 0 ]; then
    if echo "$raw_output" | grep -qi "connection\|connect\|refused"; then
      echo "Error: llama-server not reachable (is llama-server running?)" >&2
    else
      echo "Error: aider failed (exit code: $exit_code): $raw_output" >&2
    fi
    return 1
  fi

  local extracted=$(echo "$raw_output" | _aider_extract_response)
  if [[ -n "$extracted" ]]; then
    echo "$extracted"
    return 0
  fi

  echo "Error: aider returned empty response" >&2
  return 1
}


# Execute AI command with plain text output (for commit messages, etc.)
# Usage: echo "prompt" | _run_ai_plain ["haiku"|"sonnet"|"opus"]
function _run_ai_plain() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      echo "$result"
      return 0
      ;;

    opencode)
      # Use OpenCode CLI for all opencode provider requests
      # This handles authentication and API endpoints correctly
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      _herdr_report_opencode_idle
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      echo "$result"
      return 0
      ;;
      
    claude-code)
      # All tiers route via opencode+Copilot — never claude --print — so this
      # never touches the Anthropic API directly. _get_opencode_model always
      # returns a github-copilot/* model for this provider (see above); the
      # direct-Anthropic branch this used to have for the opus tier is gone
      # on purpose, not an oversight.
      local result exit_code
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      exit_code=$?
      _herdr_report_opencode_idle
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      echo "$result"
      return 0
      ;;

    llama-cpp)
      # Truncate prompt to ~6000 chars to keep it fast for plain-text tasks
      # (commit messages only need a representative sample of the diff)
      local truncated_prompt="${prompt:0:6000}"
      local prompt_len=${#prompt}
      if [ $prompt_len -gt 6000 ]; then
        truncated_prompt="${truncated_prompt}
... [diff truncated at 6000 chars for speed — ${prompt_len} total]"
      fi

      # Routed through Aider instead of a direct curl call -- Aider handles
      # response extraction robustly (its own --chat-mode ask flow), so this
      # replaces what used to be a hand-rolled curl+jq+perl chain here (raw
      # newline JSON parsing, <think> block stripping, markdown fence
      # stripping all lived in this branch and each had its own real bug
      # fixed earlier). The chat_template_kwargs.enable_thinking=false fix is
      # preserved via .config/aider/model-settings.yml's openai/local-coder-commit
      # entry instead of being inlined in the request body here.
      _run_aider_local "local-coder-commit" 60 "$truncated_prompt"
      return $?
      ;;


    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# Execute AI command with direct API call (returns JSON array)
# Usage: echo "prompt" | _run_ai_direct ["haiku"|"sonnet"|"opus"]
function _run_ai_direct() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    github-copilot)
      local model_name="$model"
      local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include:
- Any conversational text before the JSON
- Any explanations after the JSON
- Any markdown code blocks or backticks
- Any commentary or notes

Your entire response must be valid JSON starting with [ and ending with ].
If there are no issues to report, respond with exactly: []

