# Launch OpenCode with the selected provider/model
# This replaces the 'aidev' alias to dynamically select model based on aiselect preference
function aidev() {
  local provider=$(_get_ai_provider)
  
  # Colors for terminal output
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m' # No Color
  
  # Validate authentication before launching
  local auth_valid=false
  case $provider in
    github-copilot)
      if _validate_github_copilot; then
        auth_valid=true
      else
        echo "${RED}✗${NC} GitHub Copilot not authenticated"
        echo ""
      fi
      ;;
    opencode)
      if _validate_opencode_zen; then
        auth_valid=true
      else
        echo "${RED}✗${NC} OpenCode Zen API key not configured"
        echo ""
      fi
      ;;
    openrouter)
      if _validate_openrouter; then
        auth_valid=true
      else
        echo "${RED}✗${NC} OpenRouter API key not configured"
        echo ""
      fi
      ;;
  esac
  
  # If authentication failed, ask user what to do
  if ! $auth_valid; then
    echo "Options:"
    echo "  [a] Run aiselect to configure authentication"
    echo "  [c] Continue anyway (may fail)"
    echo "  [q] Quit"
    echo ""
    echo -n "Your choice: "
    
    local choice
    read -k1 choice
    echo ""
    echo ""
    
    case $choice in
      a | A)
        aiselect
        # Check if authentication succeeded after running aiselect
        case $provider in
          github-copilot)
            if ! _validate_github_copilot; then
              echo "${RED}✗${NC} Authentication still not valid. Aborting."
              return 1
            fi
            ;;
          opencode)
            if ! _validate_opencode_zen; then
              echo "${RED}✗${NC} API key still not configured. Aborting."
              return 1
            fi
            ;;
          openrouter)
            if ! _validate_openrouter; then
              echo "${RED}✗${NC} API key still not configured. Aborting."
              return 1
            fi
            ;;
        esac
        ;;
      c | C)
        echo "${YELLOW}⚠${NC}  Continuing without valid authentication..."
        echo ""
        ;;
      q | Q | $'\e')
        echo "Cancelled"
        return 1
        ;;
      *)
        echo "${RED}✗${NC} Invalid choice. Aborting."
        return 1
        ;;
    esac
  fi
  
  local model=$(_get_opencode_model "sonnet")
  opencode --model "$model" "$@"
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  # Fallback: Check gh CLI authentication
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

# Validate OpenCode Zen API key
function _validate_opencode_zen() {
  # Check for OpenCode API key in environment
  if [[ -n "$OPENCODE_API_KEY" ]]; then
    return 0
  fi
  
  # Check if key is in .zshrc_envvars (not tracked by git)
  if [[ -f ~/.zshrc_envvars ]]; then
    if grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars; then
      return 0
    fi
  fi
  
  # Also check .zshrc_envvars_insecure (for non-sensitive configs, not tracked by git)
  if [[ -f ~/.zshrc_envvars_insecure ]]; then
    if grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars_insecure; then
      return 0
    fi
  fi
  
  return 1
}

# Validate OpenRouter API key
function _validate_openrouter() {
  # Check for OpenRouter API key in environment
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    return 0
  fi
  
  # Check if key is in .zshrc_envvars (not tracked by git)
  if [[ -f ~/.zshrc_envvars ]]; then
    if grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars; then
      return 0
    fi
  fi
  
  # Also check .zshrc_envvars_insecure (for non-sensitive configs, not tracked by git)
  if [[ -f ~/.zshrc_envvars_insecure ]]; then
    if grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars_insecure; then
      return 0
    fi
  fi
  
  return 1
}

# Helper function to get current AI provider preference
function _get_ai_provider() {
  local preference_file="$HOME/.ai_provider_preference"
  
  # If preference file doesn't exist, default to GitHub Copilot
  if [[ ! -f "$preference_file" ]]; then
    echo "github-copilot"
    return 0
  fi
  
  # Read and return the preference
  cat "$preference_file"
}

# AI Provider Selection - System-wide provider preference
# Stores selection in ~/.ai_provider_preference
function aiselect() {
  local preference_file="$HOME/.ai_provider_preference"
  
  # If called with --show or --status, just display current provider
  if [[ "$1" == "--show" ]] || [[ "$1" == "--status" ]]; then
    local current_provider=$(_get_ai_provider)
    local opencode_model=$(_get_opencode_model "sonnet")
    local opencode_haiku_model=$(_get_opencode_model "haiku")
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Current AI Configuration"
    echo "═══════════════════════════════════════════════════════════"
    echo "Active Provider: $current_provider"
    echo ""
    echo "Interactive Sessions (aidev):"
    echo "  Model: $opencode_model"
    echo "  Mode: Full OpenCode agent with tools"
    echo "  → Launched with -m flag based on aiselect preference"
    echo ""
    echo "Direct API Functions (fast, lightweight):"
    echo "  Haiku tasks  (commit msgs): $opencode_haiku_model"
    echo "  Sonnet tasks (code review): $opencode_model"
    echo "  Mode: Direct API calls (no agent overhead)"
    echo "  Response time: ~5-15 seconds"
    echo ""
    echo "Command → Model → Mode:"
    echo "  • aidev                     → $opencode_model → Full Agent"
    echo "  • gpc (commit messages)     → $opencode_haiku_model → Direct API"
    echo "  • gpa (code review)         → $opencode_model → Direct API"
    echo ""
    echo "Note: Run 'aiselect' to change provider. Changes apply immediately"
    echo "      to all commands (no restart required)."
    echo "═══════════════════════════════════════════════════════════"
    return 0
  fi
  
  # Colors for terminal output
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m' # No Color
  
  # Run validations
  echo "Checking AI provider availability..."
  echo ""
  
  local github_valid=false
  local opencode_valid=false
  local openrouter_valid=false
  
  # Validate GitHub Copilot
  if _validate_github_copilot; then
    github_valid=true
  else
    # Offer to authenticate
    echo "${YELLOW}⚠${NC}  GitHub Copilot not authenticated"
    echo ""
    echo -n "Would you like to authenticate now? [Y/n]: "
    read -k1 auth_choice
    echo ""
    
    if [[ "$auth_choice" =~ ^[Yy]$ ]] || [[ -z "$auth_choice" ]]; then
      echo ""
      echo "Opening GitHub device login page..."
      if command -v open &>/dev/null; then
        open "https://github.com/login/device"
      elif command -v xdg-open &>/dev/null; then
        xdg-open "https://github.com/login/device"
      fi
      echo ""
      echo "Starting OpenCode authentication..."
      opencode auth login
      
      # Re-validate
      if _validate_github_copilot; then
        github_valid=true
        echo ""
        echo "${GREEN}✓${NC} GitHub Copilot authenticated successfully!"
      else
        echo ""
        echo "${RED}✗${NC} Authentication failed or was cancelled"
      fi
    fi
    echo ""
  fi
  
  # Validate OpenCode Zen
  if _validate_opencode_zen; then
    opencode_valid=true
  else
    # Offer to configure API key
    echo "${YELLOW}⚠${NC}  OpenCode Zen API key not configured"
    echo ""
    echo -n "Would you like to add your API key now? [Y/n]: "
    read -k1 api_choice
    echo ""
    
    if [[ "$api_choice" =~ ^[Yy]$ ]] || [[ -z "$api_choice" ]]; then
      echo ""
      echo "${YELLOW}⚠  Security Notice:${NC}"
      echo "   API keys will be stored in plain text in ~/.zshrc_envvars"
      echo "   File permissions will be set to 600 (owner read/write only)"
      echo "   This file is NOT tracked by git (.gitignore entry exists)"
      echo ""
      echo "   Note: This is separate from ~/.zshrc_envvars_insecure"
      echo "   which is tracked by git for non-sensitive variables."
      echo ""
      echo "Enter your OpenCode API key (get it from https://opencode.ai/auth):"
      echo -n "API Key: "
      
      # Read API key securely (disable echo for sensitive input)
      read -rs opencode_api_key
      echo ""  # New line after hidden input
      
      # Sanitize and validate input
      # Remove any whitespace, newlines, and dangerous characters
      opencode_api_key=$(echo "$opencode_api_key" | tr -d '[:space:]' | tr -d '\n\r')
      
      if [[ -z "$opencode_api_key" ]]; then
        echo ""
        echo "${RED}✗${NC} No API key provided"
      elif [[ ! "$opencode_api_key" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo ""
        echo "${RED}✗${NC} Invalid API key format (only alphanumeric, underscore, and hyphen allowed)"
      elif [[ ${#opencode_api_key} -lt 20 ]]; then
        echo ""
        echo "${RED}✗${NC} API key seems too short (expected at least 20 characters)"
      else
        # Create ~/.zshrc_envvars if it doesn't exist
        if [[ ! -f ~/.zshrc_envvars ]]; then
          touch ~/.zshrc_envvars
          chmod 600 ~/.zshrc_envvars
        fi
        
        # Check if key already exists and remove old entry
        if grep -q "^export OPENCODE_API_KEY=" ~/.zshrc_envvars 2>/dev/null; then
          # Create temp file without the old key
          grep -v "^export OPENCODE_API_KEY=" ~/.zshrc_envvars > ~/.zshrc_envvars.tmp
          grep -v "^# OpenCode Zen API key" ~/.zshrc_envvars.tmp > ~/.zshrc_envvars.tmp2
          mv ~/.zshrc_envvars.tmp2 ~/.zshrc_envvars
          rm -f ~/.zshrc_envvars.tmp
        fi
        
        # Add to ~/.zshrc_envvars with proper escaping
        echo "" >> ~/.zshrc_envvars
        echo "# OpenCode Zen API key (added $(date '+%Y-%m-%d %H:%M:%S'))" >> ~/.zshrc_envvars
        echo "export OPENCODE_API_KEY=\"${opencode_api_key}\"" >> ~/.zshrc_envvars
        
        # Set restrictive permissions
        chmod 600 ~/.zshrc_envvars
        
        # Set in current session
        export OPENCODE_API_KEY="$opencode_api_key"
        
        # Re-validate
        if _validate_opencode_zen; then
          opencode_valid=true
          echo ""
          echo "${GREEN}✓${NC} OpenCode Zen API key configured successfully!"
          echo "${GREEN}✓${NC} File permissions set to 600 (owner read/write only)"
        else
          echo ""
          echo "${RED}✗${NC} Configuration failed"
        fi
        
        # Clear the variable from memory
        unset opencode_api_key
      fi
    fi
    echo ""
  fi
  
  # Validate OpenRouter
  if _validate_openrouter; then
    openrouter_valid=true
  else
    # Offer to configure API key
    echo "${YELLOW}⚠${NC}  OpenRouter API key not configured"
    echo ""
    echo -n "Would you like to add your API key now? [Y/n]: "
    read -k1 api_choice
    echo ""
    
    if [[ "$api_choice" =~ ^[Yy]$ ]] || [[ -z "$api_choice" ]]; then
      echo ""
      echo "${YELLOW}⚠  Security Notice:${NC}"
      echo "   API keys will be stored in plain text in ~/.zshrc_envvars"
      echo "   File permissions will be set to 600 (owner read/write only)"
      echo "   This file is NOT tracked by git (.gitignore entry exists)"
      echo ""
      echo "   Note: This is separate from ~/.zshrc_envvars_insecure"
      echo "   which is tracked by git for non-sensitive variables."
      echo ""
      echo "Enter your OpenRouter API key (get it from https://openrouter.ai/settings/keys):"
      echo -n "API Key: "
      
      # Read API key securely (disable echo for sensitive input)
      read -rs openrouter_api_key
      echo ""  # New line after hidden input
      
      # Sanitize and validate input
      # OpenRouter keys start with "sk-or-v1-" followed by 64 hex characters
      openrouter_api_key=$(echo "$openrouter_api_key" | tr -d '[:space:]' | tr -d '\n\r')
      
      if [[ -z "$openrouter_api_key" ]]; then
        echo ""
        echo "${RED}✗${NC} No API key provided"
      elif [[ ! "$openrouter_api_key" =~ ^sk-or-v1-[a-f0-9]{64}$ ]]; then
        echo ""
        echo "${YELLOW}⚠${NC}  Warning: API key doesn't match expected OpenRouter format (sk-or-v1-...)"
        echo -n "Continue anyway? [y/N]: "
        read -k1 continue_choice
        echo ""
        
        if [[ ! "$continue_choice" =~ ^[Yy]$ ]]; then
          echo "${RED}✗${NC} Cancelled"
        else
          # Proceed with saving even if format doesn't match
          if [[ ! "$openrouter_api_key" =~ ^[a-zA-Z0-9_-]+$ ]]; then
            echo "${RED}✗${NC} Invalid characters in API key (only alphanumeric, underscore, and hyphen allowed)"
          else
            # Create ~/.zshrc_envvars if it doesn't exist
            if [[ ! -f ~/.zshrc_envvars ]]; then
              touch ~/.zshrc_envvars
              chmod 600 ~/.zshrc_envvars
            fi
            
            # Check if key already exists and remove old entry
            if grep -q "^export OPENROUTER_API_KEY=" ~/.zshrc_envvars 2>/dev/null; then
              grep -v "^export OPENROUTER_API_KEY=" ~/.zshrc_envvars > ~/.zshrc_envvars.tmp
              grep -v "^# OpenRouter API key" ~/.zshrc_envvars.tmp > ~/.zshrc_envvars.tmp2
              mv ~/.zshrc_envvars.tmp2 ~/.zshrc_envvars
              rm -f ~/.zshrc_envvars.tmp
            fi
            
            # Add to ~/.zshrc_envvars with proper escaping
            echo "" >> ~/.zshrc_envvars
            echo "# OpenRouter API key (added $(date '+%Y-%m-%d %H:%M:%S'))" >> ~/.zshrc_envvars
            echo "export OPENROUTER_API_KEY=\"${openrouter_api_key}\"" >> ~/.zshrc_envvars
            
            # Set restrictive permissions
            chmod 600 ~/.zshrc_envvars
            
            # Set in current session
            export OPENROUTER_API_KEY="$openrouter_api_key"
            
            # Re-validate
            if _validate_openrouter; then
              openrouter_valid=true
              echo ""
              echo "${GREEN}✓${NC} OpenRouter API key configured successfully!"
              echo "${GREEN}✓${NC} File permissions set to 600 (owner read/write only)"
            else
              echo ""
              echo "${RED}✗${NC} Configuration failed"
            fi
            
            # Clear the variable from memory
            unset openrouter_api_key
          fi
        fi
      else
        # Valid format, proceed with saving
        # Create ~/.zshrc_envvars if it doesn't exist
        if [[ ! -f ~/.zshrc_envvars ]]; then
          touch ~/.zshrc_envvars
          chmod 600 ~/.zshrc_envvars
        fi
        
        # Check if key already exists and remove old entry
        if grep -q "^export OPENROUTER_API_KEY=" ~/.zshrc_envvars 2>/dev/null; then
          grep -v "^export OPENROUTER_API_KEY=" ~/.zshrc_envvars > ~/.zshrc_envvars.tmp
          grep -v "^# OpenRouter API key" ~/.zshrc_envvars.tmp > ~/.zshrc_envvars.tmp2
          mv ~/.zshrc_envvars.tmp2 ~/.zshrc_envvars
          rm -f ~/.zshrc_envvars.tmp
        fi
        
        # Add to ~/.zshrc_envvars with proper escaping
        echo "" >> ~/.zshrc_envvars
        echo "# OpenRouter API key (added $(date '+%Y-%m-%d %H:%M:%S'))" >> ~/.zshrc_envvars
        echo "export OPENROUTER_API_KEY=\"${openrouter_api_key}\"" >> ~/.zshrc_envvars
        
        # Set restrictive permissions
        chmod 600 ~/.zshrc_envvars
        
        # Set in current session
        export OPENROUTER_API_KEY="$openrouter_api_key"
        
        # Re-validate
        if _validate_openrouter; then
          openrouter_valid=true
          echo ""
          echo "${GREEN}✓${NC} OpenRouter API key configured successfully!"
          echo "${GREEN}✓${NC} File permissions set to 600 (owner read/write only)"
        else
          echo ""
          echo "${RED}✗${NC} Configuration failed"
        fi
        
        # Clear the variable from memory
        unset openrouter_api_key
      fi
    fi
    echo ""
  fi
  
  # Display menu with status indicators
  while true; do
    echo "═══════════════════════════════════════════════════════════"
    echo "Select AI Provider:"
    echo "═══════════════════════════════════════════════════════════"
    
    if $github_valid; then
      echo "  [g] GitHub Copilot (default) ${GREEN}✓${NC}"
    else
      echo "  [g] GitHub Copilot (default) ${RED}✗${NC}"
    fi
    
    if $opencode_valid; then
      echo "  [c] OpenCode Zen             ${GREEN}✓${NC}"
    else
      echo "  [c] OpenCode Zen             ${RED}✗${NC}"
    fi
    
    if $openrouter_valid; then
      echo "  [r] OpenRouter               ${GREEN}✓${NC}"
    else
      echo "  [r] OpenRouter               ${RED}✗${NC}"
    fi
    
    echo "  [q] Quit"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo -n "Your choice: "
    
    # Read single character
    local choice
    read -k1 choice
    echo ""
    echo ""
    
    case $choice in
      $'\n' | '' | g | G)
        if $github_valid; then
          echo "github-copilot" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: GitHub Copilot"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "github-copilot" "sonnet")
          local haiku_model=$(_discover_latest_model "github-copilot" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} GitHub Copilot is not available (not authenticated)"
          echo ""
          continue
        fi
        ;;
      c | C)
        if $opencode_valid; then
          echo "opencode" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: OpenCode Zen"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "opencode" "sonnet")
          local haiku_model=$(_discover_latest_model "opencode" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} OpenCode Zen is not available"
          echo "ℹ  Set OPENCODE_API_KEY in ~/.zshrc_envvars (not tracked by git)"
          echo ""
          continue
        fi
        ;;
      r | R)
        if $openrouter_valid; then
          echo "openrouter" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: OpenRouter"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "openrouter" "sonnet")
          local haiku_model=$(_discover_latest_model "openrouter" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} OpenRouter is not available"
          echo "ℹ  Set OPENROUTER_API_KEY in ~/.zshrc_envvars (not tracked by git)"
          echo ""
          continue
        fi
        ;;
      q | Q | $'\e')
        echo "✗ Cancelled"
        return 0
        ;;
      *)
        echo "${RED}✗${NC} Invalid choice. Please select a valid option."
        echo ""
        continue
        ;;
    esac
  done
}

# Security audit function for AI configuration files
function ai_security_audit() {
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m' # No Color
  
  echo "═══════════════════════════════════════════════════════════"
  echo "AI Configuration Security Audit"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  
  local issues_found=0
  
  # Check ~/.zshrc_envvars permissions
  if [[ -f ~/.zshrc_envvars ]]; then
    # Cross-platform stat command (macOS vs Linux)
    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS
      perms=$(stat -f "%Op" ~/.zshrc_envvars 2>/dev/null | tail -c 4)
    else
      # Linux
      perms=$(stat -c "%a" ~/.zshrc_envvars 2>/dev/null)
    fi
    
    echo "Checking ~/.zshrc_envvars..."
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars'"
      issues_found=$((issues_found + 1))
    fi
    
    # Check if file contains API keys
    if grep -q "API_KEY" ~/.zshrc_envvars; then
      echo "  ${YELLOW}ℹ${NC}  Contains API keys (stored in plain text)"
    fi
  else
    echo "~/.zshrc_envvars: Not found"
  fi
  
  echo ""
  
  # Check ~/.zshrc_envvars_insecure permissions
  if [[ -f ~/.zshrc_envvars_insecure ]] || [[ -L ~/.zshrc_envvars_insecure ]]; then
    # Resolve symlink to get actual file path
    local target_file=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null || echo ~/.zshrc_envvars_insecure)
    
    # Cross-platform stat command (macOS vs Linux)
    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS
      perms=$(stat -f "%Op" "$target_file" 2>/dev/null | tail -c 4)
    else
      # Linux
      perms=$(stat -c "%a" "$target_file" 2>/dev/null)
    fi
    
    echo "Checking ~/.zshrc_envvars_insecure..."
    if [[ -L ~/.zshrc_envvars_insecure ]]; then
      echo "  ${YELLOW}ℹ${NC}  Symlink to: $target_file"
    fi
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      if [[ -L ~/.zshrc_envvars_insecure ]]; then
        echo "    Recommended: Run 'chmod 600 $target_file'"
      else
        echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars_insecure'"
      fi
      issues_found=$((issues_found + 1))
    fi
    
    # Warn if this file contains API keys (it shouldn't based on name)
    if grep -q "API_KEY" "$target_file" 2>/dev/null; then
      echo "  ${RED}✗${NC} Contains API keys (should be in ~/.zshrc_envvars instead)"
      issues_found=$((issues_found + 1))
    fi
  fi
  
  echo ""
  
  # Check if API keys are in environment
  if [[ -n "$OPENCODE_API_KEY" ]]; then
    echo "Environment variables:"
    echo "  ${GREEN}✓${NC} OPENCODE_API_KEY is set"
  fi
  
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    echo "  ${GREEN}✓${NC} OPENROUTER_API_KEY is set"
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  
  if [[ $issues_found -eq 0 ]]; then
    echo "${GREEN}✓${NC} No security issues found"
  else
    echo "${RED}✗${NC} Found $issues_found security issue(s)"
  fi
  
  echo "═══════════════════════════════════════════════════════════"
}

