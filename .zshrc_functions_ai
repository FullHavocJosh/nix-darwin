# Helper function: Discover latest Claude model for a provider
# Usage: _discover_latest_model <provider> <model_type>
# model_type can be "sonnet" or "haiku"
function _discover_latest_model() {
  local provider="$1"
  local model_type="$2"
  
  # Get all models for the provider
  local models=$(opencode models "$provider" 2>/dev/null)
  
  if [[ -z "$models" ]]; then
    return 1
  fi
  
  # Filter for the model type and sort to get the latest
  local latest_model=""
  
  case $model_type in
    sonnet)
      # Look for sonnet models, prioritizing higher version numbers
      # Use -V for natural version sort (handles 4.5 vs 4 correctly)
      latest_model=$(echo "$models" | grep -i "claude" | grep -i "sonnet" | sort -V | tail -1)
      ;;
    haiku)
      # Look for haiku models, prioritizing higher version numbers
      latest_model=$(echo "$models" | grep -i "claude" | grep -i "haiku" | sort -V | tail -1)
      ;;
  esac
  
  if [[ -n "$latest_model" ]]; then
    echo "$latest_model"
    return 0
  fi
  
  return 1
}

# Helper function: Get OpenCode model string based on provider preference
# Usage: _get_opencode_model ["simple"|"complex"]
function _get_opencode_model() {
  local task_type="${1:-complex}"
  local provider=$(_get_ai_provider)
  
  # Try to discover the latest model dynamically
  local model=""
  
  if [[ "$task_type" == "simple" ]]; then
    model=$(_discover_latest_model "$provider" "haiku")
  else
    model=$(_discover_latest_model "$provider" "sonnet")
  fi
  
  # If discovery succeeded, return the model
  if [[ -n "$model" ]]; then
    echo "$model"
    return 0
  fi
  
  # Fallback to hardcoded models if discovery fails
  case $provider in
    github-copilot)
      if [[ "$task_type" == "simple" ]]; then
        echo "github-copilot/claude-haiku-4.5"
      else
        echo "github-copilot/claude-sonnet-4.5"
      fi
      ;;
    opencode)
      if [[ "$task_type" == "simple" ]]; then
        echo "opencode/claude-3-5-haiku"
      else
        echo "opencode/claude-sonnet-4.5"
      fi
      ;;
    openrouter)
      if [[ "$task_type" == "simple" ]]; then
        echo "openrouter/anthropic/claude-3.5-haiku"
      else
        echo "openrouter/anthropic/claude-sonnet-4.5"
      fi
      ;;
    *)
      echo "github-copilot/claude-sonnet-4.5"  # Default fallback
      ;;
  esac
}

