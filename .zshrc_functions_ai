# Secrets: ~/.zshrc_envvars (git-ignored, chmod 600)
# Non-sensitive config: ~/.zshrc_envvars_insecure (tracked by git)

# Discover latest Claude model for a provider
# Usage: _discover_latest_model <provider> <model_type>  (model_type: sonnet|haiku|opus)
function _discover_latest_model() {
  local provider="$1"
  local model_type="$2"

  local models
  models=$(opencode models "$provider" 2>/dev/null)
  [[ -z "$models" ]] && return 1

  local filtered_models
  filtered_models=$(echo "$models" | grep -i "$model_type")
  [[ -z "$filtered_models" ]] && return 1

  # Exclude dated variants (-20241022) and -latest aliases
  local base_models
  base_models=$(echo "$filtered_models" | grep -Ev -- '-[0-9]{8}$|-latest$')
  [[ -z "$base_models" ]] && base_models="$filtered_models"

  echo "$base_models" | sort -V | tail -1
}

function _get_opencode_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)

  # GitHub Copilot: skip auto-discovery (4.6 listed but not actually supported)
  if [[ "$provider" != "github-copilot" ]]; then
    local model=""
    if [[ "$task_type" == "haiku" ]]; then
      model=$(_discover_latest_model "$provider" "haiku")
    elif [[ "$task_type" == "opus" ]]; then
      model=$(_discover_latest_model "$provider" "opus")
    else
      model=$(_discover_latest_model "$provider" "sonnet")
    fi
    if [[ -n "$model" ]]; then
      echo "$model"
      return 0
    fi
  fi

  case $provider in
    github-copilot)
      if [[ "$task_type" == "opus" ]]; then
        echo "github-copilot/claude-opus-4.5"
      elif [[ "$task_type" == "haiku" ]]; then
        echo "github-copilot/claude-haiku-4.5"
      else
        echo "github-copilot/claude-sonnet-4.5"
      fi
      ;;
    opencode)
      if [[ "$task_type" == "haiku" ]]; then
        echo "opencode/claude-3-5-haiku"
      elif [[ "$task_type" == "opus" ]]; then
        echo "opencode/claude-opus-4.5"
      else
        echo "opencode/claude-sonnet-4.5"
      fi
      ;;
    openrouter)
      if [[ "$task_type" == "haiku" ]]; then
        echo "openrouter/anthropic/claude-3.5-haiku"
      elif [[ "$task_type" == "opus" ]]; then
        echo "openrouter/anthropic/claude-opus-4.5"
      else
        echo "openrouter/anthropic/claude-sonnet-4.5"
      fi
      ;;
    llama-cpp)
      echo "llama-cpp/local-coder"
      ;;
    *)
      echo "github-copilot/claude-sonnet-4.5"
      ;;
  esac
}

# AI Command Execution Functions

# Execute AI command with plain text output (for commit messages, etc.)
# Usage: echo "prompt" | _run_ai_plain ["haiku"|"sonnet"|"opus"]
function _run_ai_plain() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        return 1
      fi
      echo "$result"
      return 0
      ;;
      
    opencode)
      if [[ -z "$OPENCODE_API_KEY" ]]; then
        echo "Error: OPENCODE_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenCode API returned invalid response" >&2
      return 1
      ;;
      
    openrouter)
      if [[ -z "$OPENROUTER_API_KEY" ]]; then
        echo "Error: OPENROUTER_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenRouter API returned invalid response" >&2
      return 1
      ;;
      
    llama-cpp)
      # llama-server exposes an OpenAI-compatible /v1/chat/completions endpoint
      local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
      local model_name="${model#llama-cpp/}"

      # Truncate prompt to ~6000 chars to keep it fast for plain-text tasks
      # (commit messages only need a representative sample of the diff)
      local truncated_prompt="${prompt:0:6000}"
      local prompt_len=${#prompt}
      if [ $prompt_len -gt 6000 ]; then
        truncated_prompt="${truncated_prompt}
... [diff truncated at 6000 chars for speed — ${prompt_len} total]"
      fi

      local result=$(curl -s "${endpoint}/v1/chat/completions" \
        --max-time 60 \
        --connect-timeout 5 \
        -H "Content-Type: application/json" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$truncated_prompt" | jq -Rs .)}],
          \"temperature\": 0.2,
          \"max_tokens\": 256
        }" 2>/dev/null)

      local curl_exit=$?
      if [ $curl_exit -eq 28 ]; then
        echo "Error: llama-server timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: llama-server not reachable (is llama-server running?)" >&2
        return 1
      fi

      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi

      # Surface the actual error from llama-server if present
      local server_error=$(echo "$result" | jq -r '.error.message' 2>/dev/null)
      if [[ -n "$server_error" && "$server_error" != "null" ]]; then
        echo "Error: llama-server: $server_error" >&2
      else
        echo "Error: llama-server returned invalid response" >&2
      fi
      return 1
      ;;

    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# Execute AI command with direct API call (returns JSON array)
# Usage: echo "prompt" | _run_ai_direct ["haiku"|"sonnet"|"opus"]
function _run_ai_direct() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Make direct API call based on provider
  case $provider in
    github-copilot)
      local model_name="$model"
      local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include:
- Any conversational text before the JSON
- Any explanations after the JSON  
- Any markdown code blocks or backticks
- Any commentary or notes

Your entire response must be valid JSON starting with [ and ending with ].
If there are no issues to report, respond with exactly: []

Example of CORRECT response format:
[{\"file\":\"example.tf\",\"severity\":\"Critical\",\"issue\":\"Hardcoded secret\",\"recommendation\":\"Use variable\"}]

Example of INCORRECT response (DO NOT DO THIS):
Here are the issues I found:
\`\`\`json
[{...}]
\`\`\`
Let me know if you need anything else!

START YOUR RESPONSE NOW WITH [ OR []:"
      
      local result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model_name" 2>&1)
      local exit_code=$?
      
      if [ $exit_code -eq 124 ]; then
        echo "Error: OpenCode command timeout after 90s" >&2
        return 1
      elif [ $exit_code -ne 0 ]; then
        echo "Error: OpenCode command failed (exit code: $exit_code)" >&2
        if [[ -n "$result" ]]; then
          echo "Output: $(echo "$result" | head -c 200)" >&2
        fi
        return 1
      fi
      
      # Extract JSON more efficiently - single strategy that handles most cases
      if [[ -n "$result" ]]; then
        # Strategy: Extract from first [ to last ] (handles wrapped JSON)
        local extracted=$(echo "$result" | perl -0777 -pe 's/^[^\[]*(\[.*\])[^\]]*$/$1/s' | head -c 50000)
        
        # Validate it's proper JSON
        if echo "$extracted" | jq empty 2>/dev/null; then
          echo "$extracted"
          return 0
        fi
        
        # Soft failure: Could not parse response
        # Exit code 2 = unparseable output (user should be warned)
        echo "Error: Could not parse AI response as JSON" >&2
        echo "[]"
        return 2
      fi
      
      echo "Error: OpenCode returned empty response" >&2
      return 1
      ;;
      
    opencode)
      # Use curl with OpenCode API
      if [[ -z "$OPENCODE_API_KEY" ]]; then
        echo "Error: OPENCODE_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#opencode/}"
      
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 \
        --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local curl_exit=$?
      
      if [ $curl_exit -eq 28 ]; then
        echo "Error: OpenCode API timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: OpenCode API network error (curl exit code: $curl_exit)" >&2
        return 1
      fi
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenCode API returned invalid response" >&2
      return 1
      ;;
      
    openrouter)
      # Use curl with OpenRouter API
      if [[ -z "$OPENROUTER_API_KEY" ]]; then
        echo "Error: OPENROUTER_API_KEY not set" >&2
        return 1
      fi
      
      local model_name="${model#openrouter/}"
      
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 \
        --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$prompt" | jq -Rs .)}],
          \"max_tokens\": 200000
        }" 2>/dev/null)
      
      local curl_exit=$?
      
      if [ $curl_exit -eq 28 ]; then
        echo "Error: OpenRouter API timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: OpenRouter API network error (curl exit code: $curl_exit)" >&2
        return 1
      fi
      
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        echo "$extracted"
        return 0
      fi
      
      echo "Error: OpenRouter API returned invalid response" >&2
      return 1
      ;;
      
    llama-cpp)
      # llama-server exposes an OpenAI-compatible /v1/chat/completions endpoint
      local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
      local model_name="${model#llama-cpp/}"

      # Truncate prompt to ~4000 chars (~1000 tokens) to keep inference fast (~10s).
      # Each additional 1000 tokens adds ~20s on 7B Q8; code review JSON is short.
      local truncated_prompt="${prompt:0:4000}"
      local prompt_len=${#prompt}
      if [ $prompt_len -gt 4000 ]; then
        truncated_prompt="${truncated_prompt}
... [diff truncated at 4000 chars — ${prompt_len} total]"
      fi

      local result=$(curl -s "${endpoint}/v1/chat/completions" \
        --max-time 60 \
        --connect-timeout 5 \
        -H "Content-Type: application/json" \
        -d "{
          \"model\": \"$model_name\",
          \"messages\": [{\"role\": \"user\", \"content\": $(echo "$truncated_prompt" | jq -Rs .)}],
          \"temperature\": 0.1,
          \"max_tokens\": 256
        }" 2>/dev/null)

      local curl_exit=$?
      if [ $curl_exit -eq 28 ]; then
        echo "Error: llama-server timeout after 60s" >&2
        return 1
      elif [ $curl_exit -ne 0 ]; then
        echo "Error: llama-server not reachable (is llama-server running?)" >&2
        return 1
      fi

      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      if [[ -n "$extracted" && "$extracted" != "null" ]]; then
        # Extract JSON array from the response (same strategy as anthropic branch)
        local json_extracted=$(echo "$extracted" | perl -0777 -pe 's/^[^\[]*(\[.*\])[^\]]*$/$1/s' | head -c 50000)
        if echo "$json_extracted" | jq empty 2>/dev/null; then
          echo "$json_extracted"
          return 0
        fi
        # Soft failure: response not parseable as JSON
        echo "Error: Could not parse llama-server response as JSON" >&2
        echo "[]"
        return 2
      fi

      echo "Error: llama-server returned invalid response" >&2
      return 1
      ;;

    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# Execute AI command via OpenCode agent (full agent capabilities, slower)
# Usage: echo "prompt" | _run_ai_agent ["haiku"|"sonnet"|"opus"]
function _run_ai_agent() {
  local task_type="${1:-sonnet}"
  local model=$(_get_opencode_model "$task_type")
  local prompt=$(cat)
  opencode run --model "$model" "$prompt"
}

function _run_ai_command() {
  _run_ai_direct "$@"
}

function _get_ai_command() {
  local task_type="${1:-sonnet}"
  echo "_run_ai_direct $task_type"
}

# jrollet (work) → claude, havoc (personal) → opencode
function aidev() {
  # Detect profile by home directory username
  local _home_user="${HOME:t}"
  if [[ "$_home_user" == "jrollet" ]]; then
    claude "$@"
    return $?
  fi

  local provider=$(_get_ai_provider)
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'

  # If no preference is set and we're offline, auto-select llama-cpp
  if ! _is_online; then
    if [[ "$provider" != "llama-cpp" ]]; then
      echo "${YELLOW}⚠${NC}  No internet connection detected."
      if _validate_llamacpp; then
        echo "   Switching to llama-cpp (local) for this session."
        echo ""
        provider="llama-cpp"
      else
        echo "${RED}✗${NC} Offline and llama-server is not running. Cannot start aidev."
        echo "   Start llama-server or connect to the internet and try again."
        return 1
      fi
    fi
  fi

  if [[ "$provider" == "llama-cpp" ]]; then
    if ! _validate_llamacpp; then
      echo "${RED}✗${NC} llama-server is not running at http://127.0.0.1:8080"
      echo "   Start it first: launchctl kickstart -k gui/\$(id -u)/llama-server"
      return 1
    fi
    local local_model="llama.cpp/local-coder"
    echo "${GREEN}✓${NC} Provider: llama-cpp (local)"
    echo "${GREEN}✓${NC} Model:    ⚪ $(_llamacpp_model_short) → $local_model"
    echo ""
    opencode --model "$local_model" "$@"
    return $?
  fi

  local auth_valid=false
  local _aidev_validate() {
    case $provider in
      github-copilot) _validate_github_copilot ;;
      opencode)     _validate_opencode_zen ;;
      openrouter)   _validate_openrouter ;;
      *)            return 1 ;;
    esac
  }
  
  if _aidev_validate; then
    auth_valid=true
  else
    echo "${RED}✗${NC} Provider '$provider' is not available or not authenticated"
    echo ""
    echo "Options:"
    echo "  [a] Run aiselect to configure or switch provider"
    echo "  [c] Continue anyway (may fail)"
    echo "  [q] Quit"
    echo ""
    echo -n "Your choice: "
    
    local choice
    read -k1 choice
    echo ""
    echo ""
    
    case $choice in
      a | A)
        aiselect
        # Re-read provider in case user switched it
        provider=$(_get_ai_provider)
        if ! _aidev_validate; then
          echo "${RED}✗${NC} Provider '$provider' still not valid. Aborting."
          return 1
        fi
        ;;
      c | C)
        echo "${YELLOW}⚠${NC}  Continuing without valid authentication..."
        echo ""
        ;;
      q | Q | $'\e')
        echo "Cancelled"
        return 1
        ;;
      *)
        echo "${RED}✗${NC} Invalid choice. Aborting."
        return 1
        ;;
    esac
  fi
  
  # Resolve the model for the current provider
  local model
  model=$(_get_opencode_model "sonnet")
  if [[ -z "$model" ]]; then
    echo "${RED}✗${NC} Could not determine model for provider: $provider"
    return 1
  fi
  
  echo "${GREEN}✓${NC} Provider: $provider"
  echo "${GREEN}✓${NC} Model:    $model"
  echo ""
  
  opencode --model "$model" "$@"
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

function _validate_opencode_zen() {
  [[ -n "$OPENCODE_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars_insecure && return 0
  return 1
}

function _validate_openrouter() {
  [[ -n "$OPENROUTER_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars_insecure && return 0
  return 1
}

function _llamacpp_model_tier() {
  local ram_bytes ram_gb
  ram_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
  ram_gb=$(( ram_bytes / 1024 / 1024 / 1024 ))
  echo "qwen2.5-coder-7b Q8 (~8 GB, ${ram_gb} GB device)"
}

function _llamacpp_model_short() {
  echo "Qwen2.5-Coder-7B"
}

function _validate_llamacpp() {
  local endpoint="${LLAMACPP_HOST:-http://127.0.0.1:8080}"
  local response
  response=$(curl -s --max-time 3 "${endpoint}/health" 2>/dev/null)
  if echo "$response" | grep -q '"status"'; then
    return 0
  fi
  return 1
}

# Check internet connectivity using curl or dig (not ping)
function _is_online() {
  if command -v curl &>/dev/null; then
    curl -sf --max-time 2 --connect-timeout 1 https://1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  if command -v dig &>/dev/null; then
    dig +time=1 +tries=1 @1.1.1.1 cloudflare.com >/dev/null 2>&1 && return 0
  fi
  if command -v ping &>/dev/null; then
    ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  return 1
}

function _get_ai_provider() {
  local preference_file="$HOME/.ai_provider_preference"
  [[ ! -f "$preference_file" ]] && echo "github-copilot" && return 0
  cat "$preference_file"
}

# Hybrid routing: llama-cpp → cloud escalation
# gpc/gpr always local; gpa escalates to cloud on critical/security findings
# Cloud provider stored in ~/.ai_cloud_provider_preference (separate from main provider)
function _get_cloud_fallback_provider() {
  local cloud_pref="$HOME/.ai_cloud_provider_preference"
  if [[ -f "$cloud_pref" ]]; then
    cat "$cloud_pref"
  else
    echo "anthropic"
  fi
}

function _get_cloud_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)

  case $provider in
    github-copilot)
      [[ "$task_type" == "opus"  ]] && echo "github-copilot/claude-opus-4.5"  && return
      [[ "$task_type" == "haiku" ]] && echo "github-copilot/claude-haiku-4.5" && return
      echo "github-copilot/claude-sonnet-4.5"
      ;;
    opencode)
      [[ "$task_type" == "opus"  ]] && echo "opencode/claude-opus-4.5"        && return
      [[ "$task_type" == "haiku" ]] && echo "opencode/claude-3-5-haiku"        && return
      echo "opencode/claude-sonnet-4.5"
      ;;
    openrouter)
      [[ "$task_type" == "opus"  ]] && echo "openrouter/anthropic/claude-opus-4.5"   && return
      [[ "$task_type" == "haiku" ]] && echo "openrouter/anthropic/claude-3.5-haiku"  && return
      echo "openrouter/anthropic/claude-sonnet-4.5"
      ;;
    anthropic|*)
      [[ "$task_type" == "opus"  ]] && echo "anthropic/claude-opus-4-5"  && return
      [[ "$task_type" == "haiku" ]] && echo "anthropic/claude-haiku-4-5" && return
      echo "anthropic/claude-sonnet-4-6"
      ;;
  esac
}

# Plain-text AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_plain_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_plain_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout after 90s" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed (exit $exit_code)" >&2; return 1; }
      echo "$result"
      ;;
    opencode)
      [[ -z "$OPENCODE_API_KEY" ]] && { echo "Error: OPENCODE_API_KEY not set" >&2; return 1; }
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "Error: OpenCode cloud API returned invalid response" >&2; return 1
      ;;
    openrouter)
      [[ -z "$OPENROUTER_API_KEY" ]] && { echo "Error: OPENROUTER_API_KEY not set" >&2; return 1; }
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "Error: OpenRouter cloud API returned invalid response" >&2; return 1
      ;;
  esac
}

# Structured-JSON AI call against cloud fallback provider (for llama-cpp escalation)
# Usage: echo "prompt" | _run_ai_direct_cloud ["haiku"|"sonnet"|"opus"]
function _run_ai_direct_cloud() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)
  local model=$(_get_cloud_model "$task_type")
  local prompt=$(cat)

  local json_prompt="$prompt

CRITICAL INSTRUCTIONS - READ CAREFULLY:
You MUST respond with ONLY a JSON array. Do not include any text before or after it.
If there are no issues, respond with exactly: []
START YOUR RESPONSE NOW WITH [ OR []:"

  case $provider in
    anthropic | github-copilot)
      local result
      result=$(echo "$json_prompt" | timeout 90s opencode run --model "$model" 2>&1)
      local exit_code=$?
      [ $exit_code -eq 124 ] && { echo "Error: cloud timeout" >&2; return 1; }
      [ $exit_code -ne 0  ] && { echo "Error: cloud call failed" >&2; return 1; }
      local extracted=$(echo "$result" | perl -0777 -pe 's/^[^\[]*(\[.*\])[^\]]*$/$1/s' | head -c 50000)
      echo "$extracted" | jq empty 2>/dev/null && echo "$extracted" && return 0
      echo "[]"; return 2
      ;;
    opencode)
      [[ -z "$OPENCODE_API_KEY" ]] && { echo "Error: OPENCODE_API_KEY not set" >&2; return 1; }
      local model_name="${model#opencode/}"
      local result=$(curl -s https://api.opencode.ai/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENCODE_API_KEY" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$json_prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "[]"; return 1
      ;;
    openrouter)
      [[ -z "$OPENROUTER_API_KEY" ]] && { echo "Error: OPENROUTER_API_KEY not set" >&2; return 1; }
      local model_name="${model#openrouter/}"
      local result=$(curl -s https://openrouter.ai/api/v1/chat/completions \
        --max-time 60 --connect-timeout 10 \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $OPENROUTER_API_KEY" \
        -H "HTTP-Referer: https://github.com/user/zsh-functions" \
        -d "{\"model\":\"$model_name\",\"messages\":[{\"role\":\"user\",\"content\":$(echo "$json_prompt" | jq -Rs .)}],\"max_tokens\":200000}" 2>/dev/null)
      local extracted=$(echo "$result" | jq -r '.choices[0].message.content' 2>/dev/null)
      [[ -n "$extracted" && "$extracted" != "null" ]] && echo "$extracted" && return 0
      echo "[]"; return 1
      ;;
  esac
}

