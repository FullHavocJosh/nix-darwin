              echo "${YELLOW}⚠${NC} Could not restart llama-server-local automatically."
              echo "Run manually: launchctl kickstart -k gui/\$(id -u)/org.nixos.llama-server-local"
            fi
          fi
        fi

        echo ""
        echo "${GREEN}✓${NC} Using llama.cpp (local: $(_llamacpp_model_short))"
        echo ""
        echo "aidev/opencode will now use llama.cpp (currently: $(_llamacpp_model_short))."
        echo "gpc/gpr always prefer llama.cpp when reachable regardless of this"
        echo "setting; gpa escalates to cloud on larger diffs or critical findings"
        echo "unless this host defaults gpc/gpa/gpr to local-only (AI_LOCAL_DEFAULT)."
