          extracted=$(echo "$result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
          if echo "$extracted" | jq empty 2>/dev/null; then
            echo "$extracted"; return 0
          fi
          echo "Error: Could not parse AI response as JSON" >&2
          echo "[]"
          return 2
        fi
        echo "Error: claude returned empty response" >&2
        return 1
      fi
      ;;

    *)
      echo "Error: Unknown provider $provider" >&2
      return 1
      ;;
  esac
}

# Execute AI command via OpenCode agent (full agent capabilities, slower)
# Usage: echo "prompt" | _run_ai_agent ["haiku"|"sonnet"|"opus"]
function _run_ai_agent() {
  local task_type="${1:-sonnet}"
  local model=$(_get_opencode_model "$task_type")
  local prompt=$(cat)
  opencode run --model "$model" "$prompt"
}

function _run_ai_command() {
  _run_ai_direct "$@"
}

function _get_ai_command() {
  local task_type="${1:-sonnet}"
  echo "_run_ai_direct $task_type"
}

function aidev() {
  local GREEN='\033[0;32m'
  local NC='\033[0m'

  _ensure_ai_provider || return 1

  local provider=$(_get_ai_provider)

  echo "${GREEN}✓${NC} Provider: $(_provider_display_name "$provider")"

  # Detect -p/--print flag and translate for providers that don't support it.
  # claude uses -p for headless mode; opencode uses `run` as the subcommand.
  local print_mode=false
  local filtered_args=()
  for arg in "$@"; do
    if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
      print_mode=true
    else
      filtered_args+=("$arg")
    fi
  done

  case "$provider" in
    claude-code)
      echo ""
      if $print_mode; then
        claude -p "${filtered_args[@]}"
      else
        claude "${filtered_args[@]}"
      fi
      ;;
    llama-cpp)
      local local_model="llama.cpp/local-coder"
      echo "${GREEN}✓${NC} Model:    ⚪ $(_llamacpp_model_short) → $local_model"
      echo ""
      if $print_mode; then
        opencode --model "$local_model" run "${filtered_args[@]}"
      else
        opencode --model "$local_model" "${filtered_args[@]}"
      fi
      ;;
    github-copilot)
      # GitHub Copilot via OpenCode
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      if $print_mode; then
        opencode --model "$model" run "${filtered_args[@]}"
      else
        opencode --model "$model" "${filtered_args[@]}"
      fi
      ;;
    opencode)
      # OpenCode Zen - check if a specific model is set in opencode.json
      local model=""
      local config_file="$HOME/.config/opencode/opencode.json"
      if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
        model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
      fi
      
      # Fallback to discovering latest Sonnet if no model is set
      if [[ -z "$model" || "$model" == "null" ]]; then
        model=$(_get_opencode_model "sonnet")
      fi
      
      echo "${GREEN}✓${NC} Model:    $model"
      echo ""
      if $print_mode; then
        opencode --model "$model" run "${filtered_args[@]}"
      else
        opencode --model "$model" "${filtered_args[@]}"
      fi
      ;;
    *)
      # Unknown provider - fall back to github-copilot
      local model=$(_get_opencode_model "sonnet")
      echo "${GREEN}✓${NC} Model:    $model (fallback)"
      echo ""
      if $print_mode; then
        opencode --model "$model" run "${filtered_args[@]}"
      else
        opencode --model "$model" "${filtered_args[@]}"
      fi
      ;;
  esac
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

function _validate_opencode_zen() {
  [[ -n "$OPENCODE_ZEN_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars_insecure && return 0
  [[ -f ~/.config/opencode/.env ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.config/opencode/.env && return 0
  # Check auth.json for OpenCode Zen API key (injected by nix-darwin activation)
  if [[ -f ~/.local/share/opencode/auth.json ]] && command -v jq &>/dev/null; then
    local opencode_key=$(jq -r '.opencode.key // empty' ~/.local/share/opencode/auth.json 2>/dev/null)
    [[ -n "$opencode_key" ]] && return 0
  fi
  return 1
}

function _validate_openrouter() {
  [[ -n "$OPENROUTER_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars_insecure && return 0
  return 1
}

function _llamacpp_model_tier() {
  local ram_bytes ram_gb
  ram_bytes=$(sysctl -n hw.memsize 2>/dev/null || echo 0)
  ram_gb=$(( ram_bytes / 1024 / 1024 / 1024 ))
  echo "qwen2.5-coder-7b Q8 (~8 GB, ${ram_gb} GB device)"
}

function _llamacpp_model_short() {
  echo "Qwen2.5-Coder-7B"
}

function _validate_llamacpp() {
  local endpoint="http://macminim1.rollet.family:8080"
  local response
  response=$(curl -s --max-time 3 "${endpoint}/health" 2>/dev/null)
  if echo "$response" | grep -q '"status"'; then
    return 0
  fi
  return 1
}

function _validate_claude_code() {
  command -v claude &>/dev/null || return 1
  # API key auth
  [[ -n "$ANTHROPIC_API_KEY" ]] && return 0
  # OAuth session - use `claude auth status` to check if logged in
  if claude auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    return 0
  fi
  return 1
}

# Check internet connectivity using curl or dig (not ping)
function _is_online() {
  if command -v curl &>/dev/null; then
    curl -sf --max-time 2 --connect-timeout 1 https://1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  if command -v dig &>/dev/null; then
    dig +time=1 +tries=1 @1.1.1.1 cloudflare.com >/dev/null 2>&1 && return 0
  fi
  if command -v ping &>/dev/null; then
    ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 && return 0
  fi
  return 1
}

function _get_ai_provider() {
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local preference_file="$HOME/.ai_provider_preference"
  [[ -f "$session_file" ]] && cat "$session_file" && return 0
  [[ -f "$preference_file" ]] && cat "$preference_file" && return 0
  _validate_claude_code 2>/dev/null && echo "claude-code" && return 0
  echo "github-copilot"
}

# Dispatch validation to the appropriate provider validator
function _validate_provider() {
  case "$1" in
    claude-code)    _validate_claude_code ;;
    github-copilot) _validate_github_copilot ;;
    opencode)       _validate_opencode_zen ;;
    openrouter)     _validate_openrouter ;;
    llama-cpp)      _validate_llamacpp ;;
    *)              return 1 ;;
  esac
}

# Ensure a valid provider is set for this session.
# - No session file: auto-detect silently (no cascade, _get_ai_provider handles it).
# - Session file exists but provider is invalid: re-run aiselect cascade.
function _ensure_ai_provider() {
  local session_file="/tmp/.ai_provider_session_$(id -u)"
  local RED='\033[0;31m'
  local NC='\033[0m'
  [[ ! -f "$session_file" ]] && return 0
  local provider
  provider=$(cat "$session_file")
  if _validate_provider "$provider" 2>/dev/null; then
    return 0
  fi
  echo "${RED}✗${NC} Provider '$provider' is no longer valid — re-running aiselect..."
  rm -f "$session_file"
  aiselect
}

# Hybrid routing: llama-cpp → cloud escalation
# gpc/gpr always local; gpa escalates to cloud on critical/security findings
# Cloud provider stored in ~/.ai_cloud_provider_preference (separate from main provider)
function _get_cloud_fallback_provider() {
  local cloud_pref="$HOME/.ai_cloud_provider_preference"
  if [[ -f "$cloud_pref" ]]; then
    cat "$cloud_pref"
  else
    echo "anthropic"
  fi
}

function _get_cloud_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_cloud_fallback_provider)

  case $provider in
    github-copilot)
      [[ "$task_type" == "opus"  ]] && echo "github-copilot/claude-opus-4.5"  && return
      [[ "$task_type" == "haiku" ]] && echo "github-copilot/claude-haiku-4.5" && return
