# Secrets: ~/.zshrc_envvars (git-ignored, chmod 600)
# Non-sensitive config: ~/.zshrc_envvars_insecure (tracked by git)

# Helper function: Clean OpenCode CLI output by removing ANSI codes and prompts
# Usage: _clean_opencode_output <output>
function _clean_opencode_output() {
  local output="$1"
  # Strip ANSI escape codes (use perl for better escape sequence handling)
  output=$(echo "$output" | perl -pe 's/\e\[[0-9;]*m//g')
  # Remove OpenCode CLI prompt lines (e.g., "> build · claude-haiku-4.5")
  # and extract only content lines (non-empty, non-prompt)
  output=$(echo "$output" | grep -v '^> ' | grep -v '^[[:space:]]*$')
  echo "$output"
}

# Read a single keypress into the named variable.
# After ESC, drains any buffered ANSI escape-sequence tail (e.g. ESC [ from
# arrow keys) so the next read is not poisoned by leftover bytes.
function _read_key() {
  # Reads one keypress into the global _KEY.
  # If ESC is pressed, drains any buffered ANSI tail bytes (e.g. ESC [ from
  # arrow keys) so subsequent reads are not poisoned by leftover input.
  read -k1 _KEY
  if [[ "$_KEY" == $'\e' ]]; then
    local _drain
    read -k10 -t 0.1 _drain 2>/dev/null || true
  fi
}

# Free OpenCode Zen model choice lives in ~/.config/aistack/zen_models.py: the models.dev catalog says what is free,
# `opencode models` says what this account is offered, zen-policy.json (from the Zen docs) says which free models are
# zero-retention. The helpers that used to be here called `opencode models --verbose opencode`, which opencode v2
# rejects, so discovery failed silently and a hardcoded "big-pickle" was used no matter what: nothing would have
# noticed Big Pickle turning paid or being retired. Kept as thin wrappers; they print the reason when nothing is free.
# Prints a bare model id; returns 1 when there is no free model.
function _discover_best_free_zen_model() {
  python3 "${AISTACK_DIR:-$HOME/.config/aistack}/zen_models.py" best
}
function _get_free_zen_model() {
  _discover_best_free_zen_model
}

# AI Command Execution Functions

# `opencode run` is one-shot/headless: it never emits a session.idle event and
# (contrary to an earlier assumption) doesn't reliably fire a
# server.instance.disposed plugin event either. herdr's opencode plugin
# (.config/opencode/plugins/herdr-agent-state.js) registered a session for it
# on startup, but there's no TUI session to return to once the process exits,
# so release the agent registration entirely instead of leaving a stale/idle
# entry behind. Call this right after every `opencode run` invocation.
function _herdr_report_opencode_idle() {
  [[ -z "$HERDR_PANE_ID" || -z "$HERDR_SOCKET_PATH" ]] && return 0
  command -v herdr &>/dev/null || return 0
  herdr pane release-agent "$HERDR_PANE_ID" --source herdr:opencode --agent opencode --seq "$(($(date +%s) * 1000000))" >/dev/null 2>&1
}

# Strips Aider's own chrome (version/model/repo banner, the trailing
# "Tokens: N sent, M received." line), a leaked <think>...</think> block, and
# a markdown code fence wrapping the answer -- GLM in particular wraps JSON
# responses in ```json ... ```, the same fence-stripping gpc/gpa's old
# direct-curl path already needed.
#
# The <think> strip is needed despite model-settings.yml's
# chat_template_kwargs.enable_thinking=false: on the currently loaded model
# (GLM-4.7-Flash via llama-server --reasoning-format none) that setting does
# not stop the block from appearing in the response content -- only removing
# it from a separate reasoning_content field would, and this server config
# doesn't split it out. Verified live: every local-coder-plan/-judge call so
# far has emitted one. The second rule (no closing tag) covers a thinking
# block truncated by max_tokens before it could close -- nothing after an
# unclosed <think> is a usable answer either.
function _aider_extract_response() {
  perl -0777 -pe '
    s/^Warning:.*\n//mg;
    s/^You can skip this check.*\n//mg;
    s/^https:\/\/aider\.chat.*\n//mg;
    s/^Aider v.*\n//mg;
    s/^Model: .*\n//mg;
    s/^Git repo:.*\n//mg;
    s/^Repo-map:.*\n//mg;
    s/^Added .* to the chat.*\n//mg;
    s/^Tokens: .* sent, .* received\.\s*\n?//mg;
    s/<think>.*?<\/think>\s*//is;
    s/<think>.*$//is;
    s/^\s*```(?:json)?\s*\n//;
    s/\n?```\s*$//;
    s/^\s+//;
    s/\s+$//;
  '
}

# Runs a one-shot, read-only (--chat-mode ask, no file attached, no git
# operations) Aider query against this host's llama-server and prints the
# model's cleaned text response. The prompt is passed as the message body,
# not a --read file, matching how gpc/gpa already embed the diff directly in
# the prompt text rather than pointing at a file on disk.
#
# Timeouts for the local model, in seconds. Override per shell with AI_LOCAL_COMMIT_TIMEOUT / AI_LOCAL_REVIEW_TIMEOUT.
# A call has to cover the model's JIT load when it is not loaded (8-13s measured for the 9B, 22s for the 27B), prompt
# processing, and then generation, which dominates: measured generation speed of qwen3.5-9b is 10.6 tok/s on the
# MacMiniM1 and 22.5 tok/s on the MacBookM2Pro (prefill 72 and 156 tok/s). So a commit message (max_tokens 512,
# ~1.5k-token prompt) can take ~90s on the slowest host, and a review (max_tokens 4096, ~1k-token prompt) ~430s when
# the model uses its whole budget. The old 60s / 180s / 240s limits cut those off, and gpc/gpa then fail with
# "timeout" even though the model was working. The defaults leave about 3x headroom for the commit and 2x for the
# review; a hung model is still bounded.
function _local_llm_timeout() {
  case "$1" in
    commit) echo "${AI_LOCAL_COMMIT_TIMEOUT:-300}" ;;
    review) echo "${AI_LOCAL_REVIEW_TIMEOUT:-900}" ;;
    *)      echo "${AI_LOCAL_REVIEW_TIMEOUT:-900}" ;;
  esac
}

# Usage: _run_aider_local <model-alias> <timeout-seconds> <prompt>
# Returns: 0 on success (stdout = cleaned response), 1 on failure (stderr =
# error message matching the same "timeout"/"not reachable" wording the old
# direct-curl branches used, since gpc/gpa's own retry loop greps for those).
function _run_aider_local() {
  local model_alias="$1"
  local timeout_secs="$2"
  local prompt="$3"
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}"
  local settings_file aider_model tmp_settings

  if ! command -v aider &>/dev/null; then
    echo "Error: aider not installed" >&2
    return 1
  fi

  # llama-server serves one model under the alias LOCAL_LLM_MODEL (set in
  # llamacpp-local.nix), so aider is pointed at that and gets a one-entry
  # settings file carrying a per-purpose max_tokens (the alias only picks the cap).
  # chat_template_kwargs.enable_thinking=false goes in extra_body: Qwen3.5 reasons
  # by default and spends max_tokens on it, returning empty content. Verified on
  # llama-server 9190: that kwarg turns thinking off (2 tokens for "ok"), while
  # reasoning_effort "none" is ignored. Only aider (one-shot commit/review/judge
  # calls) disables reasoning; aistack tier 1 (pi, a live session) keeps it.
  local lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
  local lms_max_tokens
  case "$model_alias" in
    local-coder-commit) lms_max_tokens=512 ;;   # one 72-char line; measured ~15-40 tokens
    local-coder-plan)   lms_max_tokens=1024 ;;
    local-coder-judge)  lms_max_tokens=256 ;;
    local-coder-secrets) lms_max_tokens=1536 ;;   # gpa's secrets analysis: a short verdict, but longer than a commit message
    local-coder-review) lms_max_tokens=3072 ;;  # JSON array capped at 10 issues (~1k tokens)
    *)                  lms_max_tokens=4096 ;;
  esac
  # Output cap never above 1/8 of the device's context window (the prompt needs the rest). The per-purpose caps
  # above fit every profile class today (smallest window 32768 -> 4096), so this only bites if a profile shrinks.
  if _llamacpp_profile_load && (( lms_max_tokens > LLAMA_CTX_SIZE / 8 )); then
    lms_max_tokens=$(( LLAMA_CTX_SIZE / 8 ))
  fi
  # Review, judge and secrets calls decide whether a commit goes through, so their sampling is pinned: the same
  # prompt gives the same findings instead of a new set on every run. Commit messages and plans keep the defaults.
  local lms_temperature="" lms_seed=""
  case "$model_alias" in
    local-coder-review|local-coder-judge|local-coder-secrets)
      lms_temperature=$'\n    temperature: 0'
      lms_seed=$'\n      seed: 20261008'
      ;;
  esac
  tmp_settings=$(mktemp "${TMPDIR:-/tmp}/aider-llama-settings.XXXXXX") || {
    echo "Error: could not create aider settings file" >&2
    return 1
  }
  cat > "$tmp_settings" <<EOF
- name: openai/${lms_model}
  edit_format: ask
  extra_params:
    max_tokens: ${lms_max_tokens}${lms_temperature}
    extra_body:${lms_seed}
      chat_template_kwargs:
        enable_thinking: false
EOF
  settings_file="$tmp_settings"
  aider_model="openai/${lms_model}"

  local raw_output
  # BROWSER=true: with --yes-always aider auto-accepts its "Open URL for more info?" offer when a call
  # hits a token limit and would open aider.chat/docs/troubleshooting/token-limits.html in a browser.
  # Python's webbrowser honors $BROWSER, so the page is "opened" with /usr/bin/true instead.
  raw_output=$(BROWSER=true timeout "${timeout_secs}s" aider \
    --model "$aider_model" \
    --openai-api-base "${endpoint}/v1" \
    --openai-api-key "sk-local" \
    --model-settings-file "$settings_file" \
    --no-git \
    --yes-always \
    --chat-mode ask \
    --no-pretty \
    --no-check-update \
    --no-analytics \
    --no-show-model-warnings \
    --no-detect-urls \
    --input-history-file /tmp/.aider-local-input-history \
    --chat-history-file /tmp/.aider-local-chat-history.md \
    --message "$prompt" 2>&1)
  local exit_code=$?
  [[ -n "$tmp_settings" ]] && rm -f "$tmp_settings"

  if [ $exit_code -eq 124 ]; then
    echo "Error: local model timeout after ${timeout_secs}s (raise AI_LOCAL_COMMIT_TIMEOUT or AI_LOCAL_REVIEW_TIMEOUT)" >&2
    return 1
  elif [ $exit_code -ne 0 ]; then
    if echo "$raw_output" | grep -qi "connection\|connect\|refused"; then
      echo "Error: llama-server not reachable (run: sudo launchctl kickstart -k system/org.nixos.llama-server-local)" >&2
    else
      echo "Error: aider failed (exit code: $exit_code): $raw_output" >&2
    fi
    return 1
  fi

  # Aider prints this and exits 0 when finish_reason is "length". What is left is a truncated answer (a
  # cut-off review/commit message) plus aider's error text, which must not be used as the model's reply.
  # (anchored at line start so a review that merely quotes the phrase does not trigger it)
  if echo "$raw_output" | grep -Eq "^Model [^ ]+ has hit a token limit!"; then
    echo "Error: local model hit its token limit (alias $model_alias, max_tokens ${lms_max_tokens}) -- output was truncated and was discarded" >&2
    return 1
  fi

  local extracted=$(echo "$raw_output" | _aider_extract_response)
  if [[ -n "$extracted" ]]; then
    echo "$extracted"
    return 0
  fi

  echo "Error: aider returned empty response" >&2
  return 1
}

# Plain-text call to the local model (commit messages, gpa's secrets analysis). gpa/gpc/gpr only ever run on
# llama.cpp through aider; the one cloud path is gpa's escalation to Claude Code (_run_ai_direct_claude).
# Usage: echo "prompt" | _run_ai_plain
function _run_ai_plain() {
  local prompt=$(cat)

  # Truncate prompt to ~6000 chars to keep it fast for plain-text tasks
  # (commit messages only need a representative sample of the diff)
  local truncated_prompt="${prompt:0:6000}"
  local prompt_len=${#prompt}
  if [ $prompt_len -gt 6000 ]; then
    truncated_prompt="${truncated_prompt}
... [diff truncated at 6000 chars for speed — ${prompt_len} total]"
  fi

  # Routed through Aider instead of a direct curl call -- Aider handles
  # response extraction robustly (its own --chat-mode ask flow), so this
  # replaces what used to be a hand-rolled curl+jq+perl chain here (raw
  # newline JSON parsing, <think> block stripping, markdown fence
  # stripping all lived in this branch and each had its own real bug
  # fixed earlier). The chat_template_kwargs.enable_thinking=false fix is
  # preserved via .config/aider/model-settings.yml's openai/local-coder-commit
  # entry instead of being inlined in the request body here.
  _run_aider_local "${AI_LOCAL_ALIAS:-local-coder-commit}" "$(_local_llm_timeout commit)" "$truncated_prompt"
}

# Structured call to the local model that prints a JSON array (gpa's review and its second look at a finding).
# Exit codes: 0 = valid JSON array, 1 = hard failure (timeout, server down), 2 = reply not parseable ("[]" printed).
# Usage: echo "prompt" | _run_ai_direct
function _run_ai_direct() {
  local prompt=$(cat)

  # Cap the prompt to keep prompt processing reasonable, but keep BOTH ends: the review prompt ends
  # with the instructions ("Output ONLY a JSON array ...", the issue limit), so a plain prefix cut dropped
  # them and the model answered with an unbounded markdown review that ran into max_tokens (seen twice
  # on 2026-10-06, ~3.8k output tokens, cut off mid-sentence). The middle of the diff is what gets omitted.
  # (Output max_tokens comes from _run_aider_local's per-alias cap.)
  local max_chars=6000 tail_chars=2400
  local truncated_prompt="$prompt"
  local prompt_len=${#prompt}
  if [ $prompt_len -gt $max_chars ]; then
    truncated_prompt="${prompt:0:$((max_chars - tail_chars))}
... [diff middle omitted: ${prompt_len} chars total, first $((max_chars - tail_chars)) and last ${tail_chars} kept] ...
${prompt: -$tail_chars}"
  fi

  # The limit comes from _local_llm_timeout (900s by default; see the measurements there): a review that uses its
  # whole 4096-token output budget needs ~430s at the 9B's slowest measured generation speed.
  local aider_output
  aider_output=$(_run_aider_local "local-coder-review" "$(_local_llm_timeout review)" "$truncated_prompt")
  local aider_exit=$?
  if [ $aider_exit -ne 0 ]; then
    echo "$aider_output" >&2
    return 1
  fi

  # _run_aider_local already stripped Aider's own chrome and any markdown fence, but the array-extraction regex
  # stays as a safety net in case the model wraps the array in stray prose.
  if [[ -z "${aider_output//[[:space:]]/}" ]]; then
    echo "Error: Aider returned empty response" >&2
    echo "[]"
    return 2
  fi
  # Error response (first non-empty line starts with "Error:") is a hard
  # failure: never run jq on it, never emit "[]" as if it were valid.
  if echo "$aider_output" | grep -m1 -v '^[[:space:]]*$' | grep -q '^Error:'; then
    echo "Error: Aider returned an error response: $(echo "$aider_output" | head -c 200)" >&2
    return 1
  fi

  local json_extracted=$(echo "$aider_output" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
  if [[ -n "${json_extracted//[[:space:]]/}" ]] && echo "$json_extracted" | jq empty 2>/dev/null; then
    echo "$json_extracted"
    return 0
  fi

  # Soft failure: response not parseable as JSON
  echo "Error: Could not parse aider response as JSON" >&2
  echo "[]"
  return 2
}

# Tier 0 probe: prints "lumo" when a lumo-tamer answers /v1/models with its key, otherwise "local". Tried in order:
# this machine's own tamer (127.0.0.1:3003, key from ~/lumo-tamer-fullhavoc/config.yaml), MacMiniM1's on the home network (key
# from Doppler), then the public endpoint https://lumo.rollet.family/v1 (key from Doppler root_hetzner-cluster, or
# AISTACK_LUMO_PUBLIC_KEY). Each is tried only when the one before does not answer. ralph_mcp.py uses the same order for
# the requests themselves. AISTACK_TIER0=local forces local; AISTACK_TAMER_URL / AISTACK_TAMER_KEY pin one endpoint.
function _aistack_tier0() {
  [[ "${AISTACK_TIER0:-auto}" == "local" ]] && { echo local; return 0; }
  local url key
  _aistack_tamer_ok() {   # url, key -> 0 when /models answers 200
    local -a auth
    [[ -n "$2" ]] && auth=(-H "Authorization: Bearer $2")
    [[ "$(curl -s -m 4 -o /dev/null -w '%{http_code}' "${auth[@]}" "${1%/}/models" 2>/dev/null)" == "200" ]]
  }
  url="${AISTACK_TAMER_URL:-${AISTACK_LUMO_URL:-}}"     # AISTACK_LUMO_URL / _KEY: the older names for the same pin
  if [[ -n "$url" ]]; then
    _aistack_tamer_ok "$url" "${AISTACK_TAMER_KEY:-${AISTACK_LUMO_KEY:-}}" && echo lumo || echo local
    return 0
  fi
  key=$(sed -n 's/^ *apiKey: *"\(.*\)" *$/\1/p' "$HOME/lumo-tamer-fullhavoc/config.yaml" 2>/dev/null | head -1)
  _aistack_tamer_ok "http://127.0.0.1:3003/v1" "$key" && { echo lumo; return 0; }
  key="${AISTACK_TAMER_MINI_KEY:-}"
  if [[ -z "$key" ]] && command -v doppler >/dev/null; then
    key=$(doppler secrets get LUMO_TAMER_API_KEY --project FullHavocJosh --config root_macmini --plain 2>/dev/null)
  fi
  _aistack_tamer_ok "${AISTACK_TAMER_MINI_URL:-http://macminim1.rollet.family:3003/v1}" "$key" && { echo lumo; return 0; }
  key="${AISTACK_LUMO_PUBLIC_KEY:-}"
  if [[ -z "$key" ]] && command -v doppler >/dev/null; then
    key=$(doppler secrets get LUMO_PUBLIC_API_KEY --project FullHavocJosh --config root_hetzner-cluster --plain 2>/dev/null)
  fi
  if [[ -n "$key" ]]; then
    _aistack_tamer_ok "${AISTACK_LUMO_PUBLIC_URL:-https://lumo.rollet.family/v1}" "$key" && { echo lumo; return 0; }
  fi
  echo local
}

# Is the project's GitHub repository private? Prints yes or no. Anything that cannot be confirmed as public (no
# remote, no gh login, offline, not GitHub) counts as private, so code is never sent by accident to a free model that
# may train on it. AISTACK_REPO_PRIVATE=yes|no overrides.
function _aistack_repo_private() {
  [[ "${AISTACK_REPO_PRIVATE:-}" == (yes|no) ]] && { echo "$AISTACK_REPO_PRIVATE"; return 0; }
  local v
  v=$(cd "$1" 2>/dev/null && timeout 10 gh repo view --json isPrivate -q .isPrivate 2>/dev/null)
  [[ "$v" == "false" ]] && echo no || echo yes
}

# _aidev_stack -- the stack behind `aidev` (there is one stack; `aistack` is an alias for `aidev`).
#
# Opens a live pi session on the local llama-server model, which coordinates and never answers the request itself:
#
#   research   the local model looks at the project through budgeted, read-only tools           free
#   draft      Lumo, through lumo-tamer, with online research; it can ask this machine for more   free
#              files. Tried in order: this machine's tamer, MacMiniM1's, https://lumo.rollet.family
#   plan       Claude Code writes prd.json + verify.json in ONE call (ralph_plan)                BILLED
#   build      a free OpenCode Zen model, one task at a time (Claude only when there is none)     free
#   review     Claude Code, once for the whole run; it builds a task only if it keeps failing     BILLED
#
# The run itself is ~/.config/aistack/ralph_driver.py (detached, state under ~/.aistack/<project>/runs/): one task at
# a time through `ralph-tui run`, a task only counts as done when its verify commands exit 0, retry then escalate,
# agents can ask you questions, and a failed review pauses for your decision. pi reaches it through ralph_mcp.py.
#
# Nothing is written into the repository while planning: plan files, runs, reviews and Ralph's own state live in
# ~/.aistack/<project>-<hash> (AISTACK_HOME overrides). In the main checkout of a git repo a gpr worktree + draft PR is
# created when you confirm the plan, and the agents work there. Nothing is committed: use gpc/gpa when you are happy.
#
# The AISTACK_* names of the settings and ~/.config/aistack are kept from before the two commands were merged.
# AISTACK_DIR overrides ~/.config/aistack; AISTACK_PI_EXTRA adds pi flags (tests use "-p").
function _aidev_stack() {
  local task="$*"
  local adir="${AISTACK_DIR:-$HOME/.config/aistack}"
  local cache_dir="$HOME/.cache/nix-darwin-ai"
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}"
  local lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
  local f reply
  # pi waits for ralph_plan: Lumo drafts and may ask for files (AISTACK_LUMO_LOOP_S, 480 s), shortens a long draft
  # (one request, up to 300 s), then one Claude call (AISTACK_PLAN_TIMEOUT_S, 280 s): 480 + 300 + 280 = 1060.
  local stack_name="aidev" mcp_timeout=1200
  local -a need_files
  need_files=(ralph_mcp.py ralph_driver.py task-template.hbs review-template.hbs planner-prompt.md planner-tier0-lumo.md planner-tier0-local.md opencode-auto.sh claude-review.sh claude-work.sh claude-plan.sh claude-fetch.sh zen_models.py zen-policy.json)

  # ---- preflight ---------------------------------------------------------------------------------------------
  for f in $need_files; do
    if [[ ! -e "$adir/$f" ]]; then
      echo "✗ $adir/$f is missing -- run darwin-rebuild so the aistack files are stowed." >&2
      return 1
    fi
  done
  command -v pi >/dev/null || { echo "✗ pi is not installed -- aistack's planner runs in pi." >&2; return 1; }
  command -v python3 >/dev/null || { echo "✗ python3 is not installed." >&2; return 1; }
  command -v jq >/dev/null || { echo "✗ jq is not installed." >&2; return 1; }
  local ralph_bin
  ralph_bin=$(command -v ralph-tui 2>/dev/null || echo "$HOME/.bun/bin/ralph-tui")
  [[ -x "$ralph_bin" ]] || { echo "✗ ralph-tui not found. Install it: bun install -g ralph-tui" >&2; return 1; }

  # A handoff (aidev --handoff) skips pi, so it needs neither the local model nor Lumo.
  local handoff_dir="${AIDEV_HANDOFF_DIR:-}"
  if [[ -z "$handoff_dir" ]] && ! _validate_llamacpp; then
    echo "✗ The local planner model (llama-server, $lms_model) is not usable at $endpoint." >&2
    echo "  It must listen on this machine's loopback only. Start it: sudo launchctl kickstart -k system/org.nixos.llama-server-local" >&2
    echo "  (the model file is ~/models/Qwen3.5-9B-Q4_K_M.gguf; see ~/models/download.log and /tmp/llama-server-local.error.log)" >&2
    return 1
  fi
  if ! _validate_claude_code 2>/dev/null; then
    echo "✗ Claude Code is not logged in (tier 2: fallback worker and reviewer). Run: claude auth login" >&2
    return 1
  fi

  # Tier 1 is chosen later (it depends on whether the repository is private). Until then, and when no free model
  # exists, Claude Code Sonnet does the building: that is billed, so aistack says so and asks first.
  local worker="claude-work" fallback="claude-work" fallback_attempts=0 zen_model=""
  # Model and effort for every Claude call come from the host profile (work.nix / personal.nix set these).
  local claude_model="${AISTACK_CLAUDE_MODEL:-sonnet}" claude_effort="${AISTACK_CLAUDE_EFFORT:-medium}"
  local claude_label="Claude Code $claude_model, $claude_effort effort"
  local worker_label="$claude_label (billed)" fallback_label="$claude_label (billed)"
  local reviewer="claude-review"

  # ---- project and state ---------------------------------------------------------------------------------------
  # Nothing aistack-related is ever written into the repository: plan files, runs, questions, reviews and Ralph's
  # own state live in ~/.aistack/<project key> (AISTACK_HOME overrides ~/.aistack). Planning only reads the project.
  # In a main checkout the agents' worktree + draft PR is created by ralph_run once you have confirmed the plan.
  local project repo_root wt_mode="none"
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  if [[ -n "$repo_root" ]]; then
    project="$repo_root"
    if [[ "$(git rev-parse --path-format=absolute --git-dir)" == "$(git rev-parse --path-format=absolute --git-common-dir)" ]]; then
      wt_mode="create"
    fi
  else
    project="$PWD"
  fi
  local aihome="${AISTACK_HOME:-$HOME/.aistack}" aihome_real
  mkdir -p "$aihome" 2>/dev/null
  aihome_real=$(cd "$aihome" 2>/dev/null && pwd -P)
  if [[ -z "$aihome_real" ]] || git -C "$aihome_real" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "✗ $aihome resolves to ${aihome_real:-nowhere}${aihome_real:+, which is inside a git repository}; aistack keeps its files outside repositories." >&2
    echo "  If it is a symlink that stow made into a dotfiles repo, remove just the link (rm $aihome) and run aistack again." >&2
    return 1
  fi
  local state_dir="$aihome_real/${project:t}-$(echo -n "$project" | shasum | cut -c1-10)"

  # ---- tier 0: Lumo on MacMiniM1, or the local model when it is unreachable ------------------------------------
  local tier0 tier0_label
  if [[ -n "$handoff_dir" ]]; then
    tier0=local
  else
    tier0=$(_aistack_tier0)
  fi
  if [[ "$tier0" == "lumo" ]]; then
    tier0_label="Lumo drafts with online research and asks this machine for the files it needs (own tamer, then MacMiniM1's, then lumo.rollet.family)"
  else
    tier0_label="no Lumo is reachable, so there is no draft from it"
  fi

  # ---- tier 1: a free Zen model chosen for this repository; Claude (billed) only when there is none ---------------
  local t1_note=""
  if _validate_opencode_zen 2>/dev/null; then
    local private choice
    private=$(_aistack_repo_private "$project")
    choice=$(python3 "$adir/zen_models.py" choose --private "$private" 2>/dev/null)
    if [[ -z "$choice" ]]; then
      echo "⚠ tier 1: could not run $adir/zen_models.py to choose a free model."
    else
      zen_model=$(jq -r '.model // empty' <<<"$choice" 2>/dev/null)
      jq -r '.warnings[]?' <<<"$choice" 2>/dev/null | while IFS= read -r w; do echo "⚠ tier 1: $w"; done
      t1_note=$(jq -r '.notes[0] // empty' <<<"$choice" 2>/dev/null)
    fi
    if [[ -n "$zen_model" ]]; then
      worker="opencode-pickle"; worker_label="OpenCode $zen_model (free)"; fallback_attempts=1
    fi
  else
    echo "⚠ tier 1: OpenCode Zen is not set up on this host (no API key)."
  fi
  if [[ -z "$zen_model" ]]; then
    echo "⚠ Tier 1 has no free model, so $claude_label (billed) would build the tasks as well as review them."
    # A handoff usually runs from Claude Code's shell, where `read` gets no answer: never bill without a yes.
    if [[ -n "$handoff_dir" && "${AISTACK_ASSUME_YES:-}" != "1" ]]; then
      echo "✗ Not starting the handoff: run it yourself with AISTACK_ASSUME_YES=1 to let Claude build (billed)." >&2
      return 1
    fi
    if [[ "${AISTACK_ASSUME_YES:-}" != "1" ]]; then
      echo -n "Continue with Claude as tier 1? [Y/n] "
      read -r reply
      [[ "${reply:l}" == "n" ]] && return 1
    fi
  fi

  # ---- per-project files ---------------------------------------------------------------------------------------
  mkdir -p "$state_dir/plan" "$state_dir/ralph/.ralph-tui"
  # Ralph always passes --dangerously-skip-permissions to claude; claude-review is wrapped to drop it, and
  # opencode needs --auto after `run` (see the wrappers' comments).
  {
    cat <<TOML
tracker = "json"
maxIterations = 1
iterationDelay = 1000
autoCommit = false
# Ralph only filters *_API_KEY, *_SECRET_KEY and *_SECRET from the agents it launches, so DOPPLER_TOKEN, AWX_TOKEN,
# HETZNER_API_TOKEN and similar exports from ~/.zshrc_personal would reach agents that can run shell commands.
envExclude = ["*_TOKEN", "*_PAT", "*_PASSWORD", "DOPPLER_*"]
defaultAgent = "$worker"

[errorHandling]
strategy = "skip"
maxRetries = 0
retryDelayMs = 3000

[[agents]]
name = "claude-work"
plugin = "claude"
command = "$adir/claude-work.sh"
timeout = 1500000
  [agents.options]
  model = "$claude_model"

[[agents]]
name = "claude-review"
plugin = "claude"
command = "$adir/claude-review.sh"
timeout = 900000
  [agents.options]
  model = "$claude_model"
TOML
    if [[ -n "$zen_model" ]]; then
      cat <<TOML

[[agents]]
name = "opencode-pickle"
plugin = "opencode"
command = "$adir/opencode-auto.sh"
timeout = 1500000
  [agents.options]
  provider = "opencode"
  model = "$zen_model"
TOML
    fi
  } > "$state_dir/ralph/.ralph-tui/config.toml"

  # ---- handoff: a plan written in an interactive Claude Code session runs without pi ---------------------------------
  if [[ -n "$handoff_dir" ]]; then
    local out
    out=$(cd "$project" && RALPH_MCP_ROOTS="$project" AISTACK_WORKER_AGENT="$worker" AISTACK_FALLBACK_AGENT="$fallback" \
      AISTACK_REVIEW_AGENT="$reviewer" AISTACK_FALLBACK_ATTEMPTS="$fallback_attempts" RALPH_TUI_BIN="$ralph_bin" \
      AISTACK_TIER0="$tier0" AISTACK_STATE_DIR="$state_dir" AISTACK_WORKTREE_MODE="$wt_mode" \
      AISTACK_REVIEW_MODE="${AISTACK_REVIEW_MODE:-batch}" \
      AISTACK_TIERS="plan Claude Code session (handed off); build ${worker_label}; review $claude_label (billed)" \
      python3 "$adir/ralph_mcp.py" --handoff "$project" "$handoff_dir")
    local rc=$?
    print -r -- "$out"
    if (( rc == 0 )); then
      echo "Build:  $worker_label   Review: $claude_label (billed, once)"
      echo "The run continues on its own. Follow it with \`aidev\` in $project (pi offers to follow the active run)."
    fi
    return $rc
  fi

  # URLs typed with the task (RFC 0001): the ones on MCP hosts (Jira, GitHub, Terraform; every one when there is no Lumo)
  # are fetched now by one small billed Claude call, so the local model researches with the ticket in front of it.
  # ralph_plan reuses the cached result; AISTACK_REQUEST_URLS keeps the URLs even if the local model rewords the request.
  local req_urls="" url_block=""
  if [[ "$task" == *http* ]]; then
    req_urls=$(grep -oE 'https?://[^[:space:]]+' <<<"$task" | tr '\n' ' ')
    url_block=$(AISTACK_STATE_DIR="$state_dir" AISTACK_TIER0="$tier0" python3 "$adir/ralph_mcp.py" --fetch-urls "$project" "$task")
  fi

  # pi: isolated agent dir (models.json for llama-server, mcp.json for the bridge), regenerated every run.
  local pi_dir="$cache_dir/aistack-pi/$(echo -n "$project" | shasum | cut -c1-10)"
  mkdir -p "$pi_dir"
  jq -n --arg url "${endpoint}/v1" --arg id "$lms_model" \
    '{providers: {llamacpp: {baseUrl: $url, api: "openai-completions", apiKey: "sk-local", models: [{id: $id, reasoning: true}]}}}' \
    > "$pi_dir/models.json"
  local tiers_text="research local $lms_model; plan $claude_label (billed); build ${worker_label}; review $claude_label (billed)"
  jq -n --arg py "$(command -v python3)" --arg bridge "$adir/ralph_mcp.py" --arg root "$project" \
    --arg worker "$worker" --arg fallback "$fallback" --arg reviewer "$reviewer" --arg fa "$fallback_attempts" \
    --arg ralph "$ralph_bin" --arg tier0 "$tier0" --arg state "$state_dir" --arg wtmode "$wt_mode" --arg reviewmode "${AISTACK_REVIEW_MODE:-batch}" --arg tiers "$tiers_text" --arg to "$mcp_timeout" --arg urls "$req_urls" \
    '{mcpServers: {ralph: {command: $py, args: [$bridge],
       env: {RALPH_MCP_ROOTS: $root, AISTACK_WORKER_AGENT: $worker, AISTACK_FALLBACK_AGENT: $fallback,
             AISTACK_REVIEW_AGENT: $reviewer, AISTACK_FALLBACK_ATTEMPTS: $fa, RALPH_TUI_BIN: $ralph,
             AISTACK_TIER0: $tier0, AISTACK_STATE_DIR: $state, AISTACK_WORKTREE_MODE: $wtmode,
             AISTACK_REVIEW_MODE: $reviewmode, AISTACK_TIERS: $tiers, AISTACK_REQUEST_URLS: $urls},
       exposure: "direct", timeout: ($to|tonumber),
       description: "Runs the confirmed plan through Ralph: worker agents, verification, retries, review. Poll ralph_status."},
      github: {command: "npx", args: ["-y", "@edjl/github-mcp"], exposure: "direct", timeout: 60,
       description: "Read-only GitHub lookups through the logged-in gh (PRs, files, branches, issues)."}}}' \
    > "$pi_dir/mcp.json"

  local prompt
  prompt=$(<"$adir/planner-prompt.md")
  prompt=${prompt//@@PROJECT@@/$project}
  prompt=${prompt//@@PLAN_DIR@@/$state_dir/plan}
  prompt=${prompt//@@STATE_DIR@@/$state_dir}
  prompt=${prompt//@@WORKER@@/$worker_label}
  prompt=${prompt//@@FALLBACK@@/$fallback_label}
  prompt=${prompt//@@REVIEWER@@/$claude_label (billed)}
  prompt=${prompt//@@TIER0_LABEL@@/$tier0_label}
  prompt=${prompt//@@LOCAL_MODEL@@/$lms_model}
  prompt=${prompt//@@TIER0@@/$(<"$adir/planner-tier0-$tier0.md")}

  echo "── $stack_name ──"
  if [[ "$wt_mode" == "create" ]]; then
    echo "Project: $project (read-only while planning; a git worktree + draft PR is created when you confirm the plan)"
  else
    echo "Project: $project (the agents work here)"
  fi
  echo "aidev files: $state_dir (nothing is written into the repository)"
  echo "Research:  local $lms_model in pi (free)   [$tier0_label]"
  echo "Plan:      $claude_label (BILLED: one call, from the local model's research)"
  echo "Build:     $worker_label${t1_note:+   [$t1_note]}"
  echo "Review:    $claude_label (BILLED: one review for the whole run; builds a task only if it keeps failing)"
  echo "Describe what you want; pi researches it, Claude writes the plan, and you confirm before anything runs."
  echo "(The local model is slow: a reply can take a while with nothing visible. That is normal.)"
  echo ""

  # pi gets exactly two MCP servers: ralph (this bridge) and github. Every other server
  # belongs to OpenCode and Claude Code only. github is allowlisted read-only: pr_create, pr_approve and pr_suggest_change
  # stay invisible to the local model (agents may not create, approve or review PRs; see the gpr/gpa workflow hook).
  local github_tools="mcp__github__github_repos_list,mcp__github__github_file_get,mcp__github__github_branch_list,mcp__github__github_pr_list,mcp__github__github_pr_details,mcp__github__github_pr_changes,mcp__github__github_pr_comments_get,mcp__github__github_issues_list"
  # What the local model can call. It has no file tools of pi's own:
  #   repo_tree / repo_read / repo_grep   its only view of the project; the bridge counts the calls and refuses past
  #                                       AISTACK_RESEARCH_CALLS (16). With pi's read/ls it made 90 calls on one request.
  #   ralph_plan                          hands the research to Lumo and Claude Code; it never plans or answers itself
  #   ralph_update_task                   the one way to change a plan; it can only touch the plan files
  # pi's --tools is an allowlist, so anything not named here does not exist for the model.
  local tools="mcp__ralph__repo_tree,mcp__ralph__repo_read,mcp__ralph__repo_grep,mcp__ralph__ralph_validate_plan,mcp__ralph__ralph_plan,mcp__ralph__ralph_update_task,mcp__ralph__ralph_run,mcp__ralph__ralph_status,mcp__ralph__ralph_respond,mcp__ralph__ralph_cancel,mcp__ralph__ralph_runs,$github_tools"
  local session_name="aidev: research local, plan claude, build ${zen_model:-claude}, review claude"
  # A small model weighs the last thing it read most, so the request itself carries the rules.
  [[ -n "$task" ]] && task="REQUEST FROM THE USER: $task

(Rules for you, the coordinator: do NOT answer this request yourself, however broad it is. Look with repo_tree first, then a few repo_read or repo_grep calls (the tools stop you after 16), then call ralph_plan with the request, your brief and the files that matter. Lumo and Claude Code do the thinking; you report what they return.)"
  [[ -n "$url_block" ]] && task+="

CONTENT OF THE URLS IN THE REQUEST (fetched by Claude Code at start; ralph_plan passes it on, so do not try to open the URLs; use it to decide what to look at in the project):$url_block"
  local -a extra
  extra=(${=AISTACK_PI_EXTRA})
  (
    cd "$project" || exit 1
    PI_CODING_AGENT_DIR="$pi_dir" pi --provider llamacpp --model "$lms_model" --name "$session_name" --no-skills \
      --append-system-prompt "$prompt" --tools "$tools" "${extra[@]}" ${task:+"$task"}
  )
  local rc=$?

  # ---- after the session ------------------------------------------------------------------------------------------
  local latest st work_dir
  work_dir=$(jq -r '.work_dir // empty' "$state_dir/project.json" 2>/dev/null)
  [[ -z "$work_dir" ]] && work_dir="$project"
  latest=$(/bin/ls -1 "$state_dir/runs" 2>/dev/null | tail -1)
  if [[ -n "$latest" ]]; then
    st=$(jq -r '"\(.state) / \(.phase)"' "$state_dir/runs/$latest/state.json" 2>/dev/null)
    echo ""
    echo "Last run: $latest -- $st"
    case "$st" in
      running*|waiting_user*) echo "It keeps going without pi. Run $stack_name in $project again and ask pi to follow it." ;;
    esac
    [[ -d "$state_dir/reviews" ]] && echo "Review reports: $state_dir/reviews/"
    echo "Changes are uncommitted in $work_dir -- cd there and use gpc/gpa when you are happy."
  fi
  return $rc
}

# opencode v2: the top-level TUI has no --model flag and treats its first positional as the [project] directory.
# Interactive mode uses `opencode mini`, which takes --model and --prompt; only `run` accepts the message
# positionally. `run` needs --auto: without it every edit and shell permission is refused ("non-interactive run
# cannot ask the user for permission"), so `aidev -p` and gpa's auto-fix printed code instead of changing files.
# --auto approves anything opencode.json does not explicitly deny (the same flag opencode-auto.sh gives Ralph).
function _aidev_opencode() {
  local model="$1" print_mode="$2"
  shift 2
  if $print_mode; then
    opencode run --auto --model "$model" "$@"
    local rc=$?
    _herdr_report_opencode_idle
    return $rc
  elif (( $# > 0 )); then
    opencode mini --model "$model" --prompt "$*"
  else
    opencode mini --model "$model"
  fi
}

# aidev -- the default way to get work done: the planner stack with Claude Code used as little as possible.
#
#   aidev [task words...]        e.g.  aidev add a --json flag to the report command
#   aidev                        then describe the work as pi's first message
#   aidev --direct [args...]     a plain interactive OpenCode Zen session (Big Pickle)
#   aidev -p "prompt"            one headless OpenCode Zen call (any flag means --direct)
#   aidev --handoff DIR          run a plan an interactive Claude Code session wrote (DIR/prd.json, DIR/verify.json;
#                                the /aidev-handoff command writes them): no pi, no billed planning call
#
# Who does what:  the local model in pi talks to you, finds the code and follows the run (free);  Lumo adds a draft
# with online research when MacMiniM1 is reachable (free);  Claude Code writes the plan in ONE call from that research
# (ralph_plan + claude-plan.sh);  OpenCode's free model builds;  Claude Code reviews once at the end.
# The stack itself is _aidev_stack above. `aistack` is an alias for this command.
function aidev() {
  local direct=false handoff=""
  local -a rest
  while (( $# )); do
    case "$1" in
      --handoff) handoff="$2"; shift 2; continue ;;
      --direct) direct=true ;;
      -*) direct=true; rest+=("$1") ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
  if [[ -n "$handoff" ]]; then
    if [[ ! -f "$handoff/prd.json" || ! -f "$handoff/verify.json" ]]; then
      echo "✗ aidev --handoff DIR needs DIR/prd.json and DIR/verify.json (see /aidev-handoff)." >&2
      return 1
    fi
    AIDEV_HANDOFF_DIR="${handoff:A}" _aidev_stack
    return
  fi
  if $direct; then
    _aidev_direct "${rest[@]}"
    return
  fi
  _aidev_stack "${rest[@]}"
}

# ainfo -- the read-only advisor: it researches and advises, it never changes anything. The user is the hands and the brain.
#
#   ainfo [question words...]       interactive: answers the question first, then stays open for follow-ups
#   some-command 2>&1 | ainfo [why]  pipe an error or log in (the words are optional)
#   ainfo -p "question"             one-shot: print the advice and exit
#   ainfo -c                        continue the last session of this project (after pi crashed or you left)
#
# Who does what:  the local model in pi (Qwen) only relays and reports, with no file or shell tools;  Claude Code researches
# with every MCP server and read-only local reads;  Lumo searches the web for documentation and links. Claude asks Lumo
# for every doc, manpage and best practice it wants; Qwen summarizes and shows which recommendations have a source.
#
# Read-only is enforced outside Claude Code: ~/.config/ainfo/ainfo_guard.py is a default-deny PreToolUse hook passed with
# --settings (a plain `claude` run never loads it), Claude runs under a sandbox profile that refuses file writes, and
# the writing built-in tools are disallowed. AWS: the aws CLI with *-ro (OpsReadOnly) profiles and read operations only. Transcripts and state: ~/.ainfo/<project>-<hash> (never inside a repository).
# AINFO_DIR overrides ~/.config/ainfo; AINFO_MAX_CLAUDE_CALLS (3) and AINFO_MAX_LUMO_CALLS (2) cap one question;
# AINFO_CLAUDE_BUDGET_USD (2.0) caps one Claude call; AINFO_SANDBOX=off drops the sandbox profile.
function ainfo() {
  local adir="${AINFO_DIR:-$HOME/.config/ainfo}" sdir="${AISTACK_DIR:-$HOME/.config/aistack}"
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}" lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
  local f a cont=false print_mode=false
  local -a words
  for a in "$@"; do
    case "$a" in
      -c|--continue) cont=true ;;
      -p|--print) print_mode=true ;;
      *) words+=("$a") ;;
    esac
  done
  local task="${words[*]}" piped=""
  if [[ ! -t 0 ]]; then
    piped=$(head -c 60000)
    [[ -n "$piped" ]] && task="${task:+$task

}$piped"
  fi

  for f in ainfo_mcp.py ainfo_guard.py ainfo-prompt.md claude-system.md lumo-prompt.md; do
    [[ -e "$adir/$f" ]] || { echo "✗ $adir/$f is missing -- run darwin-rebuild so the ainfo files are stowed." >&2; return 1; }
  done
  [[ -e "$sdir/ralph_mcp.py" ]] || { echo "✗ $sdir/ralph_mcp.py is missing (ainfo reuses its Lumo endpoint lookup)." >&2; return 1; }
  command -v pi >/dev/null || { echo "✗ pi is not installed." >&2; return 1; }
  command -v python3 >/dev/null || { echo "✗ python3 is not installed." >&2; return 1; }
  command -v jq >/dev/null || { echo "✗ jq is not installed." >&2; return 1; }
  if ! _validate_llamacpp; then
    echo "✗ The local relay model (llama-server, $lms_model) is not usable at $endpoint. Start it: sudo launchctl kickstart -k system/org.nixos.llama-server-local" >&2
    return 1
  fi
  if ! _validate_claude_code 2>/dev/null; then
    echo "✗ Claude Code is not logged in. Run: claude auth login" >&2
    return 1
  fi

  local project repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
  project="${repo_root:-$PWD}"
  local aihome="${AINFO_HOME:-$HOME/.ainfo}" aihome_real
  mkdir -p "$aihome" 2>/dev/null
  aihome_real=$(cd "$aihome" 2>/dev/null && pwd -P)
  if [[ -z "$aihome_real" ]] || git -C "$aihome_real" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "✗ $aihome resolves to ${aihome_real:-nowhere}${aihome_real:+, which is inside a git repository}; ainfo keeps its files outside repositories." >&2
    return 1
  fi
  local state_dir="$aihome_real/${project:t}-$(echo -n "$project" | shasum | cut -c1-10)"
  local pi_dir="$state_dir/pi"
  mkdir -p "$pi_dir"

  local tier0
  tier0=$(_aistack_tier0)
  local lumo_note="Lumo (online docs) reachable"
  [[ "$tier0" == "lumo" ]] || lumo_note="Lumo NOT reachable: advice will carry no online documentation (run lumoreauth, or check lumo-tamer)"
  local claude_model="${AINFO_CLAUDE_MODEL:-${AISTACK_CLAUDE_MODEL:-sonnet}}"

  jq -n --arg url "${endpoint}/v1" --arg id "$lms_model" \
    '{providers: {llamacpp: {baseUrl: $url, api: "openai-completions", apiKey: "sk-local", models: [{id: $id, reasoning: true}]}}}' \
    > "$pi_dir/models.json"
  jq -n --arg py "$(command -v python3)" --arg bridge "$adir/ainfo_mcp.py" --arg root "$project" --arg state "$state_dir" --arg sdir "$sdir" \
    '{mcpServers: {ainfo: {command: $py, args: [$bridge],
       env: {AINFO_PROJECT: $root, AINFO_STATE_DIR: $state, AINFO_AISTACK_DIR: $sdir},
       exposure: "direct", timeout: 90,
       description: "Relays a question to Claude (MCP + local reads) and Lumo (online docs). Read-only. Poll ainfo_wait."}}}' \
    > "$pi_dir/mcp.json"

  local prompt
  prompt=$(<"$adir/ainfo-prompt.md")
  prompt=${prompt//@@PROJECT@@/$project}
  prompt=${prompt//@@STATE_DIR@@/$state_dir}

  echo "── ainfo (read-only advisor) ──"
  echo "Project:  $project"
  echo "Relay:    local $lms_model in pi (free; no file or shell tools)"
  echo "Research: Claude Code $claude_model, all MCP servers, read-only (BILLED, capped per question)   Online: $lumo_note"
  echo "Enforced: guard hook + sandbox + disallowed write tools; nothing here can edit a file. Transcript: $state_dir"
  echo "AWS:      aws CLI with *-ro (OpsReadOnly) profiles and read operations only; expired SSO: Claude runs aws sso login, approve it in the browser"
  echo ""

  local tools="mcp__ainfo__ainfo_investigate,mcp__ainfo__ainfo_ask_claude,mcp__ainfo__ainfo_ask_lumo,mcp__ainfo__ainfo_wait,mcp__ainfo__ainfo_cancel"
  local -a flags extra
  flags=(--provider llamacpp --model "$lms_model" --name "ainfo" --no-skills --append-system-prompt "$prompt" --tools "$tools")
  $cont && flags+=(-c)
  $print_mode && flags+=(-p)
  extra=(${=AINFO_PI_EXTRA})
  (
    cd "$project" || exit 1
    if [[ -n "$piped" && ! $print_mode == true ]]; then
      PI_CODING_AGENT_DIR="$pi_dir" pi "${flags[@]}" "${extra[@]}" ${task:+"$task"} </dev/tty
    else
      PI_CODING_AGENT_DIR="$pi_dir" pi "${flags[@]}" "${extra[@]}" ${task:+"$task"}
    fi
  )
}

# The direct session: OpenCode Zen with the model opencode.json sets (Big Pickle), the stack's coding/editing agent.
# Used by `aidev --direct`, `aidev -p`, and the gpa/gpc fix helpers, which need a model that edits a file now rather
# than a planned run.
function _aidev_direct() {
  local GREEN='\033[0;32m'
  local RED='\033[0;31m'
  local NC='\033[0m'

  if ! _validate_opencode_zen; then
    echo "${RED}✗${NC} OpenCode Zen is not set up on this host (no API key). Run darwin-rebuild switch so Doppler injects it." >&2
    return 1
  fi

  # claude-style -p/--print means one headless call: `opencode run` (see _aidev_opencode).
  local print_mode=false
  local filtered_args=()
  for arg in "$@"; do
    if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
      print_mode=true
    else
      filtered_args+=("$arg")
    fi
  done

  local model=""
  local config_file="$HOME/.config/opencode/opencode.json"
  if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
    model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
  fi
  [[ -z "$model" || "$model" == "null" ]] && model="opencode/big-pickle"

  echo "${GREEN}✓${NC} OpenCode Zen: $model"
  echo ""
  _aidev_opencode "$model" $print_mode "${filtered_args[@]}"
}

# Validation Functions for AI Providers

function _validate_opencode_zen() {
  [[ -n "$OPENCODE_ZEN_API_KEY" ]] && return 0
  [[ -f ~/.zshrc_envvars ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars && return 0
  [[ -f ~/.zshrc_envvars_insecure ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.zshrc_envvars_insecure && return 0
  [[ -f ~/.config/opencode/.env ]] && grep -q "OPENCODE_ZEN_API_KEY" ~/.config/opencode/.env && return 0
  # Check auth.json for OpenCode Zen API key (injected by nix-darwin activation)
  if [[ -f ~/.local/share/opencode/auth.json ]] && command -v jq &>/dev/null; then
    local opencode_key=$(jq -r '.opencode.key // empty' ~/.local/share/opencode/auth.json 2>/dev/null)
    [[ -n "$opencode_key" ]] && return 0
  fi
  return 1
}

# Device profile (RAM class, context, KV cache types): ~/.config/llama/profile.sh, the same file the llama-server
# launcher embeds, so the shell and the server agree. Sets LLAMA_RAM_GB, LLAMA_CLASS, LLAMA_CTX_SIZE, LLAMA_KV_K/V.
function _llamacpp_profile_load() {
  local f="${LLAMA_PROFILE_FILE:-$HOME/.config/llama/profile.sh}"
  [[ -r "$f" ]] || return 1
  source "$f" && llama_profile
}

function _llamacpp_model_tier() {
  if _llamacpp_profile_load; then
    echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b} (llama.cpp, ${LLAMA_RAM_GB} GB device, ${LLAMA_CLASS} profile)"
  else
    echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b} (llama.cpp)"
  fi
}

# llamacpp_profile: what the device profile says versus what the running llama-server was started with.
# A mismatch means the server predates the profile: run darwin-rebuild switch (it restarts the launchd job).
function llamacpp_profile() {
  _llamacpp_profile_load || { echo "✗ ~/.config/llama/profile.sh is missing -- run darwin-rebuild so it is stowed." >&2; return 1; }
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}" args run_ctx run_k run_v
  echo "Device:   ${LLAMA_RAM_GB} GB -> ${LLAMA_CLASS}"
  echo "Profile:  ctx=${LLAMA_CTX_SIZE} kv=${LLAMA_KV_K}/${LLAMA_KV_V}"
  args=$(ps -axo command | grep '[l]lama-server --model' | head -1)
  if [[ -z "$args" ]]; then echo "Running:  no llama-server process"; return 0; fi
  run_ctx=$(sed -n 's/.*--ctx-size \([0-9]*\).*/\1/p' <<<"$args")
  run_k=$(sed -n 's/.*--cache-type-k \([a-z0-9_]*\).*/\1/p' <<<"$args")
  run_v=$(sed -n 's/.*--cache-type-v \([a-z0-9_]*\).*/\1/p' <<<"$args")
  echo "Running:  ctx=${run_ctx:-?} kv=${run_k:-?}/${run_v:-?} ($endpoint)"
  if [[ "$run_ctx" == "$LLAMA_CTX_SIZE" && "$run_k" == "$LLAMA_KV_K" && "$run_v" == "$LLAMA_KV_V" ]]; then
    echo "✓ running server matches the profile"
  else
    echo "⚠ running server differs from the profile: darwin-rebuild switch restarts it with the profile"
  fi
}


# Name kept for the callers; the local model is now whatever LOCAL_LLM_MODEL
# names (set in llamacpp-local.nix).
function _llamacpp_model_short() {
  echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
}


function _validate_llamacpp() {
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}"
  local lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
  # Local AI only ever talks to llama-server on this machine's loopback. Reject
  # any other host (a stray LLAMA_CPP_HOST pointing at another device, a LAN
  # address, a hostname) before sending a prompt anywhere.
  case "$endpoint" in
    http://127.0.0.1:*|http://localhost:*|http://\[::1\]:*) ;;
    *) return 1 ;;
  esac
  # llama-server answers /v1/models with its --alias; it only lists the model
  # once it is loaded and ready.
  curl -s --max-time 3 "${endpoint}/v1/models" 2>/dev/null | grep -q "\"${lms_model}\""
}

function _validate_claude_code() {
  command -v claude &>/dev/null || return 1
  # API key auth
  [[ -n "$ANTHROPIC_API_KEY" ]] && return 0
  # OAuth session - use `claude auth status` to check if logged in
  if claude auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    return 0
  fi
  return 1
}

# gpa's one cloud path: a structured review call to Claude Code, used when the local review hard-fails, when it finds
# a Critical security issue and the user escalates, or when --tier names a model. Never runs under AI_LOCAL_ONLY
# (gpa-local, or plain gpa on hosts that set AI_LOCAL_DEFAULT): the callers check that. Billed, so it is small:
#   --tools ""                the diff is in the prompt; no file, shell or web tools
#   --setting-sources ""      no user/project settings, so no hooks, plugins or permission rules run here
#   --strict-mcp-config       no MCP servers
#   --json-schema             Claude Code validates the reply; the issues come back in .structured_output
#   --max-budget-usd          hard cap for the one call (GPA_CLAUDE_BUDGET_USD)
# Prints a JSON array with the same exit codes as _run_ai_direct: 0 ok, 1 hard failure, 2 unparseable ("[]" printed).
# Usage: echo "prompt" | _run_ai_direct_claude [haiku|sonnet|opus]
function _run_ai_direct_claude() {
  local model="${1:-sonnet}"
  local prompt=$(cat)
  if ! _validate_claude_code; then
    echo "Error: Claude Code is not logged in (run: claude auth login)" >&2
    return 1
  fi
  local schema='{"type":"object","required":["issues"],"properties":{"issues":{"type":"array","items":{"type":"object",
"required":["file","severity","issue","recommendation","category","evidence"],"properties":{"file":{"type":"string"},
"severity":{"type":"string","enum":["Critical","Warning"]},"issue":{"type":"string"},"recommendation":{"type":"string"},
"category":{"type":"string","enum":["secret-exposure","injection","destructive-command","broken-syntax","auth-bypass","other"]},
"evidence":{"type":"string"}}}}}}'
  local result exit_code errf
  errf=$(mktemp "${TMPDIR:-/tmp}/gpa-claude-err.XXXXXX") || return 1
  result=$(print -r -- "$prompt" | timeout "${GPA_CLAUDE_TIMEOUT:-180}s" claude -p --model "$model" --effort medium \
    --tools "" --setting-sources "" --strict-mcp-config --disable-slash-commands --no-session-persistence \
    --max-budget-usd "${GPA_CLAUDE_BUDGET_USD:-0.5}" --output-format json --json-schema "$schema" 2>"$errf")
  exit_code=$?
  local err_text=$(head -c 300 "$errf"); rm -f "$errf"
  if [ $exit_code -eq 124 ]; then
    echo "Error: Claude Code timeout after ${GPA_CLAUDE_TIMEOUT:-180}s" >&2
    return 1
  elif [ $exit_code -ne 0 ] || [[ "$(jq -r '.is_error' <<<"$result" 2>/dev/null)" != "false" ]]; then
    # (not `.is_error // true`: jq's // treats false as missing, so it would turn every success into a failure)
    echo "Error: Claude Code call failed (exit $exit_code): ${err_text:-$(print -r -- "$result" | head -c 200)}" >&2
    return 1
  fi
  local issues
  issues=$(jq -c '.structured_output.issues // empty' <<<"$result" 2>/dev/null)
  if [[ -n "$issues" ]] && jq -e 'type == "array"' <<<"$issues" >/dev/null 2>&1; then
    print -r -- "$issues"
    return 0
  fi
  echo "Error: Claude Code reply had no structured issues" >&2
  echo "[]"
  return 2
}

# Security audit function for AI configuration files
function ai_security_audit() {
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  echo "═══════════════════════════════════════════════════════════"
  echo "AI Configuration Security Audit"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  
  local issues_found=0
  
  # Check ~/.zshrc_envvars permissions
  if [[ -f ~/.zshrc_envvars ]]; then
    # Cross-platform stat command (macOS vs Linux)
    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS
      perms=$(stat -f "%Op" ~/.zshrc_envvars 2>/dev/null | tail -c 4)
    else
      # Linux
      perms=$(stat -c "%a" ~/.zshrc_envvars 2>/dev/null)
    fi
    
    echo "Checking ~/.zshrc_envvars..."
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars'"
      issues_found=$((issues_found + 1))
    fi
    
    # Check if file contains API keys
    if grep -q "API_KEY" ~/.zshrc_envvars; then
      echo "  ${YELLOW}ℹ${NC}  Contains API keys (stored in plain text)"
    fi
  else
    echo "~/.zshrc_envvars: Not found"
  fi
  
  echo ""
  
  if [[ -f ~/.zshrc_envvars_insecure ]] || [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target_file=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null || echo ~/.zshrc_envvars_insecure)

    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      perms=$(stat -f "%Op" "$target_file" 2>/dev/null | tail -c 4)
    else
      perms=$(stat -c "%a" "$target_file" 2>/dev/null)
    fi

    echo "Checking ~/.zshrc_envvars_insecure..."
    if [[ -L ~/.zshrc_envvars_insecure ]]; then
      echo "  ${YELLOW}ℹ${NC}  Symlink to: $target_file"
    fi
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      if [[ -L ~/.zshrc_envvars_insecure ]]; then
        echo "    Recommended: Run 'chmod 600 $target_file'"
      else
        echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars_insecure'"
      fi
      issues_found=$((issues_found + 1))
    fi
    
    if grep -q "API_KEY" "$target_file" 2>/dev/null; then
      echo "  ${RED}✗${NC} Contains API keys (should be in ~/.zshrc_envvars instead)"
      issues_found=$((issues_found + 1))
    fi
  fi
  
  echo ""
  
  if [[ -n "$OPENCODE_ZEN_API_KEY" ]]; then
    echo "Environment variables:"
    echo "  ${GREEN}✓${NC} OPENCODE_ZEN_API_KEY is set"
  fi
  
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    echo "  ${GREEN}✓${NC} OPENROUTER_API_KEY is set"
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  
  if [[ $issues_found -eq 0 ]]; then
    echo "${GREEN}✓${NC} No security issues found"
  else
    echo "${RED}✗${NC} Found $issues_found security issue(s)"
  fi
  
  echo "═══════════════════════════════════════════════════════════"
}

# pi: local llama-server qwen/qwen3.5-9b drives the session and owns the tools. ~/.pi/agent/extensions/lumo-first.ts
# sends every message to Lumo first and runs qwen only when Lumo says files or shell are needed (";" at the start
# of a message skips Lumo; PI_LUMO_FIRST=0 turns it off). Strip AWS creds so Bedrock models
# are not auto-detected, strip infra secrets the model could read via env,
# skip AGENTS.md/CLAUDE.md (they reference MCP servers pi does not have),
# and skip startup network calls. Models are defined in ~/.pi/agent/models.json.
#
# -nc and --offline are chat-session flags. Placed before a subcommand (pi mcp list, pi install, pi update, pi auth ...)
# they make pi read the subcommand as a chat message and open the TUI, and --offline would stop update from using the
# network, so subcommands get the same credential scrubbing but no session flags.
function pi() {
  local -a session_flags=(-nc --offline)
  case "$1" in
    install|remove|uninstall|update|list|config|auth|mcp) session_flags=() ;;
  esac
  env -u AWS_PROFILE -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
    -u AWS_BEARER_TOKEN_BEDROCK -u TRUENAS_API_KEY -u OPNSENSE_API_SECRET \
    command pi "${session_flags[@]}" "$@"
}

function _ensure_envvars_permissions() {
  [[ -f ~/.zshrc_envvars ]] && chmod 600 ~/.zshrc_envvars 2>/dev/null

  if [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null)
    [[ -f "$target" ]] && chmod 600 "$target" 2>/dev/null
  elif [[ -f ~/.zshrc_envvars_insecure ]]; then
    chmod 600 ~/.zshrc_envvars_insecure 2>/dev/null
  fi
}

_ensure_envvars_permissions
