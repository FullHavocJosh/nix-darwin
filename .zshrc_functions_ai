# Device profile (RAM class, context, KV cache types): ~/.config/llama/profile.sh, the same file the llama-server
# launcher embeds, so the shell and the server agree. Sets LLAMA_RAM_GB, LLAMA_CLASS, LLAMA_CTX_SIZE, LLAMA_KV_K/V.
function _llamacpp_profile_load() {
  local f="${LLAMA_PROFILE_FILE:-$HOME/.config/llama/profile.sh}"
  [[ -r "$f" ]] || return 1
  source "$f" && llama_profile
}

function _llamacpp_model_tier() {
  if _llamacpp_profile_load; then
    echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b} (llama.cpp, ${LLAMA_RAM_GB} GB device, ${LLAMA_CLASS} profile)"
  else
    echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b} (llama.cpp)"
  fi
}

# llamacpp_profile: what the device profile says versus what the running llama-server was started with.
# A mismatch means the server predates the profile: run darwin-rebuild switch (it restarts the launchd job).
function llamacpp_profile() {
  _llamacpp_profile_load || { echo "✗ ~/.config/llama/profile.sh is missing -- run darwin-rebuild so it is stowed." >&2; return 1; }
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}" args run_ctx run_k run_v
  echo "Device:   ${LLAMA_RAM_GB} GB -> ${LLAMA_CLASS}"
  echo "Profile:  ctx=${LLAMA_CTX_SIZE} kv=${LLAMA_KV_K}/${LLAMA_KV_V}"
  args=$(ps -axo command | grep '[l]lama-server --model' | head -1)
  if [[ -z "$args" ]]; then echo "Running:  no llama-server process"; return 0; fi
  run_ctx=$(sed -n 's/.*--ctx-size \([0-9]*\).*/\1/p' <<<"$args")
  run_k=$(sed -n 's/.*--cache-type-k \([a-z0-9_]*\).*/\1/p' <<<"$args")
  run_v=$(sed -n 's/.*--cache-type-v \([a-z0-9_]*\).*/\1/p' <<<"$args")
  echo "Running:  ctx=${run_ctx:-?} kv=${run_k:-?}/${run_v:-?} ($endpoint)"
  if [[ "$run_ctx" == "$LLAMA_CTX_SIZE" && "$run_k" == "$LLAMA_KV_K" && "$run_v" == "$LLAMA_KV_V" ]]; then
    echo "✓ running server matches the profile"
  else
    echo "⚠ running server differs from the profile: darwin-rebuild switch restarts it with the profile"
  fi
}


# Name kept for the callers; the local model is now whatever LOCAL_LLM_MODEL
# names (set in llamacpp-local.nix).
function _llamacpp_model_short() {
  echo "${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
}


function _validate_llamacpp() {
  local endpoint="${LLAMA_CPP_HOST:-http://127.0.0.1:8080}"
  local lms_model="${LOCAL_LLM_MODEL:-qwen/qwen3.5-9b}"
  # Local AI only ever talks to llama-server on this machine's loopback. Reject
  # any other host (a stray LLAMA_CPP_HOST pointing at another device, a LAN
  # address, a hostname) before sending a prompt anywhere.
  case "$endpoint" in
    http://127.0.0.1:*|http://localhost:*|http://\[::1\]:*) ;;
    *) return 1 ;;
  esac
  # llama-server answers /v1/models with its --alias; it only lists the model
  # once it is loaded and ready.
  curl -s --max-time 3 "${endpoint}/v1/models" 2>/dev/null | grep -q "\"${lms_model}\""
}

function _ai_provider_enabled() {
  local name="$1"
  
  # Check if the environment variable is set
  local var_name="AI_${name}_ENABLED"
  if [[ -n "${(P)var_name}" ]]; then
    # If the env var is set to off, false, no, or 0 (case-insensitive), return 1 (disabled)
    case "${(P)var_name}" in
      [oO][fF][fF]|[fF][aA][lL][sS][eE]|[nN][oO]|[0O])
        return 1
        ;;
      *)
        return 0
        ;;
    esac
  fi
  
  # If env var is not set, check for .off file
  local switches_dir="${${AI_HOME/#\~/$HOME}:-$HOME/.ai}/switches"
  if [[ -f "${switches_dir}/${name}.off" ]]; then
    return 1  # Provider disabled by file
  fi
  
  # Default is enabled
  return 0
}

function _validate_claude_code() {
  _ai_provider_enabled claude || return 1
  command -v claude &>/dev/null || return 1
  # API key auth
  [[ -n "$ANTHROPIC_API_KEY" ]] && return 0
  # OAuth session - use `claude auth status` to check if logged in
  if claude auth status 2>/dev/null | grep -q '"loggedIn": true'; then
    return 0
  fi
  return 1
}

# gpa's one cloud path: a structured review call to Claude Code, used when the local review hard-fails, when it finds
# a Critical security issue and the user escalates, or when --tier names a model. Never runs under AI_LOCAL_ONLY
# (gpa-local, or plain gpa on hosts that set AI_LOCAL_DEFAULT): the callers check that. Billed, so it is small:
#   --tools ""                the diff is in the prompt; no file, shell or web tools
#   --setting-sources ""      no user/project settings, so no hooks, plugins or permission rules run here
#   --strict-mcp-config       no MCP servers
#   --json-schema             Claude Code validates the reply; the issues come back in .structured_output
#   --max-budget-usd          hard cap for the one call (GPA_CLAUDE_BUDGET_USD)
# Prints a JSON array with the same exit codes as _run_ai_direct: 0 ok, 1 hard failure, 2 unparseable ("[]" printed).
# Usage: echo "prompt" | _run_ai_direct_claude [haiku|sonnet|opus]
function _run_ai_direct_claude() {
  local model="${1:-sonnet}"
  local prompt=$(cat)
  if ! _validate_claude_code; then
    echo "Error: Claude Code is not logged in (run: claude auth login)" >&2
    return 1
  fi
  local schema='{"type":"object","required":["issues"],"properties":{"issues":{"type":"array","items":{"type":"object",
"required":["file","severity","issue","recommendation","category","evidence"],"properties":{"file":{"type":"string"},
"severity":{"type":"string","enum":["Critical","Warning"]},"issue":{"type":"string"},"recommendation":{"type":"string"},
"category":{"type":"string","enum":["secret-exposure","injection","destructive-command","broken-syntax","auth-bypass","other"]},
"evidence":{"type":"string"}}}}}}'
  local result exit_code errf
  errf=$(mktemp "${TMPDIR:-/tmp}/gpa-claude-err.XXXXXX") || return 1
  result=$(print -r -- "$prompt" | timeout "${GPA_CLAUDE_TIMEOUT:-180}s" claude -p --model "$model" --effort medium \
    --tools "" --setting-sources "" --strict-mcp-config --disable-slash-commands --no-session-persistence \
    --max-budget-usd "${GPA_CLAUDE_BUDGET_USD:-0.5}" --output-format json --json-schema "$schema" 2>"$errf")
  exit_code=$?
  local err_text=$(head -c 300 "$errf"); rm -f "$errf"
  if [ $exit_code -eq 124 ]; then
    echo "Error: Claude Code timeout after ${GPA_CLAUDE_TIMEOUT:-180}s" >&2
    return 1
  elif [ $exit_code -ne 0 ] || [[ "$(jq -r '.is_error' <<<"$result" 2>/dev/null)" != "false" ]]; then
    # (not `.is_error // true`: jq's // treats false as missing, so it would turn every success into a failure)
    echo "Error: Claude Code call failed (exit $exit_code): ${err_text:-$(print -r -- "$result" | head -c 200)}" >&2
    return 1
  fi
  local issues
  issues=$(jq -c '.structured_output.issues // empty' <<<"$result" 2>/dev/null)
  if [[ -n "$issues" ]] && jq -e 'type == "array"' <<<"$issues" >/dev/null 2>&1; then
    print -r -- "$issues"
    return 0
  fi
  echo "Error: Claude Code reply had no structured issues" >&2
  echo "[]"
  return 2
}

# Security audit function for AI configuration files
function ai_security_audit() {
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m'
  
  echo "═══════════════════════════════════════════════════════════"
  echo "AI Configuration Security Audit"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  
  local issues_found=0
  
  # Check ~/.zshrc_envvars permissions
  if [[ -f ~/.zshrc_envvars ]]; then
    # Cross-platform stat command (macOS vs Linux)
    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      # macOS
      perms=$(stat -f "%Op" ~/.zshrc_envvars 2>/dev/null | tail -c 4)
    else
      # Linux
      perms=$(stat -c "%a" ~/.zshrc_envvars 2>/dev/null)
    fi
    
    echo "Checking ~/.zshrc_envvars..."
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars'"
      issues_found=$((issues_found + 1))
    fi
    
    # Check if file contains API keys
    if grep -q "API_KEY" ~/.zshrc_envvars; then
      echo "  ${YELLOW}ℹ${NC}  Contains API keys (stored in plain text)"
    fi
  else
    echo "~/.zshrc_envvars: Not found"
  fi
  
  echo ""
  
  if [[ -f ~/.zshrc_envvars_insecure ]] || [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target_file=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null || echo ~/.zshrc_envvars_insecure)

    local perms=""
    if [[ "$OSTYPE" == "darwin"* ]]; then
      perms=$(stat -f "%Op" "$target_file" 2>/dev/null | tail -c 4)
    else
      perms=$(stat -c "%a" "$target_file" 2>/dev/null)
    fi

    echo "Checking ~/.zshrc_envvars_insecure..."
    if [[ -L ~/.zshrc_envvars_insecure ]]; then
      echo "  ${YELLOW}ℹ${NC}  Symlink to: $target_file"
    fi
    if [[ "$perms" == "0600" ]] || [[ "$perms" == "600" ]]; then
      echo "  ${GREEN}✓${NC} File permissions: 600 (secure)"
    else
      echo "  ${RED}✗${NC} File permissions: $perms (INSECURE)"
      if [[ -L ~/.zshrc_envvars_insecure ]]; then
        echo "    Recommended: Run 'chmod 600 $target_file'"
      else
        echo "    Recommended: Run 'chmod 600 ~/.zshrc_envvars_insecure'"
      fi
      issues_found=$((issues_found + 1))
    fi
    
    if grep -q "API_KEY" "$target_file" 2>/dev/null; then
      echo "  ${RED}✗${NC} Contains API keys (should be in ~/.zshrc_envvars instead)"
      issues_found=$((issues_found + 1))
    fi
  fi
  
  echo ""
  
  if [[ -n "$OPENCODE_ZEN_API_KEY" ]]; then
    echo "Environment variables:"
    echo "  ${GREEN}✓${NC} OPENCODE_ZEN_API_KEY is set"
  fi
  
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    echo "  ${GREEN}✓${NC} OPENROUTER_API_KEY is set"
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  
  if [[ $issues_found -eq 0 ]]; then
    echo "${GREEN}✓${NC} No security issues found"
  else
    echo "${RED}✗${NC} Found $issues_found security issue(s)"
  fi
  
  echo "═══════════════════════════════════════════════════════════"
}

# pi: local llama-server qwen/qwen3.5-9b drives the session and owns the tools. ~/.pi/agent/extensions/lumo-first.ts
# sends every message to Lumo first and runs qwen only when Lumo says files or shell are needed (";" at the start
# of a message skips Lumo; PI_LUMO_FIRST=0 turns it off). Strip AWS creds so Bedrock models
# are not auto-detected, strip infra secrets the model could read via env,
# skip AGENTS.md/CLAUDE.md (they reference MCP servers pi does not have),
# and skip startup network calls. Models are defined in ~/.pi/agent/models.json.
#
# -nc and --offline are chat-session flags. Placed before a subcommand (pi mcp list, pi install, pi update, pi auth ...)
# they make pi read the subcommand as a chat message and open the TUI, and --offline would stop update from using the
# network, so subcommands get the same credential scrubbing but no session flags.
function pi() {
  local -a session_flags=(-nc --offline)
  case "$1" in
    install|remove|uninstall|update|list|config|auth|mcp) session_flags=() ;;
  esac
  env -u AWS_PROFILE -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
    -u AWS_BEARER_TOKEN_BEDROCK -u TRUENAS_API_KEY -u OPNSENSE_API_SECRET \
    command pi "${session_flags[@]}" "$@"
}

function _ensure_envvars_permissions() {
  [[ -f ~/.zshrc_envvars ]] && chmod 600 ~/.zshrc_envvars 2>/dev/null

  if [[ -L ~/.zshrc_envvars_insecure ]]; then
    local target=$(readlink -f ~/.zshrc_envvars_insecure 2>/dev/null || realpath ~/.zshrc_envvars_insecure 2>/dev/null)
    [[ -f "$target" ]] && chmod 600 "$target" 2>/dev/null
  elif [[ -f ~/.zshrc_envvars_insecure ]]; then
    chmod 600 ~/.zshrc_envvars_insecure 2>/dev/null
  fi
}

_ensure_envvars_permissions
