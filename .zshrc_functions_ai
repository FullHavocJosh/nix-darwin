#
# SECURITY MODEL FOR ENVIRONMENT VARIABLES:
# 
# Two separate files are used for environment variables:
#
# 1. ~/.zshrc_envvars (IGNORED by git)
#    - Stores SENSITIVE data: API keys, tokens, secrets
#    - Plain text storage with chmod 600 (owner read/write only)
#    - Automatically created by aiselect when configuring providers
#    - NEVER committed to git (.gitignore entry exists)
#    - Examples: OPENCODE_API_KEY, OPENROUTER_API_KEY
#
# 2. ~/.zshrc_envvars_insecure (TRACKED by git)
#    - Stores NON-SENSITIVE data: regions, profiles, defaults
#    - Shared with team via git repository
#    - chmod 600 for consistency, but content is public
#    - Examples: AWS_REGION, AWS_PROFILE
#
# Why plain text for secrets?
# - Cross-platform compatibility (macOS & Linux)
# - No external dependencies (keychain only on macOS)
# - File permissions (600) provide adequate protection
# - Users are explicitly warned during key entry
# - Security audit function available: ai_security_audit
#
# Alternative secure storage options (not implemented):
# - macOS Keychain: security add-generic-password (macOS only)
# - pass: Unix password manager (requires GPG setup)
# - Encrypted vaults: age, sops (complex workflows)
#
# =============================================================================

# Helper function: Discover latest Claude model for a provider
# Usage: _discover_latest_model <provider> <model_type>
# model_type can be "sonnet", "haiku", or "opus"
# Returns the highest-versioned base model (no dated variants, no -latest aliases)
function _discover_latest_model() {
  local provider="$1"
  local model_type="$2"
  
  # Get all models for the provider
  local models
  models=$(opencode models "$provider" 2>/dev/null)
  
  if [[ -z "$models" ]]; then
    return 1
  fi
  
  # Filter for the model type keyword
  local filtered_models
  filtered_models=$(echo "$models" | grep -i "$model_type")
  
  if [[ -z "$filtered_models" ]]; then
    return 1
  fi
  
  # Exclude:
  #   - dated variants (lines ending in 8-digit date like -20241022)
  #   - -latest aliases
  # This leaves only canonical versioned names like anthropic/claude-sonnet-4-6
  local base_models
  base_models=$(echo "$filtered_models" | grep -Ev -- '-[0-9]{8}$|-latest$')
  
  if [[ -z "$base_models" ]]; then
    # Fall back to all matches if filtering removed everything
    base_models="$filtered_models"
  fi
  
  # Sort using version sort on the full line — handles both:
  #   hyphen-separated:  anthropic/claude-sonnet-4-6  (treated as version tokens)
  #   dot-separated:     github-copilot/claude-sonnet-4.5
  # sort -V understands numeric segments so 4-6 > 4-5 > 4 > 3-7
  echo "$base_models" | sort -V | tail -1
}

# Helper function: Get OpenCode model string based on provider preference
# Usage: _get_opencode_model ["haiku"|"sonnet"|"opus"]
function _get_opencode_model() {
  local task_type="${1:-sonnet}"
  local provider=$(_get_ai_provider)
  
  # Try to discover the latest model dynamically
  local model=""
  
  if [[ "$task_type" == "haiku" ]]; then
    model=$(_discover_latest_model "$provider" "haiku")
  elif [[ "$task_type" == "opus" ]]; then
    model=$(_discover_latest_model "$provider" "opus")
  else
    model=$(_discover_latest_model "$provider" "sonnet")
  fi
  
  # If discovery succeeded, return the model
  if [[ -n "$model" ]]; then
    echo "$model"
    return 0
  fi
  
  # Fallback to hardcoded models if discovery fails
  # Note: These fallback values should be updated periodically to match latest available models
  case $provider in
    github-copilot)
      if [[ "$task_type" == "opus" ]]; then
        echo "github-copilot/claude-opus-4.5"  # Latest: Opus 4.5 (semantic versioning)
      elif [[ "$task_type" == "haiku" ]]; then
        echo "github-copilot/claude-haiku-4.5"  # Latest: Haiku 4.5
      else
        echo "github-copilot/claude-sonnet-4.5"  # Latest: Sonnet 4.5
      fi
      ;;
    opencode)
      if [[ "$task_type" == "haiku" ]]; then
        echo "opencode/claude-3-5-haiku"  # Latest known Haiku
      elif [[ "$task_type" == "opus" ]]; then
        echo "opencode/claude-opus-4.5"  # Latest: Opus 4.5
      else
        echo "opencode/claude-sonnet-4.5"  # Latest: Sonnet 4.5
      fi
      ;;
    openrouter)
      if [[ "$task_type" == "haiku" ]]; then
        echo "openrouter/anthropic/claude-3.5-haiku"  # Latest known Haiku
      elif [[ "$task_type" == "opus" ]]; then
        echo "openrouter/anthropic/claude-opus-4.5"  # Latest: Opus 4.5
      else
        echo "openrouter/anthropic/claude-sonnet-4.5"  # Latest: Sonnet 4.5
      fi
      ;;
    anthropic)
      if [[ "$task_type" == "haiku" ]]; then
        echo "anthropic/claude-haiku-4-5"
      elif [[ "$task_type" == "opus" ]]; then
        echo "anthropic/claude-opus-4-5"
      else
        echo "anthropic/claude-sonnet-4-5"
      fi
      ;;
    llama-cpp)
      # llama-server is always started with --alias local-coder regardless of
      # which model file was selected by the RAM-aware launcher wrapper script.
      # Shell code never needs to know the RAM tier — the server handles it.
      echo "llama-cpp/local-coder"
      ;;
    *)
      echo "anthropic/claude-sonnet-4-5"  # Default fallback
      ;;
  esac
}

