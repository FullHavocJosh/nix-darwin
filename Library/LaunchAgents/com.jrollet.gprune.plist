<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jrollet.gprune</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<!-- nix-darwin's /etc/zshenv unconditionally resets PATH (via Nix's set-environment)
		     for every zsh invocation, before this -c string even starts running -- so an
		     EnvironmentVariables PATH override here gets silently clobbered before `gh`/`jq`
		     (both under /opt/homebrew/bin, absent from the Nix-only PATH) are looked up.
		     Exporting PATH from inside the command string itself runs after that reset, so
		     it's the only place an override actually sticks. -->
		<string>export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH" &amp;&amp; source ~/.zshrc_functions_git &amp;&amp; gprune</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/gprune.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/gprune.log</string>
</dict>
</plist>
