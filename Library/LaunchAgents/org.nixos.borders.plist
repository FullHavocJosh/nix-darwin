<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>org.nixos.borders</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/borders</string>
		<string>width=8.0</string>
		<string>hidpi=on</string>
		<string>active_color=glow(0xFFCBA6F7)</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/borders.error.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/borders.log</string>
</dict>
</plist>