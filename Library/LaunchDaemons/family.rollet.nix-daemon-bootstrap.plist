<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>family.rollet.nix-daemon-bootstrap</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/usr/bin/launchctl bootstrap system /Library/LaunchDaemons/org.nixos.activate-system.plist; /usr/bin/launchctl bootstrap system /Library/LaunchDaemons/org.nixos.nix-daemon.plist</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>StandardOutPath</key>
	<string>/var/log/nix-daemon-bootstrap.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/nix-daemon-bootstrap.log</string>
</dict>
</plist>
