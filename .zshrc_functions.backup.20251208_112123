    echo ""
    echo "Options:"
    echo "  [m] Manual fix - open tmux workspace with nvim + OpenCode"
    echo "  [a] Auto-fix - let OpenCode fix it automatically"
    echo "  [s] Skip this issue"
    echo "  [q] Quit and proceed to commit"
    echo ""
    echo -n "Your choice: "
    read -r choice
    
    case "$choice" in
      m | M)
        echo ""
        _gpa_create_edit_workspace "$file" "$recommendation"
        
        # Wait for user to finish editing
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "⏸  Waiting for you to finish editing..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "When you're done editing in the new terminal window:"
        echo "  1. Save your changes in nvim"
        echo "  2. Close the terminal window (or exit tmux)"
        echo "  3. Press Enter here to continue"
        echo ""
        echo -n "Press Enter when editing is complete: "
        read -r
        
        # Re-stage the file
        echo ""
        echo "ℹ Re-staging file..."
        git add "$file" 2>/dev/null && echo "  ✓ Re-staged: $file"
        echo ""
        echo "✓ Returning to issue list..."
        echo ""
        ;;
      a | A)
        _gpa_auto_fix "$file" "$recommendation"
        echo ""
        ;;
      s | S)
        echo "⊳ Skipping this issue"
        echo ""
        ;;
      q | Q)
        echo ""
        echo "✓ Proceeding to commit with current changes..."
        echo ""
        gpc
        return $?
        ;;
      *)
        echo "✗ Invalid choice. Skipping this issue."
        echo ""
        ;;
    esac
    
    ((issue_index++))
  done
  
  # All issues processed
  echo "═══════════════════════════════════════════════════════════"
  echo "All issues processed!"
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  echo "Options:"
  echo "  [c] Commit and push changes"
  echo "  [r] Review again with 'gpa'"
  echo "  [q] Quit and keep changes staged"
  echo ""
  echo -n "Your choice: "
  read -r final_choice
  
  case "$final_choice" in
    c | C)
      echo ""
      gpc
      return $?
      ;;
    r | R)
      echo ""
      gpa
      return $?
      ;;
    *)
      echo "ℹ Keeping changes staged."
      return 0
      ;;
  esac
  
}

# Usage: _gpa_review_batch_with_timeout <batch> <batch_num> <total_batches>
# Returns: JSON array of issues or empty array on failure
function _gpa_review_batch_with_timeout() {
  local batch="$1"
  local batch_num="$2"
  local total_batches="$3"
  local timeout=300  # 5 minutes in seconds
  local max_retries=3
  local retry_count=0
  
  while [ $retry_count -lt $max_retries ]; do
    if [ $retry_count -gt 0 ]; then
      echo "  ⚠ Retry attempt $retry_count of $max_retries..." >&2
    fi
    
    # Create a temporary file to store the result
    local tmp_result=$(mktemp)
    local tmp_pid_file=$(mktemp)
    
    # Run the review in a background process
    (
      local result=$(_gpa_review_batch "$batch" "$batch_num" "$total_batches" 2>&1)
      echo "$result" > "$tmp_result"
    ) &
    
    local bg_pid=$!
    echo $bg_pid > "$tmp_pid_file"
    
    # Wait for the process with timeout
    local elapsed=0
    local interval=5
    while kill -0 $bg_pid 2>/dev/null; do
      if [ $elapsed -ge $timeout ]; then
        echo "  ⚠ AI review timed out after ${timeout} seconds" >&2
        kill -9 $bg_pid 2>/dev/null
        wait $bg_pid 2>/dev/null
        rm -f "$tmp_result" "$tmp_pid_file"
        ((retry_count++))
        break
      fi
      sleep $interval
      ((elapsed += interval))
    done
    
    # Check if we broke out due to timeout
    if [ $elapsed -ge $timeout ]; then
      continue
    fi
    
    # Wait for background process to complete
    wait $bg_pid
    local exit_code=$?
    
    # Read the result
    local batch_result=""
    if [ -f "$tmp_result" ]; then
      batch_result=$(cat "$tmp_result")
      rm -f "$tmp_result"
    fi
    rm -f "$tmp_pid_file"
    
    # Validate the result
    if [ $exit_code -eq 0 ] && [ -n "$batch_result" ]; then
      if echo "$batch_result" | jq empty 2>/dev/null; then
        echo "$batch_result"
        return 0
      fi
    fi
    
    # Failed, increment retry
    ((retry_count++))
  done
  
  # All retries failed
  echo "  ✗ AI review failed after $max_retries attempts" >&2
  return 1
}

function gpa() {
  # Git Partial Add with AI code review
  
  # Save current shell options and disable tracing
  local prev_opts=$-
  setopt local_options
  [[ $prev_opts == *x* ]] && setopt no_xtrace

  # Validate git repository
  _check_git_repo || return 1

  # Check if there are ANY changes (staged or unstaged)
  if git diff --quiet && git diff --cached --quiet; then
    echo "⚠ No changes to stage or review"
    return 1
  fi

  # Get git root directory for proper path resolution
  local git_root=$(git rev-parse --show-toplevel)
  local current_dir=$(pwd)
  local relative_to_root="${current_dir#$git_root}"
  relative_to_root="${relative_to_root#/}"  # Remove leading slash if present
  
  # Get list of changed files with status - properly handle filenames with spaces
  local changed_files=()
  local file_status=()
  local display_files=()  # Files as shown by git status (for display)
  
  while IFS= read -r line; do
    # Parse git status --short format: XY filename
    # First 2 chars are status, then space, then filename
    local git_status="${line:0:2}"
    local file="${line:3}"
    
    # Only include unstaged changes (status code in second position)
    # Check for: modified (M), deleted (D), or untracked (??)
    if [[ "$git_status" == " M" || "$git_status" == " D" || "$git_status" == "??" ]]; then
      # Convert path relative to current dir to path relative to git root
      local file_from_root
      if [[ -n "$relative_to_root" ]]; then
        file_from_root="${relative_to_root}/${file}"
      else
        file_from_root="$file"
      fi
      
      changed_files+=("$file_from_root")
      file_status+=("$git_status")
      display_files+=("$file")  # Keep original for display
    fi
  done < <(git status --short)

  # Check if there are already staged changes
  local staged_count=$(git diff --cached --name-only | wc -l | tr -d ' ')
  
  # If there are unstaged changes, let user select what to stage
  if [ ${#changed_files[@]} -gt 0 ]; then
    # Show already-staged files if any
    if [ "$staged_count" -gt 0 ]; then
      echo "Already staged ($staged_count file(s)):"
      git diff --cached --name-status | while IFS=$'\t' read -r status file; do
        echo "  $status $file"
      done
      echo ""
    fi
    
    # Display files with numbers and status like git status
    echo "Select files to stage and review:"
    echo ""
    local i=1
    for idx in {1..${#changed_files[@]}}; do
      local file="${display_files[$idx]}"
      local git_status="${file_status[$idx]}"
      echo "  $i) $git_status $file"
      ((i++))
    done
    echo "  a) All files"
    if [ "$staged_count" -gt 0 ]; then
      echo "  [Enter] Continue with already-staged files only"
    fi
    echo "  q) Quit"
    echo ""
    
    if [ "$staged_count" -gt 0 ]; then
      echo -n "Enter numbers, 'a' for all, Enter to continue with staged, or 'q' to quit: "
    else
      echo -n "Enter numbers separated by spaces (e.g., '1 3 5') or 'a' for all: "
    fi
    read -r selection

    # Handle selection
    case "$selection" in
      q | Q)
        echo "✓ Cancelled"
        return 0
        ;;
      "")
        # Empty input (Enter key)
        if [ "$staged_count" -gt 0 ]; then
          echo "✓ Continuing with $staged_count already-staged file(s)"
        else
          echo "✗ No files are staged"
          return 1
        fi
        ;;
      a | A)
        # Stage all files - run git add from repo root to handle relative paths correctly
        for file in "${changed_files[@]}"; do
          git -C "$git_root" add "$file"
        done
        ;;
      *)
        # Stage selected files
        local selected_files=()
        for num in $selection; do
          if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#changed_files[@]}" ]; then
            # Note: zsh arrays are 1-indexed by default, so we use $num directly
            local selected_file="${changed_files[$num]}"
            if [ -n "$selected_file" ]; then
              selected_files+=("$selected_file")
            fi
          fi
        done

        if [ ${#selected_files[@]} -eq 0 ]; then
          echo "✗ No valid files selected"
          return 1
        fi

        # Stage each file individually - run git add from repo root to handle relative paths correctly
        for file in "${selected_files[@]}"; do
          git -C "$git_root" add "$file"
        done
        ;;
    esac
  else
    # No unstaged changes, but there are staged changes - proceed to review them
    if [ "$staged_count" -gt 0 ]; then
      echo "Already staged ($staged_count file(s)):"
      git diff --cached --name-status | while IFS=$'\t' read -r status file; do
        echo "  $status $file"
      done
      echo ""
      echo "ℹ No unstaged changes found, reviewing already-staged changes..."
    fi
  fi

  # Check if there are staged changes to review
  if git diff --cached --quiet; then
    echo ""
    echo "⚠ No files are staged for review"
    return 0
  fi

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running secrets detection scan..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Run secrets detection using helper function
  if ! _check_for_secrets; then
    echo "✗ Secrets detection aborted commit."
    return 1
  fi
  
  echo "✓ No secrets detected in staged changes"
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running linters on staged files..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  
  # Run linters
  if ! _run_linters; then
    echo "✗ Linting check aborted."
    return 1
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running AI code review on staged changes..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Create batches for review
  echo "ℹ Analyzing staged files and creating review batches..."
  local batches=$(_gpa_create_batches)
  local batch_count=$(echo "$batches" | jq 'length')
  
  if [ "$batch_count" -eq 0 ]; then
    echo "⚠ No files to review"
    return 0
  fi
  
  local total_files=$(git diff --cached --name-only | wc -l)
  local total_lines=$(git diff --cached | wc -l)
  
  echo "ℹ Processing $total_files file(s) in $batch_count batch(es)"
  echo "  Total changes: $total_lines lines"
  echo "  Model: $(_get_opencode_model 'complex')"
  echo ""
  
  # Process each batch and collect all issues
  local all_issues="[]"
  local batch_index=0
  local failed_batches=0
  local ai_review_failed=false
  
  while [ $batch_index -lt $batch_count ]; do
    local batch=$(echo "$batches" | jq -c ".[$batch_index]")
    local batch_num=$((batch_index + 1))
    
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Reviewing batch $batch_num of $batch_count..."
    
    # Review this batch with timeout and retry
    local batch_issues=$(_gpa_review_batch_with_timeout "$batch" "$batch_num" "$batch_count")
    local review_status=$?
    
    if [ $review_status -eq 0 ]; then
      # Merge batch issues into all_issues
      if [ -n "$batch_issues" ] && echo "$batch_issues" | jq empty 2>/dev/null; then
        local issue_count=$(echo "$batch_issues" | jq 'length')
        if [ "$issue_count" -gt 0 ]; then
          echo "  Found $issue_count issue(s) in this batch"
          all_issues=$(echo "$all_issues" | jq --argjson batch "$batch_issues" '. + $batch')
        else
          echo "  ✓ No issues found in this batch"
        fi
      else
        echo "  ⚠ Batch review returned invalid JSON"
        ((failed_batches++))
      fi
    else
      echo "  ✗ Batch review failed completely"
      ((failed_batches++))
    fi
    
    echo ""
    ((batch_index++))
  done
  
  # Check if all batches failed
  if [ $failed_batches -eq $batch_count ]; then
    ai_review_failed=true
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "⚠ WARNING: AI code review could not be completed"
    echo "  All $batch_count batch(es) failed after multiple retry attempts"
    echo ""
    echo "This could be due to:"
    echo "  - Network connectivity issues"
    echo "  - AI service unavailability"
    echo "  - Rate limiting"
    echo ""
    echo -n "Do you want to continue without AI review? [y/N]: "
    read -r skip_review
    
    case "$skip_review" in
      y|Y)
        echo "✓ Continuing without AI review"
        ;;
      *)
        echo "✗ Aborting commit"
        return 1
        ;;
    esac
  elif [ $failed_batches -gt 0 ]; then
    echo "⚠ Warning: $failed_batches of $batch_count batch(es) failed review"
  fi
  
  echo "═══════════════════════════════════════════════════════════"
  
  # Count total issues found
  local total_issue_count=$(echo "$all_issues" | jq 'length')
  
  # Handle case where AI review was skipped or no issues found
  if [ "$ai_review_failed" = true ] || [ "$total_issue_count" -eq 0 ]; then
    # No issues found or review was skipped - proceed directly to commit
    if [ "$ai_review_failed" = true ]; then
      echo "ℹ Proceeding without AI review"
    else
      echo "✓ Code review complete - no critical issues or warnings found"
    fi
    echo ""
    echo "Options:"
    echo "  [Y/Enter] Commit and push - automatically runs 'gpc'"
    echo "  [n] Cancel - keep staged but don't proceed"
    echo ""
    echo -n "Your choice: "
    read -r continue_choice

    case "$continue_choice" in
      y | Y | "")
        echo ""
        echo "✓ Proceeding to commit and push..."
        echo ""
        gpc
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  else
    # Issues found - display summary and enter interactive mode
    echo "⚠ Found $total_issue_count issue(s) across all batches"
    echo ""
    
    # Display a summary of issues by severity
    local critical_count=$(echo "$all_issues" | jq '[.[] | select(.severity == "Critical")] | length')
    local warning_count=$(echo "$all_issues" | jq '[.[] | select(.severity == "Warning")] | length')
    
    if [ "$critical_count" -gt 0 ]; then
      echo "  🔴 Critical: $critical_count"
    fi
    if [ "$warning_count" -gt 0 ]; then
      echo "  🟡 Warning: $warning_count"
    fi
    echo ""
    
    # Enter interactive fix mode
    echo "Entering interactive fix mode..."
    echo ""
    _gpa_interactive_fix "$all_issues"
    return $?
  fi
}

# Validation Functions for AI Providers

# Validate GitHub Copilot authentication
function _validate_github_copilot() {
  # Check if GitHub Copilot is authenticated via OpenCode
  if command -v opencode &>/dev/null; then
    if opencode auth list 2>/dev/null | grep -q "GitHub Copilot"; then
      return 0
    fi
  fi
  
  # Fallback: Check gh CLI authentication
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

# Validate OpenCode Zen API key
function _validate_opencode_zen() {
  # Check for OpenCode API key in environment
  if [[ -n "$OPENCODE_API_KEY" ]]; then
    return 0
  fi
  
  # Check if key is in .zshrc_envvars (not tracked by git)
  if [[ -f ~/.zshrc_envvars ]]; then
    if grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars; then
      return 0
    fi
  fi
  
  # Also check .zshrc_envvars_insecure (for non-sensitive configs, not tracked by git)
  if [[ -f ~/.zshrc_envvars_insecure ]]; then
    if grep -q "OPENCODE_API_KEY" ~/.zshrc_envvars_insecure; then
      return 0
    fi
  fi
  
  return 1
}

# Validate OpenRouter API key
function _validate_openrouter() {
  # Check for OpenRouter API key in environment
  if [[ -n "$OPENROUTER_API_KEY" ]]; then
    return 0
  fi
  
  # Check if key is in .zshrc_envvars (not tracked by git)
  if [[ -f ~/.zshrc_envvars ]]; then
    if grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars; then
      return 0
    fi
  fi
  
  # Also check .zshrc_envvars_insecure (for non-sensitive configs, not tracked by git)
  if [[ -f ~/.zshrc_envvars_insecure ]]; then
    if grep -q "OPENROUTER_API_KEY" ~/.zshrc_envvars_insecure; then
      return 0
    fi
  fi
  
  return 1
}

# AI Provider Selection - System-wide provider preference
# Stores selection in ~/.ai_provider_preference
function aiselect() {
  local preference_file="$HOME/.ai_provider_preference"
  
  # If called with --show or --status, just display current provider
  if [[ "$1" == "--show" ]] || [[ "$1" == "--status" ]]; then
    local current_provider=$(_get_ai_provider)
    local opencode_model=$(_get_opencode_model "complex")
    local opencode_simple_model=$(_get_opencode_model "simple")
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Current AI Configuration"
    echo "═══════════════════════════════════════════════════════════"
    echo "Active Provider: $current_provider"
    echo ""
    echo "Interactive Sessions (aidev/opencode):"
    echo "  Model: $opencode_model"
    echo "  → Launched with -m flag based on aiselect preference"
    echo ""
    echo "Helper Functions:"
    echo "  Simple tasks  (commit msgs): $opencode_simple_model"
    echo "  Complex tasks (code review): $opencode_model"
    echo ""
    echo "Command → Model Mapping:"
    echo "  • aidev                     → $opencode_model"
    echo "  • gpc (commit messages)     → $opencode_simple_model"
    echo "  • gpa (code review)         → $opencode_model"
    echo "  • README generation         → $opencode_model"
    echo ""
    echo "Note: Run 'aiselect' to change provider. Changes apply immediately"
    echo "      to new 'aidev' sessions (no restart required)."
    echo "═══════════════════════════════════════════════════════════"
    return 0
  fi
  
  # Colors for terminal output
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m' # No Color
  
  # Run validations
  echo "Checking AI provider availability..."
  echo ""
  
  local github_valid=false
  local opencode_valid=false
  local openrouter_valid=false
  
  # Validate GitHub Copilot
  if _validate_github_copilot; then
    github_valid=true
  else
    # Offer to authenticate
    echo "${YELLOW}⚠${NC}  GitHub Copilot not authenticated"
    echo ""
    echo -n "Would you like to authenticate now? [Y/n]: "
    read -k1 auth_choice
    echo ""
    
    if [[ "$auth_choice" =~ ^[Yy]$ ]] || [[ -z "$auth_choice" ]]; then
      echo ""
      echo "Opening GitHub device login page..."
      if command -v open &>/dev/null; then
        open "https://github.com/login/device"
      elif command -v xdg-open &>/dev/null; then
        xdg-open "https://github.com/login/device"
      fi
      echo ""
      echo "Starting OpenCode authentication..."
      opencode auth login
      
      # Re-validate
      if _validate_github_copilot; then
        github_valid=true
        echo ""
        echo "${GREEN}✓${NC} GitHub Copilot authenticated successfully!"
      else
        echo ""
        echo "${RED}✗${NC} Authentication failed or was cancelled"
      fi
    fi
    echo ""
  fi
  
  # Validate OpenCode Zen
  if _validate_opencode_zen; then
    opencode_valid=true
  fi
  
  # Validate OpenRouter
  if _validate_openrouter; then
    openrouter_valid=true
  fi
  
  # Display menu with status indicators
  while true; do
    echo "═══════════════════════════════════════════════════════════"
    echo "Select AI Provider:"
    echo "═══════════════════════════════════════════════════════════"
    
    if $github_valid; then
      echo "  [g] GitHub Copilot (default) ${GREEN}✓${NC}"
    else
      echo "  [g] GitHub Copilot (default) ${RED}✗${NC}"
    fi
    
    if $opencode_valid; then
      echo "  [c] OpenCode Zen             ${GREEN}✓${NC}"
    else
      echo "  [c] OpenCode Zen             ${RED}✗${NC}"
    fi
    
    if $openrouter_valid; then
      echo "  [r] OpenRouter               ${GREEN}✓${NC}"
    else
      echo "  [r] OpenRouter               ${RED}✗${NC}"
    fi
    
    echo "  [q] Quit"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo -n "Your choice: "
    
    # Read single character
    local choice
    read -k1 choice
    echo ""
    echo ""
    
    case $choice in
      $'\n' | '' | g | G)
        if $github_valid; then
          echo "github-copilot" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: GitHub Copilot"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "github-copilot" "sonnet")
          local haiku_model=$(_discover_latest_model "github-copilot" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} GitHub Copilot is not available (not authenticated)"
          echo ""
          continue
        fi
        ;;
      c | C)
        if $opencode_valid; then
          echo "opencode" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: OpenCode Zen"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "opencode" "sonnet")
          local haiku_model=$(_discover_latest_model "opencode" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} OpenCode Zen is not available"
          echo "ℹ  Set OPENCODE_API_KEY in ~/.zshrc_envvars (not tracked by git)"
          echo ""
          continue
        fi
        ;;
      r | R)
        if $openrouter_valid; then
          echo "openrouter" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: OpenRouter"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "openrouter" "sonnet")
          local haiku_model=$(_discover_latest_model "openrouter" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} OpenRouter is not available"
          echo "ℹ  Set OPENROUTER_API_KEY in ~/.zshrc_envvars (not tracked by git)"
          echo ""
          continue
        fi
        ;;
      q | Q | $'\e')
        echo "✗ Cancelled"
        return 0
        ;;
      *)
        echo "${RED}✗${NC} Invalid choice. Please select a valid option."
        echo ""
        continue
        ;;
    esac
  done
}

# Helper function to get current AI provider preference
function _get_ai_provider() {
  local preference_file="$HOME/.ai_provider_preference"
  
  # If preference file doesn't exist, default to GitHub Copilot
  if [[ ! -f "$preference_file" ]]; then
    echo "github-copilot"
    return 0
  fi
  
  # Read and return the preference
  cat "$preference_file"
}

# Export AI_PROVIDER environment variable for use in scripts
export AI_PROVIDER=$(_get_ai_provider)

