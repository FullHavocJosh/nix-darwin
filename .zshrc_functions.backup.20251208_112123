# Helper function: Check if current directory is a git repository
function _check_git_repo() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "✗ Error: Not in a git repository"
    return 1
  fi
  return 0
}

# Helper function: Discover latest Claude model for a provider
# Usage: _discover_latest_model <provider> <model_type>
# model_type can be "sonnet" or "haiku"
function _discover_latest_model() {
  local provider="$1"
  local model_type="$2"
  
  # Get all models for the provider
  local models=$(opencode models "$provider" 2>/dev/null)
  
  if [[ -z "$models" ]]; then
    return 1
  fi
  
  # Filter for the model type and sort to get the latest
  local latest_model=""
  
  case $model_type in
    sonnet)
      # Look for sonnet models, prioritizing higher version numbers
      # Use -V for natural version sort (handles 4.5 vs 4 correctly)
      latest_model=$(echo "$models" | grep -i "claude" | grep -i "sonnet" | sort -V | tail -1)
      ;;
    haiku)
      # Look for haiku models, prioritizing higher version numbers
      latest_model=$(echo "$models" | grep -i "claude" | grep -i "haiku" | sort -V | tail -1)
      ;;
  esac
  
  if [[ -n "$latest_model" ]]; then
    echo "$latest_model"
    return 0
  fi
  
  return 1
}

# Helper function: Get OpenCode model string based on provider preference
# Usage: _get_opencode_model ["simple"|"complex"]
function _get_opencode_model() {
  local task_type="${1:-complex}"
  local provider=$(_get_ai_provider)
  
  # Try to discover the latest model dynamically
  local model=""
  
  if [[ "$task_type" == "simple" ]]; then
    model=$(_discover_latest_model "$provider" "haiku")
  else
    model=$(_discover_latest_model "$provider" "sonnet")
  fi
  
  # If discovery succeeded, return the model
  if [[ -n "$model" ]]; then
    echo "$model"
    return 0
  fi
  
  # Fallback to hardcoded models if discovery fails
  case $provider in
    github-copilot)
      if [[ "$task_type" == "simple" ]]; then
        echo "github-copilot/claude-haiku-4.5"
      else
        echo "github-copilot/claude-sonnet-4.5"
      fi
      ;;
    opencode)
      if [[ "$task_type" == "simple" ]]; then
        echo "opencode/claude-3-5-haiku"
      else
        echo "opencode/claude-sonnet-4.5"
      fi
      ;;
    openrouter)
      if [[ "$task_type" == "simple" ]]; then
        echo "openrouter/anthropic/claude-3.5-haiku"
      else
        echo "openrouter/anthropic/claude-sonnet-4.5"
      fi
      ;;
    *)
      echo "github-copilot/claude-sonnet-4.5"  # Default fallback
      ;;
  esac
}

# Helper function: Execute AI command with stdin input
# Usage: echo "prompt" | _run_ai_command ["simple"|"complex"]
function _run_ai_command() {
  local task_type="${1:-complex}"
  local model=$(_get_opencode_model "$task_type")
  
  # Read stdin into a variable
  local prompt=$(cat)
  
  # Always use OpenCode (it supports all providers including GitHub Copilot)
  # OpenCode run takes the prompt as a positional argument
  opencode run --model "$model" "$prompt"
}

# Helper function: Get AI command based on provider preference (DEPRECATED - use _run_ai_command)
# This is kept for backward compatibility but should be replaced
# Usage: _get_ai_command ["simple"|"complex"]
function _get_ai_command() {
  local task_type="${1:-complex}"
  echo "_run_ai_command $task_type"
}

# Launch OpenCode with the selected provider/model
# This replaces the 'aidev' alias to dynamically select model based on aiselect preference
function aidev() {
  local model=$(_get_opencode_model "complex")
  opencode --model "$model" "$@"
}

# Helper function: Generate README.md content using AI
function _generate_readme() {
  local file_list=$(find . -maxdepth 1 -type f ! -name ".*" -exec basename {} \;)

  # README generation needs full model (complex task)
  cat <<EOF | _run_ai_command "complex" 2>/dev/null
Generate a comprehensive README.md for a directory containing these files:

$file_list

The README should include:
1. A clear description of the purpose of the files in this directory
2. Simple usage examples showing the most basic use case
3. Advanced/customized usage examples showing more complex scenarios
4. Any prerequisites or dependencies
5. Proper markdown formatting

Return ONLY the README.md content, starting with a # heading.
EOF
}

function asc() {
  if [ "$1" = "clear" ]; then
    unset -m "AWS_*"
    echo "✓ AWS environment variables unset"
  else
    eval "$(aws configure export-credentials --profile $1 --format env)"
    export AWS_PROFILE=$1
    echo "✓ AWS environment variables set"
  fi
}

function gpr_func() {
  # Validate git repository
  _check_git_repo || return 1

  # Check if there are files in current directory (not subdirectories) and no README.md
  local files_in_dir=$(find . -maxdepth 1 -type f ! -name "README.md" ! -name ".*" | wc -l)

  if [ "$files_in_dir" -gt 0 ] && [ ! -f "README.md" ]; then
    echo "ℹ No README.md found. Generating one with AI..."

    # Generate README.md using helper function
    local readme_content=$(_generate_readme)

    if [ -n "$readme_content" ]; then
      echo "$readme_content" >README.md
      echo "✓ README.md created"
      git add README.md
      git commit -m "docs: Add README.md"
      echo ""
    else
      echo "⚠ Failed to generate README.md"
    fi
  fi

  # Original gpr functionality
  echo "Select type:"
  echo "  1) feat"
  echo "  2) fix"
  echo -n "Enter choice (1 or 2): "
  read type_choice
  case "$type_choice" in
    1) type_prefix="feat" ;;
    2) type_prefix="fix" ;;
    *)
      echo "✗ Invalid choice. Please select 1 or 2"
      return 1
      ;;
  esac
  echo -n "Branch name: "
  read branch_name
  if [ -z "$branch_name" ]; then
    echo "✗ Branch name cannot be empty"
    return 1
  fi
  git checkout -b "$branch_name" &&
    git commit --allow-empty -m "$branch_name" &&
    git push -u origin "$branch_name" &&
    gh pr create --draft --title "$type_prefix: $branch_name" --body "$(
      cat <<EOF
## Description
$type_prefix: $branch_name

## Tickets
$type_prefix: $branch_name
EOF
    )"
}

# Helper function: Create tmux workspace for linting fixes in new terminal window
# Usage: _linter_create_edit_workspace <files_with_issues> <lint_report>
function _linter_create_edit_workspace() {
  local -a files_array
  IFS=$'\n' read -rd '' -A files_array <<< "$1"
  local lint_report="$2"
  
  # Get absolute path to repo root
  local repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  
  # Save the prompt to a temp file to avoid quoting issues
  local prompt_file="/tmp/lint_prompt_$$.txt"
  cat > "$prompt_file" <<EOF
Help me fix the following linting issues. The files are already open in the editor above.

Linting Issues:
$(echo -e "$lint_report")

Files to fix: ${files_array[@]}

Please review the issues and suggest fixes. I can make the changes in the editor above or you can help automate the fixes.
EOF
  
  # Get AI model
  local model=$(_get_opencode_model "complex")
  
  # Open first file with issues in nvim
  local first_file="${files_array[1]}"
  # If file path is relative, make it absolute from repo root
  if [[ ! "$first_file" = /* ]]; then
    first_file="$repo_root/$first_file"
  fi
  
  # Create a session name
  local session_name="lint-fix-$$"
  
  # Create a startup script that will run tmux in the new terminal
  local startup_script="/tmp/lint_startup_$$.sh"
  cat > "$startup_script" <<STARTUP
#!/usr/bin/env bash
# Change to repo root
cd '$repo_root'

# Create tmux session with nvim in top pane and OpenCode in bottom
tmux new-session -s '$session_name' -c '$repo_root' "nvim '$first_file'" \\; \\
  split-window -v -p 30 -c '$repo_root' "bash -c 'echo \"=== OpenCode Linting Assistant ===\"; echo \"\"; opencode --model \"$model\" -p \"\\\$(cat \"$prompt_file\")\"; exec \\\$SHELL'" \\; \\
  select-pane -t 0

# Cleanup temp files after tmux session ends
rm -f '$prompt_file' '$startup_script'
STARTUP
  chmod +x "$startup_script"
  
  # Launch in default terminal
  if command -v xdg-terminal-exec &>/dev/null; then
    # Use xdg-terminal-exec to launch default terminal
    nohup xdg-terminal-exec "$startup_script" >/dev/null 2>&1 &
    echo "✓ Launched editing workspace in new terminal window"
  elif [ -n "$TERMINAL" ] && command -v "$TERMINAL" &>/dev/null; then
    # Use $TERMINAL environment variable
    nohup "$TERMINAL" -e "$startup_script" >/dev/null 2>&1 &
    echo "✓ Launched editing workspace in new terminal window"
  else
    echo "✗ Could not determine default terminal"
    echo "  Set \$TERMINAL environment variable or install xdg-terminal-exec"
    rm -f "$prompt_file" "$startup_script"
    return 1
  fi
  
  echo "  Session: $session_name"
  echo "  Files: ${files_array[@]}"
  echo "  Edit the files in the new window, then close it when done."
  echo ""
}

# Helper function: Run linters on staged files
# Returns 0 if all linters pass or user wants to continue, 1 if user wants to abort
function _run_linters() {
  local files=()
  while IFS= read -r file; do
    files+=("$file")
  done < <(git diff --cached --name-only)
  
  if [ ${#files[@]} -eq 0 ]; then
    return 0
  fi
  
  local linting_issues=false
  local lint_report=""
  local files_with_issues=()
  
  # Check for available linters and verify they work
  local has_nixfmt=false
  local nixfmt_broken=false
  if command -v nixfmt &>/dev/null; then
    local nixfmt_path=$(command -v nixfmt)
    # Check if it's a real binary (not just a text file placeholder)
    if file "$nixfmt_path" | grep -qE "(executable|ELF|Mach-O)"; then
      # Verify nixfmt actually works (not just a placeholder file)
      if nixfmt --version &>/dev/null || nixfmt --help &>/dev/null; then
        has_nixfmt=true
      else
        nixfmt_broken=true
      fi
    else
      # It's a text file or script placeholder
      nixfmt_broken=true
    fi
  fi
  
  local has_prettier=false
  if command -v prettier &>/dev/null; then
    if prettier --version &>/dev/null; then
      has_prettier=true
    fi
  fi
  
  local has_ruff=false
  if command -v ruff &>/dev/null; then
    if ruff --version &>/dev/null; then
      has_ruff=true
    fi
  fi
  
  # Track files that need linters but linters are unavailable
  local missing_linters=false
  local missing_linters_report=""
  
  # Run linters based on file types
  for file in "${files[@]}"; do
    # Skip deleted files
    if [ ! -f "$file" ]; then
      continue
    fi
    
    local file_has_issues=false
    
    case "$file" in
      *.nix)
        if $has_nixfmt; then
          if ! nixfmt --check "$file" 2>/dev/null; then
            lint_report="${lint_report}🟡 $file: nixfmt formatting issues\n"
            linting_issues=true
            file_has_issues=true
          fi
        elif $nixfmt_broken; then
          missing_linters_report="${missing_linters_report}⚠️  $file: nixfmt is broken/unavailable\n"
          missing_linters=true
        else
          missing_linters_report="${missing_linters_report}⚠️  $file: nixfmt not installed\n"
          missing_linters=true
        fi
        ;;
      *.js|*.jsx|*.ts|*.tsx|*.json|*.md|*.yml|*.yaml|*.css|*.html)
        if $has_prettier; then
          if ! prettier --check "$file" 2>/dev/null; then
            lint_report="${lint_report}🟡 $file: prettier formatting issues\n"
            linting_issues=true
            file_has_issues=true
          fi
        else
          missing_linters_report="${missing_linters_report}⚠️  $file: prettier not installed\n"
          missing_linters=true
        fi
        ;;
      *.py)
        if $has_ruff; then
          local ruff_output=$(ruff check "$file" 2>&1)
          if [ -n "$ruff_output" ]; then
            lint_report="${lint_report}🟡 $file: ruff linting issues\n"
            lint_report="${lint_report}   $(echo "$ruff_output" | head -3 | sed 's/^/   /')\n"
            linting_issues=true
            file_has_issues=true
          fi
        else
          missing_linters_report="${missing_linters_report}⚠️  $file: ruff not installed\n"
          missing_linters=true
        fi
        ;;
    esac
    
    if $file_has_issues; then
      files_with_issues+=("$file")
    fi
  done
  
  # Display missing linters warnings if any
  if $missing_linters; then
    echo ""
    echo "⚠️  MISSING OR BROKEN LINTERS"
    echo ""
    echo -e "$missing_linters_report"
    echo "ℹ  Some files could not be checked. Install missing linters:"
    if ! $has_nixfmt || $nixfmt_broken; then
      echo "    • nixfmt: Install via your system package manager or nix profile"
      if $nixfmt_broken; then
        echo "      (Note: Current nixfmt at $(command -v nixfmt) is broken)"
      fi
    fi
    if ! $has_prettier; then
      echo "    • prettier: npm install -g prettier"
    fi
    if ! $has_ruff; then
      echo "    • ruff: pip install ruff or install via system package manager"
    fi
    echo ""
  fi
  
  if $linting_issues; then
    echo ""
    echo "⚠️  LINTING ISSUES DETECTED"
    echo ""
    echo -e "$lint_report"
    echo ""
    echo "Options:"
    echo "  [e] Edit files with AI assistance (opens tmux workspace)"
    echo "  [f] Auto-fix formatting issues (where possible)"
    echo "  [i] Ignore and continue"
    echo "  [q] Quit and fix manually"
    echo ""
    echo -n "Your choice: "
    read -r lint_choice
    
    case "$lint_choice" in
      e | E)
        echo ""
        echo "ℹ Opening tmux workspace for manual fixes with AI assistance..."
        echo "  Top pane: nvim with files"
        echo "  Bottom pane: OpenCode assistant"
        echo ""
        
        # Convert files_with_issues array to newline-separated string
        local files_string=$(printf '%s\n' "${files_with_issues[@]}")
        
        _linter_create_edit_workspace "$files_string" "$lint_report"
        
        # Wait for user to finish editing
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "⏸  Waiting for you to finish editing..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "When you're done editing in the new terminal window:"
        echo "  1. Save your changes in nvim"
        echo "  2. Close the terminal window (or exit tmux)"
        echo "  3. Press Enter here to re-run linting checks"
        echo ""
        echo -n "Press Enter when editing is complete: "
        read -r
        
        # Re-stage the files
        echo ""
        echo "ℹ Re-staging modified files..."
        for file in "${files_with_issues[@]}"; do
          if [ -f "$file" ]; then
            git add "$file"
            echo "  ✓ Re-staged: $file"
          fi
        done
        
        # Re-run linting checks
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "ℹ Re-running linting checks..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        
        # Recursively call _run_linters to check again
        _run_linters
        return $?
        ;;
      f | F)
        echo ""
        echo "ℹ Auto-fixing formatting issues..."
        for file in "${files[@]}"; do
          if [ ! -f "$file" ]; then
            continue
          fi
          
          case "$file" in
            *.nix)
              if $has_nixfmt; then
                echo "  Formatting $file with nixfmt..."
                if nixfmt "$file" 2>&1; then
                  echo "  ✓ Formatted: $file"
                  git add "$file"
                else
                  echo "  ✗ Failed to format: $file"
                fi
              fi
              ;;
            *.js|*.jsx|*.ts|*.tsx|*.json|*.md|*.yml|*.yaml|*.css|*.html)
              if $has_prettier; then
                echo "  Formatting $file with prettier..."
                if prettier --write "$file" 2>&1; then
                  echo "  ✓ Formatted: $file"
                  git add "$file"
                else
                  echo "  ✗ Failed to format: $file"
                fi
              fi
              ;;
            *.py)
              if $has_ruff; then
                echo "  Checking $file with ruff..."
                if ruff check --fix "$file" 2>&1; then
                  echo "  ✓ Fixed: $file"
                  git add "$file"
                else
                  echo "  ✗ Failed to fix: $file"
                fi
              fi
              ;;
          esac
        done
        echo ""
        echo "✓ Auto-fix complete. Files re-staged."
        
        # Re-run linting checks to verify fixes
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "ℹ Re-running linting checks to verify fixes..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        _run_linters
        return $?
        ;;
      i | I)
        echo "⚠️  Proceeding with linting issues!"
        return 0
        ;;
      *)
        echo "✗ Aborting. Fix linting issues manually."
        return 1
        ;;
    esac
  elif ! $missing_linters; then
    # Only show "all good" if we actually checked everything
    echo "✓ No linting issues detected"
  fi
  
  return 0
}

# Helper function: Check staged changes for secrets/credentials
# Returns 0 if safe to proceed, 1 if secrets found and user wants to abort
function _check_for_secrets() {
  local diff_output=$(git diff --cached)
  local added_lines=$(echo "$diff_output" | grep "^+" | grep -v "^+++")
  
  # Filter out false positives: comments, grep patterns, function definitions, variable names
  # Keep only lines that might contain actual secrets
  local filtered_lines=$(echo "$added_lines" | \
    grep -vE '^\+\s*(#|//|/\*)' | \
    grep -v 'grep.*-[qE]' | \
    grep -v 'function _check_for_secrets' | \
    grep -v 'secrets_report=' | \
    grep -v 'if echo.*grep' | \
    grep -v '\.example' | \
    grep -v '\.sample' | \
    grep -v 'YOUR_.*_HERE' | \
    grep -v '<YOUR_' | \
    grep -v 'REPLACE_' | \
    grep -v 'INSERT_' || true)
  
  local secrets_found=false
  local secrets_report=""
  local suspicious_lines=""
  
  # Check for AWS credentials - look for actual AKIA keys or key=value patterns
  if echo "$filtered_lines" | grep -qE "AKIA[0-9A-Z]{16}"; then
    secrets_report="${secrets_report}  • AWS Access Key (AKIA...)\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -E "AKIA[0-9A-Z]{16}" | head -2)\n"
    secrets_found=true
  fi
  
  if echo "$filtered_lines" | grep -qiE "(aws_access_key_id|aws_secret_access_key)\s*=\s*['\"][A-Za-z0-9/+=]{20,}"; then
    secrets_report="${secrets_report}  • AWS credentials in config format\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -iE "(aws_access_key_id|aws_secret_access_key)\s*=\s*['\"]" | head -2)\n"
    secrets_found=true
  fi
  
  # Check for API keys - must have key= or key: with actual value
  if echo "$filtered_lines" | grep -qiE "(api[_-]?key|apikey)\s*[=:]\s*['\"][0-9a-zA-Z_\-]{32,}"; then
    secrets_report="${secrets_report}  • API key\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -iE "(api[_-]?key|apikey)\s*[=:]\s*['\"][0-9a-zA-Z_\-]{32,}" | head -2)\n"
    secrets_found=true
  fi
  
  # Check for passwords - must be in assignment format
  if echo "$filtered_lines" | grep -qiE "(password|passwd)\s*[=:]\s*['\"][^'\"]{8,}['\"]"; then
    secrets_report="${secrets_report}  • Password\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -iE "(password|passwd)\s*[=:]\s*['\"]" | head -2)\n"
    secrets_found=true
  fi
  
  # Check for tokens - must be in assignment format with sufficient length
  if echo "$filtered_lines" | grep -qiE "(secret|token|auth[_-]?token)\s*[=:]\s*['\"][0-9a-zA-Z_\-]{40,}"; then
    secrets_report="${secrets_report}  • Secret/Token\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -iE "(secret|token|auth[_-]?token)\s*[=:]\s*['\"]" | head -2)\n"
    secrets_found=true
  fi
  
  # Check for OpenAI/Stripe keys - very specific patterns
  if echo "$filtered_lines" | grep -qE "sk-[a-zA-Z0-9]{32,}|pk-(live|test)_[a-zA-Z0-9]{24,}"; then
    secrets_report="${secrets_report}  • OpenAI/Stripe API key\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -E "sk-[a-zA-Z0-9]{32,}|pk-(live|test)_" | head -2)\n"
    secrets_found=true
  fi
  
  # Check for GitHub tokens - very specific patterns
  if echo "$filtered_lines" | grep -qE "ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59}"; then
    secrets_report="${secrets_report}  • GitHub token\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -E "ghp_|gho_|github_pat_" | head -2)\n"
    secrets_found=true
  fi
  
  # Check for private keys - actual PEM format
  if echo "$filtered_lines" | grep -qE -- "-----BEGIN (RSA |DSA |EC )?PRIVATE KEY-----"; then
    secrets_report="${secrets_report}  • Private key\n"
    suspicious_lines="${suspicious_lines}$(echo "$filtered_lines" | grep -E -- "-----BEGIN.*PRIVATE KEY-----" | head -2)\n"
    secrets_found=true
  fi
  
  if $secrets_found; then
    echo ""
    echo "🚨 SECRETS DETECTED IN STAGED CHANGES! 🚨"
    echo ""
    echo "Potential secrets found:"
    echo -e "$secrets_report"
    echo ""
    echo "⚠️  Committing secrets to git is a security risk!"
    echo ""
    echo -n "Abort commit? [Y/n]: "
    read -r abort_choice
    
    if [[ "$abort_choice" =~ ^[Yy]$ ]] || [[ -z "$abort_choice" ]]; then
      echo "✗ Commit aborted. Please review and remove secrets."
      return 1
    else
      echo "⚠️  Proceeding with commit despite secrets warning!"
      return 0
    fi
  fi
  
  return 0
}

function gpc() {
  # Validate git repository
  _check_git_repo || return 1

  # Parse arguments
  local skip_readme=false
  if [ "$1" = "--skip-readme" ]; then
    skip_readme=true
    echo "ℹ Skipping README generation"
  fi

  # Check if there are files in current directory (not subdirectories)
  local files_in_dir=$(find . -maxdepth 1 -type f ! -name "README.md" ! -name ".*" | wc -l)

  if [ "$skip_readme" = false ] && [ "$files_in_dir" -gt 0 ]; then
    if [ ! -f "README.md" ]; then
      echo "ℹ No README.md found. Generating one with AI..."

      # Generate README.md using helper function
      local readme_content=$(_generate_readme)

      if [ -n "$readme_content" ]; then
        echo "$readme_content" >README.md
        echo "✓ README.md created"
        git add README.md
      else
        echo "⚠ Failed to generate README.md"
      fi
    else
      # README.md exists, check if staged changes require README update
      if ! git diff --cached --quiet; then
        echo "ℹ Checking if README.md needs updates based on staged changes..."

        local diff_output=$(git diff --cached)
        local staged_files=$(git diff --cached --name-only)

        # Read current README
        local current_readme=$(cat README.md)

        # Ask AI if README needs updating
        # README analysis needs full model (complex task)
        local readme_update=$(
          cat <<EOF | _run_ai_command "complex" 2>/dev/null
Review these staged git changes and the current README.md. Determine if the README.md needs to be updated.

STAGED CHANGES:
$diff_output

CURRENT README.md:
$current_readme

If updates are needed, return the COMPLETE updated README.md content with:
1. Updated description reflecting the changes
2. Updated or new usage examples (both simple and advanced)
3. Proper markdown formatting

If NO updates are needed, return exactly: "NO_UPDATE_NEEDED"
EOF
        )

        if [ "$readme_update" != "NO_UPDATE_NEEDED" ] && [ -n "$readme_update" ]; then
          echo "$readme_update" >README.md
          echo "✓ README.md updated based on staged changes"
          git add README.md
        else
          echo "✓ README.md is up to date"
        fi
      fi
    fi
  fi

  # Check if there are staged changes
  if ! git diff --cached --quiet; then
    echo ""
    echo "ℹ Generating commit message with AI..."

    # Get the diff of staged changes
    local diff_output=$(git diff --cached)

    # Use AI to generate commit message
    # Commit messages can use fast model (simple task)
    local commit_msg=$(echo "Review the following git diff and generate a concise, single-sentence commit message that describes the changes. The message should be in imperative mood (e.g., 'Add feature' not 'Added feature'). Return ONLY the commit message, nothing else.\n\n$diff_output" | _run_ai_command "simple" 2>/dev/null | tail -1)

    # Check if we got a valid response
    if [ -z "$commit_msg" ]; then
      echo "✗ Error: Failed to generate commit message"
      return 1
    fi

    echo "✓ Commit message: $commit_msg"
    echo ""

    # Commit with the generated message
    git commit -m "$commit_msg"

    if [ $? -eq 0 ]; then
      echo ""
      echo "ℹ Pushing to remote..."
      git push
      if [ $? -eq 0 ]; then
        echo "✓ Successfully pushed to remote"
      else
        echo "✗ Push failed"
        return 1
      fi
    else
      echo "✗ Commit failed, skipping push"
      return 1
    fi
  else
    echo "⚠ No staged changes to commit"
    return 1
  fi
}

# Helper function: Create tmux workspace for manual file editing with AI assistance
# Usage: _gpa_create_edit_workspace <file_path> <recommendation_text>
function _gpa_create_edit_workspace() {
  local file_path="$1"
  local recommendation="$2"
  local file_dir=$(dirname "$file_path")
  local file_name=$(basename "$file_path")
  local session_name="gpa-fix-${file_name}-$$"
  
