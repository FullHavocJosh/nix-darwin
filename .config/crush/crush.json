      "Read(~/pscloudops)",
      "Read(~/nix-darwin)",
      "Read(~/codebase-to-course)",
      "Read(~/claude-howto)"
    ],
    "deny": []
  },
  "includeCoAuthoredBy": false,
  "mcp": {
    "memory": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-memory"],
      "type": "stdio"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-sequential-thinking"],
      "type": "stdio"
    },
    "github": {
      "command": "npx",
      "args": ["@edjl/github-mcp"],
      "type": "stdio"
    },
    "terraform": {
      "command": "npx",
      "args": ["terraform-mcp-server"],
      "type": "stdio"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "type": "stdio"
    },
    "aws-core-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.core-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "type": "stdio"
    },
    "aws-terraform-mcp": {
      "command": "uvx",
      "args": ["awslabs.terraform-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "type": "stdio"
    },
    "mcp-server-chart": {
      "command": "npx",
      "args": ["-y", "@antv/mcp-server-chart"],
      "type": "stdio"
    },
    "aws-pricing-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-pricing-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "services"
      },
      "type": "stdio"
    }
  },
  "lsp": {
    "ansible": {
      "command": "ansible-language-server",
      "args": ["--stdio"]
    },
    "bash": {
      "command": "bash-language-server",
      "args": ["start"]
    },
    "dockerfile": {
      "command": "docker-langserver",
      "args": ["--stdio"]
    },
    "go": {
      "command": "gopls"
    },
    "json": {
      "command": "vscode-json-language-server",
      "args": ["--stdio"]
    },
    "lua": {
      "command": "lua-language-server"
    },
    "nix": {
      "command": "nil"
    },
    "python": {
      "command": "pylsp"
    },
    "rust": {
      "command": "rust-analyzer"
    },
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"]
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"]
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"]
    },
    "powershell": {
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$PSES_BUNDLE_PATH = (Get-ChildItem -Path ~/.vscode/extensions/ms-vscode.powershell-*/modules/PowerShellEditorServices | Select-Object -First 1).FullName; Import-Module \"$PSES_BUNDLE_PATH/PowerShellEditorServices.psd1\"; Start-EditorServices -HostName 'Crush' -HostProfileId 'Crush' -HostVersion '1.0.0' -BundledModulesPath $PSES_BUNDLE_PATH -LogLevel Normal -LogPath /tmp/pses.log -SessionDetailsPath /tmp/session.json -FeatureFlags @() -AdditionalModules @() -Stdio"
      ]
    },

    "ruby": {
      "command": "solargraph",
      "args": ["stdio"]
    },
    "xml": {
      "command": "lemminx"
    },
    "toml": {
      "command": "taplo",
      "args": ["lsp", "stdio"]
    }
  }
}
