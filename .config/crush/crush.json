{
  "provider": "bedrock",
  "bedrock": {
    "model": "${ANTHROPIC_MODEL}",
    "region": "${AWS_REGION}",
    "profile": "${AWS_PROFILE}"
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(git *)",
      "Bash(cat *)",
      "Bash(view *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(brew search *)",
      "Bash(brew list *)",
      "Bash(nix *)",
      "Bash(darwin-rebuild *)",
      "Bash(ansible --version)",
      "Bash(ansible --help)",
      "Bash(ansible-config list)",
      "Bash(ansible-config dump)",
      "Bash(ansible-config view)",
      "Bash(ansible-doc *)",
      "Bash(ansible-galaxy list *)",
      "Bash(ansible-galaxy info *)",
      "Bash(ansible-galaxy search *)",
      "Bash(ansible-playbook --check *)",
      "Bash(ansible-playbook --syntax-check *)",
      "Bash(ansible-playbook --list-*)",
      "Bash(ansible-lint *)",
      "Bash(ansible-inventory *)",
      "Bash(terraform init)",
      "Bash(terraform validate)",
      "Bash(terraform plan *)",
      "Bash(terraform fmt *)",
      "Bash(terraform show *)",
      "Bash(terraform state list)",
      "Bash(terraform state show *)",
      "Bash(terraform state pull)",
      "Bash(terraform output *)",
      "Bash(terraform workspace list)",
      "Bash(terraform workspace show)",
      "Bash(terraform providers *)",
      "Bash(terraform version)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go mod *)",
      "Bash(go version)",
      "Bash(python -m py_compile *)",
      "Bash(python -m pytest *)",
      "Bash(python --version)",
      "Bash(cargo build)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo --version)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws sts get-session-token *)",
      "Bash(aws sts assume-role *)",
      "Bash(aws configure list *)",
      "Bash(aws configure get *)",
      "Bash(aws iam get-user *)",
      "Bash(aws iam get-role *)",
      "Bash(aws iam list-*)",
      "Bash(aws iam get-*)",
      "Bash(aws ec2 describe-*)",
      "Bash(aws s3 ls *)",
      "Bash(aws s3 head-object *)",
      "Bash(aws s3api list-*)",
      "Bash(aws s3api get-*)",
      "Bash(aws s3api head-*)",
      "Bash(aws lambda list-*)",
      "Bash(aws lambda get-*)",
      "Bash(aws logs describe-*)",
      "Bash(aws logs get-*)",
      "Bash(aws cloudformation list-*)",
      "Bash(aws cloudformation describe-*)",
      "Bash(aws cloudformation get-*)",
      "Bash(aws eks list-*)",
      "Bash(aws eks describe-*)",
      "Bash(aws rds describe-*)",
      "Bash(aws bedrock list-*)",
      "Bash(aws bedrock get-*)",
      "Bash(aws ssm get-parameter *)",
      "Bash(aws ssm get-parameters *)",
      "Bash(aws ssm describe-parameters *)",
      "Bash(aws secretsmanager list-secrets *)",
      "Bash(aws secretsmanager describe-secret *)",
      "Bash(aws secretsmanager get-secret-value *)",
      "Bash(aws --version)",
      "Bash(aws --help)",
      "Bash(env | grep *)",
      "Bash(echo *)",
      "mcp_sequential-thinking_sequentialthinking",
      "grep",
      "Read(~/pscloudops)",
      "Read(~/nix-darwin)"
    ],
    "deny": [
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "includeCoAuthoredBy": false,
  "mcp": {
    "memory": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-memory"],
      "type": "stdio"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-sequential-thinking"],
      "type": "stdio"
    },
    "github": {
      "command": "npx",
      "args": ["@edjl/github-mcp"],
      "type": "stdio"
    },
    "terraform": {
      "command": "npx",
      "args": ["terraform-mcp-server"],
      "type": "stdio"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "type": "stdio"
    },
    "aws-core-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.core-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "type": "stdio"
    },
    "aws-terraform-mcp": {
      "command": "uvx",
      "args": ["awslabs.terraform-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "type": "stdio"
    },
    "mcp-server-chart": {
      "command": "npx",
      "args": ["-y", "@antv/mcp-server-chart"],
      "type": "stdio"
    },
    "aws-pricing-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-pricing-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "services"
      },
      "type": "stdio"
    }
  },
  "lsp": {
    "ansible": {
      "command": "ansible-language-server",
      "args": ["--stdio"],
      "rootMarkers": [".git", "ansible.cfg", "playbook.yml", "*.yml"]
    },
    "bash": {
      "command": "bash-language-server",
      "args": ["start"],
      "rootMarkers": [".git", "*.sh"]
    },
    "dockerfile": {
      "command": "docker-langserver",
      "args": ["--stdio"],
      "rootMarkers": [".git", "Dockerfile", "docker-compose.yml"]
    },
    "go": {
      "command": "gopls",
      "rootMarkers": [".git", "go.mod", "go.sum"]
    },
    "lua": {
      "command": "lua-language-server",
      "rootMarkers": [".git", "*.lua"]
    },
    "python": {
      "command": "pylsp",
      "rootMarkers": [".git", "pyproject.toml", "setup.py", "requirements.txt"]
    },
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"],
      "rootMarkers": [".git", "*.tf", "terraform.tfvars"]
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "rootMarkers": [".git", "package.json", "tsconfig.json"]
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"],
      "rootMarkers": [".git", "*.yml", "*.yaml"]
    }
  }
}
