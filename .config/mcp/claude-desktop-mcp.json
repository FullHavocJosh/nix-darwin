{
  "mcpServers": {
    "terraform": {
      "command": "npx",
      "args": ["terraform-mcp-server"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "hetzner": {
      "command": "npx",
      "args": ["-y", "@lazyants/hetzner-mcp-server"],
      "env": {
        "HETZNER_API_TOKEN": "${HETZNER_API_TOKEN}"
      }
    },
    "opnsense": {
      "command": "npx",
      "args": ["-y", "@richard-stovall/opnsense-mcp-server"],
      "env": {
        "OPNSENSE_URL": "${OPNSENSE_URL}",
        "OPNSENSE_API_KEY": "${OPNSENSE_API_KEY}",
        "OPNSENSE_API_SECRET": "${OPNSENSE_API_SECRET}",
        "OPNSENSE_VERIFY_SSL": "false"
      }
    },
    "truenas": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "truenas-mcp-server"],
      "env": {
        "TRUENAS_URL": "${TRUENAS_URL}",
        "TRUENAS_API_KEY": "${TRUENAS_API_KEY}"
      }
    },
    "awx": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "--from",
        "git+https://github.com/SurgeX-Labs/awx-mcp-server.git@40870878846c10c8433894a2fbd1be5641ea357d#subdirectory=server",
        "python",
        "-m",
        "awx_mcp_server"
      ],
      "env": {
        "AWX_BASE_URL": "${AWX_BASE_URL}",
        "AWX_TOKEN": "${AWX_TOKEN}"
      }
    },
    "doppler": {
      "command": "npx",
      "args": ["-y", "@dopplerhq/mcp-server"]
    },
    "mcp-stack-fullhavoc": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "__HOME__/mcp-stack-fullhavoc",
        "mcp-stack-fullhavoc"
      ],
      "env": {
        "VG_THRESHOLDS": "comment_ratio=0.4,pr_words=350,ticket_words=500,similarity=0.75,fixme_chatter=5"
      }
    },
    "lumo": {
      "command": "python3",
      "args": ["__HOME__/.config/lumo/lumo_mcp.py"]
    },
    "oczen": {
      "command": "python3",
      "args": ["__HOME__/.config/aistack/oczen_mcp.py"]
    },
    "local-edit": {
      "command": "python3",
      "args": ["__HOME__/.config/aistack/local_edit_mcp.py"]
    }
  }
}
