#!/bin/zsh
# aidev for agents: the `aidev` that OpenCode, pi and scripts find on PATH (~/.local/bin/aidev links here).
# aidev itself is a zsh function (.zshrc_functions_ai); interactive zsh has it, so this is only reached from other
# shells, and it runs the function in an interactive zsh. An agent can use the two headless forms:
#
#   aidev -p "<exact change. Change nothing else.>" <files>   one edit: the on-device 30B, then Big Pickle
#                                                              (AIDEV_TEST_CMD: a check that must pass)
#   aidev --handoff <dir>                                      run a plan the agent wrote (prd.json + verify.json)
#
# Plain `aidev` (the interactive planner in pi) and `aidev --direct` belong in the user's terminal. Never inside an
# aidev run: an agent there building with aidev again would loop.

if [[ -n "${AISTACK_STATE_DIR:-}" ]]; then
  echo "aidev: refusing to start inside an aidev run (AISTACK_STATE_DIR is set)" >&2
  exit 2
fi
case "${1:-}" in
  -p|--print|--handoff) ;;
  *)
    echo "aidev (from an agent): use  aidev -p \"<exact change>\" <files>  or  aidev --handoff <plan dir>." >&2
    echo "Plain aidev and aidev --direct are interactive: give the user the command to run in their terminal." >&2
    exit 2
    ;;
esac
exec zsh -i -c 'aidev "$@"' aidev "$@"
