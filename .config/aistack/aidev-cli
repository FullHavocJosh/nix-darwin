#!/bin/zsh
# aidev for agents: the `aidev` that OpenCode, pi and scripts find on PATH (~/.local/bin/aidev links here).
# aidev itself is a zsh function (.zshrc_functions_tuios); this runs the same script without an interactive zsh.
# An agent can use the two headless forms:
#
#   aidev -p "<exact change. Change nothing else.>" <files>   one edit by a free builder (the on-device 30B, then a
#                                                              free Zen model); blocks; AIDEV_TEST_CMD must pass.
#                                                              Inside tuios the builder works in a pane you can watch
#   aidev --handoff <dir>                                      open a run for a plan the agent wrote and the user
#                                                              approved (prd.json + verify.json); prints one JSON line
#
# Plain `aidev`, --rfc and --direct belong in the user's terminal. Never inside a run's builder (the script refuses
# there too: AIDEV_TUIOS_BUILDER): building with aidev again would loop.

if [[ "${1:-}" != "--handoff" && " $* " != *" -p "* && " $* " != *" --print "* ]]; then
  echo "aidev (from an agent): use  aidev -p \"<exact change>\" <files>  or  aidev --handoff <plan dir>." >&2
  echo "Plain aidev, --rfc and --direct are interactive: give the user the command to run in their terminal." >&2
  exit 2
fi
exec python3 "${AIDEV_TUIOS_DIR:-$HOME/.config/aistack-tuios}/aidev_tuios.py" start "$@"
