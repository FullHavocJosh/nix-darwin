{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (remote)",
      "options": {
        "baseURL": "http://macminim1.rollet.family:8080/v1"
      },
      "models": {
        "local-coder": {
          "name": "Qwen2.5-Coder-7B (remote)",
          "limit": {
            "context": 81920,
            "output": 8192
          }
        }
      }
    }
  },
  "tools": {
    "read": true,
    "grep": true,
    "glob": true,
    "list": true,
    "edit": true,
    "write": true,
    "bash": true,
    "webfetch": true,
    "todoread": true,
    "todowrite": true,
    "patch": true,
    "token-savior_replace_symbol_source": false,
    "token-savior_insert_near_symbol": false,
    "token-savior_get_edit_context": false,
    "token-savior_search_codebase": false,
    "token-savior_ts_search": false
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".yaml",
        ".yml",
        ".md",
        ".html",
        ".css"
      ]
    },
    "nixfmt": {
      "command": ["nixfmt", "$FILE"],
      "extensions": [".nix"]
    },
    "terraform": {
      "command": ["terraform", "fmt", "$FILE"],
      "extensions": [".tf", ".tfvars"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "stylua": {
      "command": ["stylua", "$FILE"],
      "extensions": [".lua"]
    },
    "ruff": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    },
    "gofmt": {
      "command": ["gofmt", "-w", "$FILE"],
      "extensions": [".go"]
    },
    "powershell": {
      "command": [
        "pwsh",
        "-Command",
        "Invoke-Formatter",
        "-ScriptDefinition",
        "$(cat $FILE)"
      ],
      "extensions": [".ps1", ".psm1"]
    },
    "rubocop": {
      "command": ["rubocop", "-a", "$FILE"],
      "extensions": [".rb"]
    },
    "xmllint": {
      "command": ["xmllint", "--format", "$FILE"],
      "extensions": [".xml"]
    },
    "taplo": {
      "command": ["taplo", "format", "$FILE"],
      "extensions": [".toml"]
    },
    "djlint": {
      "command": ["djlint", "--reformat", "$FILE"],
      "extensions": [".j2", ".jinja", ".jinja2"]
    }
  },
  "permission": {
    "bash": {
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "sudo rm *": "deny",
      "sudo rmdir *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "chown -R root *": "deny",
      "dd if=*": "deny",
      "mkfs.*": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "shred *": "deny",
      "> /dev/sd*": "deny",
      ":|:": "deny",
      ":(){ :|:& };:": "deny",
      "*": "ask"
    },
    "edit": "ask",
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "~/codebase-to-course": "allow",
      "~/claude-howto": "allow",
      "*": "ask"
    }
  },
  "lsp": {
    "ansible": {
      "command": ["ansible-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "dockerfile": {
      "command": ["docker-langserver", "--stdio"],
      "extensions": [".dockerfile"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    },
    "nix": {
      "command": ["nil"],
      "extensions": [".nix"]
    },
    "python": {
      "command": ["pylsp"],
      "extensions": [".py", ".pyi"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "terraform": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "powershell": {
      "command": [
        "pwsh",
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$PSES_BUNDLE_PATH = (Get-ChildItem -Path ~/.vscode/extensions/ms-vscode.powershell-*/modules/PowerShellEditorServices | Select-Object -First 1).FullName; Import-Module \"$PSES_BUNDLE_PATH/PowerShellEditorServices.psd1\"; Start-EditorServices -HostName 'OpenCode' -HostProfileId 'OpenCode' -HostVersion '1.0.0' -BundledModulesPath $PSES_BUNDLE_PATH -LogLevel Normal -LogPath /tmp/pses.log -SessionDetailsPath /tmp/session.json -FeatureFlags @() -AdditionalModules @() -Stdio"
      ],
      "extensions": [".ps1", ".psm1", ".psd1"]
    },
    "ruby": {
      "command": ["solargraph", "stdio"],
      "extensions": [".rb"]
    },
    "xml": {
      "command": ["lemminx"],
      "extensions": [".xml"]
    },
    "toml": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "edit": true,
        "write": true,
        "bash": true,
        "webfetch": true
      },
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": {
          "rm -rf /": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~/*": "deny",
          "sudo rm *": "deny",
          "sudo rmdir *": "deny",
          "chmod 777 *": "deny",
          "chmod -R 777 *": "deny",
          "chown -R root *": "deny",
          "dd if=*": "deny",
          "mkfs.*": "deny",
          "fdisk *": "deny",
          "parted *": "deny",
          "shred *": "deny",
          "> /dev/sd*": "deny",
          ":|:": "deny",
          ":(){ :|:& };:": "deny",
          "*": "ask"
        },
        "webfetch": "allow"
      }
    }
  },
  "mcp": {
    "context-guardian": {
      "type": "local",
      "command": [
        "node",
        "{env:HOME}/mcp-context-guardian-perfectserve/dist/index.js"
      ]
    },
    "context-guardian-fullhavoc": {
      "type": "local",
      "command": [
        "node",
        "{env:HOME}/mcp-context-guardian-fullhavoc/dist/index.js"
      ]
    },
    "token-optimizer-mcp": {
      "type": "local",
      "command": ["token-optimizer-mcp"]
    },
    "token-savior": {
      "type": "local",
      "command": ["{env:HOME}/bench/venv-tokensavior/bin/token-savior"],
      "environment": {
        "WORKSPACE_ROOTS": "{env:HOME}",
        "TOKEN_SAVIOR_PROFILE": "core"
      }
    },
    "memory": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-memory@2026.8.31"]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "@modelcontextprotocol/server-sequential-thinking@2026.8.31"
      ]
    },
    "github": {
      "type": "local",
      "command": ["npx", "@edjl/github-mcp@1.0.8"]
    },
    "terraform": {
      "type": "local",
      "command": ["npx", "terraform-mcp-server@0.13.0"]
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@4.1.1"]
    },
    "aws-terraform-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "awslabs.terraform-mcp-server@1.0.18"
      ],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "mcp-server-chart": {
      "type": "local",
      "command": ["npx", "-y", "@antv/mcp-server-chart@0.9.10"]
    },
    "aws-pricing-mcp-server": {
      "type": "local",
      "command": ["uvx", "awslabs.aws-pricing-mcp-server@1.1.1"],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "services"
      }
    },
    "context-mode": {
      "type": "local",
      "command": ["context-mode"]
    },
    "terraform-cloud": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/severity1/terraform-cloud-mcp.git",
        "--with",
        "fastmcp<3",
        "terraform-cloud-mcp"
      ],
      "environment": {
        "TFC_TOKEN": "{env:TFC_TOKEN}"
      }
    },
    "terraform-hcp": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_TOKEN",
        "hashicorp/terraform-mcp-server:latest"
      ],
      "environment": {
        "TFE_TOKEN": "{env:TFE_TOKEN}"
      }
    },
    "hetzner": {
      "type": "local",
      "command": ["npx", "-y", "@lazyants/hetzner-mcp-server@2.5.0"],
      "environment": {
        "HETZNER_API_TOKEN": "{env:HETZNER_API_TOKEN}"
      }
    },
    "opnsense": {
      "type": "local",
      "command": ["npx", "-y", "@richard-stovall/opnsense-mcp-server@0.5.3"],
      "environment": {
        "OPNSENSE_URL": "{env:OPNSENSE_URL}",
        "OPNSENSE_API_KEY": "{env:OPNSENSE_API_KEY}",
        "OPNSENSE_API_SECRET": "{env:OPNSENSE_API_SECRET}",
        "OPNSENSE_VERIFY_SSL": "false"
      }
    },
    "truenas": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2", "truenas-mcp-server@3.0.2"],
      "environment": {
        "TRUENAS_URL": "{env:TRUENAS_URL}",
        "TRUENAS_API_KEY": "{env:TRUENAS_API_KEY}"
      }
    },
    "awx": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp<2",
        "--from",
        "git+https://github.com/SurgeX-Labs/awx-mcp-server.git@40870878846c10c8433894a2fbd1be5641ea357d#subdirectory=server",
        "python",
        "-m",
        "awx_mcp_server"
      ],
      "environment": {
        "AWX_BASE_URL": "{env:AWX_BASE_URL}",
        "AWX_TOKEN": "{env:AWX_TOKEN}"
      }
    },
    "atlassian": {
      "type": "local",
      "command": ["uvx", "mcp-atlassian@0.23.1"],
      "environment": {
        "JIRA_URL": "https://smartpager.atlassian.net",
        "JIRA_USERNAME": "{env:ATLASSIAN_EMAIL}",
        "JIRA_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}"
      }
    },
    "doppler": {
      "type": "local",
      "command": ["npx", "-y", "@dopplerhq/mcp-server@1.0.5"]
    },
    "prettier": {
      "type": "local",
      "command": ["npx", "-y", "@prettier/mcp@0.0.1"]
    }
  },
  "skills": {
    "paths": [
      "/Users/havoc/model-skills-fullhavoc",
      "/Users/havoc/model-skills-perfectserve",
      "/Users/havoc/model-skills-fullhavoc",
      "/Users/havoc/model-skills-perfectserve"
    ]
  },
  "model": "opencode/claude-sonnet-4-6"
}
