{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "{env:LLAMA_CPP_HOST}/v1"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Qwen3.5 9B (LM Studio)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "tools": {
    "read": true,
    "grep": true,
    "glob": true,
    "list": true,
    "edit": true,
    "write": true,
    "bash": true,
    "webfetch": true,
    "todoread": true,
    "todowrite": true,
    "patch": true
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".yaml",
        ".yml",
        ".md",
        ".html",
        ".css"
      ]
    },
    "nixfmt": {
      "command": ["nixfmt", "$FILE"],
      "extensions": [".nix"]
    },
    "terraform": {
      "command": ["terraform", "fmt", "$FILE"],
      "extensions": [".tf", ".tfvars"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "stylua": {
      "command": ["stylua", "$FILE"],
      "extensions": [".lua"]
    },
    "ruff": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    },
    "gofmt": {
      "command": ["gofmt", "-w", "$FILE"],
      "extensions": [".go"]
    },
    "powershell": {
      "command": [
        "pwsh",
        "-Command",
        "Invoke-Formatter",
        "-ScriptDefinition",
        "$(cat $FILE)"
      ],
      "extensions": [".ps1", ".psm1"]
    },
    "rubocop": {
      "command": ["rubocop", "-a", "$FILE"],
      "extensions": [".rb"]
    },
    "xmllint": {
      "command": ["xmllint", "--format", "$FILE"],
      "extensions": [".xml"]
    },
    "taplo": {
      "command": ["taplo", "format", "$FILE"],
      "extensions": [".toml"]
    },
    "djlint": {
      "command": ["djlint", "--reformat", "$FILE"],
      "extensions": [".j2", ".jinja", ".jinja2"]
    }
  },
  "permission": {
    "bash": {
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "sudo rm *": "deny",
      "sudo rmdir *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "chown -R root *": "deny",
      "dd if=*": "deny",
      "mkfs.*": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "shred *": "deny",
      "> /dev/sd*": "deny",
      ":|:": "deny",
      ":(){ :|:& };:": "deny",
      "*": "ask"
    },
    "edit": "ask",
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "~/codebase-to-course": "allow",
      "~/claude-howto": "allow",
      "*": "ask"
    }
  },
  "lsp": {
    "ansible": {
      "command": ["ansible-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "dockerfile": {
      "command": ["docker-langserver", "--stdio"],
      "extensions": [".dockerfile"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    },
    "nix": {
      "command": ["nil"],
      "extensions": [".nix"]
    },
    "python": {
      "command": ["pylsp"],
      "extensions": [".py", ".pyi"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "terraform": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "powershell": {
      "command": [
        "pwsh",
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$PSES_BUNDLE_PATH = (Get-ChildItem -Path ~/.vscode/extensions/ms-vscode.powershell-*/modules/PowerShellEditorServices | Select-Object -First 1).FullName; Import-Module \"$PSES_BUNDLE_PATH/PowerShellEditorServices.psd1\"; Start-EditorServices -HostName 'OpenCode' -HostProfileId 'OpenCode' -HostVersion '1.0.0' -BundledModulesPath $PSES_BUNDLE_PATH -LogLevel Normal -LogPath /tmp/pses.log -SessionDetailsPath /tmp/session.json -FeatureFlags @() -AdditionalModules @() -Stdio"
      ],
      "extensions": [".ps1", ".psm1", ".psd1"]
    },
    "ruby": {
      "command": ["solargraph", "stdio"],
      "extensions": [".rb"]
    },
    "xml": {
      "command": ["lemminx"],
      "extensions": [".xml"]
    },
    "toml": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "edit": true,
        "write": true,
        "bash": true,
        "webfetch": true
      },
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": {
          "rm -rf /": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~/*": "deny",
          "sudo rm *": "deny",
          "sudo rmdir *": "deny",
          "chmod 777 *": "deny",
          "chmod -R 777 *": "deny",
          "chown -R root *": "deny",
          "dd if=*": "deny",
          "mkfs.*": "deny",
          "fdisk *": "deny",
          "parted *": "deny",
          "shred *": "deny",
          "> /dev/sd*": "deny",
          ":|:": "deny",
          ":(){ :|:& };:": "deny",
          "*": "ask"
        },
        "webfetch": "allow"
      }
    }
  },
  "mcp": {
    "context-guardian-perfectserve": {
      "type": "local",
      "command": [
        "node",
        "{env:HOME}/mcp-context-guardian-perfectserve/dist/index.js"
      ]
    },
    "mcp-stack-fullhavoc": {
      "type": "local",
      "command": [
        "{env:HOME}/mcp-stack-fullhavoc/.venv/bin/mcp-stack-fullhavoc"
      ],
      "environment": {
        "VG_THRESHOLDS": "comment_ratio=0.4,pr_words=350,ticket_words=500,similarity=0.75,fixme_chatter=5"
      }
    },
    "mcp-lazy": {
      "type": "local",
      "command": ["npx", "-y", "mcp-lazy", "serve"],
      "environment": {
        "JIRA_USERNAME": "{env:ATLASSIAN_EMAIL}",
        "JIRA_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}"
      }
    },
    "doppler": {
      "type": "local",
      "command": ["npx", "-y", "@dopplerhq/mcp-server@1.0.5"]
    },
    "prettier": {
      "type": "local",
      "command": ["npx", "-y", "@prettier/mcp@0.0.1"]
    }
  },
  "plugin": ["@zenobius/opencode-skillful"],
  "model": "opencode/big-pickle",
  "instructions": ["{env:HOME}/.config/opencode/verbosity-guardian-rule.md"],
  "skills": {
    "paths": []
  }
}
