{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["github-copilot", "opencode", "llama.cpp"],
  "plugin": ["model-filter"],
  "command": {
    "select": {
      "template": "bash ~/.config/opencode/commands/select-model.sh",
      "description": "Interactive model selector (Claude + Free models only)",
      "mode": "shell"
    }
  },
  "provider": {
    "github-copilot": {
      "comment": "GitHub Copilot - only Claude models allowed",
      "models": {
        "claude-opus-4.5": {
          "name": "Claude Opus 4.5"
        },
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5"
        },
        "claude-haiku-4.5": {
          "name": "Claude Haiku 4.5"
        },
        "claude-opus-4.7": {
          "name": "Claude Opus 4.7"
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6"
        },
        "gpt-4.1": {
          "disabled": true
        },
        "gpt-4o": {
          "disabled": true
        },
        "gpt-5": {
          "disabled": true
        },
        "gpt-5.1": {
          "disabled": true
        },
        "gpt-5.2": {
          "disabled": true
        },
        "gpt-5.3": {
          "disabled": true
        },
        "gpt-5.4": {
          "disabled": true
        },
        "gpt-5.5": {
          "disabled": true
        },
        "gemini-2": {
          "disabled": true
        },
        "gemini-2.5": {
          "disabled": true
        },
        "gemini-3": {
          "disabled": true
        }
      }
    },
    "opencode": {
      "comment": "OpenCode Zen - Claude models (paid) and free models only",
      "options": {
        "apiKey": "${OPENCODE_ZEN_API_KEY}"
      },
      "models": {
        "claude-opus-4.7": {
          "name": "Claude Opus 4.7"
        },
        "claude-opus-4.6": {
          "name": "Claude Opus 4.6"
        },
        "claude-opus-4.5": {
          "name": "Claude Opus 4.5"
        },
        "claude-opus-4.1": {
          "name": "Claude Opus 4.1"
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6"
        },
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5"
        },
        "claude-sonnet-4": {
          "name": "Claude Sonnet 4"
        },
        "claude-haiku-4.5": {
          "name": "Claude Haiku 4.5"
        },
        "claude-3-5-haiku": {
          "name": "Claude Haiku 3.5"
        },
        "big-pickle": {
          "name": "Big Pickle (Free)"
        },
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash (Free)"
        },
        "minimax-m2.5-free": {
          "name": "MiniMax M2.5 (Free)"
        },
        "nemotron-3-super-free": {
          "name": "Nemotron 3 Super (Free)"
        },
        "gpt-5.5": {
          "disabled": true
        },
        "gpt-5.5-pro": {
          "disabled": true
        },
        "gpt-5.4": {
          "disabled": true
        },
        "gpt-5.4-pro": {
          "disabled": true
        },
        "gpt-5.4-mini": {
          "disabled": true
        },
        "gpt-5.4-nano": {
          "disabled": true
        },
        "gpt-5.3-codex-spark": {
          "disabled": true
        },
        "gpt-5.3-codex": {
          "disabled": true
        },
        "gpt-5.2": {
          "disabled": true
        },
        "gpt-5.2-codex": {
          "disabled": true
        },
        "gpt-5.1": {
          "disabled": true
        },
        "gpt-5.1-codex-max": {
          "disabled": true
        },
        "gpt-5.1-codex": {
          "disabled": true
        },
        "gpt-5.1-codex-mini": {
          "disabled": true
        },
        "gpt-5": {
          "disabled": true
        },
        "gpt-5-codex": {
          "disabled": true
        },
        "gpt-5-nano": {
          "disabled": true
        },
        "glm-5.1": {
          "disabled": true
        },
        "glm-5": {
          "disabled": true
        },
        "minimax-m2.7": {
          "disabled": true
        },
        "minimax-m2.5": {
          "disabled": true
        },
        "kimi-k2.6": {
          "disabled": true
        },
        "kimi-k2.5": {
          "disabled": true
        },
        "qwen3.6-plus": {
          "disabled": true
        },
        "qwen3.5-plus": {
          "disabled": true
        },
        "qwen3.6-plus-free": {
          "disabled": true
        },
        "gemini-3.1-pro": {
          "disabled": true
        },
        "gemini-3-flash": {
          "disabled": true
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "local-coder": {
          "name": "Qwen2.5-Coder-7B (local)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "opencode/nemotron-3-super-free",
  "tools": {
    "read": true,
    "grep": true,
    "glob": true,
    "list": true,
    "edit": true,
    "write": true,
    "bash": true,
    "webfetch": true,
    "todoread": true,
    "todowrite": true,
    "patch": true
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--write", "$FILE"],
      "extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx",
        ".json",
        ".yaml",
        ".yml",
        ".md",
        ".html",
        ".css"
      ]
    },
    "nixfmt": {
      "command": ["nixfmt", "$FILE"],
      "extensions": [".nix"]
    },
    "terraform": {
      "command": ["terraform", "fmt", "$FILE"],
      "extensions": [".tf", ".tfvars"]
    },
    "shfmt": {
      "command": ["shfmt", "-w", "$FILE"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "stylua": {
      "command": ["stylua", "$FILE"],
      "extensions": [".lua"]
    },
    "ruff": {
      "command": ["ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    },
    "gofmt": {
      "command": ["gofmt", "-w", "$FILE"],
      "extensions": [".go"]
    },
    "powershell": {
      "command": [
        "pwsh",
        "-Command",
        "Invoke-Formatter",
        "-ScriptDefinition",
        "$(cat $FILE)"
      ],
      "extensions": [".ps1", ".psm1"]
    },
    "rubocop": {
      "command": ["rubocop", "-a", "$FILE"],
      "extensions": [".rb"]
    },
    "xmllint": {
      "command": ["xmllint", "--format", "$FILE"],
      "extensions": [".xml"]
    },
    "taplo": {
      "command": ["taplo", "format", "$FILE"],
      "extensions": [".toml"]
    },
    "djlint": {
      "command": ["djlint", "--reformat", "$FILE"],
      "extensions": [".j2", ".jinja", ".jinja2"]
    }
  },
  "permission": {
    "bash": {
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "sudo rm *": "deny",
      "sudo rmdir *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "chown -R root *": "deny",
      "dd if=*": "deny",
      "mkfs.*": "deny",
      "fdisk *": "deny",
      "parted *": "deny",
      "shred *": "deny",
      "> /dev/sd*": "deny",
      ":|:": "deny",
      ":(){ :|:& };:": "deny",
      "*": "ask"
    },
    "edit": "ask",
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "~/codebase-to-course": "allow",
      "~/claude-howto": "allow",
      "*": "ask"
    }
  },
  "lsp": {
    "ansible": {
      "command": ["ansible-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash", ".zsh"]
    },
    "dockerfile": {
      "command": ["docker-langserver", "--stdio"],
      "extensions": [".dockerfile"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "lua": {
      "command": ["lua-language-server"],
      "extensions": [".lua"]
    },
    "nix": {
      "command": ["nil"],
      "extensions": [".nix"]
    },
    "python": {
      "command": ["pylsp"],
      "extensions": [".py", ".pyi"]
    },
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "terraform": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yml", ".yaml"]
    },
    "powershell": {
      "command": [
        "pwsh",
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$PSES_BUNDLE_PATH = (Get-ChildItem -Path ~/.vscode/extensions/ms-vscode.powershell-*/modules/PowerShellEditorServices | Select-Object -First 1).FullName; Import-Module \"$PSES_BUNDLE_PATH/PowerShellEditorServices.psd1\"; Start-EditorServices -HostName 'OpenCode' -HostProfileId 'OpenCode' -HostVersion '1.0.0' -BundledModulesPath $PSES_BUNDLE_PATH -LogLevel Normal -LogPath /tmp/pses.log -SessionDetailsPath /tmp/session.json -FeatureFlags @() -AdditionalModules @() -Stdio"
      ],
      "extensions": [".ps1", ".psm1", ".psd1"]
    },
    "ruby": {
      "command": ["solargraph", "stdio"],
      "extensions": [".rb"]
    },
    "xml": {
      "command": ["lemminx"],
      "extensions": [".xml"]
    },
    "toml": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "edit": true,
        "write": true,
        "bash": true,
        "webfetch": true
      },
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": {
          "rm -rf /": "deny",
          "rm -rf /*": "deny",
          "rm -rf ~/*": "deny",
          "sudo rm *": "deny",
          "sudo rmdir *": "deny",
          "chmod 777 *": "deny",
          "chmod -R 777 *": "deny",
          "chown -R root *": "deny",
          "dd if=*": "deny",
          "mkfs.*": "deny",
          "fdisk *": "deny",
          "parted *": "deny",
          "shred *": "deny",
          "> /dev/sd*": "deny",
          ":|:": "deny",
          ":(){ :|:& };:": "deny",
          "*": "ask"
        },
        "webfetch": "allow"
      }
    }
  },
  "mcp": {
    "context-guardian": {
      "type": "local",
      "command": ["node", "~/mcp-context-guardian-fullhavoc/dist/index.js"]
    },
    "memory": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-memory"]
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "github": {
      "type": "local",
      "command": ["npx", "@edjl/github-mcp"]
    },
    "terraform": {
      "type": "local",
      "command": ["npx", "terraform-mcp-server"]
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "aws-core-mcp-server": {
      "type": "local",
      "command": ["uvx", "awslabs.core-mcp-server@latest"],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-terraform-mcp": {
      "type": "local",
      "command": ["uvx", "awslabs.terraform-mcp-server@latest"],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "mcp-server-chart": {
      "type": "local",
      "command": ["npx", "-y", "@antv/mcp-server-chart"]
    },
    "aws-pricing-mcp-server": {
      "type": "local",
      "command": ["uvx", "awslabs.aws-pricing-mcp-server@latest"],
      "environment": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "AWS_PROFILE": "services"
      }
    }
  }
}
