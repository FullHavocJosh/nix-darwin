# This is the configuration file for Ghostty.
#
#   /home/havoc/.config/ghostty/config
#

# Import theme from catppuccin-mocha (assumes the file exists in Ghostty's themes directory)
theme = catppuccin-mocha.conf

# General settings
auto-update = download
auto-update-channel = stable

shell-integration = zsh
shell-integration-features = sudo,title

# Font settings
font-family = Hack Nerd Font
font-size = 14

# Cursor style
cursor-style = block

# Window settings
window-decoration = none
window-padding-balance = true
background-opacity = 0.8
background-blur = true

window-save-state = always
quit-after-last-window-closed = true
confirm-close-surface = false

# Mouse settings (Ghostty doesn't support custom mouse bindings)
clipboard-read = allow
clipboard-write = allow

# Additional settings

