# devim opens the current directory with the standard nvim/aidev/zsh layout,
# naming the herdr space after the current directory by default. An optional
# first arg overrides the space name (e.g. `devim updates` names it "updates"
# instead of the repo's basename) while still using the current directory.
devim_herdr() {
  local dir="$(pwd)"
  local name="${1:-$(basename "$dir")}"
