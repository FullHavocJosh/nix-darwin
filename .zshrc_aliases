# Lays out the standard nvim/aidev/zsh panes (plus an optional tuicr review
# pane when $cmd_review is non-empty) as SPLITS within a single tab, instead
# of one tab per command -- modeled on the manual split layout in the
# nix-darwin workspace's zsh tab: a left column (tuicr on top of aidev, or
# just aidev alone with no review pane) and a right column (nvim on top of a
# short zsh strip). Runs against an already-created workspace $ws_id (whose
# first tab/pane already exist at ${ws_id}:t1/${ws_id}:p1). Shared by
# _herdr_space (fresh workspaces) and _herdr_worktree (worktree-backed
# workspaces that `herdr worktree create` already opened).
_herdr_populate_panes() {
  local ws_id="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" cmd_zsh="$5" tab_suffix="$6" cmd_review="$7"
  local label_nvim="nvim${tab_suffix}" label_aidev="aidev${tab_suffix}" label_zsh="zsh${tab_suffix}" label_review="tuicr${tab_suffix}"
  herdr tab rename "${ws_id}:t1" "dev${tab_suffix}" >/dev/null

  local p_left="${ws_id}:p1" p_right p_aidev p_zsh
  p_right=$(herdr pane split "$p_left" --direction right --ratio 0.5 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')

  # ratio 0.49 (not 0.5) gives aidev a couple rows more than tuicr -- aidev is
  # the pane you're actively typing into, tuicr mostly just needs to show diffs.
  if [ -n "$cmd_review" ]; then
    p_aidev=$(herdr pane split "$p_left" --direction down --ratio 0.49 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')
    herdr pane rename "$p_left" "$label_review" >/dev/null
    herdr pane run "$p_left" "$cmd_review" >/dev/null
  else
    p_aidev="$p_left"
  fi
  herdr pane rename "$p_aidev" "$label_aidev" >/dev/null
  [ -n "$cmd_aidev" ] && herdr pane run "$p_aidev" "$cmd_aidev" >/dev/null

  p_zsh=$(herdr pane split "$p_right" --direction down --ratio 0.75 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')
  herdr pane rename "$p_right" "$label_nvim" >/dev/null
  [ -n "$cmd_nvim" ] && herdr pane run "$p_right" "$cmd_nvim" >/dev/null
  herdr pane rename "$p_zsh" "$label_zsh" >/dev/null
  [ -n "$cmd_zsh" ] && herdr pane run "$p_zsh" "$cmd_zsh" >/dev/null

  herdr pane focus --pane "$p_zsh" --direction up >/dev/null
}

# Core primitive: a herdr workspace labeled $name (local pane cwd $dir) with a single
# tab split into nvim (focused, top-right) / aidev (left, running $cmd_aidev) / zsh
# (bottom-right, running $cmd_zsh) panes, plus an optional tuicr pane (running
# $cmd_review) stacked above aidev on the left when $cmd_review is non-empty.
# Used for both local project layouts and remote/ssh layouts (the remote ones just
# pass ssh-wrapped commands instead of plain local ones).
#
# $HERDR_ENV is set inside every herdr pane (like tmux's $TMUX). When already inside
# herdr, attaching to a separate named session would nest multiplexers, so instead
# this opens/focuses a workspace labeled $name in the CURRENT session.
_herdr_space() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" cmd_zsh="$5" tab_suffix="$6" cmd_review="$7"

  if [ -n "$HERDR_ENV" ]; then
    local ws_id
    ws_id=$(herdr workspace list | jq -r --arg n "$name" '.result.workspaces[] | select(.label==$n) | .workspace_id' | head -1)
    if [ -z "$ws_id" ]; then
      ws_id=$(herdr workspace create --cwd "$dir" --label "$name" | jq -r '.result.workspace.workspace_id')
      _herdr_populate_panes "$ws_id" "$dir" "$cmd_nvim" "$cmd_aidev" "$cmd_zsh" "$tab_suffix" "$cmd_review"
    fi
    herdr workspace focus "$ws_id" >/dev/null
    return
  fi

  local label_nvim="nvim${tab_suffix}" label_aidev="aidev${tab_suffix}" label_zsh="zsh${tab_suffix}" label_review="tuicr${tab_suffix}"
  if ! herdr session list --json 2>/dev/null | jq -e --arg n "$name" '.sessions[] | select(.name==$n and .running==true)' >/dev/null 2>&1; then
    nohup herdr server --session "$name" >/dev/null 2>&1 &
    disown
    sleep 0.5
    herdr workspace create --session "$name" --cwd "$dir" --label "$name" >/dev/null
    herdr tab rename w1:t1 "dev${tab_suffix}" --session "$name" >/dev/null

    local p_right p_aidev p_zsh
    p_right=$(herdr pane split w1:p1 --direction right --ratio 0.5 --cwd "$dir" --no-focus --session "$name" | jq -r '.result.pane.pane_id')

    if [ -n "$cmd_review" ]; then
      p_aidev=$(herdr pane split w1:p1 --direction down --ratio 0.49 --cwd "$dir" --no-focus --session "$name" | jq -r '.result.pane.pane_id')
      herdr pane rename w1:p1 "$label_review" --session "$name" >/dev/null
      herdr pane run w1:p1 "$cmd_review" --session "$name" >/dev/null
    else
      p_aidev="w1:p1"
    fi
    herdr pane rename "$p_aidev" "$label_aidev" --session "$name" >/dev/null
    [ -n "$cmd_aidev" ] && herdr pane run "$p_aidev" "$cmd_aidev" --session "$name" >/dev/null

    p_zsh=$(herdr pane split "$p_right" --direction down --ratio 0.75 --cwd "$dir" --no-focus --session "$name" | jq -r '.result.pane.pane_id')
    herdr pane rename "$p_right" "$label_nvim" --session "$name" >/dev/null
    [ -n "$cmd_nvim" ] && herdr pane run "$p_right" "$cmd_nvim" --session "$name" >/dev/null
    herdr pane rename "$p_zsh" "$label_zsh" --session "$name" >/dev/null
    [ -n "$cmd_zsh" ] && herdr pane run "$p_zsh" "$cmd_zsh" --session "$name" >/dev/null

    herdr pane focus --pane "$p_zsh" --direction up --session "$name" >/dev/null
  fi
  herdr --session "$name"
}

# Opens an ephemeral 2-tab herdr workspace (nvim + aidev) for AI-assisted manual
# editing flows (lint-fix, gpa auto-mode review). Unlike _herdr_space, this always
# creates a fresh workspace -- callers pass a $$-suffixed name for uniqueness rather
# than relying on label-based reuse. Ported from a tmux new-session/split-window
# version (see git history) once herdr became the daily driver.
_herdr_ai_edit_workspace() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4"

  if [ -n "$HERDR_ENV" ]; then
    local ws_id
    ws_id=$(herdr workspace create --cwd "$dir" --label "$name" | jq -r '.result.workspace.workspace_id')
    _herdr_populate_panes "$ws_id" "$dir" "$cmd_nvim" "$cmd_aidev" "" ""
    herdr workspace focus "$ws_id" >/dev/null
    return
  fi

  nohup herdr server --session "$name" >/dev/null 2>&1 &
  disown
  sleep 0.5
  herdr workspace create --session "$name" --cwd "$dir" --label "$name" >/dev/null
  herdr tab rename w1:t1 "nvim" --session "$name" >/dev/null
  [ -n "$cmd_nvim" ] && herdr pane run w1:p1 "$cmd_nvim" --session "$name" >/dev/null
  herdr tab create --session "$name" --workspace w1 --cwd "$dir" --label "aidev" --no-focus >/dev/null
  [ -n "$cmd_aidev" ] && herdr pane run w1:p2 "$cmd_aidev" --session "$name" >/dev/null

  local attach_script="/tmp/herdr_attach_$$.sh"
  cat >"$attach_script" <<STARTUP
#!/usr/bin/env bash
herdr --session '$name'
rm -f '$attach_script'
STARTUP
  chmod +x "$attach_script"
  _launch_terminal_window "$attach_script" "$name"
}

# Opens a new herdr space backed by a fresh git worktree (new branch off the
# source repo's current HEAD) with the same nvim/tuicr/aidev/zsh layout, so multiple
# in-flight branches/PRs on the same repo never share working-directory state. The
# tuicr pane is exactly where this is most useful -- each worktree is its own
# branch/PR by design, so _tuicr_current_pr has something fresh to load every time.
# Requires an existing herdr session ($HERDR_ENV set) -- worktree spaces are meant
# to live alongside your main dev session, not as their own standalone session.
_herdr_worktree() {
  local repo_name="$1" repo_dir="$2" branch="$3"
  if [ -z "$branch" ]; then
    echo "usage: hiwt <branch-name>" >&2
    return 1
  fi
  if [ -z "$HERDR_ENV" ]; then
    echo "herdr: run this from inside an existing herdr session (e.g. dev)" >&2
    return 1
  fi

  local label="${repo_name}-${branch}"
  local src_ws worktree_json ws_id wt_dir
  src_ws=$(herdr workspace list | jq -r --arg n "$repo_name" '.result.workspaces[] | select(.label==$n) | .workspace_id' | head -1)

  if [ -n "$src_ws" ]; then
    worktree_json=$(herdr worktree create --workspace "$src_ws" --branch "$branch" --label "$label" --focus)
  else
    worktree_json=$(herdr worktree create --cwd "$repo_dir" --branch "$branch" --label "$label" --focus)
  fi
  ws_id=$(echo "$worktree_json" | jq -r '.result.workspace.workspace_id')
  wt_dir=$(echo "$worktree_json" | jq -r '.result.workspace.worktree.checkout_path')

  _herdr_populate_panes "$ws_id" "$wt_dir" "nvim" "claude --resume" "git status" "" "_tuicr_current_pr"
  herdr workspace focus "$ws_id" >/dev/null
}

alias hiwt='_herdr_worktree home-infrastructure ~/home-infrastructure'

# Quits whatever tuicr is currently showing in pane $1 -- PR mode, working-tree
# diff, or the always-alive pristine/all-files fallback below -- and relaunches
# _tuicr_current_pr there (cd'ing to $2 first if given). `:q` works as the quit
# command regardless of which of those modes it's currently in. Used both by the
# watcher below (to re-evaluate which mode is now right once git state changes --
# :e alone can't jump from pristine/all-files mode to a real diff, since those are
# different tuicr CLI targets, not just a stale view of the same one) and by
# _herdr_sync_tab_to_worktree (to point an already-open tuicr pane at a newly
# created worktree instead of leaving it showing the old one).
#
# The relaunch step uses send-text + send-keys enter, NOT `herdr pane run` --
# confirmed by testing that `pane run` deadlocks specifically when the caller is
# itself a lingering background process of the SAME pane it's targeting (as the
# watcher below is): it appears to wait for the pane to have no attached child
# processes before injecting the command, which can never become true while the
# very process making the call is one of them. send-text/send-keys don't wait for
# that and work fine self-targeted; `pane run` is still fine for cross-pane calls
# (e.g. _herdr_sync_tab_to_worktree targeting sibling panes from a different one).
#
# Waits for the pane to actually settle on a plain shell before sending the
# relaunch text, rather than a blind sleep -- confirmed by testing that a fixed
# short sleep isn't reliably long enough for tuicr's quit to fully land, and text
# sent while it's still mid-exit silently never reaches a shell prompt to execute.
_tuicr_restart() {
  local pane_id="$1" dir="$2"
  herdr pane send-keys "$pane_id" esc >/dev/null 2>&1
  herdr pane send-text "$pane_id" ":q" >/dev/null 2>&1
  herdr pane send-keys "$pane_id" enter >/dev/null 2>&1

  local tries=0 fg
  while [ "$tries" -lt 25 ]; do
    fg=$(herdr pane process-info --pane "$pane_id" 2>/dev/null | jq -r '.result.process_info.foreground_processes[-1].name // ""')
    { [ "$fg" = "zsh" ] || [ "$fg" = "-zsh" ]; } && break
    sleep 0.2
    tries=$((tries + 1))
  done

  if [ -n "$dir" ]; then
    herdr pane send-text "$pane_id" "cd $dir && _tuicr_current_pr" >/dev/null 2>&1
  else
    herdr pane send-text "$pane_id" "_tuicr_current_pr" >/dev/null 2>&1
  fi
  herdr pane send-keys "$pane_id" enter >/dev/null 2>&1
}

# Polls for git activity (HEAD + working-tree status) in the tuicr pane's directory
# and, whenever something changes, sends tuicr's own `:e` reload command into
# $HERDR_PANE_ID -- so the diff aidev/nvim are producing keeps showing up without
# anyone pressing `:e` by hand. Polling (not fswatch) because fswatch isn't
# installed here and this is a low enough frequency that the extra dependency isn't
# worth it; it only acts when the actual git state (not just the clock) has changed,
# which is what makes this "continuous" rather than a blind timer-based reload.
#
# This intentionally sends `:e`, not a full _tuicr_restart -- tried that first, but
# a self-targeted restart (this watcher quitting and relaunching tuicr in its OWN
# hosting pane) turned out to be unreliable: the relaunch text sent right after the
# quit routinely never reached a shell prompt to execute (most likely the shell's
# own prompt redraw discarding queued input, a common anti-typeahead protection in
# fancy prompt frameworks), silently leaving the pane dead at an idle shell instead
# of picking the new mode. `:e` doesn't have that problem -- it doesn't need tuicr to
# exit and a new process to land in its place -- but it also can't jump out of the
# pristine/all-files fallback into a real diff, since those are different tuicr CLI
# targets, not just a stale view of the same one. That upgrade still happens
# correctly whenever something restarts tuicr from a DIFFERENT pane instead (e.g.
# _herdr_sync_tab_to_worktree, which calls _tuicr_restart cross-pane and doesn't hit
# this issue).
_tuicr_watch_and_refresh() {
  local pane_id="$HERDR_PANE_ID"
  [ -n "$pane_id" ] || return 0

  local last_state state
  last_state=$(git rev-parse HEAD 2>/dev/null)$(git status --porcelain 2>/dev/null)
  while true; do
    sleep 5
    state=$(git rev-parse HEAD 2>/dev/null)$(git status --porcelain 2>/dev/null)
    if [ "$state" != "$last_state" ]; then
      last_state="$state"
      herdr pane send-keys "$pane_id" esc >/dev/null 2>&1
      herdr pane send-text "$pane_id" ":e" >/dev/null 2>&1
      herdr pane send-keys "$pane_id" enter >/dev/null 2>&1
    fi
  done
}

# tuicr pane's default command in the dev layout. Every branch this workflow creates
# (gpr) has a matching GitHub PR from the moment it's created, so this loads that PR's
# diff (including any not-yet-pushed working-tree changes) straight away instead of
# landing on tuicr's local/PR target picker. Falls back to a plain local working-tree
# diff when there's no PR to load (current branch has none, e.g. `nxvim`/`dev` opened
# directly on main) or `tuicr pr` errors out (e.g. right after `gpr` creates a
# worktree, the PR exists but its initial commit is empty, so `tuicr pr` finds no
# file changes even with --working-tree). Final fallback is -A (review every tracked
# file) when there's truly nothing to diff yet -- tuicr exits immediately on "no
# changes to review" otherwise, which would leave the pane dead with nothing running
# to receive the watcher's refresh or a later worktree-sync restart. Also runs
# _tuicr_watch_and_refresh alongside it, in the background, so the diff stays live as
# aidev/nvim keep committing/editing instead of freezing at whatever it looked like
# on launch.
_tuicr_current_pr() {
  local pr_num
  pr_num=$(gh pr view --json number -q .number 2>/dev/null)

  _tuicr_watch_and_refresh &
  local watcher_pid=$!
  disown

  if [ -n "$pr_num" ] && tuicr pr "$pr_num" --working-tree; then
    kill "$watcher_pid" 2>/dev/null
    return
  fi
  if tuicr -w; then
    kill "$watcher_pid" 2>/dev/null
    return
  fi
  tuicr -A
  kill "$watcher_pid" 2>/dev/null
}

# aidev pane starts with `claude --resume` so any prior session in that pane
# (herdr's pane persistence means detach/reattach normally just resumes
# whatever's running) can also be picked back up after the pane itself was
# recreated -- --resume prompts to pick a session if one exists, or starts
# fresh otherwise.
_herdr_devlayout() {
  local name="$1" dir="$2"
  _herdr_space "$name" "$dir" "nvim" "claude --resume" "git status" "" "_tuicr_current_pr"
}

# Like _herdr_space, but never resumes an existing same-label workspace/session --
# always creates a brand-new one with the standard nvim/aidev/zsh split layout (plus
# an optional tuicr pane running $cmd_review, stacked above aidev) and
# focuses/attaches it. devim uses this because it should give a clean layout
# every time instead of reattaching to whatever's left over from a previous run.
_herdr_space_new() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" cmd_zsh="$5" tab_suffix="$6" cmd_review="$7"

  if [ -n "$HERDR_ENV" ]; then
    local ws_id
    ws_id=$(herdr workspace create --cwd "$dir" --label "$name" | jq -r '.result.workspace.workspace_id')
    _herdr_populate_panes "$ws_id" "$dir" "$cmd_nvim" "$cmd_aidev" "$cmd_zsh" "$tab_suffix" "$cmd_review"
    herdr workspace focus "$ws_id" >/dev/null
    return
  fi

  local label_nvim="nvim${tab_suffix}" label_aidev="aidev${tab_suffix}" label_zsh="zsh${tab_suffix}" label_review="tuicr${tab_suffix}"
  local session_name="${name}-$$"
  nohup herdr server --session "$session_name" >/dev/null 2>&1 &
  disown
  sleep 0.5
  herdr workspace create --session "$session_name" --cwd "$dir" --label "$name" >/dev/null
  herdr tab rename w1:t1 "dev${tab_suffix}" --session "$session_name" >/dev/null

  local p_right p_aidev p_zsh
  p_right=$(herdr pane split w1:p1 --direction right --ratio 0.5 --cwd "$dir" --no-focus --session "$session_name" | jq -r '.result.pane.pane_id')

  if [ -n "$cmd_review" ]; then
    p_aidev=$(herdr pane split w1:p1 --direction down --ratio 0.49 --cwd "$dir" --no-focus --session "$session_name" | jq -r '.result.pane.pane_id')
    herdr pane rename w1:p1 "$label_review" --session "$session_name" >/dev/null
    herdr pane run w1:p1 "$cmd_review" --session "$session_name" >/dev/null
  else
    p_aidev="w1:p1"
  fi
  herdr pane rename "$p_aidev" "$label_aidev" --session "$session_name" >/dev/null
  [ -n "$cmd_aidev" ] && herdr pane run "$p_aidev" "$cmd_aidev" --session "$session_name" >/dev/null

  p_zsh=$(herdr pane split "$p_right" --direction down --ratio 0.75 --cwd "$dir" --no-focus --session "$session_name" | jq -r '.result.pane.pane_id')
  herdr pane rename "$p_right" "$label_nvim" --session "$session_name" >/dev/null
  [ -n "$cmd_nvim" ] && herdr pane run "$p_right" "$cmd_nvim" --session "$session_name" >/dev/null
  herdr pane rename "$p_zsh" "$label_zsh" --session "$session_name" >/dev/null
  [ -n "$cmd_zsh" ] && herdr pane run "$p_zsh" "$cmd_zsh" --session "$session_name" >/dev/null

  herdr pane focus --pane "$p_zsh" --direction up --session "$session_name" >/dev/null
  herdr --session "$session_name"
}

# devim's layout function: same nvim/tuicr/aidev/zsh split layout as
# _herdr_devlayout, but routed through _herdr_space_new so it always starts fresh.
_herdr_devlayout_new() {
  local name="$1" dir="$2"
  _herdr_space_new "$name" "$dir" "nvim" "claude --resume" "git status" "" "_tuicr_current_pr"
}

# Same split layout (no tuicr pane, since _herdr_space is called without
# $cmd_review here), but each pane ssh's into $host and runs its command in
# $remote_dir there. No herdr install needed on the remote end -- it's just an
# ssh'd-in shell inside a local pane, same as typing the ssh command by hand.
#
# Each command runs via `zsh -ic` on the remote side: a plain ssh remote command
# is non-interactive, so .zshrc (and its homebrew PATH setup) never sources and
# tools like nvim/aiselect come back "command not found".
_herdr_remote_space() {
  local name="$1" host="$2" remote_dir="$3"
  local ssh="ssh -t -i ~/.ssh/id_ed25519 $host"
  _herdr_space "$name" "$HOME" \
    "$ssh \"zsh -ic 'cd $remote_dir && nvim'\"" \
    "$ssh \"zsh -ic 'cd $remote_dir && claude --resume; exec zsh -l'\"" \
    "$ssh \"zsh -ic 'cd $remote_dir && git status; exec zsh -l'\"" \
    "-macmini"
}

# Guards nxvim/psvim/hivim/itvim against machines where the project folder doesn't
# exist (e.g. ~/home-infrastructure isn't cloned on the work laptop).
_herdr_project() {
  local name="$1" dir="$2"
  if [ ! -d "$dir" ]; then
    echo "herdr: $dir does not exist on this machine, skipping $name" >&2
    return 1
  fi
  cd "$dir" && _herdr_devlayout "$name" "$dir"
}

alias nxvim='_herdr_project nix-darwin ~/nix-darwin'
# devim opens the current directory with the standard nvim/tuicr/aidev/zsh layout,
# naming the herdr space after the current directory by default. An optional
# first arg overrides the space name (e.g. `devim updates` names it "updates"
# instead of the repo's basename) while still using the current directory.
devim() {
  local dir="$(pwd)"
  local name="${1:-$(basename "$dir")}"
  _herdr_devlayout_new "$name" "$dir"
}
alias psvim='_herdr_project pscloudops ~/pscloudops'
alias hivim='_herdr_project home-infrastructure ~/home-infrastructure'
alias itvim='_herdr_project Infrastructure-Terrakube ~/Infrastructure-Terrakube'

# Single daily-driver herdr session named "dev" holding one workspace per project.
# Reruns of `dev` just reattach -- no re-scanning. First run auto-discovers every
# git repo directly under ~/ (any dir with a .git) and opens a workspace for each,
# so newly cloned repos get picked up automatically without editing this file.
# Add repo names to the case statement below to exclude them from the scan.
_herdr_dev() {
  if herdr session list --json 2>/dev/null | jq -e '.sessions[] | select(.name=="dev" and .running==true)' >/dev/null 2>&1; then
    herdr --session dev
    return
  fi

  nohup herdr server --session dev >/dev/null 2>&1 &
  disown
  sleep 0.5

  local orig_dir="$PWD"
  export HERDR_ENV=1 HERDR_SESSION=dev
  local repo base
  for repo in "$HOME"/*/; do
    repo="${repo%/}"
    base="$(basename "$repo")"
    [ -e "$repo/.git" ] || continue
    case "$base" in
      claude-howto|codebase-to-course) continue ;;
    esac
    _herdr_devlayout "$base" "$repo"
  done
  [ -d ~/nix-darwin ] && nxvim
  unset HERDR_ENV HERDR_SESSION
  cd "$orig_dir"

  herdr --session dev
}
