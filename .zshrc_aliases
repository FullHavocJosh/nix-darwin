# Single daily-driver herdr session named "dev" holding one workspace per project.
# Reruns of `dev` just reattach -- no re-scanning. First run auto-discovers every
# git repo directly under ~/ (any dir with a .git) and opens a workspace for each,
# so newly cloned repos get picked up automatically without editing this file.
# Add repo names to the case statement below to exclude them from the scan.
_herdr_dev() {
  if herdr session list --json 2>/dev/null | jq -e '.sessions[] | select(.name=="dev" and .running==true)' >/dev/null 2>&1; then
    herdr --session dev
    return
  fi

  nohup herdr server --session dev >/dev/null 2>&1 &
  disown
  sleep 0.5

  local orig_dir="$PWD"
  export HERDR_ENV=1 HERDR_SESSION=dev
  local repo base
  for repo in "$HOME"/*/; do
    repo="${repo%/}"
    base="$(basename "$repo")"
    [ -e "$repo/.git" ] || continue
    case "$base" in
      claude-howto|codebase-to-course) continue ;;
    esac
    _herdr_devlayout "$base" "$repo"
  done
  [ -d ~/nix-darwin ] && nxvim
  unset HERDR_ENV HERDR_SESSION
  cd "$orig_dir"

  herdr --session dev
}
alias dev='_herdr_dev'

