# Pulls the KRDP username/password from Doppler (fullhavocjosh/root_nobaralaptop)
# at run time instead of hardcoding them, then pipes the password to sdl-freerdp
# via /from-stdin so it never appears in argv/process list/shell history.
rdpnobaralaptop() {
  local user pass
  user=$(doppler secrets get KRDP_USERNAME --project fullhavocjosh --config root_nobaralaptop --plain) || return 1
  pass=$(doppler secrets get KRDP_PASSWORD --project fullhavocjosh --config root_nobaralaptop --plain) || return 1
  printf '%s\n' "$pass" | sdl-freerdp /v:${NOBARA_LAPTOP_IP} "/u:$user" /from-stdin /cert:ignore /dynamic-resolution /size:1920x1080
}

# ---- herdr: the previous daily stack, kept as <name>_herdr (dev_herdr, devim_herdr, nxvim_herdr, psvim_herdr,
# hivim_herdr, itvim_herdr, hiwt_herdr, mmdev_herdr, himmdev_herdr, nxmmdev_herdr). The daily commands are the
# tuios ones in .zshrc_functions_tuios.

# Lays out aidev as tab 1 (the workspace's initial tab/pane, so it sorts first
# in the tab bar), then a tab 2 "dev" tab with nvim (full-height left) and zsh
# (right) as a split. dev is left as the focused/landing tab (nvim pane) --
# aidev sorting first is purely a tab-order thing, not a default-view thing.
# Runs against an already-created workspace $ws_id (whose first tab/pane
# already exist at ${ws_id}:t1/${ws_id}:p1). Shared by _herdr_space (fresh
# workspaces) and _herdr_worktree (worktree-backed workspaces that `herdr
# worktree create` already opened).
_herdr_populate_panes() {
  local ws_id="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" cmd_zsh="$5" tab_suffix="$6"
  local label_nvim="nvim${tab_suffix}" label_aidev="ai${tab_suffix}" label_zsh="zsh${tab_suffix}"

  # aidev is tab 1 -- it's the workspace's initial tab/pane, no move needed.
  herdr tab rename "${ws_id}:t1" "$label_aidev" >/dev/null
  herdr pane rename "${ws_id}:p1" "$label_aidev" >/dev/null
  [ -n "$cmd_aidev" ] && herdr pane run "${ws_id}:p1" "$cmd_aidev" >/dev/null

  # dev is tab 2: nvim full-height left, zsh right.
  local dev_result dev_tab p_nvim p_right
  dev_result=$(herdr tab create --workspace "$ws_id" --cwd "$dir" --label "dev${tab_suffix}" --no-focus)
  dev_tab=$(echo "$dev_result" | jq -r '.result.tab.tab_id')
  p_nvim=$(echo "$dev_result" | jq -r '.result.root_pane.pane_id')
  herdr pane rename "$p_nvim" "$label_nvim" >/dev/null
  [ -n "$cmd_nvim" ] && herdr pane run "$p_nvim" "$cmd_nvim" >/dev/null

  p_right=$(herdr pane split "$p_nvim" --direction right --ratio 0.5 --cwd "$dir" --no-focus | jq -r '.result.pane.pane_id')
  herdr pane rename "$p_right" "$label_zsh" >/dev/null
  [ -n "$cmd_zsh" ] && herdr pane run "$p_right" "$cmd_zsh" >/dev/null
  herdr tab focus "$dev_tab" >/dev/null
  herdr pane focus --pane "$p_right" --direction left >/dev/null
}

# Core primitive: a herdr workspace labeled $name (local pane cwd $dir) with a dev
# tab split into nvim (focused, full-height left) / zsh (right, running
# $cmd_zsh), plus a separate aidev tab running $cmd_aidev. Used for both
# local project layouts and remote/ssh layouts (the remote ones just pass
# ssh-wrapped commands instead of plain local ones).
#
# $HERDR_ENV is set inside every herdr pane (like tmux's $TMUX). When already inside
# herdr, attaching to a separate named session would nest multiplexers, so instead
# this opens/focuses a workspace labeled $name in the CURRENT session.
_herdr_space() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" cmd_zsh="$5" tab_suffix="$6"

  if [ -n "$HERDR_ENV" ]; then
    local ws_id
    ws_id=$(herdr workspace list | jq -r --arg n "$name" '.result.workspaces[] | select(.label==$n) | .workspace_id' | head -1)
    if [ -z "$ws_id" ]; then
      ws_id=$(herdr workspace create --cwd "$dir" --label "$name" | jq -r '.result.workspace.workspace_id')
      _herdr_populate_panes "$ws_id" "$dir" "$cmd_nvim" "$cmd_aidev" "$cmd_zsh" "$tab_suffix"
    fi
    herdr workspace focus "$ws_id" >/dev/null
    return
  fi

  local label_nvim="nvim${tab_suffix}" label_aidev="ai${tab_suffix}" label_zsh="zsh${tab_suffix}"
  if ! herdr session list --json 2>/dev/null | jq -e --arg n "$name" '.sessions[] | select(.name==$n and .running==true)' >/dev/null 2>&1; then
    nohup herdr server --session "$name" >/dev/null 2>&1 &
    disown
    sleep 0.5
    herdr workspace create --session "$name" --cwd "$dir" --label "$name" >/dev/null

    # aidev is tab 1 -- it's the workspace's initial tab/pane, no move needed.
    herdr tab rename w1:t1 "$label_aidev" --session "$name" >/dev/null
    herdr pane rename w1:p1 "$label_aidev" --session "$name" >/dev/null
    [ -n "$cmd_aidev" ] && herdr pane run w1:p1 "$cmd_aidev" --session "$name" >/dev/null

    # dev is tab 2: nvim full-height left, zsh right.
    local dev_result dev_tab p_nvim p_right
    dev_result=$(herdr tab create --session "$name" --workspace w1 --cwd "$dir" --label "dev${tab_suffix}" --no-focus)
    dev_tab=$(echo "$dev_result" | jq -r '.result.tab.tab_id')
    p_nvim=$(echo "$dev_result" | jq -r '.result.root_pane.pane_id')
    herdr pane rename "$p_nvim" "$label_nvim" --session "$name" >/dev/null
    [ -n "$cmd_nvim" ] && herdr pane run "$p_nvim" "$cmd_nvim" --session "$name" >/dev/null

    p_right=$(herdr pane split "$p_nvim" --direction right --ratio 0.5 --cwd "$dir" --no-focus --session "$name" | jq -r '.result.pane.pane_id')
    herdr pane rename "$p_right" "$label_zsh" --session "$name" >/dev/null
    [ -n "$cmd_zsh" ] && herdr pane run "$p_right" "$cmd_zsh" --session "$name" >/dev/null
    herdr tab focus "$dev_tab" --session "$name" >/dev/null
    herdr pane focus --pane "$p_right" --direction left --session "$name" >/dev/null
  fi
  herdr --session "$name"
}

# Opens an ephemeral 2-tab herdr workspace (nvim + aidev) for AI-assisted manual
# editing flows (lint-fix, gpa auto-mode review). Unlike _herdr_space, this always
# creates a fresh workspace -- callers pass a $$-suffixed name for uniqueness rather
# than relying on label-based reuse. Ported from a tmux new-session/split-window
# version (see git history) once herdr became the daily driver.
_herdr_ai_edit_workspace() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4"

  if [ -n "$HERDR_ENV" ]; then
    local ws_id
    ws_id=$(herdr workspace create --cwd "$dir" --label "$name" | jq -r '.result.workspace.workspace_id')
    _herdr_populate_panes "$ws_id" "$dir" "$cmd_nvim" "$cmd_aidev" "" ""
    herdr workspace focus "$ws_id" >/dev/null
    return
  fi

  nohup herdr server --session "$name" >/dev/null 2>&1 &
  disown
  sleep 0.5
  herdr workspace create --session "$name" --cwd "$dir" --label "$name" >/dev/null

  # aidev is tab 1 -- it's the workspace's initial tab/pane, no move needed.
  herdr tab rename w1:t1 "ai" --session "$name" >/dev/null
  [ -n "$cmd_aidev" ] && herdr pane run w1:p1 "$cmd_aidev" --session "$name" >/dev/null

  # nvim is tab 2, and stays the focused/landing tab.
  local nvim_result nvim_tab p_nvim
  nvim_result=$(herdr tab create --session "$name" --workspace w1 --cwd "$dir" --label "nvim" --no-focus)
  nvim_tab=$(echo "$nvim_result" | jq -r '.result.tab.tab_id')
  p_nvim=$(echo "$nvim_result" | jq -r '.result.root_pane.pane_id')
  [ -n "$cmd_nvim" ] && herdr pane run "$p_nvim" "$cmd_nvim" --session "$name" >/dev/null
  herdr tab focus "$nvim_tab" --session "$name" >/dev/null

  local attach_script="/tmp/herdr_attach_$$.sh"
  cat >"$attach_script" <<STARTUP
#!/usr/bin/env bash
herdr --session '$name'
rm -f '$attach_script'
STARTUP
  chmod +x "$attach_script"
  _launch_terminal_window "$attach_script" "$name"
}

# Opens a new herdr space backed by a fresh git worktree (new branch off the
# source repo's current HEAD) with the same nvim/aidev/zsh layout, so multiple
# in-flight branches/PRs on the same repo never share working-directory state.
# Requires an existing herdr session ($HERDR_ENV set) -- worktree spaces are meant
# to live alongside your main dev session, not as their own standalone session.
_herdr_worktree() {
  local repo_name="$1" repo_dir="$2" branch="$3"
  if [ -z "$branch" ]; then
    echo "usage: hiwt <branch-name>" >&2
    return 1
  fi
  if [ -z "$HERDR_ENV" ]; then
    echo "herdr: run this from inside an existing herdr session (e.g. dev)" >&2
    return 1
  fi

  local label="${repo_name}-${branch}"
  local src_ws worktree_json ws_id wt_dir
  src_ws=$(herdr workspace list | jq -r --arg n "$repo_name" '.result.workspaces[] | select(.label==$n) | .workspace_id' | head -1)

  if [ -n "$src_ws" ]; then
    worktree_json=$(herdr worktree create --workspace "$src_ws" --branch "$branch" --label "$label" --focus)
  else
    worktree_json=$(herdr worktree create --cwd "$repo_dir" --branch "$branch" --label "$label" --focus)
  fi
  ws_id=$(echo "$worktree_json" | jq -r '.result.workspace.workspace_id')
  wt_dir=$(echo "$worktree_json" | jq -r '.result.workspace.worktree.checkout_path')

  _herdr_populate_panes "$ws_id" "$wt_dir" "nvim" "" "git status" ""
  herdr workspace focus "$ws_id" >/dev/null
}

alias hiwt_herdr='_herdr_worktree home-infrastructure ~/home-infrastructure'

# Waits for pane $1's VISIBLE CONTENT to go still (three consecutive
# identical, non-empty reads) before returning -- a direct signal that
# whatever's rendering there (shell startup, an editor repainting, a plugin
# still loading) has settled, rather than an indirect proxy like process
# state. Requiring non-empty specifically so a still-blank pane (nothing
# rendered yet at all) never false-positives as "stable" on its very first
# read. Times out after ~6s (40 tries * 0.15s) and returns anyway rather than
# blocking forever if content never settles for some other reason -- callers
# proceed either way.
# Usage: _herdr_wait_pane_stable <pane_id>
_herdr_wait_pane_stable() {
  local pane_id="$1"
  local prev_content="" cur_content stable_count=0 tries=0
  while [ "$tries" -lt 40 ]; do
    cur_content=$(herdr pane read "$pane_id" --source visible 2>/dev/null)
    if [ "$cur_content" = "$prev_content" ] && [ -n "$cur_content" ]; then
      stable_count=$((stable_count + 1))
      [ "$stable_count" -ge 3 ] && return 0
    else
      stable_count=0
    fi
    prev_content="$cur_content"
    sleep 0.15
    tries=$((tries + 1))
  done
}

# aidev pane starts with `claude --resume` so any prior session in that pane
# (herdr's pane persistence means detach/reattach normally just resumes
# whatever's running) can also be picked back up after the pane itself was
# recreated -- --resume prompts to pick a session if one exists, or starts
# fresh otherwise.
_herdr_devlayout() {
  local name="$1" dir="$2"
  _herdr_space "$name" "$dir" "nvim" "" "git status" ""
}

# Like _herdr_space, but never resumes an existing same-label workspace/session --
# always creates a brand-new one with the standard nvim/zsh dev tab + separate
# aidev tab layout and focuses/attaches it. devim uses this because it
# should give a clean layout every time instead of reattaching to whatever's left
# over from a previous run.
_herdr_space_new() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" cmd_zsh="$5" tab_suffix="$6"

  if [ -n "$HERDR_ENV" ]; then
    local ws_id
    ws_id=$(herdr workspace create --cwd "$dir" --label "$name" | jq -r '.result.workspace.workspace_id')
    _herdr_populate_panes "$ws_id" "$dir" "$cmd_nvim" "$cmd_aidev" "$cmd_zsh" "$tab_suffix"
    herdr workspace focus "$ws_id" >/dev/null
    return
  fi

  local label_nvim="nvim${tab_suffix}" label_aidev="ai${tab_suffix}" label_zsh="zsh${tab_suffix}"
  local session_name="${name}-$$"
  nohup herdr server --session "$session_name" >/dev/null 2>&1 &
  disown
  sleep 0.5
  herdr workspace create --session "$session_name" --cwd "$dir" --label "$name" >/dev/null

  # aidev is tab 1 -- it's the workspace's initial tab/pane, no move needed.
  herdr tab rename w1:t1 "$label_aidev" --session "$session_name" >/dev/null
  herdr pane rename w1:p1 "$label_aidev" --session "$session_name" >/dev/null
  [ -n "$cmd_aidev" ] && herdr pane run w1:p1 "$cmd_aidev" --session "$session_name" >/dev/null

  # dev is tab 2: nvim full-height left, zsh right.
  local dev_result dev_tab p_nvim p_right
  dev_result=$(herdr tab create --session "$session_name" --workspace w1 --cwd "$dir" --label "dev${tab_suffix}" --no-focus)
  dev_tab=$(echo "$dev_result" | jq -r '.result.tab.tab_id')
  p_nvim=$(echo "$dev_result" | jq -r '.result.root_pane.pane_id')
  herdr pane rename "$p_nvim" "$label_nvim" --session "$session_name" >/dev/null
  [ -n "$cmd_nvim" ] && herdr pane run "$p_nvim" "$cmd_nvim" --session "$session_name" >/dev/null

  p_right=$(herdr pane split "$p_nvim" --direction right --ratio 0.5 --cwd "$dir" --no-focus --session "$session_name" | jq -r '.result.pane.pane_id')
  herdr pane rename "$p_right" "$label_zsh" --session "$session_name" >/dev/null
  [ -n "$cmd_zsh" ] && herdr pane run "$p_right" "$cmd_zsh" --session "$session_name" >/dev/null
  herdr tab focus "$dev_tab" --session "$session_name" >/dev/null
  herdr pane focus --pane "$p_right" --direction left --session "$session_name" >/dev/null
  herdr --session "$session_name"
}

# devim's layout function: same nvim/zsh dev tab + separate aidev tab as
# _herdr_devlayout, but routed through _herdr_space_new so it always starts fresh.
_herdr_devlayout_new() {
  local name="$1" dir="$2"
  _herdr_space_new "$name" "$dir" "nvim" "" "git status" ""
}

# Same split layout, but each pane ssh's into $host and runs its command in
# $remote_dir there. No herdr install needed on the remote end -- it's just an
# ssh'd-in shell inside a local pane, same as typing the ssh command by hand.
#
# Each command runs via `zsh -ic` on the remote side: a plain ssh remote command
# is non-interactive, so .zshrc (and its homebrew PATH setup) never sources and
# tools like nvim/aidev come back "command not found".
_herdr_remote_space() {
  local name="$1" host="$2" remote_dir="$3"
  local ssh="ssh -t -i ~/.ssh/id_ed25519 $host"
  _herdr_space "$name" "$HOME" \
    "$ssh \"zsh -ic 'cd $remote_dir && nvim'\"" \
    "$ssh \"zsh -ic 'cd $remote_dir; exec zsh -l'\"" \
    "$ssh \"zsh -ic 'cd $remote_dir && git status; exec zsh -l'\"" \
    "-macmini"
}

# Guards nxvim/psvim/hivim/itvim against machines where the project folder doesn't
# exist (e.g. ~/home-infrastructure isn't cloned on the work laptop).
_herdr_project() {
  local name="$1" dir="$2"
  if [ ! -d "$dir" ]; then
    echo "herdr: $dir does not exist on this machine, skipping $name" >&2
    return 1
  fi
  cd "$dir" && _herdr_devlayout "$name" "$dir"
}

