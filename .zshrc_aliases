# nix-recover -- load the nix launchd daemons by hand when macOS did not start them at boot.
#
# Background Task Management (sfltool dumpbtm) can mark the nix daemons "disallowed"; System Settings lists them as
# "sh" from an unknown developer, and macOS updates reset them. launchd then skips them at boot: /nix stays locked,
# activate-system never recreates /run/current-system, and `sudo darwin-rebuild` fails with "command not found".
# A manual launchctl bootstrap is not gated by BTM, so this loads them until the next reboot. The lasting fix is an
# MDM com.apple.servicemanagement LabelPrefix rule for org.nixos. and family.rollet. (it cannot be installed locally).
# Runs before any command line containing darwin-rebuild (preexec hook below) and before darwin-reload.
function nix-recover() {
  [[ "$OSTYPE" == darwin* ]] || return 0
  [[ -d /nix/store && -e /run/current-system ]] && return 0
  echo "nix-recover: the nix launchd daemons did not start at boot (Background Task Management). Loading them..." >&2
  local label plist i
  # keepalive unlocks the /nix volume; activate-system waits for /nix/store, then recreates /run/current-system
  for label in family.rollet.nix-store-keepalive org.nixos.activate-system org.nixos.nix-daemon; do
    plist="/Library/LaunchDaemons/$label.plist"
    [[ -f "$plist" ]] || continue
    launchctl print "system/$label" >/dev/null 2>&1 || sudo launchctl bootstrap system "$plist"
  done
  for i in {1..60}; do
    [[ -e /run/current-system ]] && { echo "nix-recover: /run/current-system is back." >&2; return 0; }
    sleep 1
  done
  echo "nix-recover: /run/current-system is still missing after 60s. Check: ls /nix/store; sudo launchctl print system/org.nixos.activate-system" >&2
  return 1
}
function _nix_recover_preexec() {
  # not `[[ ]] && ...`: a non-matching line must return 0, or a `source ~/.zshrc* && ...` chain stops here
  [[ "$1" == *darwin-rebuild* ]] || return 0
  nix-recover
}

# darwin-reload -- darwin-rebuild for one of this repo's hosts, followed by the Lumo sign-in when it has expired.
#
#   darwin-reload switch laptop            this MacBook
#   darwin-reload switch desktop           MacMiniM1; from the MacBook it runs there over ssh
#   darwin-reload switch work
#   darwin-reload build laptop --show-trace   (build and check also work; extra arguments go to darwin-rebuild)
#
# After a successful switch of laptop or desktop it asks that machine's tamer whether the Proton sign-in is still
# valid. If it is not, the browser sign-in starts here: lumoauth for the laptop, lumoreauth for the Mini (the Mini is
# headless, so its sign-in always happens in a browser on the MacBook). A valid sign-in is left alone, and no API key
# is ever changed. Plain `darwin-rebuild switch` only prints the sign-in state (nix-modules/macos/lumo.nix); the
# activation runs as root without a desktop session and cannot hold a browser sign-in.
function darwin-reload() {
  local action="$1" host="$2"
  if [[ "$action" != (switch|build|check) || "$host" != (laptop|desktop|work) ]]; then
    echo "usage: darwin-reload <switch|build|check> <laptop|desktop|work> [darwin-rebuild arguments...]" >&2
    return 2
  fi
  shift 2
  local mini="${LUMO_MINI_USER:-havoc}@${LUMO_MINI_HOST:-macminim1.rollet.family}"
  local this="$(scutil --get LocalHostName 2>/dev/null)" remote=""
  # desktop is MacMiniM1: from any other Mac its rebuild runs there (-t: sudo asks for the password)
  [[ "$host" == desktop && "${this:l}" != macminim1 ]] && remote="$mini"
  local -a sudo_cmd
  [[ "$action" == build ]] || sudo_cmd=(sudo)   # switch and check must run as root (darwin-rebuild refuses otherwise)
  if [[ -n "$remote" ]]; then
    ssh -t "$remote" "${sudo_cmd[*]} darwin-rebuild $action --flake ~/nix-darwin#macos_desktop ${(j: :)${(q)@}}" || return $?
  else
    nix-recover || return $?
    "${sudo_cmd[@]}" darwin-rebuild "$action" --flake "$HOME/nix-darwin#macos_$host" "$@" || return $?
  fi
  [[ "$action" == switch && "$host" != work ]] || return 0
  _lumo_signin_if_invalid "$host" "$remote"
}

# Lumo sign-in state of this machine ($1 empty) or of the ssh target in $1: prints valid, invalid, building
# (provision-tamer.sh is running, or tamer is built and its daemon has not written config.yaml yet, which is the case
# right after a first switch), missing (not built and no provisioner running: that host has not been switched since
# the tamer directory changed, or its provisioning failed), or unreachable (the ssh connection itself failed, which
# says nothing about the sign-in).
function _lumo_signin_state() {
  local check='export PATH=/opt/homebrew/bin:$PATH; d=$HOME/lumo-tamer-fullhavoc
if [ ! -d "$d/dist" ] || [ ! -f "$d/config.yaml" ]; then
  if pgrep -qf provision-tamer.sh || [ -d "$d/dist" ]; then echo building; else echo missing; fi
  exit 0
fi
cd "$d" && tamer auth status 2>&1'
  local out
  if [[ -n "$1" ]]; then
    # -n: this runs from a prompt hook, so ssh must not read (and swallow) what is typed ahead at the terminal
    out=$(ssh -n -o BatchMode=yes -o ConnectTimeout=8 "$1" "$check" 2>&1)
    [[ $? -eq 255 ]] && { echo unreachable; return 0; }
  else
    out=$(/bin/sh -c "$check" 2>&1)
  fi
  case "$out" in
    building|missing) echo "$out" ;;
    *"Authentication is configured and valid"*) echo valid ;;
    *) echo invalid ;;
  esac
}

# After a switch: start the browser sign-in for $1 (laptop|desktop) when its session is not valid. $2 = ssh target
# when the desktop was switched from another Mac. $3 = nowait: check once, do not wait for a provisioner (for a host
# this switch did not touch).
function _lumo_signin_if_invalid() {
  local host="$1" remote="$2" nowait="$3" state i
  # a first switch builds lumo-tamer in the background and its daemon then writes config.yaml: give it 2 minutes
  for i in {1..12}; do
    state=$(_lumo_signin_state "$remote")
    [[ "$state" == building && "$nowait" != nowait ]] || break
    (( i == 1 )) && echo "Lumo: lumo-tamer${remote:+ on MacMiniM1} is still being set up, waiting up to 2 minutes..."
    sleep 10
  done
  case "$state" in
    valid) echo "Lumo: Proton sign-in${remote:+ on MacMiniM1} is valid, nothing to do."; return 0 ;;
    unreachable) echo "Lumo: could not reach $remote over ssh, so its sign-in was not checked."; return 0 ;;
    building)
      echo "Lumo: lumo-tamer${remote:+ on MacMiniM1} is not ready yet (tail ~/lumo-tamer-fullhavoc.provision.log). Sign in afterwards with: ${${host:#desktop}:+lumoauth}${${host:#laptop}:+lumoreauth}"
      return 0 ;;
    missing)
      echo "Lumo: lumo-tamer${remote:+ on MacMiniM1} is not set up in ~/lumo-tamer-fullhavoc and no provisioner is running. Run: darwin-reload switch $host (if that does not fix it: tail ~/lumo-tamer-fullhavoc.provision.log)"
      return 0 ;;
  esac
  if [[ "$host" == laptop ]]; then
    echo "Lumo: the Proton sign-in on this machine is not valid. Starting the browser sign-in (lumoauth)..."
    zsh ~/.config/lumo/reauth.sh --local
  elif [[ -n "$remote" ]]; then
    echo "Lumo: the Proton sign-in on MacMiniM1 is not valid. Starting the browser sign-in here (lumoreauth)..."
    zsh ~/.config/lumo/reauth.sh
  else
    echo "Lumo: the Proton sign-in on this machine is not valid, and it has no screen. Run lumoauth here (Chromium opens on the MacBook) or lumoreauth on the MacBook"
  fi
}

# The switch is usually typed as plain `sudo darwin-rebuild switch --flake ~/nix-darwin#macos_<host>` (often behind
# `gp && source ~/.zshrc* &&`), not through darwin-reload, so an interactive shell watches for it: preexec remembers
# the command line, precmd runs the same sign-in check once the line has finished with exit 0.
#   macos_laptop   this machine's sign-in (lumoauth when it is not valid), then the Mini's as well, because the Mini is
#                  headless and can only be signed in from here (lumoreauth when it is not valid)
#   macos_desktop  typed on the Mini itself: its sign-in; when it is not valid this prints what to run on the MacBook
# A darwin-reload command line does not contain "darwin-rebuild", so the check never runs twice.
function _lumo_switch_preexec() {
  _LUMO_SWITCH_CMD=""
  [[ "$1" == *darwin-rebuild*switch*macos_(laptop|desktop)* ]] && _LUMO_SWITCH_CMD="$1"
}
function _lumo_switch_precmd() {
  local rc=$? cmd="$_LUMO_SWITCH_CMD"
  _LUMO_SWITCH_CMD=""
  [[ -n "$cmd" && $rc -eq 0 ]] || return $rc
  if [[ "$cmd" == *macos_desktop* ]]; then
    _lumo_signin_if_invalid desktop ""
  else
    _lumo_signin_if_invalid laptop ""
    # a laptop switch starts no provisioning on the Mini, so waiting for one there would only block the prompt
    _lumo_signin_if_invalid desktop "${LUMO_MINI_USER:-havoc}@${LUMO_MINI_HOST:-macminim1.rollet.family}" nowait
  fi
  return $rc
}
if [[ -o interactive ]]; then
  autoload -Uz add-zsh-hook
  add-zsh-hook preexec _lumo_switch_preexec
  add-zsh-hook precmd _lumo_switch_precmd
  add-zsh-hook preexec _nix_recover_preexec
  # preexec runs before a command line starts. The usual line sources this file and then switches, so in a shell
  # that did not have the hook yet (or after a change to it) preexec never saw that line and the first switch was
  # skipped. $history[$HISTCMD] is the line running right now: arm the check from it as preexec would have.
  zmodload -F zsh/parameter p:history 2>/dev/null
  _lumo_switch_preexec "${history[$HISTCMD]:-}"
  _nix_recover_preexec "${history[$HISTCMD]:-}"
fi
