# Core primitive: a herdr workspace labeled $name (local pane cwd $dir) with 3 tabs
# -- nvim (focused), aidev, zsh -- running $cmd_nvim/$cmd_aidev/$cmd_zsh respectively.
# Used for both local project layouts and remote/ssh layouts (the remote ones just
# pass ssh-wrapped commands instead of plain local ones).
#
# $HERDR_ENV is set inside every herdr pane (like tmux's $TMUX). When already inside
# herdr, attaching to a separate named session would nest multiplexers, so instead
# this opens/focuses a workspace labeled $name in the CURRENT session.
_herdr_space() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" cmd_zsh="$5" tab_suffix="$6"
  local label_nvim="nvim${tab_suffix}" label_aidev="aidev${tab_suffix}" label_zsh="zsh${tab_suffix}"

  if [ -n "$HERDR_ENV" ]; then
    local ws_id p1 p2 p3
    ws_id=$(herdr workspace list | jq -r --arg n "$name" '.result.workspaces[] | select(.label==$n) | .workspace_id' | head -1)
    if [ -z "$ws_id" ]; then
      ws_id=$(herdr workspace create --cwd "$dir" --label "$name" | jq -r '.result.workspace.workspace_id')
      p1="${ws_id}:p1"
      herdr tab rename "${ws_id}:t1" "$label_nvim" >/dev/null
      [ -n "$cmd_nvim" ] && herdr pane run "$p1" "$cmd_nvim" >/dev/null
      p2=$(herdr tab create --workspace "$ws_id" --cwd "$dir" --label "$label_aidev" --no-focus | jq -r '.result.root_pane.pane_id')
      [ -n "$cmd_aidev" ] && herdr pane run "$p2" "$cmd_aidev" >/dev/null
      p3=$(herdr tab create --workspace "$ws_id" --cwd "$dir" --label "$label_zsh" --no-focus | jq -r '.result.root_pane.pane_id')
      [ -n "$cmd_zsh" ] && herdr pane run "$p3" "$cmd_zsh" >/dev/null
    fi
    herdr workspace focus "$ws_id" >/dev/null
    return
  fi

  if ! herdr session list --json 2>/dev/null | jq -e --arg n "$name" '.sessions[] | select(.name==$n and .running==true)' >/dev/null 2>&1; then
    nohup herdr server --session "$name" >/dev/null 2>&1 &
    disown
    sleep 0.5
    herdr workspace create --session "$name" --cwd "$dir" --label "$name" >/dev/null
    herdr tab rename w1:t1 "$label_nvim" --session "$name" >/dev/null
    [ -n "$cmd_nvim" ] && herdr pane run w1:p1 "$cmd_nvim" --session "$name" >/dev/null
    herdr tab create --session "$name" --workspace w1 --cwd "$dir" --label "$label_aidev" --no-focus >/dev/null
    [ -n "$cmd_aidev" ] && herdr pane run w1:p2 "$cmd_aidev" --session "$name" >/dev/null
    herdr tab create --session "$name" --workspace w1 --cwd "$dir" --label "$label_zsh" --no-focus >/dev/null
    [ -n "$cmd_zsh" ] && herdr pane run w1:p3 "$cmd_zsh" --session "$name" >/dev/null
  fi
  herdr --session "$name"
}

# aidev tab starts as a plain shell (no auto-launched aiselect && aidev) -- launch
# it manually when you actually want an agent running; herdr's pane persistence
# means detach/reattach just resumes whatever's running in it.
_herdr_devlayout() {
  local name="$1" dir="$2"
  _herdr_space "$name" "$dir" "nvim" "" "git status"
}

# Same 3-tab layout, but each tab ssh's into $host and runs its command in
# $remote_dir there. No herdr install needed on the remote end -- it's just an
# ssh'd-in shell inside a local pane, same as typing the ssh command by hand.
#
# Each command runs via `zsh -ic` on the remote side: a plain ssh remote command
# is non-interactive, so .zshrc (and its homebrew PATH setup) never sources and
# tools like nvim/aiselect come back "command not found".
_herdr_remote_space() {
  local name="$1" host="$2" remote_dir="$3"
  local ssh="ssh -t -i ~/.ssh/id_ed25519 $host"
  _herdr_space "$name" "$HOME" \
    "$ssh \"zsh -ic 'cd $remote_dir && nvim'\"" \
    "$ssh \"zsh -ic 'cd $remote_dir && exec zsh -l'\"" \
    "$ssh \"zsh -ic 'cd $remote_dir && git status; exec zsh -l'\"" \
    "-macmini"
}

# Guards nxvim/psvim/hivim/itvim against machines where the project folder doesn't
# exist (e.g. ~/home-infrastructure isn't cloned on the work laptop).
_herdr_project() {
  local name="$1" dir="$2"
  if [ ! -d "$dir" ]; then
    echo "herdr: $dir does not exist on this machine, skipping $name" >&2
    return 1
  fi
  cd "$dir" && _herdr_devlayout "$name" "$dir"
}

