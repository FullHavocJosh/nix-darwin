alias nxvim="cd ~/nix-darwin && ~/.config/tmux/plugins/tpm/scripts/install_plugins.sh && (tmux has-session -t nix-darwin 2>/dev/null && tmux attach -t nix-darwin || (tmux new-session -s nix-darwin -d \; split-window -h \; split-window -v \; select-pane -t 0 \; send-keys 'nvim' Enter \; select-pane -t 1 \; send-keys 'aidev' Enter \; select-pane -t 2 \; send-keys 'git status' Enter \; select-pane -t 1 \; attach))"
alias devim='~/.config/tmux/plugins/tpm/scripts/install_plugins.sh && (tmux has-session -t $(basename $(pwd)) 2>/dev/null && tmux attach -t $(basename $(pwd)) || (tmux new-session -s $(basename $(pwd)) -d \; split-window -h \; split-window -v \; select-pane -t 0 \; send-keys "nvim" Enter \; select-pane -t 1 \; send-keys "aidev" Enter \; select-pane -t 2 \; send-keys "git status" Enter \; select-pane -t 1 \; attach))'
