# Ignore .DS_Store and other macOS-specific clutter
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
*.swp
*.swo

# Ignore sensitive or machine-specific configurations
**/secrets/
private/
*bak
*.backup
*_local*

# =============================================================================
# Environment Variable Files - Security Policy
# =============================================================================
#
# Two-file system for environment variables:
#
# 1. .zshrc_envvars (IGNORED - contains SENSITIVE data)
#    - API keys, tokens, secrets, passwords
#    - Plain text storage with chmod 600
#    - Never committed to git
#
# 2. .zshrc_envvars_insecure (TRACKED - contains NON-SENSITIVE data)
#    - AWS regions, profiles, default configurations
#    - Safe to share with team via git
#    - Despite "_insecure" in name, this file is intentionally tracked
#    - Name indicates "insecure to store secrets here" not "ignored by git"
#    - See file header for detailed security notice
#
# IMPORTANT: The wildcard pattern *_insecure* was intentionally removed
# to allow .zshrc_envvars_insecure to be tracked. This is by design.
#
# =============================================================================

# Ignore SENSITIVE environment variables (API keys, tokens, secrets)
.zshrc_envvars

# NOTE: .zshrc_envvars_insecure is intentionally NOT ignored (see above)

# Ansible inventory with real IPs/hosts  
ansible-linux/inventory/linux
ansible-linux/inventory/production
ansible-linux/inventory/staging

# SSH configurations
.ssh/
**/.ssh/

# Local environment files
.env.local
.env.production  
.env.staging

# Ignore coplit folders
/.config/github-copilot

# Ignore claude folders
/.claude

# Ignore crush folders
/.crush
/.config/crush/commands/

# Ignore opencode folders
/.opencode
/.config/opencode/commands/

# Ignore k9s clusters
/.config/k9s/clusters/

# Ignore logs and temporary files
*.log
*.tmp
.cache/
*.swp
*.pid

# Other machine-specific files, if necessary
*.local

# Ignore Nix-Darwin generated files and caches
/result
/nix/store
/nix/var/nix/profiles
/nix/var/nix/gcroots
/nix/var/log/nix/drvs
/nix/var/nix/temproots
/Library/Caches/com.apple.dt.Xcode

# Ignore Homebrew-specific files (if linked via Homebrew)
opt/
/usr/local/Cellar/
/usr/local/Homebrew/
Library/Taps/

# Stow ignores
stow-uninstall-local-ignore
**/.stow-uninstall-local-ignore

# Ignore stow conflicts (e.g., files/folders already in the target location)
*~

# Ignore lazy plugin lock files
**/lazy-lock.json

# Ignore btop.log, because why wouldn't you
**/btop.log

# Ignore iTerm folders
/.config/iterm2/AppSupport
/.config/iterm2/sockets

# Ignore Jetbrains folder
/.config/jgit
/.idea

# Ignore Ansible folders
/.ansible
**/.ansible

# Ignore NuGet
/.config/NuGet

# Ignore Raycast
/.config/raycast

# Ignore openchamber auto-generated device identifiers
.config/openchamber/install-id-*
.config/openchamber/sessions-directories.json

# Ignore Git
/.git

# Ignore tmux plugins
/.config/tmux/plugins/tmux*
/.config/tmux/plugins/tmux-*
/.config/tmux/plugins/*-tmux-*

# Ignore AWS VPN configs
/.config/AWS VPN Client*
/.config/AWSVPNCLient*
# GPA code review cache (stored in .git directory)
.git/gpa_review_cache

# =============================================================================
# Zed Editor - Security Policy
# =============================================================================
#
# SECURITY RATIONALE:
# - settings.json contains hardcoded GitHub Personal Access Token
# - conversations/ contains AI chat history (potentially sensitive)
# - prompts/ contains LMDB database files (unencrypted, may include sensitive context)
#
# TRACKED vs IGNORED:
# - Themes are safe to track (no secrets)
# - All other Zed config contains sensitive data and must be gitignored
#
# CROSS-MACHINE SYNC:
# - Settings cannot use environment variables (Zed limitation)
# - Must manually replicate settings.json on each machine
# - Token stored in ~/.zshrc_envvars (already gitignored above)
#
# =============================================================================

# Ignore Zed settings (contains hardcoded GitHub token)
.config/zed/settings.json

# Ignore AI conversation history and prompts database
.config/zed/conversations/
.config/zed/prompts/

# Keep themes tracked (safe, no secrets)
!.config/zed/themes/
