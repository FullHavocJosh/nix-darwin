cd '$file_dir'

# Create tmux session with nvim in top pane and OpenCode in bottom
tmux new-session -s '$session_name' -c '$file_dir' "nvim '$file_path'" \\; \\
  split-window -v -p 30 -c '$file_dir' "bash -c 'echo \"=== Code Review Fix Assistant ===\"; echo \"\"; echo \"Recommendation:\"; cat \"$rec_file\"; echo \"\"; echo \"Starting OpenCode...\"; echo \"\"; opencode --model \"$model\" -p \"Help me implement this fix: \\\$(cat \\\"$rec_file\\\"). The file to fix is: $file_path\"; exec \\\$SHELL'" \\; \\
