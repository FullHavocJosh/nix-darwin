# Helper function: Get hash of file's staged content
# Usage: _gpa_get_file_hash <file_path>
function _gpa_get_file_hash() {
  local file="$1"
  git diff --cached -- "$file" | shasum -a 256 | cut -d' ' -f1
}

# Helper function: Check if a file has been reviewed and hasn't changed
# Usage: _gpa_is_file_reviewed <file_path>
function _gpa_is_file_reviewed() {
  local file="$1"
  local git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  local cache_file="$git_root/.git/gpa_review_cache"
  
  if [ ! -f "$cache_file" ]; then
    return 1  # No cache file, file not reviewed
  fi
  
  local current_hash=$(_gpa_get_file_hash "$file")
  
  # Check if this file+hash exists in cache
  if grep -q "^${file}:${current_hash}$" "$cache_file" 2>/dev/null; then
    return 0  # File reviewed and unchanged
  fi
  
  return 1  # File not reviewed or changed
}

# Helper function: Mark a file as reviewed
# Usage: _gpa_mark_file_reviewed <file_path>
function _gpa_mark_file_reviewed() {
  local file="$1"
  local git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  local cache_file="$git_root/.git/gpa_review_cache"
  
  local current_hash=$(_gpa_get_file_hash "$file")
  
  # Remove any old entries for this file
  if [ -f "$cache_file" ]; then
    grep -v "^${file}:" "$cache_file" > "${cache_file}.tmp" 2>/dev/null || touch "${cache_file}.tmp"
    mv "${cache_file}.tmp" "$cache_file"
  fi
  
  # Add new entry
  echo "${file}:${current_hash}" >> "$cache_file"
}

# Helper function: Clear review cache
# Usage: _gpa_clear_cache
function _gpa_clear_cache() {
  local git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  local cache_file="$git_root/.git/gpa_review_cache"
  
  if [ -f "$cache_file" ]; then
    rm -f "$cache_file"
    echo "✓ Review cache cleared"
  else
    echo "ℹ No review cache to clear"
  fi
}

# Helper function: Split staged files into batches for AI review
# Returns batches as a JSON array where each batch is an array of file paths
# Batches are sized to keep diff output around 300 lines per batch
# Usage: _gpa_create_batches
function _gpa_create_batches() {
  local target_lines=300
  local batches="[]"
  local current_batch="[]"
  local current_batch_lines=0
  
  # Get all staged files
  local staged_files=()
  
  while IFS= read -r file; do
    staged_files+=("$file")
  done < <(git diff --cached --name-only)
  
  if [ ${#staged_files[@]} -eq 0 ]; then
    echo "[]"
    return 0
  fi
  
  # Process each file and group into batches
  for file in "${staged_files[@]}"; do
    # Get line count for this file's diff
    local file_diff_lines=$(git diff --cached -- "$file" | wc -l)
    
    # If adding this file would exceed target, start a new batch
    # (unless current batch is empty - always include at least one file per batch)
    if [ $current_batch_lines -gt 0 ] && [ $((current_batch_lines + file_diff_lines)) -gt $target_lines ]; then
      # Save current batch and start a new one
      batches=$(echo "$batches" | jq --argjson batch "$current_batch" '. += [$batch]')
      current_batch="[]"
      current_batch_lines=0
    fi
    
    # Add file to current batch
    current_batch=$(echo "$current_batch" | jq --arg file "$file" '. += [$file]')
    current_batch_lines=$((current_batch_lines + file_diff_lines))
  done
  
  # Add the last batch if it's not empty
  if [ "$(echo "$current_batch" | jq 'length')" -gt 0 ]; then
    batches=$(echo "$batches" | jq --argjson batch "$current_batch" '. += [$batch]')
  fi
  
  echo "$batches"
}

# Helper function: Check if issues warrant escalation to Opus
# Usage: _gpa_should_escalate <issues_json>
# Returns: 0 (true) if escalation recommended, 1 (false) otherwise
function _gpa_should_escalate() {
  local issues_json="$1"
  
  # Check if we have any issues at all
  local issue_count=$(echo "$issues_json" | jq 'length' 2>/dev/null)
  if [[ -z "$issue_count" ]] || [[ "$issue_count" -eq 0 ]]; then
    return 1  # No issues, no escalation
  fi
  
  # Keywords that indicate security-critical issues
  local security_keywords=("security" "credential" "secret" "password" "token" "key" "auth" "vulnerability" "injection" "xss" "csrf" "encryption")
  
  # Check for Critical severity issues with security keywords
  local has_critical_security=false
  while IFS= read -r issue_text; do
    # Check if this is a Critical issue
    local severity=$(echo "$issue_text" | jq -r '.severity' 2>/dev/null)
    if [[ "$severity" != "Critical" ]]; then
      continue
    fi
    
    # Check if issue or recommendation contains security keywords
    local issue_desc=$(echo "$issue_text" | jq -r '.issue + " " + .recommendation' 2>/dev/null | tr '[:upper:]' '[:lower:]')
    
    for keyword in "${security_keywords[@]}"; do
      if echo "$issue_desc" | grep -qi "$keyword"; then
        return 0  # Found Critical + security keyword = escalate
      fi
    done
  done < <(echo "$issues_json" | jq -c '.[]' 2>/dev/null)
  
  return 1  # No critical security issues found
}

# Helper function: Determine appropriate AI model tier based on batch characteristics
# Usage: _gpa_determine_tier <batch_files_json> <batch_lines> [total_batch_count]
# Returns: "local" (llama-cpp provider), "haiku", "sonnet", or "opus" (cloud providers)
#
# llama-cpp size routing (based on total_batch_count, each batch ~300 lines):
#   ≤2 batches  (~600 lines)  → local 7B  (~30s/batch, ~60s total)
#   3-4 batches (~1200 lines) → cloud Haiku (fast, cheap)
#   5+ batches  (~1500+ lines) → cloud Sonnet (large diff, needs quality)
function _gpa_determine_tier() {
  local batch_files_json="$1"
  local batch_lines="$2"
  local total_batch_count="${3:-1}"

  local provider=$(_get_ai_provider)
  
  # llama.cpp: Hybrid escalation strategy
  if [[ "$provider" == "llama-cpp" ]] || [[ "$provider" == "llama.cpp" ]]; then
    # For small diffs, keep local. For larger diffs, escalate to cloud.
    if [ "$total_batch_count" -ge 5 ]; then
      echo "sonnet"  # large diff — cloud quality
    elif [ "$total_batch_count" -ge 3 ]; then
      echo "haiku"   # medium diff — fast cloud
    else
      echo "local"   # small diff — local 7B is fast enough
    fi
    return 0
  fi

  # OpenCode with free model: Always use the configured free model
  if [[ "$provider" == "opencode" ]] && _is_opencode_free_model; then
    echo "free"  # Special marker for free model
    return 0
  fi

  # Check if provider supports multiple tiers
  if ! _supports_multi_tier; then
    # Single model only (shouldn't happen for cloud providers, but safety check)
    echo "sonnet"
    return 0
  fi

  # Multi-tier providers: Intelligent tier selection based on complexity
  
  # Check for critical file paths that should use Opus (if available)
  if _supports_opus; then
    local critical_paths=("security" "auth" "payment" "encryption" "credential" "secret" "iam" "policy" "kms")
    local batch_files_str=$(echo "$batch_files_json" | jq -r '.[]' | tr '\n' ' ')
    
    for critical_path in "${critical_paths[@]}"; do
      if echo "$batch_files_str" | grep -qi "$critical_path"; then
        echo "opus"
        return 0
      fi
    done
    
    # Check for large batches (>500 lines) - use Opus for better accuracy
    if [ "$batch_lines" -gt 500 ]; then
      echo "opus"
      return 0
    fi
  fi
  
  # Default to sonnet for code review
  echo "sonnet"
  return 0
}

# Helper function: Review a batch of files and return structured issues
# Usage: _gpa_review_batch <batch_files_json> <batch_number> <total_batches> [tier_override]
function _gpa_review_batch() {
  local batch_files_json="$1"
  local batch_number="$2"
  local total_batches="$3"
  local tier_override="${4:-auto}"  # Optional: "haiku", "sonnet", "opus", or "auto"
  
  # Convert JSON array to regular array
  local batch_files=()
  while IFS= read -r file; do
    batch_files+=("$file")
  done < <(echo "$batch_files_json" | jq -r '.[]')
  
  if [ ${#batch_files[@]} -eq 0 ]; then
    echo "[]"
    return 0
  fi
  
  # Get diff for only these files
  local batch_diff=""
  for file in "${batch_files[@]}"; do
    batch_diff="${batch_diff}$(git diff --cached -- "$file")\n"
  done

  # Build surrounding context: 40 lines before/after each changed hunk from the full file
  # This lets the reviewer see nearby comments/guards without scanning the whole file
  local batch_context=""
  for file in "${batch_files[@]}"; do
    if [[ -f "$file" ]]; then
      # Extract changed line numbers from the diff hunk headers, then grab context lines
      local changed_lines
      changed_lines=$(git diff --cached -- "$file" | grep "^@@" | \
        sed 's/.*+\([0-9]*\).*/\1/' | head -20)
      if [[ -n "$changed_lines" ]]; then
        batch_context="${batch_context}
=== Surrounding context: $file ===
"
        while IFS= read -r start_line; do
          local ctx_start=$(( start_line > 40 ? start_line - 40 : 1 ))
          local ctx_end=$(( start_line + 40 ))
          batch_context="${batch_context}$(awk "NR>=${ctx_start} && NR<=${ctx_end} {print NR\": \"\$0}" "$file")
---
"
        done <<< "$changed_lines"
      fi
    fi
  done
  
  # Count lines in this batch
  local batch_lines=$(echo -e "$batch_diff" | wc -l)
  
  # Determine which AI tier to use
  # First check if a specific model is already selected in opencode.json
  local selected_model=""
  local _active_provider=$(_get_ai_provider)
  if [[ "$_active_provider" == "opencode" ]] || [[ "$_active_provider" == "github-copilot" ]]; then
    local config_file="$HOME/.config/opencode/opencode.json"
    if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
      selected_model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
    fi
  fi
  
  local ai_tier="sonnet"
  if [[ -n "$selected_model" && "$selected_model" != "null" ]]; then
    # A specific model is selected - use "selected" as the tier marker
    ai_tier="selected"
  elif [[ "$tier_override" == "auto" ]]; then
    ai_tier=$(_gpa_determine_tier "$batch_files_json" "$batch_lines" "$total_batches")
  else
    ai_tier="$tier_override"
  fi
  
  # Check if any Terraform files are in this batch
  local has_terraform=false
  for file in "${batch_files[@]}"; do
    if [[ "$file" == *.tf ]]; then
      has_terraform=true
      break
    fi
  done
  
  # Build review prompt
  local review_prompt="Review the following staged git changes for CRITICAL ISSUES AND WARNINGS ONLY:

🔴 **CRITICAL - Must Fix Before Commit:**
1. **SECRETS & CREDENTIALS**: API keys, passwords, tokens, private keys, connection strings, AWS credentials, OAuth secrets, certificates. NOTE: Environment variable references like \${VAR_NAME} or \$VAR_NAME are NOT hardcoded credentials — do not flag them.
2. **Bugs**: Syntax errors, runtime errors, null pointer dereferences, infinite loops
3. **Security Vulnerabilities**: SQL injection, command injection, XSS, insecure crypto, path traversal
4. **Data Loss**: Destructive operations without safeguards, missing transactions, race conditions

🟡 **WARNINGS - Should Consider:**
5. **Security Concerns**: Overly permissive permissions, missing input validation, unsafe eval, hardcoded IPs/domains
6. **Logic Flaws**: Off-by-one errors, incorrect conditionals, missing edge cases
7. **Breaking Changes**: API changes, removed functionality, incompatible updates"
  
  if [ "$has_terraform" = true ]; then
    review_prompt="$review_prompt

**TERRAFORM-SPECIFIC CRITICAL/WARNING CHECKS** (detected .tf files):
🔴 **Critical**: Hardcoded secrets/keys, publicly exposed resources, destructive changes without lifecycle protection
🟡 **Warnings**: Overly permissive IAM (wildcards in production), missing encryption, expensive resources without justification"
  fi
  
  # Include secrets analysis verdict if available
  local secrets_context=""
  if [[ -f /tmp/gpa_secrets_verdict.txt ]]; then
    if [[ -s /tmp/gpa_secrets_verdict.txt ]]; then
      secrets_context="

PRIOR SECURITY ANALYSIS — Secrets detection already analyzed the following items and determined they are FALSE POSITIVES. Do NOT re-flag these:
$(cat /tmp/gpa_secrets_verdict.txt | head -30)

Secrets in your diff that match these patterns have ALREADY been verified as safe (placeholder examples, runtime-generated values, or template variable references). If a detection matches one of these, do NOT include it in your output."
    fi
  fi

  # Build full prompt
  local full_prompt="${review_prompt}${secrets_context}

Batch ${batch_number} of ${total_batches} (${batch_lines} lines)

Files in this batch:
$(printf '%s\n' "${batch_files[@]}")

Git diff:
${batch_diff}
${batch_context}
**IMPORTANT INSTRUCTIONS:**
- ONLY report 🔴 Critical issues and 🟡 Warnings
- IGNORE minor suggestions, style preferences, and code quality opinions
- Focus on things that will actually break, cause security issues, or have serious consequences
- ONLY flag issues that are INTRODUCED OR WORSENED by lines marked with + in the diff — do NOT flag pre-existing code in unchanged lines
- The surrounding context is provided so you can see if a nearby comment, guard clause, or existing code ALREADY mitigates the concern — if so, do NOT flag it
- If the code or a comment already acknowledges a known limitation, do NOT flag it as an issue
- If a prior security analysis has already confirmed an item is a false positive, do NOT flag it
- Output ONLY a JSON array of issues in this exact format:
[
  {
    \"file\": \"path/to/file.ext\",
    \"severity\": \"Critical\" or \"Warning\",
    \"issue\": \"Brief issue description\",
    \"recommendation\": \"Detailed fix recommendation\"
  }
]
- If there are no critical/warning issues in this batch, return an empty array: []
- Return ONLY valid JSON, nothing else."
  
  # Note: Tier display moved to main loop for better visibility
  # (was being cleared by progress spinner)

  # ── Route the API call ──────────────────────────────────────────────────────
  # "local"            → llama-cpp via _run_ai_direct (provider already set)
  # "cloud-escalation" → cloud fallback provider via _run_ai_direct_cloud
  # anything else      → cloud provider via _run_ai_direct (haiku/sonnet/opus)
  local batch_result
  local api_exit_code

  local _route_provider=$(_get_ai_provider)
  local _route_model
  
  # Use selected model if available, otherwise use tier-based selection
  if [[ "$ai_tier" == "selected" && -n "$selected_model" ]]; then
    _route_model="$selected_model"
  else
    _route_model=$(_get_opencode_model "$ai_tier")
  fi

  if [[ "$ai_tier" == "cloud-escalation" ]]; then
    local _cloud=$(_get_cloud_fallback_provider)
    local _cloud_model=$(_get_cloud_model "sonnet")
    echo "  ☁  Routing to cloud [$_cloud / $_cloud_model] for escalation..." >&2
    batch_result=$(echo "$full_prompt" | _run_ai_direct_cloud "sonnet" 2>&1)
    api_exit_code=$?
  elif [[ "$ai_tier" == "local" ]]; then
    echo "  ⚪ Using local model [$_route_provider / $(_llamacpp_model_short)]" >&2
    batch_result=$(echo "$full_prompt" | _run_ai_direct "sonnet" 2>&1)
    api_exit_code=$?
    if [ $api_exit_code -eq 1 ]; then
      local _cloud=$(_get_cloud_fallback_provider)
      echo "  ⚠ Local model failed — falling back to cloud [$_cloud]..." >&2
      batch_result=$(echo "$full_prompt" | _run_ai_direct_cloud "sonnet" 2>&1)
      api_exit_code=$?
    fi
  else
    echo "  🤖 Using [$_route_provider / $_route_model]" >&2
    batch_result=$(echo "$full_prompt" | _run_ai_direct "$ai_tier" 2>&1)
    api_exit_code=$?
  fi

  # Check exit codes
  if [ $api_exit_code -eq 1 ]; then
    # Hard failure - API error, timeout, network issue
    echo "  ✗ API Error" >&2
    echo "[]"
    return 1
  elif [ $api_exit_code -eq 2 ]; then
    # Soft failure - unparseable response
    echo "  ⚠ AI response could not be parsed" >&2
    echo "[]"
    return 2
  fi
  
  # Success (exit code 0) - validate and return
  if echo "$batch_result" | jq empty 2>/dev/null; then
    echo "$batch_result"
    return 0
  fi
  
  # Shouldn't reach here if _run_ai_direct works correctly, but handle it
  echo "  ⚠ Unexpected: Valid exit code but invalid JSON" >&2
  echo "[]"
  return 2
}

# Helper function: Launch aidev inline with all issues as context
# Usage: _gpa_send_all_to_aidev <structured_issues_json>
# Returns 0 to re-review, 1 to keep staged
function _gpa_send_all_to_aidev() {
  local structured_issues="$1"
  local issue_count=$(echo "$structured_issues" | jq 'length' 2>/dev/null)
  local session_name="gpa-aidev-$$"

  # Build prompt file
  local prompt_file="/tmp/gpa_all_issues_$$.txt"
  printf "I have %s code review issue(s) in my staged git changes that need to be fixed. Please help me address each one.\n\n" "$issue_count" > "$prompt_file"

  local i=0
  while [ $i -lt "$issue_count" ]; do
    local issue=$(echo "$structured_issues" | jq -r ".[$i]" 2>/dev/null)
    local file=$(echo "$issue" | jq -r '.file // empty' 2>/dev/null)
    local severity=$(echo "$issue" | jq -r '.severity // empty' 2>/dev/null)
    local issue_desc=$(echo "$issue" | jq -r '.issue // empty' 2>/dev/null)
    local recommendation=$(echo "$issue" | jq -r '.recommendation // empty' 2>/dev/null)
    printf -- "---\nIssue %s of %s\nFile: %s\nSeverity: %s\nIssue: %s\nRecommendation: %s\n\n" \
      "$((i+1))" "$issue_count" "$file" "$severity" "$issue_desc" "$recommendation" >> "$prompt_file"
    ((i++))
  done
  printf "Please fix all of these issues. After fixing, I'll re-stage the affected files." >> "$prompt_file"

  # Capture staged files and their hashes before running aidev
  local repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  local staged_files=()
  while IFS= read -r f; do
    staged_files+=("$f")
  done < <(git diff --cached --name-only)

  # Snapshot content hashes of each staged file before aidev runs
  local -A pre_hashes
  for f in "${staged_files[@]}"; do
    local abs="$repo_root/$f"
    if [[ -f "$abs" ]]; then
      pre_hashes[$f]=$(shasum -a 256 "$abs" | cut -d' ' -f1)
    fi
  done

  echo ""
  echo "=== aidev: Fix All Issues ==="
  echo ""
  local model=$(jq -r '.model // empty' ~/.config/opencode/opencode.json 2>/dev/null)
  [ -z "$model" ] && model=$(_get_opencode_model "sonnet")
  (cd "$repo_root" && opencode --model "$model" --prompt "I have $issue_count code review issue(s) in my staged git changes that need to be fixed. Read $prompt_file for full details and help me fix them.")
  rm -f "$prompt_file"

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "aidev session complete."
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  echo "  [Enter] Re-review with gpa"
  echo "  [esc]   Keep staged as-is"
  echo ""
  echo -n "Your choice: "
  _read_key
  echo ""

  case "$_KEY" in
    $'\n' | $'\r')
      echo ""
      # Re-stage all files, but only re-review files aidev actually changed
      local changed_files=()
      for f in "${staged_files[@]}"; do
        local abs="$repo_root/$f"
        git -C "$repo_root" add "$f" 2>/dev/null
        local post_hash=""
        if [[ -f "$abs" ]]; then
          post_hash=$(shasum -a 256 "$abs" | cut -d' ' -f1)
        fi
        if [[ "${pre_hashes[$f]}" != "$post_hash" ]]; then
          changed_files+=("$f")
        fi
      done

      if [[ ${#changed_files[@]} -eq 0 ]]; then
        echo "ℹ aidev made no file changes — skipping re-review"
        echo ""
        echo "Options:"
        echo "  [Enter] Commit and push (gpc)"
        echo "  [r]     Force re-review"
        echo "  [esc]   Keep staged"
        echo ""
        echo -n "Your choice: "
        _read_key
        echo ""
        case "$_KEY" in
          y | Y | $'\n') gpc; return $? ;;
          r | R) gpa; return $? ;;
          *) echo "ℹ Keeping changes staged."; return 0 ;;
        esac
      fi

      echo "ℹ aidev modified ${#changed_files[@]} file(s) — re-reviewing only those"
      echo ""
      # Pass the changed files as a filter to a targeted gpa re-review
      _gpa_review_files "${changed_files[@]}"
      return $?
      ;;
    *)
      echo "ℹ Keeping changes staged."
      return 0
      ;;
  esac
}

# Helper function: Run the AI review + interactive fix loop on a specific subset of files
# Usage: _gpa_review_files file1 file2 ...
function _gpa_review_files() {
  local target_files=("$@")

  # Build a batch from only the specified files (as a JSON array)
  local batch="[]"
  for f in "${target_files[@]}"; do
    batch=$(echo "$batch" | jq --arg f "$f" '. += [$f]')
  done

  local batch_count=1
  local batch_lines=$(git diff --cached -- "${target_files[@]}" | wc -l | tr -d ' ')
  local _active_provider=$(_get_ai_provider)

  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Re-reviewing ${#target_files[@]} changed file(s)..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  local tier=$(_gpa_determine_tier "$batch" "$batch_lines" "1")
  local tier_icon="" tier_label=""
  case "$tier" in
    opus)   tier_icon="🔴"; tier_label="Opus" ;;
    sonnet) tier_icon="🔵"; tier_label="Sonnet" ;;
    haiku)  tier_icon="🟢"; tier_label="Haiku" ;;
    *)      tier_icon="🔵"; tier_label="Sonnet" ;;
  esac

  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "$tier_icon $tier_label — Reviewing ${#target_files[@]} file(s)... [$_active_provider]"

  local batch_issues
  batch_issues=$(_gpa_review_batch_with_timeout "$batch" "1" "1" "auto")
  local review_status=$?

  if [[ $review_status -ne 0 ]] || ! echo "$batch_issues" | jq empty 2>/dev/null; then
    echo "  ⚠ Review failed or returned invalid JSON"
    echo ""
    echo "Options:"
    echo "  [Enter] Commit and push (gpc)"
    echo "  [esc]   Keep staged"
    echo ""
    echo -n "Your choice: "
    _read_key; echo ""
    case "$_KEY" in
      y | Y | $'\n') gpc; return $? ;;
      *) echo "ℹ Keeping changes staged."; return 0 ;;
    esac
  fi

  local valid_issues=$(echo "$batch_issues" | jq '[.[] | select(type == "object" and has("file") and has("severity") and has("issue") and has("recommendation"))]' 2>/dev/null)
  local issue_count=$(echo "$valid_issues" | jq 'length')

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  if [[ "$issue_count" -eq 0 ]]; then
    echo "✓ Re-review complete — no issues found in changed files"
  else
    echo "⚠ Re-review found $issue_count remaining issue(s) — showing for reference"
    echo ""
    local ci=0
    while [[ $ci -lt $issue_count ]]; do
      local iss=$(echo "$valid_issues" | jq -r ".[$ci]" 2>/dev/null)
      local isev=$(echo "$iss" | jq -r '.severity // empty')
      local ifile=$(echo "$iss" | jq -r '.file // empty')
      local idesc=$(echo "$iss" | jq -r '.issue // empty')
      echo "  [$isev] $ifile — $idesc"
      ((ci++))
    done
  fi
  echo ""
  echo "Options:"
  echo "  [Enter] Commit and push (gpc)"
  echo "  [esc]   Keep staged — fix manually and re-run gpa"
  echo ""
  echo -n "Your choice: "
  _read_key; echo ""
  case "$_KEY" in
    y | Y | $'\n') gpc; return $? ;;
    *) echo "ℹ Keeping changes staged."; return 0 ;;
  esac
}

# Helper function: Interactive fix mode for code review suggestions
# Usage: _gpa_interactive_fix <structured_issues_json>
function _gpa_interactive_fix() {
  local structured_issues="$1"
  
  # Validate JSON input
  if ! echo "$structured_issues" | jq empty 2>/dev/null; then
    echo "⚠ Invalid JSON structure for issues."
    echo ""
    echo "Options:"
    echo "  [e] Edit all staged files manually"
    echo "  [i] Ignore and proceed to commit"
    echo "  [q] Quit and keep changes staged"
    echo ""
    echo -n "Your choice: "
    read -r choice
    
    case "$choice" in
      e | E)
        local files_to_edit=()
        while IFS= read -r file; do
          files_to_edit+=("$file")
        done < <(git diff --cached --name-only)
        
        if command -v nvim &>/dev/null; then
          nvim "${files_to_edit[@]}"
        else
          echo "✗ No editor found."
          return 1
        fi
        echo "✓ Files edited. Run 'gpa' again to review."
        return 0
        ;;
      i | I)
        gpc
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  fi
  
  # Count issues
  local issue_count=$(echo "$structured_issues" | jq 'length' 2>/dev/null)
  
  if [ "$issue_count" -eq 0 ] || [ -z "$issue_count" ]; then
    echo "✓ No issues found. Proceeding to commit."
    gpc
    return $?
  fi
  
  echo ""
  echo "Found $issue_count issue(s) to address."
  echo ""
  echo "  [Enter] Send all issues to aidev"
  echo "  [r]     Review issues one by one"
  echo "  [esc]   Quit and keep staged"
  echo ""
  echo -n "Your choice: "
  _read_key
  echo ""

  case "$_KEY" in
    $'\n' | $'\r')
      _gpa_send_all_to_aidev "$structured_issues"
      return $?
      ;;
    r | R)
      ;;
    *)
      echo "ℹ Keeping changes staged."
      return 0
      ;;
  esac

  # Process each issue
  local issue_index=0
  while [ $issue_index -lt $issue_count ]; do
    local issue=$(echo "$structured_issues" | jq -r ".[$issue_index]" 2>/dev/null)
    local file=$(echo "$issue" | jq -r '.file // empty' 2>/dev/null)
    local severity=$(echo "$issue" | jq -r '.severity // empty' 2>/dev/null)
    local issue_desc=$(echo "$issue" | jq -r '.issue // empty' 2>/dev/null)
    local recommendation=$(echo "$issue" | jq -r '.recommendation // empty' 2>/dev/null)
    
    # Skip if any required field is missing
    if [ -z "$file" ] || [ -z "$severity" ] || [ -z "$issue_desc" ] || [ -z "$recommendation" ]; then
      echo "⚠ Skipping malformed issue entry at index $issue_index"
      ((issue_index++))
      continue
    fi
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Issue $((issue_index + 1)) of $issue_count"
    echo "═══════════════════════════════════════════════════════════"
    echo "File: $file"
    echo "Severity: $severity"
    echo "Issue: $issue_desc"
    echo ""
    echo "Recommendation:"
    echo "$recommendation"
    echo ""
    echo "Options:"
    echo "  [m] Manual fix - open herdr workspace with nvim + aidev"
    echo "  [a] Auto-fix - let aidev fix it automatically"
    echo "  [s] Skip this issue"
    echo "  [q] Quit and proceed to commit"
    echo ""
    echo -n "Your choice: "
    read -r choice
    
    case "$choice" in
      m | M)
        echo ""
        _gpa_create_edit_workspace "$file" "$recommendation"
        
        # Wait for user to finish editing
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "⏸  Waiting for you to finish editing..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "When you're done editing in the herdr workspace:"
        echo "  1. Save your changes in nvim"
        echo "  2. Switch back to this pane"
        echo "  3. Press Enter here to continue"
        echo ""
        echo -n "Press Enter when editing is complete: "
        read -r
        
        # Re-stage the file
        echo ""
        echo "ℹ Re-staging file..."
        git add "$file" 2>/dev/null && echo "  ✓ Re-staged: $file"
        echo ""
        echo "✓ Returning to issue list..."
        echo ""
        ;;
      a | A)
        _gpa_auto_fix "$file" "$recommendation"
        echo ""
        ;;
      s | S)
        echo "⊳ Skipping this issue"
        echo ""
        ;;
      q | Q)
        echo ""
        echo "ℹ Skipping remaining issues"
        echo ""
        # Jump to the final prompt
        break
        ;;
      *)
        echo "✗ Invalid choice. Skipping this issue."
        echo ""
        ;;
    esac
    
    ((issue_index++))
  done
  
  # All issues processed (or user quit early)
  echo "═══════════════════════════════════════════════════════════"
  if [ $issue_index -ge $issue_count ]; then
    echo "All issues processed!"
  else
    echo "Issue review session ended"
  fi
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  echo "Options:"
  echo "  [Enter] Commit and push (gpc)"
  echo "  [r]     Review again with gpa"
  echo "  [esc]   Cancel - keep staged"
  echo ""
  echo -n "Your choice: "
  _read_key
  echo ""

  case "$_KEY" in
    y | Y | $'\n')
      echo ""
      gpc
      return $?
      ;;
    r | R)
      echo ""
      gpa
      return $?
      ;;
    *)
      echo "ℹ Keeping changes staged."
      return 0
      ;;
  esac
  
}

# Usage: _gpa_review_batch_with_timeout <batch> <batch_num> <total_batches> [tier_override]
# Returns: JSON array of issues or empty array on failure
function _gpa_review_batch_with_timeout() {
  local batch="$1"
  local batch_num="$2"
  local total_batches="$3"
  local tier_override="${4:-auto}"  # Optional tier override

  # Local 7B model: ~15-30s per batch. Cloud APIs: ~5-15s.
  # Use 60s for local (generous but not painful), 90s for cloud.
  # Pass total_batches=1 so tier defaults to "local" only when genuinely local.
  # For cloud tiers (haiku/sonnet/opus) always use 90s.
  local _tier_for_timeout="$tier_override"
  if [[ "$_tier_for_timeout" == "auto" ]]; then
    _tier_for_timeout=$(_gpa_determine_tier "[]" "0" "$total_batches")
  fi
  local timeout max_retries
  if [[ "$_tier_for_timeout" == "local" ]]; then
    timeout=60
    max_retries=2
  else
    timeout=90
    max_retries=3
  fi
  local retry_count=0
  
  while [ $retry_count -lt $max_retries ]; do
    if [ $retry_count -gt 0 ]; then
      echo "  ⚠ Retry attempt $retry_count of $max_retries..." >&2
    fi
    
    # Create a temporary file to store the result
    local tmp_result=$(mktemp)
    local tmp_pid_file=$(mktemp)
    
    # Run the review in a background process.
    # Redirect subshell stdout+stderr to /dev/null: the result travels through
    # $tmp_result (explicit redirect), so inherited fds are not needed. This also
    # prevents any streaming text from claude from leaking to the terminal.
    (
      local result=$(_gpa_review_batch "$batch" "$batch_num" "$total_batches" "$tier_override" 2>/dev/null)
      echo "$result" > "$tmp_result"
    ) >/dev/null 2>/dev/null &
    
    local bg_pid=$!
    echo $bg_pid > "$tmp_pid_file"
    
    # Wait for the process with timeout and show progress
    local elapsed=0
    local interval=0.5
    local spinner_chars="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    local spinner_idx=0
    local tick_count=0
    
    # Print initial status on same line
    printf "  " >&2
    
    while kill -0 $bg_pid 2>/dev/null; do
      # Update elapsed time every 2 ticks (1 second)
      if [ $((tick_count % 2)) -eq 0 ]; then
        elapsed=$((tick_count / 2))
      fi
      
      if [ $elapsed -ge $timeout ]; then
        printf "\r  ⚠ AI review timed out after ${timeout} seconds\n" >&2
        kill -9 $bg_pid 2>/dev/null
        wait $bg_pid 2>/dev/null
        rm -f "$tmp_result" "$tmp_pid_file"
        ((retry_count++))
        break
      fi
      
      # Show spinner and elapsed time
      local spinner_char="${spinner_chars:$spinner_idx:1}"
      printf "\r  %s Analyzing code... %ds elapsed" "$spinner_char" "$elapsed" >&2
      
      sleep $interval
      ((tick_count++))
      ((spinner_idx = (spinner_idx + 1) % ${#spinner_chars}))
    done
    
    # Clear the progress line if process completed successfully
    if [ $elapsed -lt $timeout ]; then
      printf "\r  ✓ Analysis complete (%ds)        \n" "$elapsed" >&2
    fi
    
    # Check if we broke out due to timeout
    if [ $elapsed -ge $timeout ]; then
      continue
    fi
    
    # Wait for background process to complete
    wait $bg_pid
    local exit_code=$?
    
    # Read the result
    local batch_result=""
    if [ -f "$tmp_result" ]; then
      batch_result=$(cat "$tmp_result")
      rm -f "$tmp_result"
    fi
    rm -f "$tmp_pid_file"
    
    # Validate the result
    if [ $exit_code -eq 0 ] && [ -n "$batch_result" ]; then
      # Try to validate as JSON
      if echo "$batch_result" | jq empty 2>/dev/null; then
        echo "$batch_result"
        return 0
      else
        # Extract last JSON array: greedy .* before forces rightmost match,
        # lazy .*? inside captures minimal content to avoid crossing array boundaries.
        local extracted_json=$(echo "$batch_result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
        
        if [ -n "$extracted_json" ] && echo "$extracted_json" | jq empty 2>/dev/null; then
          echo "$extracted_json"
          return 0
        fi
        
        # Soft failure - could not parse
        printf "\r  ⚠ Could not parse response as JSON\n" >&2
        echo "[]"
        return 2
      fi
    elif [ $exit_code -eq 2 ]; then
      # Soft failure from _gpa_review_batch (unparseable)
      echo "$batch_result"
      return 2
    fi
    
    # Failed, increment retry
    ((retry_count++))
  done
  
  # All retries failed
  echo "  ✗ AI review failed after $max_retries attempts" >&2
  return 1
}

# Helper function: Prompt user for action on AI errors
# Usage: _prompt_ai_error_action <error_message> <context>
# Returns: 0 for retry, 1 for continue, 2 for cancel
function _prompt_ai_error_action() {
  local error_msg="$1"
  local context="${2:-AI operation}"
  
  echo "" >&2
  echo "⚠ ERROR: $error_msg" >&2
  echo "  Context: $context" >&2
  echo "" >&2
  echo "Options:" >&2
  echo "  [Enter] Retry" >&2
  echo "  [i]     Ignore and continue" >&2
  echo "  [esc]   Cancel" >&2
  echo "" >&2
  echo -n "Your choice: " >&2
  
  # Read a single character
  local choice
  read -r choice
  
  case "$choice" in
    ""|$'\n')  # ENTER key
      return 0  # Retry
      ;;
      i|I)
      return 1  # Ignore
      ;;
    $'\e'|q|Q)  # ESC or q
      return 2  # Cancel
      ;;
    *)
      # Invalid input, treat as cancel
      echo "⚠ Invalid input, cancelling..." >&2
      return 2
      ;;
  esac
}

function gpa() {
  # Git Partial Add with AI code review
  # Usage: gpa [--tier=haiku|sonnet|opus] [--auto]
  #
  # --auto: non-interactive mode for AI-agent callers (e.g. Claude Code).
  # Stages all changes, auto-fixes lint issues, auto-escalates ambiguous
  # AI-review escalation prompts, and never blindly proceeds past something
  # that needs a judgment call (real secrets, AI review that fully failed).
  # If issues are found, prints them and exits non-zero instead of entering
  # the interactive fix loop or recursing into aidev — the caller is
  # expected to read the findings, fix them itself, and re-run `gpa --auto`.

  # Parse optional --tier and --auto flags
  local tier_override="auto"
  local auto_mode=false
  for arg in "$@"; do
    case $arg in
      --tier=haiku|--tier=sonnet|--tier=opus)
        tier_override="${arg#--tier=}"
        shift
        ;;
      --tier=*)
        echo "✗ Invalid tier. Use: haiku, sonnet, or opus"
        return 1
        ;;
      --auto)
        auto_mode=true
        shift
        ;;
    esac
  done

  # GitHub Copilot does not support Opus — block explicit --tier=opus
  if [[ "$tier_override" == "opus" && "$(_get_ai_provider)" == "github-copilot" ]]; then
    echo "✗ Opus is not available with GitHub Copilot. Use haiku or sonnet."
    return 1
  fi
  
  # Save current shell options and disable tracing
  local prev_opts=$-
  setopt local_options
  [[ $prev_opts == *x* ]] && setopt no_xtrace

  # Validate git repository
  _check_git_repo || return 1

  # Ensure an AI provider is configured for this session
  _ensure_ai_provider || return 1

  # Use the aiselect'd provider for code review
  # (removed llama.cpp override — Qwen doesn't work inside opencode sessions)

  # Check if there are ANY changes (staged, unstaged, or untracked)
  local has_unstaged=$(git diff --quiet; echo $?)
  local has_staged=$(git diff --cached --quiet; echo $?)
  local has_untracked=$(git ls-files --others --exclude-standard | wc -l | tr -d ' ')
  
  if [[ "$has_unstaged" -eq 0 ]] && [[ "$has_staged" -eq 0 ]] && [[ "$has_untracked" -eq 0 ]]; then
    echo "⚠ No changes to stage or review"
    return 1
  fi

  # Get git root directory for proper path resolution
  local git_root=$(git rev-parse --show-toplevel)
  local current_dir=$(pwd)
  local relative_to_root="${current_dir#$git_root}"
  relative_to_root="${relative_to_root#/}"  # Remove leading slash if present
  
  # Get list of changed files with status - properly handle filenames with spaces
  local changed_files=()
  local file_status=()
  local display_files=()  # Files as shown by git status (for display)
  local auto_excluded_files=()  # Files automatically excluded
  
  while IFS= read -r line; do
    # Parse git status --short format: XY filename
    # First 2 chars are status, then space, then filename
    local git_status="${line:0:2}"
    local file="${line:3}"
    
    # Only include unstaged changes (status code in second position)
    # Check for: modified (M), deleted (D), or untracked (??)
    if [[ "$git_status" == " M" || "$git_status" == " D" || "$git_status" == "??" ]]; then
      # Check if file should be auto-excluded
      local file_basename=$(basename "$file")
      if [[ "$file_basename" == ".terraform.lock.hcl" ]]; then
        auto_excluded_files+=("$file")
        continue
      fi
      
      # Convert path relative to current dir to path relative to git root
      local file_from_root
      if [[ -n "$relative_to_root" ]]; then
        file_from_root="${relative_to_root}/${file}"
      else
        file_from_root="$file"
      fi
      
      changed_files+=("$file_from_root")
      file_status+=("$git_status")
      display_files+=("$file")  # Keep original for display
    fi
  done < <(git status --short)
  
  # Show auto-excluded files if any
  if [ ${#auto_excluded_files[@]} -gt 0 ]; then
    echo "ℹ Auto-excluded ${#auto_excluded_files[@]} file(s):"
    for file in "${auto_excluded_files[@]}"; do
      echo "  ⊝ $file"
    done
    echo ""
  fi

  # Check if there are already staged changes
  local staged_count=$(git diff --cached --name-only | wc -l | tr -d ' ')
  
  # If there are unstaged changes, let user select what to stage
  if [ ${#changed_files[@]} -gt 0 ]; then
    if $auto_mode; then
      echo "ℹ Auto mode: staging all ${#changed_files[@]} file(s)"
      for file in "${changed_files[@]}"; do
        git -C "$git_root" add "$file" 2>/dev/null
      done
      echo "✓ Staged ${#changed_files[@]} file(s)"
    else
    # Show already-staged files if any
    if [ "$staged_count" -gt 0 ]; then
      local GREEN='\033[0;32m'
      local NC='\033[0m'
      echo "Changes to be committed:"
      git diff --cached --name-status | while IFS=$'\t' read -r file_status_code file; do
        local label=""
        case "$file_status_code" in
          M) label="modified:  " ;;
          A) label="new file:  " ;;
          D) label="deleted:   " ;;
          R) label="renamed:   " ;;
          *) label="$file_status_code         " ;;
        esac
        echo -e "  ${GREEN}${label}${file}${NC}"
      done
      echo ""
      echo "  [Enter] Continue with already-staged files"
      echo ""
    fi
    
    # Display files with numbers and status like git status
    echo "Select files to stage and review:"
    echo ""
    echo "  a) All files"
    echo ""
    local i=1
    for idx in {1..${#changed_files[@]}}; do
      local file="${display_files[$idx]}"
      local git_status="${file_status[$idx]}"
      echo "  $i) $git_status $file"
      ((i++))
    done
    echo ""
    echo "  q) Exit"
    echo ""
    
    if [ "$staged_count" -gt 0 ]; then
      echo -n "Enter numbers, 'a' for all, Enter to continue with staged, or 'q' to exit: "
    else
      echo -n "Enter numbers separated by spaces (e.g., '1 3 5'), 'a' for all, or 'q' to exit: "
    fi
    
    # Read the entire line with full readline support (backspace, arrow keys, etc.)
    local selection
    read -r selection
    
    # Check for quit command
    if [[ "$selection" == "q" ]] || [[ "$selection" == "quit" ]] || [[ "$selection" == $'\x1b'* ]]; then
      echo "✓ Cancelled"
      return 0
    fi
    
    # Check for empty input (just Enter)
    if [[ -z "$selection" ]]; then
      # Empty input (Enter key) - handle immediately
      if [ "$staged_count" -gt 0 ]; then
        echo "✓ Continuing with $staged_count already-staged file(s)"
        # Skip to the review section (set selection to empty and let flow continue)
        selection=""
      else
        echo "✗ No files are staged"
        return 1
      fi
    else
      
      # Handle selection
      case "$selection" in
        q | Q)
          echo "✓ Cancelled"
          return 0
          ;;
        a | A)
          # Stage all files - run git add from repo root to handle relative paths correctly
          echo "ℹ Staging all ${#changed_files[@]} file(s)"
          if [ ${#auto_excluded_files[@]} -gt 0 ]; then
            echo "  (excluding ${#auto_excluded_files[@]} auto-excluded file(s))"
          fi
          for file in "${changed_files[@]}"; do
            git -C "$git_root" add "$file" 2>/dev/null
          done
          echo "✓ Staged ${#changed_files[@]} file(s)"
          ;;
        *)
          # Stage selected files
          local selected_files=()
          for num in $selection; do
            if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#changed_files[@]}" ]; then
              # Note: zsh arrays are 1-indexed by default, so we use $num directly
              local selected_file="${changed_files[$num]}"
              if [ -n "$selected_file" ]; then
                selected_files+=("$selected_file")
              fi
            fi
          done

          if [ ${#selected_files[@]} -eq 0 ]; then
            echo "✗ No valid files selected"
            return 1
          fi

          # Stage each file individually - run git add from repo root to handle relative paths correctly
          echo "ℹ Staging ${#selected_files[@]} file(s)..."
          for file in "${selected_files[@]}"; do
            git -C "$git_root" add "$file" 2>/dev/null
          done
          echo "✓ Staged ${#selected_files[@]} file(s)"
          ;;
      esac
    fi
    fi
  else
    # No unstaged changes, but there are staged changes - proceed to review them
    if [ "$staged_count" -gt 0 ]; then
      local GREEN='\033[0;32m'
      local NC='\033[0m'
      echo "Changes to be committed:"
      git diff --cached --name-status | while IFS=$'\t' read -r file_status_code file; do
        local label=""
        case "$file_status_code" in
          M) label="modified:  " ;;
          A) label="new file:  " ;;
          D) label="deleted:   " ;;
          R) label="renamed:   " ;;
          *) label="$file_status_code         " ;;
        esac
        echo -e "  ${GREEN}${label}${file}${NC}"
      done
      echo ""
    fi
  fi

  # Check if there are staged changes to review
  if git diff --cached --quiet; then
    echo ""
    echo "⚠ No files are staged for review"
    return 0
  fi

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running secrets detection scan..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Run secrets detection using helper function
  if ! _check_for_secrets "$auto_mode"; then
    echo "✗ Secrets detection aborted commit."
    return 1
  fi

  echo "✓ No secrets detected in staged changes"

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running linters on staged files..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Run linters
  if ! _run_linters "$auto_mode"; then
    echo "✗ Linting check aborted."
    return 1
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running AI code review on staged changes..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Create batches for review
  echo "ℹ Analyzing staged files and creating review batches..."
  local batches=$(_gpa_create_batches)
  local batch_count=$(echo "$batches" | jq 'length')
  
  if [ "$batch_count" -eq 0 ]; then
    echo ""
    echo "✓ All staged files have been previously reviewed with no changes"
    echo ""

    if $auto_mode; then
      echo "ℹ Auto mode: committing and pushing"
      echo ""
      gpc
      return $?
    fi

    echo "Options:"
    echo "  [Enter] Commit and push (gpc)"
    echo "  [r]     Re-review all files (clear cache)"
    echo "  [esc]   Cancel - keep staged"
    echo ""
    echo -n "Your choice: "
    _read_key
    echo ""

    case "$_KEY" in
      y | Y | $'\n')
        echo ""
        gpc
        return $?
        ;;
      r | R)
        echo ""
        _gpa_clear_cache
        echo ""
        echo "Re-running gpa to review all files..."
        echo ""
        gpa
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  fi
  
  local total_files=$(git diff --cached --name-only | wc -l)
  local total_lines=$(git diff --cached | wc -l)
  
  echo "ℹ Processing $total_files file(s) in $batch_count batch(es)"
  echo "  Total changes: $total_lines lines"
  local _active_provider=$(_get_ai_provider)
  echo "  Provider: $(_provider_display_name "$_active_provider")"
  
  # Check if a specific model is set in opencode.json
  local selected_model=""
  if [[ "$_active_provider" == "opencode" ]] || [[ "$_active_provider" == "github-copilot" ]]; then
    local config_file="$HOME/.config/opencode/opencode.json"
    if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
      local config_model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
      # Only use the model if it matches the current provider
      if [[ -n "$config_model" && "$config_model" != "null" ]]; then
        if [[ "$_active_provider" == "opencode" && "$config_model" == opencode/* ]]; then
          selected_model="$config_model"
        elif [[ "$_active_provider" == "github-copilot" && "$config_model" == github-copilot/* ]]; then
          selected_model="$config_model"
        fi
      fi
    fi
  fi
  
  # Display model information
  if [[ -n "$selected_model" && "$selected_model" != "null" ]]; then
    # A specific model is selected - show it with tier indicators if applicable
    if _supports_multi_tier; then
      # Multi-tier provider - show available tiers
      echo "  Model: $selected_model (Selected)"
      echo "        Available: $(_model_tier_display "$_active_provider")"
    else
      # Single-model provider (free tier or llama.cpp) - just show the model
      echo "  Model: $(_model_tier_display "$_active_provider")"
    fi
  elif [[ "$tier_override" == "auto" ]]; then
    echo "  Model: Auto-detect ($(_model_tier_display "$_active_provider"))"
  else
    local tier_emoji=""
    case "$tier_override" in
      opus) tier_emoji="🔴" ;;
      sonnet) tier_emoji="🔵" ;;
      haiku) tier_emoji="🟢" ;;
    esac
    echo "  Model: $tier_emoji $tier_override (forced) → $(_get_opencode_model "$tier_override")"
  fi
  echo ""
  
  # Process each batch and collect all issues
  local all_issues="[]"
  local batch_index=0
  local failed_batches=0
  local soft_failed_batches=0  # Track unparseable responses separately
  local ai_review_failed=false
  
  while [ $batch_index -lt $batch_count ]; do
    local batch=$(echo "$batches" | jq -c ".[$batch_index]")
    local batch_num=$((batch_index + 1))
    
    # Determine which tier will be used for this batch (for display purposes)
    local batch_tier="$tier_override"
    local batch_using_selected_model=false
    
    # Check if a specific model is selected
    if [[ "$_active_provider" == "opencode" ]] || [[ "$_active_provider" == "github-copilot" ]]; then
      local config_file="$HOME/.config/opencode/opencode.json"
      if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
        local check_selected_model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
        # Only use the model if it matches the current provider
        if [[ -n "$check_selected_model" && "$check_selected_model" != "null" ]]; then
          if [[ "$_active_provider" == "opencode" && "$check_selected_model" == opencode/* ]] || \
             [[ "$_active_provider" == "github-copilot" && "$check_selected_model" == github-copilot/* ]]; then
            batch_tier="selected"
            batch_using_selected_model=true
          fi
        fi
      fi
    fi
    
    if [[ "$batch_using_selected_model" == "false" && "$tier_override" == "auto" ]]; then
      # Pre-calculate tier for display (will be recalculated inside _gpa_review_batch)
      local batch_files_json=$(echo "$batch" | jq -c '.')
      local batch_diff_lines=$(echo "$batch_files_json" | jq -r '.[]' | xargs git diff --cached -- | wc -l)
      batch_tier=$(_gpa_determine_tier "$batch_files_json" "$batch_diff_lines" "$batch_count")
    fi
    
    # Display tier icon and label with provider and model info
    local tier_icon="" tier_label="" full_model_display=""
    local provider_display
    case "$_active_provider" in
      github-copilot)
        provider_display="GitHub Copilot"
        ;;
      opencode)
        provider_display="OpenCode Zen"
        ;;
      llama-cpp|llama.cpp)
        provider_display="llama.cpp"
        ;;
      claude-code)
        provider_display="Anthropic"
        ;;
      *)
        provider_display="$_active_provider"
        ;;
    esac
    
    if [[ "$batch_using_selected_model" == "true" ]]; then
      # Show the selected model name
      local selected_model_name=$(jq -r '.model' "$config_file" 2>/dev/null)
      tier_icon=""
      tier_label="$selected_model_name"
      full_model_display="$provider_display | $selected_model_name"
    else
      case "$batch_tier" in
        opus)   
          tier_icon="🔴"
          tier_label="Opus"
          local opus_model=$(_get_opencode_model "opus")
          full_model_display="$provider_display | $opus_model"
          ;;
        sonnet) 
          tier_icon="🔵"
          tier_label="Sonnet"
          local sonnet_model=$(_get_opencode_model "sonnet")
          full_model_display="$provider_display | $sonnet_model"
          ;;
        haiku)  
          tier_icon="🟢"
          tier_label="Haiku"
          local haiku_model=$(_get_opencode_model "haiku")
          full_model_display="$provider_display | $haiku_model"
          ;;
        local)  
          tier_icon="⚪"
          tier_label="$(_llamacpp_model_short)"
          full_model_display="$provider_display | $tier_label"
          ;;
        free)
          tier_icon="⚪"
          local free_model=$(_get_opencode_model)
          local free_model_name="${free_model#opencode/}"
          # Capitalize and format nicely
          tier_label=$(echo "$free_model_name" | sed 's/-/ /g' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2))}1')
          full_model_display="$provider_display | $free_model (Free)"
          ;;
        *)      
          tier_icon="🔵"
          tier_label="Sonnet"
          local default_model=$(_get_opencode_model "sonnet")
          full_model_display="$provider_display | $default_model"
          ;;
      esac
    fi

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "$tier_icon $tier_label — Reviewing batch $batch_num of $batch_count... [$full_model_display]"
    
    # Review this batch with timeout and retry
    # Note: must separate local declaration from assignment to preserve exit code.
    # In zsh, `local var=$(cmd)` swallows the subshell exit code.
    local batch_issues
    batch_issues=$(_gpa_review_batch_with_timeout "$batch" "$batch_num" "$batch_count" "$tier_override")
    local review_status=$?
    
    if [ $review_status -eq 0 ]; then
      # Success - merge batch issues into all_issues
      if [ -n "$batch_issues" ] && echo "$batch_issues" | jq empty 2>/dev/null; then
        # Filter out invalid/malformed issue objects
        # Valid issues must have: file, severity, issue, recommendation fields
        local valid_batch_issues=$(echo "$batch_issues" | jq '[.[] | select(type == "object" and has("file") and has("severity") and has("issue") and has("recommendation"))]' 2>/dev/null)
        
        if [ -n "$valid_batch_issues" ]; then
          local issue_count=$(echo "$valid_batch_issues" | jq 'length')
          if [ "$issue_count" -gt 0 ]; then
            echo "  Found $issue_count issue(s) in this batch"
            
            # Check if we should escalate (only when auto-selected or non-opus cloud tier)
            local active_provider=$(_get_ai_provider)
            local can_escalate=false
            if [[ "$tier_override" == "auto" ]] || [[ "$tier_override" == "sonnet" ]] || \
               [[ "$tier_override" == "haiku" ]] || [[ "$tier_override" == "local" ]]; then
              can_escalate=true
            fi

            if $can_escalate && _gpa_should_escalate "$valid_batch_issues"; then
              echo ""
              echo "  ⚠ CRITICAL SECURITY ISSUE DETECTED"

              if [[ "$active_provider" == "llama-cpp" ]]; then
                # Hybrid mode: escalate local findings to cloud Sonnet
                local cloud_provider=$(_get_cloud_fallback_provider)
                echo "  Local model found Critical+security issues."
                echo ""
                local cloud_source_model=$(_get_opencode_model "sonnet")
                echo "  Recommendation: Re-review with cloud ($cloud_provider $cloud_source_model)"
                echo "  for authoritative security analysis."
                echo ""

                local escalate_choice
                if $auto_mode; then
                  echo "  ℹ Auto mode: escalating to cloud for authoritative review"
                  escalate_choice="y"
                else
                  echo "  Options:"
                  echo "    [y] Yes - Escalate to cloud (recommended)"
                  echo "    [n] No  - Keep local findings"
                  echo ""
                  echo -n "  Your choice: "
                  read -r escalate_choice
                fi

                if [[ "$escalate_choice" == "y" || "$escalate_choice" == "Y" ]]; then
                  echo ""
                  echo "  ☁  Escalating to $cloud_provider $cloud_source_model..."
                  local cloud_issues=$(_gpa_review_batch_with_timeout "$batch" "$batch_num" "$batch_count" "cloud-escalation")
                  local cloud_status=$?

                  if [ $cloud_status -eq 0 ] && [ -n "$cloud_issues" ] && echo "$cloud_issues" | jq empty 2>/dev/null; then
                    local valid_cloud_issues=$(echo "$cloud_issues" | jq '[.[] | select(type == "object" and has("file") and has("severity") and has("issue") and has("recommendation"))]' 2>/dev/null)
                    local cloud_issue_count=$(echo "$valid_cloud_issues" | jq 'length')
                    echo "  ☁  Cloud review complete: Found $cloud_issue_count issue(s)"
                    valid_batch_issues="$valid_cloud_issues"
                  else
                    echo "  ⚠ Cloud escalation failed, keeping local findings"
                  fi
                  echo ""
                fi
              else
                # Cloud-only mode: escalate to Opus on same provider
                local source_model_name
                if [[ "$batch_using_selected_model" == "true" ]]; then
                  source_model_name=$(jq -r '.model // "unknown"' "$config_file" 2>/dev/null)
                elif [[ -n "$tier_label" ]]; then
                  source_model_name="$tier_label"
                else
                  source_model_name="$batch_tier"
                fi
                local target_model_name=$(_get_opencode_model "opus")
                if [[ "$target_model_name" == "$source_model_name" || "$target_model_name" == "$(jq -r '.model // "unknown"' "$config_file" 2>/dev/null)" ]]; then
                  echo "  ⚠ No better model available for escalation (target == source). Keeping $source_model_name findings."
                else
                  echo "  $source_model_name found Critical severity issues with security implications."
                  echo "  🔴 Automatically escalating to $target_model_name for comprehensive security review..."
                  echo ""
                  local opus_issues=$(_gpa_review_batch_with_timeout "$batch" "$batch_num" "$batch_count" "opus")
                  local opus_status=$?

                  if [ $opus_status -eq 0 ] && [ -n "$opus_issues" ] && echo "$opus_issues" | jq empty 2>/dev/null; then
                    local valid_opus_issues=$(echo "$opus_issues" | jq '[.[] | select(type == "object" and has("file") and has("severity") and has("issue") and has("recommendation"))]' 2>/dev/null)
                    if [ -n "$valid_opus_issues" ]; then
                      local opus_issue_count=$(echo "$valid_opus_issues" | jq 'length')
                      echo "  🔴 $target_model_name review complete: Found $opus_issue_count issue(s)"
                      valid_batch_issues="$valid_opus_issues"
                    else
                      echo "  🔴 $target_model_name review found no additional issues"
                    fi
                  else
                    echo "  ⚠ Escalation review failed, keeping $source_model_name findings"
                  fi
                fi
                echo ""
              fi
            fi
            
            all_issues=$(echo "$all_issues" | jq --argjson batch "$valid_batch_issues" '. + $batch')
          else
            echo "  ✓ No issues found in this batch"
          fi
        else
          echo "  ✓ No issues found in this batch"
          # No issues found - continue
        fi
      else
        echo "  ⚠ Batch review returned invalid JSON"
        ((failed_batches++))
      fi
    elif [ $review_status -eq 2 ]; then
      # Soft failure - unparseable response (already retried)
      echo "  ⚠ AI response could not be parsed (after retries)"
      ((soft_failed_batches++))
    else
      # Hard failure - API error, timeout, network issue
      echo "  ✗ Batch review failed completely"
      ((failed_batches++))
    fi
    
    echo ""
    ((batch_index++))
  done
  
  # Check if all batches failed (hard failures)
  if [ $failed_batches -eq $batch_count ]; then
    ai_review_failed=true
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "⚠ WARNING: AI code review could not be completed"
    echo "  All $batch_count batch(es) failed after multiple retry attempts"
    echo ""
    echo "This could be due to:"
    echo "  - Network connectivity issues"
    echo "  - AI service unavailability"
    echo "  - Rate limiting"
    echo ""

    if $auto_mode; then
      echo "✗ Auto mode: AI review failed completely — not committing without review."
      echo "  Check connectivity/AI provider and re-run gpa --auto."
      return 1
    fi

    echo "Options:"
    echo "  [Enter] Retry"
    echo "  [i]     Ignore and proceed"
    echo "  [esc]   Cancel"
    echo ""
    echo -n "Your choice: "
    read -r skip_review

    case "$skip_review" in
      ""|$'\n')  # ENTER - Retry
        echo ""
        echo "♻️  Retrying review..."
        echo ""
        gpa "$@"
        return $?
        ;;
      i|I)  # Ignore
        echo "✓ Continuing without AI review"
        ;;
      $'\e'|q|Q|*)  # ESC or invalid - Cancel
        echo "✗ Aborting commit - changes remain staged"
        return 1
        ;;
    esac
  elif [ $failed_batches -gt 0 ]; then
    echo "⚠ Warning: $failed_batches of $batch_count batch(es) failed review (hard failures)"
  fi
  
  # Handle soft failures (unparseable responses)
  if [ $soft_failed_batches -gt 0 ]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "⚠ WARNING: $soft_failed_batches batch(es) returned unparseable responses"
    echo ""
    echo "The AI reviewed your code but returned output that could not be parsed."
    echo "This means issues may have been found but weren't captured."
    echo ""

    if $auto_mode; then
      echo "✗ Auto mode: review response unparseable — not committing without a clean review."
      echo "  Re-run gpa --auto; if it persists, investigate the AI provider's output."
      return 1
    fi

    echo "Options:"
    echo "  [Enter] Retry"
    echo "  [i]     Ignore and proceed"
    echo "  [esc]   Cancel"
    echo ""
    echo -n "Your choice: "
    read -r soft_fail_choice

    case "$soft_fail_choice" in
      ""|$'\n')  # ENTER - Retry
        echo ""
        echo "♻️  Retrying review..."
        echo ""
        gpa "$@"
        return $?
        ;;
      i|I)  # Ignore
        echo "✓ Ignoring unparseable responses and continuing"
        ;;
      $'\e'|q|Q|*)  # ESC or invalid - Cancel
        echo "✗ Canceling review - changes remain staged"
        return 1
        ;;
    esac
  fi
  
  echo "═══════════════════════════════════════════════════════════"
  
  # Count total issues found
  local total_issue_count=$(echo "$all_issues" | jq 'length')
  
  # Handle case where AI review was skipped or no issues found
  if [ "$ai_review_failed" = true ] || [ "$total_issue_count" -eq 0 ]; then
    # No issues found or review was skipped - proceed directly to commit
    if [ "$ai_review_failed" = true ]; then
      echo "ℹ Proceeding without AI review"
    else
      echo "✓ Code review complete - no critical issues or warnings found"
    fi

    if $auto_mode; then
      echo ""
      echo "ℹ Auto mode: committing and pushing"
      echo ""
      gpc
      local gpc_status=$?
      rm -f /tmp/gpa_secrets_verdict.txt
      return $gpc_status
    fi

    echo ""
    echo "Options:"
    echo "  [Enter] Commit and push (gpc)"
    echo "  [esc]   Cancel - keep staged"
    echo ""
    echo -n "Your choice: "
    _read_key
    echo ""

    case "$_KEY" in
      y | Y | $'\n')
        echo ""
        echo "✓ Proceeding to commit and push..."
        echo ""
        gpc
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  else
    # Issues found - display summary
    echo "⚠ Found $total_issue_count issue(s) across all batches"
    echo ""

    # Display a summary of issues by severity
    local critical_count=$(echo "$all_issues" | jq '[.[] | select(type == "object" and .severity == "Critical")] | length' 2>/dev/null || echo "0")
    local warning_count=$(echo "$all_issues" | jq '[.[] | select(type == "object" and .severity == "Warning")] | length' 2>/dev/null || echo "0")

    if [ "$critical_count" -gt 0 ]; then
      echo "  🔴 Critical: $critical_count"
    fi
    if [ "$warning_count" -gt 0 ]; then
      echo "  🟡 Warning: $warning_count"
    fi
    echo ""

    if $auto_mode; then
      # Print full findings and hand control back to the caller instead of
      # entering the interactive fix loop or recursing into aidev — an
      # AI-agent caller is expected to read these, fix the files itself with
      # its own edit tools, then re-run `gpa --auto`. Changes stay staged.
      echo "Auto mode: not committing. Findings requiring a decision:"
      echo ""
      echo "$all_issues" | jq -r '.[] | "─────────────────────────────────────────────\nFile: \(.file)\nSeverity: \(.severity)\nIssue: \(.issue)\nRecommendation: \(.recommendation)\n"'
      echo "─────────────────────────────────────────────"
      echo "Fix these, then re-run 'gpa --auto' (changes remain staged)."
      rm -f /tmp/gpa_secrets_verdict.txt
      return 3
    fi

    # Enter interactive fix mode
    echo "Entering interactive fix mode..."
    echo ""
    _gpa_interactive_fix "$all_issues"
    rm -f /tmp/gpa_secrets_verdict.txt
    return $?
  fi
  rm -f /tmp/gpa_secrets_verdict.txt
}

# Returns 0 (via stdout "true"/"false") whether $1 is the repo's main
# checkout, as opposed to a linked worktree. The main checkout is the only
# one where --git-dir and --git-common-dir resolve to the same directory.
function _is_main_worktree() {
  local dir="$1"
  local git_dir common_dir
  # --path-format=absolute avoids the ambiguity where --git-dir is relative
  # for the main worktree but absolute for linked worktrees.
  git_dir=$(git -C "$dir" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
  common_dir=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  [[ "$git_dir" == "$common_dir" ]]
}

# Worktree + PR hygiene: run before creating a new worktree so we don't
# accumulate stale checkouts, and so whoever is about to start new work can
# see what's already in flight first.
#   - A worktree whose PR is MERGED/CLOSED is stale (the work is done or
#     dead) -> automatically removed, its local branch deleted.
#   - A worktree with an OPEN PR, or no PR at all (not pushed yet), is left
#     alone and just listed.
#   - An OPEN PR with no matching local worktree is only reported (it may
#     be in progress on another machine) -- never deleted.
function _gpr_prune_stale_worktrees() {
  local repo_root="$1"
  local pruned_any=false
  local -a open_worktree_branches=()

  echo "ℹ Checking existing worktrees and PRs..."

  local wt_path="" wt_branch=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) wt_path="${line#worktree }" ;;
      "branch refs/heads/"*) wt_branch="${line#branch refs/heads/}" ;;
      "")
        if [[ -n "$wt_path" && "$wt_path" != "$repo_root" ]]; then
          if [[ -z "$wt_branch" ]]; then
            echo "  ⚠ Worktree with no branch (detached?): $wt_path — left alone"
          else
            # Explicit "" assignments avoid a zsh quirk: re-declaring an
            # already-local var with no assignment (as happens each loop
            # iteration here) prints "name=value" instead of no-op'ing.
            local pr_json="" pr_state=""
            pr_json=$(cd "$wt_path" && gh pr view --json state,url 2>/dev/null)
            if [[ -n "$pr_json" ]]; then
              pr_state=$(echo "$pr_json" | jq -r '.state')
              if [[ "$pr_state" == "MERGED" || "$pr_state" == "CLOSED" ]]; then
                echo "  🧹 Pruning stale worktree '$wt_branch' (PR $pr_state): $wt_path"
                git -C "$repo_root" worktree remove "$wt_path" --force 2>/dev/null
                git -C "$repo_root" branch -D "$wt_branch" 2>/dev/null
                pruned_any=true
              else
                local pr_url=$(echo "$pr_json" | jq -r '.url')
                echo "  • Active: '$wt_branch' — $pr_url"
                open_worktree_branches+=("$wt_branch")
              fi
            else
              echo "  • In progress (no PR yet): '$wt_branch' — $wt_path"
              open_worktree_branches+=("$wt_branch")
            fi
          fi
        fi
        wt_path="" wt_branch=""
        ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain; echo)

  $pruned_any && git -C "$repo_root" worktree prune

  # Report open PRs with no local worktree — informational only, never touched.
  local open_prs
  open_prs=$(cd "$repo_root" && gh pr list --state open --json headRefName,url 2>/dev/null)
  if [[ -n "$open_prs" ]]; then
    echo "$open_prs" | jq -c '.[]' | while IFS= read -r pr; do
      local head_ref=$(echo "$pr" | jq -r '.headRefName')
      local pr_url=$(echo "$pr" | jq -r '.url')
      if [[ ! " ${open_worktree_branches[*]} " == *" $head_ref "* ]]; then
        echo "  ⓘ Open PR with no local worktree (maybe in progress elsewhere): $head_ref — $pr_url"
      fi
    done
  fi
  echo ""
}

# Fast-forwards $1's default branch (main or master, whichever origin/HEAD points
# at) to match origin, but ONLY if $1 is currently checked out on that branch --
# never touches a repo sitting on some other branch, which shouldn't happen under
# this workflow (real work always happens in a worktree) but is a cheap guard
# against pulling into the wrong place. --ff-only means this can never create a
# merge conflict: if local main has actually diverged (e.g. from a manual commit),
# the merge just fails and is silently skipped rather than leaving a scheduled,
# unattended job to sort out a conflict on its own.
function _pull_main_if_clean() {
  local repo="$1"
  local default_branch current_branch before after
  default_branch=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')
  [[ -n "$default_branch" ]] || return 0
  current_branch=$(git -C "$repo" branch --show-current 2>/dev/null)
  [[ "$current_branch" == "$default_branch" ]] || return 0

  before=$(git -C "$repo" rev-parse HEAD 2>/dev/null)
  git -C "$repo" fetch --quiet origin "$default_branch" 2>/dev/null
  if git -C "$repo" merge --ff-only --quiet "origin/$default_branch" 2>/dev/null; then
    after=$(git -C "$repo" rev-parse HEAD 2>/dev/null)
    [[ "$before" != "$after" ]] && echo "  ⬆ Updated $default_branch: ${before:0:7} → ${after:0:7}"
  fi
}

# Cross-repo repo hygiene: keeps each repo's main branch current and prunes stale
# worktrees, across every repo under $HOME (2 levels deep, to also catch nested
# repos like pscloudops/terraform-infrastructure) that has a .worktrees directory
# at all -- both are things `gpr` already does for whichever single repo you
# happen to run it in, but a repo you haven't touched with `gpr` in a while just
# drifts behind origin and keeps accumulating stale MERGED/CLOSED worktrees.
function gprune() {
  local -a repos=("$HOME"/*/.worktrees(N) "$HOME"/*/*/.worktrees(N))
  repos=("${repos[@]%/.worktrees}")

  if [[ ${#repos[@]} -eq 0 ]]; then
    echo "gprune: no repos with .worktrees found under $HOME"
    return 0
  fi

  local repo
  for repo in "${repos[@]}"; do
    # A stray .worktrees dir with no .git alongside it isn't a repo at all (seen in
    # practice: an empty leftover ~/pscloudops/.worktrees where pscloudops is just a
    # container folder for nested repos, not a repo itself) -- skip it rather than
    # letting git's "not a git repository" error leak into the output below.
    [[ -d "$repo/.git" || -f "$repo/.git" ]] || continue
    echo "═══ ${repo#$HOME/} ═══"
    _pull_main_if_clean "$repo"
    _gpr_prune_stale_worktrees "$repo"
  done
}

# Git PR - Create new branch, worktree, and draft pull request.
#
# Development happens in a worktree per PR (~/.worktrees/<branch> inside the
# repo), not by checking out a branch in place -- the main repo checkout
# always stays on main so concurrent work-in-progress branches don't collide
# in a single working directory.
function gpr_func() {
  # Usage: gpr [feat|fix] [branch-name]
  # Positional args skip the interactive prompts below (for scripted/AI callers).
  local arg_type="$1"
  local arg_branch_name="$2"

  # Validate git repository
  _check_git_repo || return 1

  local repo_root
  repo_root=$(git rev-parse --show-toplevel)

  if ! _is_main_worktree "$repo_root"; then
    local common_dir main_root
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
    main_root=$(cd "$(dirname "$common_dir")" && pwd)
    echo "✗ You're inside a worktree. Run gpr from the main repo checkout instead:"
    echo "  cd $main_root"
    return 1
  fi

  # gpr never calls an AI provider — branch naming and PR creation are
  # templated operations that don't benefit from cloud quality.
  echo "🏠 Creating PR locally (no AI provider needed)..."
  echo ""

  _gpr_prune_stale_worktrees "$repo_root"

  # Stash any uncommitted changes
  echo "Stashing uncommitted changes..."
  local stash_result=$(git stash)
  local did_stash=false
  if [[ "$stash_result" != "No local changes to save" ]]; then
    did_stash=true
  fi

  # Always attempt git pull, continue regardless of result
  echo "Pulling latest changes..."
  git pull || true

  # Restore stashed changes only if we stashed something
  if [[ "$did_stash" == true ]]; then
    echo "Restoring stashed changes..."
    git stash pop || true
  fi

  local type_choice="$arg_type"
  if [ -z "$type_choice" ]; then
    echo "Select type:"
    echo "  1) feat"
    echo "  2) fix"
    echo -n "Enter choice (1 or 2): "
    read type_choice
  fi
  case "$type_choice" in
    1|feat) type_prefix="feat" ;;
    2|fix) type_prefix="fix" ;;
    *)
      echo "✗ Invalid choice. Please select 1, 2, feat, or fix"
      return 1
      ;;
  esac
  local branch_name="$arg_branch_name"
  if [ -z "$branch_name" ]; then
    echo -n "Branch name: "
    read branch_name
  fi
  if [ -z "$branch_name" ]; then
    echo "✗ Branch name cannot be empty"
    return 1
  fi

  local worktree_dir="$repo_root/.worktrees/$branch_name"
  if [ -e "$worktree_dir" ]; then
    echo "✗ A worktree already exists at $worktree_dir"
    return 1
  fi
  mkdir -p "$repo_root/.worktrees"

  git worktree add -b "$branch_name" "$worktree_dir" main || return 1

  # Deliberately NOT cd'ing the caller's shell into the worktree. aidev is often
  # working through a whole run of PRs/worktrees in one sitting (create worktree,
  # land the PR, move to the next), and if gpr moved it each time it'd lose track
  # of "home base" -- the repo root, or wherever devim was originally triggered
  # from -- a little more with every worktree. Everything below that needs to run
  # inside the worktree does so in a subshell instead, so this shell's own cwd
  # never changes; $worktree_dir is reported at the end for anything that
  # genuinely needs to work IN it afterward.
  (
    cd "$worktree_dir" || exit 1
    git commit --allow-empty -m "$branch_name" &&
      git push -u origin "$branch_name" &&
      gh pr create --draft --title "$type_prefix: $branch_name" --body "$(
        cat <<EOF
## Description
$type_prefix: $branch_name

## Tickets
$type_prefix: $branch_name
EOF
      )"
  ) &&
    echo "" &&
    echo "✓ Worktree ready: $worktree_dir"

  # aidev's own pane deliberately stays put (see above), but the sibling
  # nvim/tuicr/zsh panes over in the workspace's dev tab should still follow the
  # worktree -- that's where the actual file changes are happening, so they
  # should be showing it even though aidev's cwd doesn't move. Push them there
  # when running in herdr.
  [ -n "$HERDR_ENV" ] && _herdr_sync_workspace_to_worktree "$worktree_dir"
}

# Pushes every pane in the workspace's dev tab (nvim/tuicr/zsh -- see
# _herdr_populate_panes) to follow gpr's newly created worktree at $1, since gpr's
# own `cd` only affects the calling pane (see gpr_func above). Resolves the dev
# tab explicitly by tab label ("dev", optionally suffixed) rather than scanning
# every pane in $HERDR_WORKSPACE_ID and matching by pane label -- that would also
# catch any OTHER tab the user happens to have open in this workspace if a pane
# in it were ever labeled nvim/tuicr/zsh too. Scoping to the resolved dev tab_id
# instead means only that tab's panes are ever touched, full stop. Per pane kind,
# by label:
#   - nvim: `:cd $1` repoints file ops (netrw, :e, fuzzy-finders) without
#     restarting nvim, so open buffers/undo history survive untouched, chained
#     with `| Neotree git_status` (same view as <leader>gs, see keymaps.lua) so
#     the changed-files list is what's on screen without touching the pane.
#   - tuicr: quit and relaunch via _tuicr_current_pr in the new directory, so it
#     loads the new worktree's PR diff (changed files) instead of the old one's --
#     there's no live ":cd" equivalent for tuicr's target repo.
#   - zsh: plain `cd $1`, but ONLY if the pane is sitting at an idle shell prompt
#     (checked via process-info) -- never inject a command into a pane that's
#     actively running something else.
_herdr_sync_workspace_to_worktree() {
  local dir="$1"
  [ -n "$HERDR_WORKSPACE_ID" ] || return 0

  local dev_tab
  dev_tab=$(herdr tab list --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null | jq -r '.result.tabs[] | select(.label | startswith("dev")) | .tab_id' | head -1)
  [ -n "$dev_tab" ] || return 0

  local panes_json
  panes_json=$(herdr pane list --workspace "$HERDR_WORKSPACE_ID" 2>/dev/null)
  [ -n "$panes_json" ] || return 0

  local pane_line pane_id label
  echo "$panes_json" | jq -c --arg tab "$dev_tab" '.result.panes[] | select(.tab_id==$tab)' | while IFS= read -r pane_line; do
    pane_id=$(echo "$pane_line" | jq -r '.pane_id')
    label=$(echo "$pane_line" | jq -r '.label')
    [ "$pane_id" = "$HERDR_PANE_ID" ] && continue

    case "$label" in
      nvim*)
        herdr pane send-keys "$pane_id" esc >/dev/null 2>&1
        herdr pane send-text "$pane_id" ":cd $dir | Neotree git_status" >/dev/null 2>&1
        herdr pane send-keys "$pane_id" enter >/dev/null 2>&1
        ;;
      tuicr*)
        _tuicr_restart "$pane_id" "$dir"
        ;;
      zsh*)
        local fg
        fg=$(herdr pane process-info --pane "$pane_id" 2>/dev/null | jq -r '.result.process_info.foreground_processes[0].name // ""')
        if [ "$fg" = "zsh" ] || [ "$fg" = "-zsh" ]; then
          herdr pane run "$pane_id" "cd $dir" >/dev/null 2>&1
        fi
        ;;
    esac
  done
}

