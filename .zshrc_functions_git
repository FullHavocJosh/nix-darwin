# Helper function: Get hash of file's staged content
# Usage: _gpa_get_file_hash <file_path>
function _gpa_get_file_hash() {
  local file="$1"
  git diff --cached -- "$file" | shasum -a 256 | cut -d' ' -f1
}

# Helper function: Check if a file has been reviewed and hasn't changed
# Usage: _gpa_is_file_reviewed <file_path>
function _gpa_is_file_reviewed() {
  local file="$1"
  local git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  local cache_file="$git_root/.git/gpa_review_cache"
  
  if [ ! -f "$cache_file" ]; then
    return 1  # No cache file, file not reviewed
  fi
  
  local current_hash=$(_gpa_get_file_hash "$file")
  
  # Check if this file+hash exists in cache
  if grep -q "^${file}:${current_hash}$" "$cache_file" 2>/dev/null; then
    return 0  # File reviewed and unchanged
  fi
  
  return 1  # File not reviewed or changed
}

# Helper function: Mark a file as reviewed
# Usage: _gpa_mark_file_reviewed <file_path>
function _gpa_mark_file_reviewed() {
  local file="$1"
  local git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  local cache_file="$git_root/.git/gpa_review_cache"
  
  local current_hash=$(_gpa_get_file_hash "$file")
  
  # Remove any old entries for this file
  if [ -f "$cache_file" ]; then
    grep -v "^${file}:" "$cache_file" > "${cache_file}.tmp" 2>/dev/null || touch "${cache_file}.tmp"
    mv "${cache_file}.tmp" "$cache_file"
  fi
  
  # Add new entry
  echo "${file}:${current_hash}" >> "$cache_file"
}

# Helper function: Clear review cache
# Usage: _gpa_clear_cache
function _gpa_clear_cache() {
  local git_root=$(git rev-parse --show-toplevel 2>/dev/null)
  local cache_file="$git_root/.git/gpa_review_cache"
  
  if [ -f "$cache_file" ]; then
    rm -f "$cache_file"
    echo "✓ Review cache cleared"
  else
    echo "ℹ No review cache to clear"
  fi
}

# Helper function: Split staged files into batches for AI review
# Returns batches as a JSON array where each batch is an array of file paths
# Batches are sized to keep diff output around 300 lines per batch
# Usage: _gpa_create_batches
function _gpa_create_batches() {
  local target_lines=300
  local batches="[]"
  local current_batch="[]"
  local current_batch_lines=0
  
  # Get all staged files
  local staged_files=()
  
  while IFS= read -r file; do
    staged_files+=("$file")
  done < <(git diff --cached --name-only)
  
  if [ ${#staged_files[@]} -eq 0 ]; then
    echo "[]"
    return 0
  fi
  
  # Process each file and group into batches
  for file in "${staged_files[@]}"; do
    # Get line count for this file's diff
    local file_diff_lines=$(git diff --cached -- "$file" | wc -l)
    
    # If adding this file would exceed target, start a new batch
    # (unless current batch is empty - always include at least one file per batch)
    if [ $current_batch_lines -gt 0 ] && [ $((current_batch_lines + file_diff_lines)) -gt $target_lines ]; then
      # Save current batch and start a new one
      batches=$(echo "$batches" | jq --argjson batch "$current_batch" '. += [$batch]')
      current_batch="[]"
      current_batch_lines=0
    fi
    
    # Add file to current batch
    current_batch=$(echo "$current_batch" | jq --arg file "$file" '. += [$file]')
    current_batch_lines=$((current_batch_lines + file_diff_lines))
  done
  
  # Add the last batch if it's not empty
  if [ "$(echo "$current_batch" | jq 'length')" -gt 0 ]; then
    batches=$(echo "$batches" | jq --argjson batch "$current_batch" '. += [$batch]')
  fi
  
  echo "$batches"
}

# Helper function: Check if issues warrant escalation to Opus
# Usage: _gpa_should_escalate <issues_json>
# Returns: 0 (true) if escalation recommended, 1 (false) otherwise
function _gpa_should_escalate() {
  local issues_json="$1"
  
  # Check if we have any issues at all
  local issue_count=$(echo "$issues_json" | jq 'length' 2>/dev/null)
  if [[ -z "$issue_count" ]] || [[ "$issue_count" -eq 0 ]]; then
    return 1  # No issues, no escalation
  fi
  
  # Keywords that indicate security-critical issues
  local security_keywords=("security" "credential" "secret" "password" "token" "key" "auth" "vulnerability" "injection" "xss" "csrf" "encryption")
  
  # Check for Critical severity issues with security keywords
  local has_critical_security=false
  while IFS= read -r issue_text; do
    # Check if this is a Critical issue
    local severity=$(echo "$issue_text" | jq -r '.severity' 2>/dev/null)
    if [[ "$severity" != "Critical" ]]; then
      continue
    fi
    
    # Check if issue or recommendation contains security keywords
    local issue_desc=$(echo "$issue_text" | jq -r '.issue + " " + .recommendation' 2>/dev/null | tr '[:upper:]' '[:lower:]')
    
    for keyword in "${security_keywords[@]}"; do
      if echo "$issue_desc" | grep -qi "$keyword"; then
        return 0  # Found Critical + security keyword = escalate
      fi
    done
  done < <(echo "$issues_json" | jq -c '.[]' 2>/dev/null)
  
  return 1  # No critical security issues found
}

# Helper function: Determine appropriate AI model tier based on batch characteristics
# Usage: _gpa_determine_tier <batch_files_json> <batch_lines> [total_batch_count]
# Returns: "local" (llama-cpp provider), "haiku", "sonnet", or "opus" (cloud providers)
#
# llama-cpp size routing (based on total_batch_count, each batch ~300 lines):
#   ≤2 batches  (~600 lines)  → local 7B  (~30s/batch, ~60s total)
#   3-4 batches (~1200 lines) → cloud Haiku (fast, cheap)
#   5+ batches  (~1500+ lines) → cloud Sonnet (large diff, needs quality)
function _gpa_determine_tier() {
  local batch_files_json="$1"
  local batch_lines="$2"
  local total_batch_count="${3:-1}"

  local provider=$(_get_ai_provider)
  if [[ "$provider" == "llama-cpp" ]]; then
    # For small diffs, keep local. For larger diffs, escalate to cloud.
    if [ "$total_batch_count" -ge 5 ]; then
      echo "sonnet"  # large diff — cloud quality
    elif [ "$total_batch_count" -ge 3 ]; then
      echo "haiku"   # medium diff — fast cloud
    else
      echo "local"   # small diff — local 7B is fast enough
    fi
    return 0
  fi

  # Cloud providers: check for critical file paths that should use Opus
  local critical_paths=("security" "auth" "payment" "encryption" "credential" "secret" "iam" "policy" "kms")
  local batch_files_str=$(echo "$batch_files_json" | jq -r '.[]' | tr '\n' ' ')
  
  for critical_path in "${critical_paths[@]}"; do
    if echo "$batch_files_str" | grep -qi "$critical_path"; then
      echo "opus"
      return 0
    fi
  done
  
  # Check for large batches (>500 lines) - use Opus for better accuracy
  if [ "$batch_lines" -gt 500 ]; then
    echo "opus"
    return 0
  fi
  
  # Default to sonnet
  echo "sonnet"
  return 0
}

# Helper function: Review a batch of files and return structured issues
# Usage: _gpa_review_batch <batch_files_json> <batch_number> <total_batches> [tier_override]
function _gpa_review_batch() {
  local batch_files_json="$1"
  local batch_number="$2"
  local total_batches="$3"
  local tier_override="${4:-auto}"  # Optional: "haiku", "sonnet", "opus", or "auto"
  
  # Convert JSON array to regular array
  local batch_files=()
  while IFS= read -r file; do
    batch_files+=("$file")
  done < <(echo "$batch_files_json" | jq -r '.[]')
  
  if [ ${#batch_files[@]} -eq 0 ]; then
    echo "[]"
    return 0
  fi
  
  # Get diff for only these files
  local batch_diff=""
  for file in "${batch_files[@]}"; do
    batch_diff="${batch_diff}$(git diff --cached -- "$file")\n"
  done
  
  # Count lines in this batch
  local batch_lines=$(echo -e "$batch_diff" | wc -l)
  
  # Determine which AI tier to use
  local ai_tier="sonnet"
  if [[ "$tier_override" == "auto" ]]; then
    ai_tier=$(_gpa_determine_tier "$batch_files_json" "$batch_lines" "$total_batches")
  else
    ai_tier="$tier_override"
  fi
  
  # Check if any Terraform files are in this batch
  local has_terraform=false
  for file in "${batch_files[@]}"; do
    if [[ "$file" == *.tf ]]; then
      has_terraform=true
      break
    fi
  done
  
  # Build review prompt
  local review_prompt="Review the following staged git changes for CRITICAL ISSUES AND WARNINGS ONLY:

🔴 **CRITICAL - Must Fix Before Commit:**
1. **SECRETS & CREDENTIALS**: API keys, passwords, tokens, private keys, connection strings, AWS credentials, OAuth secrets, certificates
2. **Bugs**: Syntax errors, runtime errors, null pointer dereferences, infinite loops
3. **Security Vulnerabilities**: SQL injection, command injection, XSS, insecure crypto, path traversal
4. **Data Loss**: Destructive operations without safeguards, missing transactions, race conditions

🟡 **WARNINGS - Should Consider:**
5. **Security Concerns**: Overly permissive permissions, missing input validation, unsafe eval, hardcoded IPs/domains
6. **Logic Flaws**: Off-by-one errors, incorrect conditionals, missing edge cases
7. **Breaking Changes**: API changes, removed functionality, incompatible updates"
  
  if [ "$has_terraform" = true ]; then
    review_prompt="$review_prompt

**TERRAFORM-SPECIFIC CRITICAL/WARNING CHECKS** (detected .tf files):
🔴 **Critical**: Hardcoded secrets/keys, publicly exposed resources, destructive changes without lifecycle protection
🟡 **Warnings**: Overly permissive IAM (wildcards in production), missing encryption, expensive resources without justification"
  fi
  
  # Build full prompt
  local full_prompt="${review_prompt}

Batch ${batch_number} of ${total_batches} (${batch_lines} lines)

Files in this batch:
$(printf '%s\n' "${batch_files[@]}")

Git diff:
${batch_diff}

**IMPORTANT INSTRUCTIONS:**
- ONLY report 🔴 Critical issues and 🟡 Warnings
- IGNORE minor suggestions, style preferences, and code quality opinions
- Focus on things that will actually break, cause security issues, or have serious consequences
- Output ONLY a JSON array of issues in this exact format:
[
  {
    \"file\": \"path/to/file.ext\",
    \"severity\": \"Critical\" or \"Warning\",
    \"issue\": \"Brief issue description\",
    \"recommendation\": \"Detailed fix recommendation\"
  }
]
- If there are no critical/warning issues in this batch, return an empty array: []
- Return ONLY valid JSON, nothing else."
  
  # Note: Tier display moved to main loop for better visibility
  # (was being cleared by progress spinner)

  # ── Route the API call ──────────────────────────────────────────────────────
  # "local"            → llama-cpp via _run_ai_direct (provider already set)
  # "cloud-escalation" → cloud fallback provider via _run_ai_direct_cloud
  # anything else      → cloud provider via _run_ai_direct (haiku/sonnet/opus)
  local batch_result
  local api_exit_code

  local _route_provider=$(_get_ai_provider)
  local _route_model=$(_get_opencode_model "$ai_tier")

  if [[ "$ai_tier" == "cloud-escalation" ]]; then
    local _cloud=$(_get_cloud_fallback_provider)
    local _cloud_model=$(_get_cloud_model "sonnet")
    echo "  ☁  Routing to cloud [$_cloud / $_cloud_model] for escalation..." >&2
    batch_result=$(echo "$full_prompt" | _run_ai_direct_cloud "sonnet" 2>&1)
    api_exit_code=$?
  elif [[ "$ai_tier" == "local" ]]; then
    echo "  ⚪ Using local model [$_route_provider / $(_llamacpp_model_short)]" >&2
    batch_result=$(echo "$full_prompt" | _run_ai_direct "sonnet" 2>&1)
    api_exit_code=$?
    if [ $api_exit_code -eq 1 ]; then
      local _cloud=$(_get_cloud_fallback_provider)
      echo "  ⚠ Local model failed — falling back to cloud [$_cloud]..." >&2
      batch_result=$(echo "$full_prompt" | _run_ai_direct_cloud "sonnet" 2>&1)
      api_exit_code=$?
    fi
  else
    echo "  🤖 Using [$_route_provider / $_route_model]" >&2
    batch_result=$(echo "$full_prompt" | _run_ai_direct "$ai_tier" 2>&1)
    api_exit_code=$?
  fi

  # Check exit codes
  if [ $api_exit_code -eq 1 ]; then
    # Hard failure - API error, timeout, network issue
    echo "  ✗ API Error" >&2
    echo "[]"
    return 1
  elif [ $api_exit_code -eq 2 ]; then
    # Soft failure - unparseable response
    echo "  ⚠ AI response could not be parsed" >&2
    echo "[]"
    return 2
  fi
  
  # Success (exit code 0) - validate and return
  if echo "$batch_result" | jq empty 2>/dev/null; then
    echo "$batch_result"
    return 0
  fi
  
  # Shouldn't reach here if _run_ai_direct works correctly, but handle it
  echo "  ⚠ Unexpected: Valid exit code but invalid JSON" >&2
  echo "[]"
  return 2
}

# Helper function: Launch aidev in a new tmux window with all issues as context
# Usage: _gpa_send_all_to_aidev <structured_issues_json>
# Returns 0 to re-review, 1 to keep staged
function _gpa_send_all_to_aidev() {
  local structured_issues="$1"
  local issue_count=$(echo "$structured_issues" | jq 'length' 2>/dev/null)
  local session_name="gpa-aidev-$$"

  # Build prompt file
  local prompt_file="/tmp/gpa_all_issues_$$.txt"
  printf "I have %s code review issue(s) in my staged git changes that need to be fixed. Please help me address each one.\n\n" "$issue_count" > "$prompt_file"

  local i=0
  while [ $i -lt "$issue_count" ]; do
    local issue=$(echo "$structured_issues" | jq -r ".[$i]" 2>/dev/null)
    local file=$(echo "$issue" | jq -r '.file // empty' 2>/dev/null)
    local severity=$(echo "$issue" | jq -r '.severity // empty' 2>/dev/null)
    local issue_desc=$(echo "$issue" | jq -r '.issue // empty' 2>/dev/null)
    local recommendation=$(echo "$issue" | jq -r '.recommendation // empty' 2>/dev/null)
    printf -- "---\nIssue %s of %s\nFile: %s\nSeverity: %s\nIssue: %s\nRecommendation: %s\n\n" \
      "$((i+1))" "$issue_count" "$file" "$severity" "$issue_desc" "$recommendation" >> "$prompt_file"
    ((i++))
  done
  printf "Please fix all of these issues. After fixing, I'll re-stage the affected files." >> "$prompt_file"

  # Run aidev directly in the current terminal
  local repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  echo ""
  echo "=== aidev: Fix All Issues ==="
  echo ""
  (cd "$repo_root" && aidev "$(cat "$prompt_file")")
  rm -f "$prompt_file"

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "aidev session complete."
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  echo "  [Enter] Re-review with gpa"
  echo "  [ESC]   Keep staged as-is"
  echo ""
  echo -n "Your choice: "
  _read_key
  echo ""

  case "$_KEY" in
    $'\n' | $'\r')
      echo ""
      gpa
      return $?
      ;;
    *)
      echo "ℹ Keeping changes staged."
      return 0
      ;;
  esac
}

# Helper function: Interactive fix mode for code review suggestions
# Usage: _gpa_interactive_fix <structured_issues_json>
function _gpa_interactive_fix() {
  local structured_issues="$1"
  
  # Validate JSON input
  if ! echo "$structured_issues" | jq empty 2>/dev/null; then
    echo "⚠ Invalid JSON structure for issues."
    echo ""
    echo "Options:"
    echo "  [e] Edit all staged files manually"
    echo "  [c] Continue to commit anyway"
    echo "  [q] Quit and keep changes staged"
    echo ""
    echo -n "Your choice: "
    read -r choice
    
    case "$choice" in
      e | E)
        local files_to_edit=()
        while IFS= read -r file; do
          files_to_edit+=("$file")
        done < <(git diff --cached --name-only)
        
        if command -v nvim &>/dev/null; then
          nvim "${files_to_edit[@]}"
        else
          echo "✗ No editor found."
          return 1
        fi
        echo "✓ Files edited. Run 'gpa' again to review."
        return 0
        ;;
      c | C)
        gpc
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  fi
  
  # Count issues
  local issue_count=$(echo "$structured_issues" | jq 'length' 2>/dev/null)
  
  if [ "$issue_count" -eq 0 ] || [ -z "$issue_count" ]; then
    echo "✓ No issues found. Proceeding to commit."
    gpc
    return $?
  fi
  
  echo ""
  echo "Found $issue_count issue(s) to address."
  echo ""
  echo "  [Enter] Send all issues to aidev"
  echo "  [r]     Review issues one by one"
  echo "  [ESC]   Quit and keep staged"
  echo ""
  echo -n "Your choice: "
  _read_key
  echo ""

  case "$_KEY" in
    $'\n' | $'\r')
      _gpa_send_all_to_aidev "$structured_issues"
      return $?
      ;;
    r | R)
      ;;
    *)
      echo "ℹ Keeping changes staged."
      return 0
      ;;
  esac

  # Process each issue
  local issue_index=0
  while [ $issue_index -lt $issue_count ]; do
    local issue=$(echo "$structured_issues" | jq -r ".[$issue_index]" 2>/dev/null)
    local file=$(echo "$issue" | jq -r '.file // empty' 2>/dev/null)
    local severity=$(echo "$issue" | jq -r '.severity // empty' 2>/dev/null)
    local issue_desc=$(echo "$issue" | jq -r '.issue // empty' 2>/dev/null)
    local recommendation=$(echo "$issue" | jq -r '.recommendation // empty' 2>/dev/null)
    
    # Skip if any required field is missing
    if [ -z "$file" ] || [ -z "$severity" ] || [ -z "$issue_desc" ] || [ -z "$recommendation" ]; then
      echo "⚠ Skipping malformed issue entry at index $issue_index"
      ((issue_index++))
      continue
    fi
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Issue $((issue_index + 1)) of $issue_count"
    echo "═══════════════════════════════════════════════════════════"
    echo "File: $file"
    echo "Severity: $severity"
    echo "Issue: $issue_desc"
    echo ""
    echo "Recommendation:"
    echo "$recommendation"
    echo ""
    echo "Options:"
    echo "  [m] Manual fix - open tmux workspace with nvim + aidev"
    echo "  [a] Auto-fix - let aidev fix it automatically"
    echo "  [s] Skip this issue"
    echo "  [q] Quit and proceed to commit"
    echo ""
    echo -n "Your choice: "
    read -r choice
    
    case "$choice" in
      m | M)
        echo ""
        _gpa_create_edit_workspace "$file" "$recommendation"
        
        # Wait for user to finish editing
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "⏸  Waiting for you to finish editing..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "When you're done editing in the new terminal window:"
        echo "  1. Save your changes in nvim"
        echo "  2. Close the terminal window (or exit tmux)"
        echo "  3. Press Enter here to continue"
        echo ""
        echo -n "Press Enter when editing is complete: "
        read -r
        
        # Re-stage the file
        echo ""
        echo "ℹ Re-staging file..."
        git add "$file" 2>/dev/null && echo "  ✓ Re-staged: $file"
        echo ""
        echo "✓ Returning to issue list..."
        echo ""
        ;;
      a | A)
        _gpa_auto_fix "$file" "$recommendation"
        echo ""
        ;;
      s | S)
        echo "⊳ Skipping this issue"
        echo ""
        ;;
      q | Q)
        echo ""
        echo "ℹ Skipping remaining issues"
        echo ""
        # Jump to the final prompt
        break
        ;;
      *)
        echo "✗ Invalid choice. Skipping this issue."
        echo ""
        ;;
    esac
    
    ((issue_index++))
  done
  
  # All issues processed (or user quit early)
  echo "═══════════════════════════════════════════════════════════"
  if [ $issue_index -ge $issue_count ]; then
    echo "All issues processed!"
  else
    echo "Issue review session ended"
  fi
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  echo "Options:"
  echo "  [Y/Enter] Commit and push changes (gpc)"
  echo "  [r] Review again with 'gpa'"
  echo "  [esc] Cancel - keep staged"
  echo ""
  echo -n "Your choice: "
  _read_key
  echo ""

  case "$_KEY" in
    y | Y | $'\n')
      echo ""
      gpc
      return $?
      ;;
    r | R)
      echo ""
      gpa
      return $?
      ;;
    *)
      echo "ℹ Keeping changes staged."
      return 0
      ;;
  esac
  
}

# Usage: _gpa_review_batch_with_timeout <batch> <batch_num> <total_batches> [tier_override]
# Returns: JSON array of issues or empty array on failure
function _gpa_review_batch_with_timeout() {
  local batch="$1"
  local batch_num="$2"
  local total_batches="$3"
  local tier_override="${4:-auto}"  # Optional tier override

  # Local 7B model: ~15-30s per batch. Cloud APIs: ~5-15s.
  # Use 60s for local (generous but not painful), 90s for cloud.
  # Pass total_batches=1 so tier defaults to "local" only when genuinely local.
  # For cloud tiers (haiku/sonnet/opus) always use 90s.
  local _tier_for_timeout="$tier_override"
  if [[ "$_tier_for_timeout" == "auto" ]]; then
    _tier_for_timeout=$(_gpa_determine_tier "[]" "0" "$total_batches")
  fi
  local timeout max_retries
  if [[ "$_tier_for_timeout" == "local" ]]; then
    timeout=60
    max_retries=2
  else
    timeout=90
    max_retries=3
  fi
  local retry_count=0
  
  while [ $retry_count -lt $max_retries ]; do
    if [ $retry_count -gt 0 ]; then
      echo "  ⚠ Retry attempt $retry_count of $max_retries..." >&2
    fi
    
    # Create a temporary file to store the result
    local tmp_result=$(mktemp)
    local tmp_pid_file=$(mktemp)
    
    # Run the review in a background process.
    # Redirect subshell stdout+stderr to /dev/null: the result travels through
    # $tmp_result (explicit redirect), so inherited fds are not needed. This also
    # prevents any streaming text from claude from leaking to the terminal.
    (
      local result=$(_gpa_review_batch "$batch" "$batch_num" "$total_batches" "$tier_override" 2>/dev/null)
      echo "$result" > "$tmp_result"
    ) >/dev/null 2>/dev/null &
    
    local bg_pid=$!
    echo $bg_pid > "$tmp_pid_file"
    
    # Wait for the process with timeout and show progress
    local elapsed=0
    local interval=0.5
    local spinner_chars="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    local spinner_idx=0
    local tick_count=0
    
    # Print initial status on same line
    printf "  " >&2
    
    while kill -0 $bg_pid 2>/dev/null; do
      # Update elapsed time every 2 ticks (1 second)
      if [ $((tick_count % 2)) -eq 0 ]; then
        elapsed=$((tick_count / 2))
      fi
      
      if [ $elapsed -ge $timeout ]; then
        printf "\r  ⚠ AI review timed out after ${timeout} seconds\n" >&2
        kill -9 $bg_pid 2>/dev/null
        wait $bg_pid 2>/dev/null
        rm -f "$tmp_result" "$tmp_pid_file"
        ((retry_count++))
        break
      fi
      
      # Show spinner and elapsed time
      local spinner_char="${spinner_chars:$spinner_idx:1}"
      printf "\r  %s Analyzing code... %ds elapsed" "$spinner_char" "$elapsed" >&2
      
      sleep $interval
      ((tick_count++))
      ((spinner_idx = (spinner_idx + 1) % ${#spinner_chars}))
    done
    
    # Clear the progress line if process completed successfully
    if [ $elapsed -lt $timeout ]; then
      printf "\r  ✓ Analysis complete (%ds)        \n" "$elapsed" >&2
    fi
    
    # Check if we broke out due to timeout
    if [ $elapsed -ge $timeout ]; then
      continue
    fi
    
    # Wait for background process to complete
    wait $bg_pid
    local exit_code=$?
    
    # Read the result
    local batch_result=""
    if [ -f "$tmp_result" ]; then
      batch_result=$(cat "$tmp_result")
      rm -f "$tmp_result"
    fi
    rm -f "$tmp_pid_file"
    
    # Validate the result
    if [ $exit_code -eq 0 ] && [ -n "$batch_result" ]; then
      # Try to validate as JSON
      if echo "$batch_result" | jq empty 2>/dev/null; then
        echo "$batch_result"
        return 0
      else
        # Extract last JSON array: greedy .* before forces rightmost match,
        # lazy .*? inside captures minimal content to avoid crossing array boundaries.
        local extracted_json=$(echo "$batch_result" | perl -0777 -pe 's/.*(\[.*?\])\s*$/$1/s' | head -c 50000)
        
        if [ -n "$extracted_json" ] && echo "$extracted_json" | jq empty 2>/dev/null; then
          echo "$extracted_json"
          return 0
        fi
        
        # Soft failure - could not parse
        printf "\r  ⚠ Could not parse response as JSON\n" >&2
        echo "[]"
        return 2
      fi
    elif [ $exit_code -eq 2 ]; then
      # Soft failure from _gpa_review_batch (unparseable)
      echo "$batch_result"
      return 2
    fi
    
    # Failed, increment retry
    ((retry_count++))
  done
  
  # All retries failed
  echo "  ✗ AI review failed after $max_retries attempts" >&2
  return 1
}

# Helper function: Prompt user for action on AI errors
# Usage: _prompt_ai_error_action <error_message> <context>
# Returns: 0 for retry, 1 for continue, 2 for cancel
function _prompt_ai_error_action() {
  local error_msg="$1"
  local context="${2:-AI operation}"
  
  echo "" >&2
  echo "⚠ ERROR: $error_msg" >&2
  echo "  Context: $context" >&2
  echo "" >&2
  echo "Options:" >&2
  echo "  [ENTER] Retry - Try the operation again" >&2
  echo "  [c] Continue - Skip this step and continue" >&2
  echo "  [ESC] Cancel - Abort the operation" >&2
  echo "" >&2
  echo -n "Your choice: " >&2
  
  # Read a single character
  local choice
  read -r choice
  
  case "$choice" in
    ""|$'\n')  # ENTER key
      return 0  # Retry
      ;;
    c|C)
      return 1  # Continue
      ;;
    $'\e'|q|Q)  # ESC or q
      return 2  # Cancel
      ;;
    *)
      # Invalid input, treat as cancel
      echo "⚠ Invalid input, cancelling..." >&2
      return 2
      ;;
  esac
}

function gpa() {
  # Git Partial Add with AI code review
  # Usage: gpa [--tier=haiku|sonnet|opus]
  
  # Parse optional --tier flag
  local tier_override="auto"
  for arg in "$@"; do
    case $arg in
      --tier=haiku|--tier=sonnet|--tier=opus)
        tier_override="${arg#--tier=}"
        shift
        ;;
      --tier=*)
        echo "✗ Invalid tier. Use: haiku, sonnet, or opus"
        return 1
        ;;
    esac
  done
  
  # Save current shell options and disable tracing
  local prev_opts=$-
  setopt local_options
  [[ $prev_opts == *x* ]] && setopt no_xtrace

  # Validate git repository
  _check_git_repo || return 1

  # Ensure an AI provider is configured for this session
  _ensure_ai_provider || return 1

  # Check if there are ANY changes (staged or unstaged)
  if git diff --quiet && git diff --cached --quiet; then
    echo "⚠ No changes to stage or review"
    return 1
  fi

  # Get git root directory for proper path resolution
  local git_root=$(git rev-parse --show-toplevel)
  local current_dir=$(pwd)
  local relative_to_root="${current_dir#$git_root}"
  relative_to_root="${relative_to_root#/}"  # Remove leading slash if present
  
  # Get list of changed files with status - properly handle filenames with spaces
  local changed_files=()
  local file_status=()
  local display_files=()  # Files as shown by git status (for display)
  local auto_excluded_files=()  # Files automatically excluded
  
  while IFS= read -r line; do
    # Parse git status --short format: XY filename
    # First 2 chars are status, then space, then filename
    local git_status="${line:0:2}"
    local file="${line:3}"
    
    # Only include unstaged changes (status code in second position)
    # Check for: modified (M), deleted (D), or untracked (??)
    if [[ "$git_status" == " M" || "$git_status" == " D" || "$git_status" == "??" ]]; then
      # Check if file should be auto-excluded
      local file_basename=$(basename "$file")
      if [[ "$file_basename" == ".terraform.lock.hcl" ]]; then
        auto_excluded_files+=("$file")
        continue
      fi
      
      # Convert path relative to current dir to path relative to git root
      local file_from_root
      if [[ -n "$relative_to_root" ]]; then
        file_from_root="${relative_to_root}/${file}"
      else
        file_from_root="$file"
      fi
      
      changed_files+=("$file_from_root")
      file_status+=("$git_status")
      display_files+=("$file")  # Keep original for display
    fi
  done < <(git status --short)
  
  # Show auto-excluded files if any
  if [ ${#auto_excluded_files[@]} -gt 0 ]; then
    echo "ℹ Auto-excluded ${#auto_excluded_files[@]} file(s):"
    for file in "${auto_excluded_files[@]}"; do
      echo "  ⊝ $file"
    done
    echo ""
  fi

  # Check if there are already staged changes
  local staged_count=$(git diff --cached --name-only | wc -l | tr -d ' ')
  
  # If there are unstaged changes, let user select what to stage
  if [ ${#changed_files[@]} -gt 0 ]; then
    # Show already-staged files if any
    if [ "$staged_count" -gt 0 ]; then
      local GREEN='\033[0;32m'
      local NC='\033[0m'
      echo "Changes to be committed:"
      git diff --cached --name-status | while IFS=$'\t' read -r file_status_code file; do
        local label=""
        case "$file_status_code" in
          M) label="modified:  " ;;
          A) label="new file:  " ;;
          D) label="deleted:   " ;;
          R) label="renamed:   " ;;
          *) label="$file_status_code         " ;;
        esac
        echo -e "  ${GREEN}${label}${file}${NC}"
      done
      echo ""
      echo "  [Enter] Continue with already-staged files"
      echo ""
    fi
    
    # Display files with numbers and status like git status
    echo "Select files to stage and review:"
    echo ""
    echo "  a) All files"
    echo ""
    local i=1
    for idx in {1..${#changed_files[@]}}; do
      local file="${display_files[$idx]}"
      local git_status="${file_status[$idx]}"
      echo "  $i) $git_status $file"
      ((i++))
    done
    echo ""
    echo "  esc) Exit"
    echo ""
    
    if [ "$staged_count" -gt 0 ]; then
      echo -n "Enter numbers, 'a' for all, Enter to continue with staged, or ESC to exit: "
    else
      echo -n "Enter numbers separated by spaces (e.g., '1 3 5'), 'a' for all, or ESC to exit: "
    fi
    
    # Read the entire line with full readline support (backspace, arrow keys, etc.)
    local selection
    read -r selection
    
    # Check for Escape sequence at start (if user typed ESC + Enter)
    if [[ "$selection" == $'\x1b'* ]]; then
      echo "✓ Cancelled"
      return 0
    fi
    
    # Check for empty input (just Enter)
    if [[ -z "$selection" ]]; then
      # Empty input (Enter key) - handle immediately
      if [ "$staged_count" -gt 0 ]; then
        echo "✓ Continuing with $staged_count already-staged file(s)"
        # Skip to the review section (set selection to empty and let flow continue)
        selection=""
      else
        echo "✗ No files are staged"
        return 1
      fi
    else
      
      # Handle selection
      case "$selection" in
        q | Q)
          echo "✓ Cancelled"
          return 0
          ;;
        a | A)
          # Stage all files - run git add from repo root to handle relative paths correctly
          echo "ℹ Staging all ${#changed_files[@]} file(s)"
          if [ ${#auto_excluded_files[@]} -gt 0 ]; then
            echo "  (excluding ${#auto_excluded_files[@]} auto-excluded file(s))"
          fi
          for file in "${changed_files[@]}"; do
            git -C "$git_root" add "$file" 2>/dev/null
          done
          echo "✓ Staged ${#changed_files[@]} file(s)"
          ;;
        *)
          # Stage selected files
          local selected_files=()
          for num in $selection; do
            if [[ "$num" =~ ^[0-9]+$ ]] && [ "$num" -ge 1 ] && [ "$num" -le "${#changed_files[@]}" ]; then
              # Note: zsh arrays are 1-indexed by default, so we use $num directly
              local selected_file="${changed_files[$num]}"
              if [ -n "$selected_file" ]; then
                selected_files+=("$selected_file")
              fi
            fi
          done

          if [ ${#selected_files[@]} -eq 0 ]; then
            echo "✗ No valid files selected"
            return 1
          fi

          # Stage each file individually - run git add from repo root to handle relative paths correctly
          echo "ℹ Staging ${#selected_files[@]} file(s)..."
          for file in "${selected_files[@]}"; do
            git -C "$git_root" add "$file" 2>/dev/null
          done
          echo "✓ Staged ${#selected_files[@]} file(s)"
          ;;
      esac
    fi
  else
    # No unstaged changes, but there are staged changes - proceed to review them
    if [ "$staged_count" -gt 0 ]; then
      local GREEN='\033[0;32m'
      local NC='\033[0m'
      echo "Changes to be committed:"
      git diff --cached --name-status | while IFS=$'\t' read -r file_status_code file; do
        local label=""
        case "$file_status_code" in
          M) label="modified:  " ;;
          A) label="new file:  " ;;
          D) label="deleted:   " ;;
          R) label="renamed:   " ;;
          *) label="$file_status_code         " ;;
        esac
        echo -e "  ${GREEN}${label}${file}${NC}"
      done
      echo ""
    fi
  fi

  # Check if there are staged changes to review
  if git diff --cached --quiet; then
    echo ""
    echo "⚠ No files are staged for review"
    return 0
  fi

  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running secrets detection scan..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Run secrets detection using helper function
  if ! _check_for_secrets; then
    echo "✗ Secrets detection aborted commit."
    return 1
  fi
  
  echo "✓ No secrets detected in staged changes"
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running linters on staged files..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""
  
  # Run linters
  if ! _run_linters; then
    echo "✗ Linting check aborted."
    return 1
  fi
  
  echo ""
  echo "═══════════════════════════════════════════════════════════"
  echo "ℹ Running AI code review on staged changes..."
  echo "═══════════════════════════════════════════════════════════"
  echo ""

  # Create batches for review
  echo "ℹ Analyzing staged files and creating review batches..."
  local batches=$(_gpa_create_batches)
  local batch_count=$(echo "$batches" | jq 'length')
  
  if [ "$batch_count" -eq 0 ]; then
    echo ""
    echo "✓ All staged files have been previously reviewed with no changes"
    echo ""
    echo "Options:"
    echo "  [Y/Enter] Proceed to commit and push (gpc)"
    echo "  [r] Re-review all files (clear cache)"
    echo "  [esc] Cancel - keep staged"
    echo ""
    echo -n "Your choice: "
    _read_key
    echo ""

    case "$_KEY" in
      y | Y | $'\n')
        echo ""
        gpc
        return $?
        ;;
      r | R)
        echo ""
        _gpa_clear_cache
        echo ""
        echo "Re-running gpa to review all files..."
        echo ""
        gpa
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  fi
  
  local total_files=$(git diff --cached --name-only | wc -l)
  local total_lines=$(git diff --cached | wc -l)
  
  echo "ℹ Processing $total_files file(s) in $batch_count batch(es)"
  echo "  Total changes: $total_lines lines"
  local _active_provider=$(_get_ai_provider)
  echo "  Provider: $(_provider_display_name "$_active_provider")"
  if [[ "$tier_override" == "auto" ]]; then
    echo "  Model: Auto-detect ($(_model_tier_display "$_active_provider"))"
  else
    local tier_emoji=""
    case "$tier_override" in
      opus) tier_emoji="🔴" ;;
      sonnet) tier_emoji="🔵" ;;
      haiku) tier_emoji="🟢" ;;
    esac
    echo "  Model: $tier_emoji $tier_override (forced) → $(_get_opencode_model "$tier_override")"
  fi
  echo ""
  
  # Process each batch and collect all issues
  local all_issues="[]"
  local batch_index=0
  local failed_batches=0
  local soft_failed_batches=0  # Track unparseable responses separately
  local ai_review_failed=false
  
  while [ $batch_index -lt $batch_count ]; do
    local batch=$(echo "$batches" | jq -c ".[$batch_index]")
    local batch_num=$((batch_index + 1))
    
    # Determine which tier will be used for this batch (for display purposes)
    local batch_tier="$tier_override"
    if [[ "$tier_override" == "auto" ]]; then
      # Pre-calculate tier for display (will be recalculated inside _gpa_review_batch)
      local batch_files_json=$(echo "$batch" | jq -c '.')
      local batch_diff_lines=$(echo "$batch_files_json" | jq -r '.[]' | xargs git diff --cached -- | wc -l)
      batch_tier=$(_gpa_determine_tier "$batch_files_json" "$batch_diff_lines" "$batch_count")
    fi
    
    # Display tier icon and label
    local tier_icon="" tier_label=""
    case "$batch_tier" in
      opus)   tier_icon="🔴" ; tier_label="Opus" ;;
      sonnet) tier_icon="🔵" ; tier_label="Sonnet" ;;
      haiku)  tier_icon="🟢" ; tier_label="Haiku" ;;
      local)  tier_icon="⚪" ; tier_label="$(_llamacpp_model_short)" ;;
      *)      tier_icon="🔵" ; tier_label="Sonnet" ;;
    esac

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "$tier_icon $tier_label — Reviewing batch $batch_num of $batch_count... [$_active_provider]"
    
    # Review this batch with timeout and retry
    # Note: must separate local declaration from assignment to preserve exit code.
    # In zsh, `local var=$(cmd)` swallows the subshell exit code.
    local batch_issues
    batch_issues=$(_gpa_review_batch_with_timeout "$batch" "$batch_num" "$batch_count" "$tier_override")
    local review_status=$?
    
    if [ $review_status -eq 0 ]; then
      # Success - merge batch issues into all_issues
      if [ -n "$batch_issues" ] && echo "$batch_issues" | jq empty 2>/dev/null; then
        # Filter out invalid/malformed issue objects
        # Valid issues must have: file, severity, issue, recommendation fields
        local valid_batch_issues=$(echo "$batch_issues" | jq '[.[] | select(type == "object" and has("file") and has("severity") and has("issue") and has("recommendation"))]' 2>/dev/null)
        
        if [ -n "$valid_batch_issues" ]; then
          local issue_count=$(echo "$valid_batch_issues" | jq 'length')
          if [ "$issue_count" -gt 0 ]; then
            echo "  Found $issue_count issue(s) in this batch"
            
            # Check if we should escalate (only when auto-selected or non-opus cloud tier)
            local active_provider=$(_get_ai_provider)
            local can_escalate=false
            if [[ "$tier_override" == "auto" ]] || [[ "$tier_override" == "sonnet" ]] || \
               [[ "$tier_override" == "haiku" ]] || [[ "$tier_override" == "local" ]]; then
              can_escalate=true
            fi

            if $can_escalate && _gpa_should_escalate "$valid_batch_issues"; then
              echo ""
              echo "  ⚠ CRITICAL SECURITY ISSUE DETECTED"

              if [[ "$active_provider" == "llama-cpp" ]]; then
                # Hybrid mode: escalate local findings to cloud Sonnet
                local cloud_provider=$(_get_cloud_fallback_provider)
                echo "  Local model found Critical+security issues."
                echo ""
                echo "  Recommendation: Re-review with cloud ($cloud_provider Sonnet)"
                echo "  for authoritative security analysis."
                echo ""
                echo "  Options:"
                echo "    [y] Yes - Escalate to cloud (recommended)"
                echo "    [n] No  - Keep local findings"
                echo ""
                echo -n "  Your choice: "
                read -r escalate_choice

                if [[ "$escalate_choice" == "y" || "$escalate_choice" == "Y" ]]; then
                  echo ""
                  echo "  ☁  Escalating to $cloud_provider Sonnet..."
                  local cloud_issues=$(_gpa_review_batch_with_timeout "$batch" "$batch_num" "$batch_count" "cloud-escalation")
                  local cloud_status=$?

                  if [ $cloud_status -eq 0 ] && [ -n "$cloud_issues" ] && echo "$cloud_issues" | jq empty 2>/dev/null; then
                    local valid_cloud_issues=$(echo "$cloud_issues" | jq '[.[] | select(type == "object" and has("file") and has("severity") and has("issue") and has("recommendation"))]' 2>/dev/null)
                    local cloud_issue_count=$(echo "$valid_cloud_issues" | jq 'length')
                    echo "  ☁  Cloud review complete: Found $cloud_issue_count issue(s)"
                    valid_batch_issues="$valid_cloud_issues"
                  else
                    echo "  ⚠ Cloud escalation failed, keeping local findings"
                  fi
                  echo ""
                fi
              else
                # Cloud-only mode: escalate to Opus on same provider
                echo "  Sonnet found Critical severity issues with security implications."
                echo "  🔴 Automatically escalating to Opus for comprehensive security review..."
                echo ""
                local opus_issues=$(_gpa_review_batch_with_timeout "$batch" "$batch_num" "$batch_count" "opus")
                local opus_status=$?

                if [ $opus_status -eq 0 ] && [ -n "$opus_issues" ] && echo "$opus_issues" | jq empty 2>/dev/null; then
                  local valid_opus_issues=$(echo "$opus_issues" | jq '[.[] | select(type == "object" and has("file") and has("severity") and has("issue") and has("recommendation"))]' 2>/dev/null)
                  if [ -n "$valid_opus_issues" ]; then
                    local opus_issue_count=$(echo "$valid_opus_issues" | jq 'length')
                    echo "  🔴 Opus review complete: Found $opus_issue_count issue(s)"
                    valid_batch_issues="$valid_opus_issues"
                  else
                    echo "  🔴 Opus review found no additional issues"
                  fi
                else
                  echo "  ⚠ Opus review failed, keeping Sonnet findings"
                fi
                echo ""
              fi
            fi
            
            all_issues=$(echo "$all_issues" | jq --argjson batch "$valid_batch_issues" '. + $batch')
          else
            echo "  ✓ No issues found in this batch"
          fi
        else
          echo "  ✓ No issues found in this batch"
          # No issues found - continue
        fi
      else
        echo "  ⚠ Batch review returned invalid JSON"
        ((failed_batches++))
      fi
    elif [ $review_status -eq 2 ]; then
      # Soft failure - unparseable response (already retried)
      echo "  ⚠ AI response could not be parsed (after retries)"
      ((soft_failed_batches++))
    else
      # Hard failure - API error, timeout, network issue
      echo "  ✗ Batch review failed completely"
      ((failed_batches++))
    fi
    
    echo ""
    ((batch_index++))
  done
  
  # Check if all batches failed (hard failures)
  if [ $failed_batches -eq $batch_count ]; then
    ai_review_failed=true
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "⚠ WARNING: AI code review could not be completed"
    echo "  All $batch_count batch(es) failed after multiple retry attempts"
    echo ""
    echo "This could be due to:"
    echo "  - Network connectivity issues"
    echo "  - AI service unavailability"
    echo "  - Rate limiting"
    echo ""
    echo "Options:"
    echo "  [ENTER] Retry - Run code review again"
    echo "  [c] Continue - Proceed without AI review"
    echo "  [ESC] Cancel - Abort and keep changes staged"
    echo ""
    echo -n "Your choice: "
    read -r skip_review
    
    case "$skip_review" in
      ""|$'\n')  # ENTER - Retry
        echo ""
        echo "♻️  Retrying review..."
        echo ""
        gpa "$@"
        return $?
        ;;
      c|C)  # Continue without review
        echo "✓ Continuing without AI review"
        ;;
      $'\e'|q|Q|*)  # ESC or invalid - Cancel
        echo "✗ Aborting commit - changes remain staged"
        return 1
        ;;
    esac
  elif [ $failed_batches -gt 0 ]; then
    echo "⚠ Warning: $failed_batches of $batch_count batch(es) failed review (hard failures)"
  fi
  
  # Handle soft failures (unparseable responses)
  if [ $soft_failed_batches -gt 0 ]; then
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "⚠ WARNING: $soft_failed_batches batch(es) returned unparseable responses"
    echo ""
    echo "The AI reviewed your code but returned output that could not be parsed."
    echo "This means issues may have been found but weren't captured."
    echo ""
    echo "Options:"
    echo "  [ENTER] Retry - Re-run review on failed batches"
    echo "  [c] Continue - Ignore and proceed to commit"
    echo "  [ESC] Cancel - Exit and keep changes staged"
    echo ""
    echo -n "Your choice: "
    read -r soft_fail_choice
    
    case "$soft_fail_choice" in
      ""|$'\n')  # ENTER - Retry
        echo ""
        echo "♻️  Retrying review..."
        echo ""
        gpa "$@"
        return $?
        ;;
      c|C)  # Continue
        echo "✓ Ignoring unparseable responses and continuing"
        ;;
      $'\e'|q|Q|*)  # ESC or invalid - Cancel
        echo "✗ Canceling review - changes remain staged"
        return 1
        ;;
    esac
  fi
  
  echo "═══════════════════════════════════════════════════════════"
  
  # Count total issues found
  local total_issue_count=$(echo "$all_issues" | jq 'length')
  
  # Handle case where AI review was skipped or no issues found
  if [ "$ai_review_failed" = true ] || [ "$total_issue_count" -eq 0 ]; then
    # No issues found or review was skipped - proceed directly to commit
    if [ "$ai_review_failed" = true ]; then
      echo "ℹ Proceeding without AI review"
    else
      echo "✓ Code review complete - no critical issues or warnings found"
    fi
    
    echo ""
    echo "Options:"
    echo "  [Y/Enter] Commit and push - automatically runs 'gpc'"
    echo "  [esc] Cancel - keep staged but don't proceed"
    echo ""
    echo -n "Your choice: "
    _read_key
    echo ""

    case "$_KEY" in
      y | Y | $'\n')
        echo ""
        echo "✓ Proceeding to commit and push..."
        echo ""
        gpc
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  else
    # Issues found - display summary and enter interactive mode
    echo "⚠ Found $total_issue_count issue(s) across all batches"
    echo ""
    
    # Display a summary of issues by severity
    local critical_count=$(echo "$all_issues" | jq '[.[] | select(type == "object" and .severity == "Critical")] | length' 2>/dev/null || echo "0")
    local warning_count=$(echo "$all_issues" | jq '[.[] | select(type == "object" and .severity == "Warning")] | length' 2>/dev/null || echo "0")
    
    if [ "$critical_count" -gt 0 ]; then
      echo "  🔴 Critical: $critical_count"
    fi
    if [ "$warning_count" -gt 0 ]; then
      echo "  🟡 Warning: $warning_count"
    fi
    echo ""
    
    # Enter interactive fix mode
    echo "Entering interactive fix mode..."
    echo ""
    _gpa_interactive_fix "$all_issues"
    return $?
  fi
}

# Git PR - Create new branch and draft pull request
function gpr_func() {
  # Validate git repository
  _check_git_repo || return 1

  # gpr never calls an AI provider — branch naming and PR creation are
  # templated operations that don't benefit from cloud quality.
  echo "🏠 Creating PR locally (no AI provider needed)..."
  echo ""

  # Stash any uncommitted changes
  echo "Stashing uncommitted changes..."
  local stash_result=$(git stash)
  local did_stash=false
  if [[ "$stash_result" != "No local changes to save" ]]; then
    did_stash=true
  fi

  # Always attempt git pull, continue regardless of result
  echo "Pulling latest changes..."
  git pull || true

  # Restore stashed changes only if we stashed something
  if [[ "$did_stash" == true ]]; then
    echo "Restoring stashed changes..."
    git stash pop || true
  fi

  echo "Select type:"
  echo "  1) feat"
  echo "  2) fix"
  echo -n "Enter choice (1 or 2): "
  read type_choice
  case "$type_choice" in
    1) type_prefix="feat" ;;
    2) type_prefix="fix" ;;
    *)
      echo "✗ Invalid choice. Please select 1 or 2"
      return 1
      ;;
  esac
  echo -n "Branch name: "
  read branch_name
  if [ -z "$branch_name" ]; then
    echo "✗ Branch name cannot be empty"
    return 1
  fi
  git checkout -b "$branch_name" &&
    git commit --allow-empty -m "$branch_name" &&
    git push -u origin "$branch_name" &&
    gh pr create --draft --title "$type_prefix: $branch_name" --body "$(
      cat <<EOF
## Description
$type_prefix: $branch_name

## Tickets
$type_prefix: $branch_name
EOF
    )"
}

