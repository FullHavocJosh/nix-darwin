# Helper function: Launch a script in a new terminal window (macOS + Linux)
# Usage: _launch_terminal_window <script_path> <label>
# Returns 0 on success, 1 if no terminal could be found
function _launch_terminal_window() {
  local script="$1"
  local label="${2:-terminal window}"

  if [[ "$OSTYPE" == darwin* ]] || [[ "$(uname 2>/dev/null)" == "Darwin" ]]; then
    # Prefer the terminal we're already running in
    case "$TERM_PROGRAM" in
      ghostty)
        if command -v ghostty &>/dev/null; then
          nohup ghostty -e "$script" >/dev/null 2>&1 &
          echo "✓ Launched $label in new Ghostty window"
          return 0
        fi
        ;;
      iTerm.app)
        osascript -e "tell application \"iTerm2\" to create window with default profile command \"$script\"" >/dev/null 2>&1
        echo "✓ Launched $label in new iTerm2 window"
        return 0
        ;;
    esac
    # Fallbacks: kitty, wezterm, then Terminal.app (always present)
    if command -v kitty &>/dev/null; then
      nohup kitty "$script" >/dev/null 2>&1 &
    elif command -v wezterm &>/dev/null; then
      nohup wezterm start -- "$script" >/dev/null 2>&1 &
    else
      open -a Terminal "$script"
    fi
    echo "✓ Launched $label in new terminal window"
    return 0
  fi

  # Linux
  if command -v xdg-terminal-exec &>/dev/null; then
    nohup xdg-terminal-exec "$script" >/dev/null 2>&1 &
    echo "✓ Launched $label in new terminal window"
    return 0
  elif [ -n "$TERMINAL" ] && command -v "$TERMINAL" &>/dev/null; then
    nohup "$TERMINAL" -e "$script" >/dev/null 2>&1 &
    echo "✓ Launched $label in new terminal window"
    return 0
  fi

  echo "✗ Could not determine default terminal"
  echo "  Set \$TERMINAL environment variable or install xdg-terminal-exec"
  return 1
}

# Helper function: Check if current directory is a git repository
function _check_git_repo() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "✗ Error: Not in a git repository"
    return 1
  fi
  return 0
}



# AWS credentials switcher
function asc() {
  if [ "$1" = "clear" ]; then
    unset -m "AWS_*"
    echo "✓ AWS environment variables unset"
  else
    eval "$(aws configure export-credentials --profile $1 --format env)"
    export AWS_PROFILE=$1
    echo "✓ AWS environment variables set"
  fi
}

# Helper function: Open a herdr workspace (nvim + aidev tabs) for linting fixes
# Usage: _linter_create_edit_workspace <files_with_issues> <lint_report>
function _linter_create_edit_workspace() {
  local -a files_array
  IFS=$'\n' read -rd '' -A files_array <<< "$1"
  local lint_report="$2"

  # Get absolute path to repo root
  local repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

  # Save the prompt to a temp file to avoid quoting issues
  local prompt_file="/tmp/lint_prompt_$$.txt"
  cat > "$prompt_file" <<EOF
Help me fix the following linting issues. The files are already open in the editor above.

Linting Issues:
$(echo -e "$lint_report")

Files to fix: ${files_array[@]}

Please review the issues and suggest fixes. I can make the changes in the editor above or you can help automate the fixes.
EOF

  # Open first file with issues in nvim
  local first_file="${files_array[1]}"
  # If file path is relative, make it absolute from repo root
  if [[ ! "$first_file" = /* ]]; then
    first_file="$repo_root/$first_file"
  fi

  local session_name="lint-fix-$$"
  local cmd_aidev="echo '=== aidev Linting Assistant ==='; echo; aidev \"\$(cat '$prompt_file')\""

  _herdr_ai_edit_workspace "$session_name" "$repo_root" "nvim '$first_file'" "$cmd_aidev"

  echo "  Workspace: $session_name"
  echo "  Files: ${files_array[@]}"
  echo "  Edit the files in the herdr workspace, then switch back here when done."
  echo ""
}

# Helper function: Check if a file contains Helm template syntax
# Usage: _is_helm_template <file_path>
# Returns 0 if file is a Helm template, 1 otherwise
function _is_helm_template() {
  local file="$1"
  
  # Check if file is in a Helm chart templates directory (path-based detection)
  # This works even if the file path is relative
  if [[ "$file" == *"/charts/"*"/templates/"* ]] || [[ "$file" == *"/helm/"*"/templates/"* ]]; then
    return 0
  fi
  
  # Check file content for Helm template syntax (only if file exists)
  if [ -f "$file" ]; then
    # Look for common Helm template patterns
    if grep -qE '\{\{-?\s*(include|define|template|if|range|with|\.Values\.|\.Release\.|\.Chart\.|toYaml|nindent)' "$file" 2>/dev/null; then
      return 0
    fi
  fi
  
  return 1
}

# Helper function: Run linters on staged files
# Returns 0 if all linters pass or user wants to continue, 1 if user wants to abort
function _run_linters() {
  local auto_mode="${1:-false}"
  local files=()
  while IFS= read -r file; do
    files+=("$file")
  done < <(git diff --cached --name-only)
  
  if [ ${#files[@]} -eq 0 ]; then
    return 0
  fi
  
  local linting_issues=false
  local lint_report=""
  local files_with_issues=()
  
  # Check for available linters and verify they work
  local has_nixfmt=false
  local nixfmt_broken=false
  if command -v nixfmt &>/dev/null; then
    local nixfmt_path=$(command -v nixfmt)
    # Check if it's a real binary (not just a text file placeholder)
    if file "$nixfmt_path" | grep -qE "(executable|ELF|Mach-O)"; then
      # Verify nixfmt actually works (not just a placeholder file)
      if nixfmt --version &>/dev/null || nixfmt --help &>/dev/null; then
        has_nixfmt=true
      else
        nixfmt_broken=true
      fi
    else
      # It's a text file or script placeholder
      nixfmt_broken=true
    fi
  fi
  
  local has_prettier=false
  if command -v prettier &>/dev/null; then
    if prettier --version &>/dev/null; then
      has_prettier=true
    fi
  fi
  
  local has_ruff=false
  if command -v ruff &>/dev/null; then
    if ruff --version &>/dev/null; then
      has_ruff=true
    fi
  fi
  
  # Track files that need linters but linters are unavailable
  local missing_linters=false
  local missing_linters_report=""
  
  # Run linters based on file types
  for file in "${files[@]}"; do
    # Skip deleted files
    if [ ! -f "$file" ]; then
      continue
    fi
    
    local file_has_issues=false
    
    case "$file" in
      *.nix)
        if $has_nixfmt; then
          if ! nixfmt --check "$file" 2>/dev/null; then
            lint_report="${lint_report}🟡 $file: nixfmt formatting issues\n"
            linting_issues=true
            file_has_issues=true
          fi
        elif $nixfmt_broken; then
          missing_linters_report="${missing_linters_report}⚠️  $file: nixfmt is broken/unavailable\n"
          missing_linters=true
        else
          missing_linters_report="${missing_linters_report}⚠️  $file: nixfmt not installed\n"
          missing_linters=true
        fi
        ;;
      *.js|*.jsx|*.ts|*.tsx|*.json|*.md|*.yml|*.yaml|*.css|*.html)
        # Skip Prettier for Helm chart templates
        if [[ "$file" == *.yml ]] || [[ "$file" == *.yaml ]]; then
          if _is_helm_template "$file"; then
            continue  # Skip linting for Helm templates
          fi
        fi
        
        if $has_prettier; then
          if ! prettier --check "$file" 2>/dev/null; then
            lint_report="${lint_report}🟡 $file: prettier formatting issues\n"
            linting_issues=true
            file_has_issues=true
          fi
        else
          missing_linters_report="${missing_linters_report}⚠️  $file: prettier not installed\n"
          missing_linters=true
        fi
        ;;
      *.py)
        if $has_ruff; then
          local ruff_output=$(ruff check "$file" 2>&1)
          local ruff_exit=$?
          # ruff returns non-zero exit code when issues are found
          # Don't check output text as "All checks passed!" is also output
          if [ $ruff_exit -ne 0 ]; then
            lint_report="${lint_report}🟡 $file: ruff linting issues\n"
            lint_report="${lint_report}   $(echo "$ruff_output" | head -3 | sed 's/^/   /')\n"
            linting_issues=true
            file_has_issues=true
          fi
        else
          missing_linters_report="${missing_linters_report}⚠️  $file: ruff not installed\n"
          missing_linters=true
        fi
        ;;
    esac
    
    if $file_has_issues; then
      files_with_issues+=("$file")
    fi
  done
  
  # Display missing linters warnings if any
  if $missing_linters; then
    echo ""
    echo "⚠️  MISSING OR BROKEN LINTERS"
    echo ""
    echo -e "$missing_linters_report"
    echo "ℹ  Some files could not be checked. Install missing linters:"
    if ! $has_nixfmt || $nixfmt_broken; then
      echo "    • nixfmt: Install via your system package manager or nix profile"
      if $nixfmt_broken; then
        echo "      (Note: Current nixfmt at $(command -v nixfmt) is broken)"
      fi
    fi
    if ! $has_prettier; then
      echo "    • prettier: npm install -g prettier"
    fi
    if ! $has_ruff; then
      echo "    • ruff: pip install ruff or install via system package manager"
    fi
    echo ""
  fi
  
  if $linting_issues; then
    echo ""
    echo "⚠️  LINTING ISSUES DETECTED"
    echo ""
    echo -e "$lint_report"
    echo ""
    local lint_choice
    if $auto_mode; then
      echo "ℹ Auto mode: auto-fixing formatting issues"
      lint_choice="f"
    else
      echo "Options:"
      echo "  [e] Edit files with AI assistance (opens herdr workspace)"
      echo "  [f] Auto-fix formatting issues (where possible)"
      echo "  [i] Ignore and continue"
      echo "  [q] Quit and fix manually"
      echo ""
      echo -n "Your choice: "
      read -r lint_choice
    fi
    
    case "$lint_choice" in
      e | E)
        echo ""
        echo "ℹ Opening herdr workspace for manual fixes with AI assistance..."
        echo "  nvim tab: files with issues"
        echo "  aidev tab: aidev assistant"
        echo ""

        # Convert files_with_issues array to newline-separated string
        local files_string=$(printf '%s\n' "${files_with_issues[@]}")

        _linter_create_edit_workspace "$files_string" "$lint_report"

        # Wait for user to finish editing
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "⏸  Waiting for you to finish editing..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        echo "When you're done editing in the herdr workspace:"
        echo "  1. Save your changes in nvim"
        echo "  2. Switch back to this pane"
        echo "  3. Press Enter here to re-run linting checks"
        echo ""
        echo -n "Press Enter when editing is complete: "
        read -r
        
        # Re-stage the files
        echo ""
        echo "ℹ Re-staging modified files..."
        for file in "${files_with_issues[@]}"; do
          if [ -f "$file" ]; then
            git add "$file"
            echo "  ✓ Re-staged: $file"
          fi
        done
        
        # Re-run linting checks
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "ℹ Re-running linting checks..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        
        # Recursively call _run_linters to check again
        _run_linters "$auto_mode"
        return $?
        ;;
      f | F)
        echo ""
        echo "ℹ Auto-fixing formatting issues..."
        for file in "${files[@]}"; do
          if [ ! -f "$file" ]; then
            continue
          fi
          
          case "$file" in
            *.nix)
              if $has_nixfmt; then
                echo "  Formatting $file with nixfmt..."
                if nixfmt "$file" 2>&1; then
                  echo "  ✓ Formatted: $file"
                  git add "$file"
                else
                  echo "  ✗ Failed to format: $file"
                fi
              fi
              ;;
            *.js|*.jsx|*.ts|*.tsx|*.json|*.md|*.yml|*.yaml|*.css|*.html)
              # Skip Prettier for Helm chart templates
              if [[ "$file" == *.yml ]] || [[ "$file" == *.yaml ]]; then
                if _is_helm_template "$file"; then
                  echo "  ⊳ Skipping Helm template: $file"
                  continue
                fi
              fi
              
              if $has_prettier; then
                echo "  Formatting $file with prettier..."
                if prettier --write "$file" 2>&1; then
                  echo "  ✓ Formatted: $file"
                  git add "$file"
                else
                  echo "  ✗ Failed to format: $file"
                fi
              fi
              ;;
            *.py)
              if $has_ruff; then
                echo "  Checking $file with ruff..."
                if ruff check --fix "$file" 2>&1; then
                  echo "  ✓ Fixed: $file"
                  git add "$file"
                else
                  echo "  ✗ Failed to fix: $file"
                fi
              fi
              ;;
          esac
        done
        echo ""
        echo "✓ Auto-fix complete. Files re-staged."
        
        # Re-run linting checks to verify fixes
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "ℹ Re-running linting checks to verify fixes..."
        echo "═══════════════════════════════════════════════════════════"
        echo ""
        _run_linters "$auto_mode"
        return $?
        ;;
      i | I)
        echo "⚠️  Proceeding with linting issues!"
        return 0
        ;;
      *)
        echo "✗ Aborting. Fix linting issues manually."
        return 1
        ;;
    esac
  elif ! $missing_linters; then
    # Only show "all good" if we actually checked everything
    echo "✓ No linting issues detected"
  fi
  
  return 0
}

# Helper: return filenames (indented) from staged diff matching a grep pattern
function _get_matching_files() {
  local pattern="$1"
  git diff --cached --name-only | while IFS= read -r file; do
    if git diff --cached -- "$file" | grep "^+" | grep -v "^+++" | grep -qiE -- "$pattern"; then
      echo "    $file"
    fi
  done
}

# Helper function: Check staged changes for secrets/credentials
# Returns 0 if safe to proceed, 1 if secrets found and user wants to abort
function _check_for_secrets() {
  local auto_mode="${1:-false}"
  local diff_output=$(git diff --cached)
  local added_lines=$(echo "$diff_output" | grep "^+" | grep -v "^+++")
  
  # Filter out false positives: comments, grep patterns, function definitions, variable names
  # Keep only lines that might contain actual secrets
  local filtered_lines=$(echo "$added_lines" | \
    grep -vE '^\+\s*(#|//|/\*)' | \
    grep -v 'grep.*-[qE]' | \
    grep -v 'function _check_for_secrets' | \
    grep -v 'secrets_report=' | \
    grep -v 'if echo.*grep' | \
    grep -v '\.example' | \
    grep -v '\.sample' | \
    grep -v 'YOUR_.*_HERE' | \
    grep -v '<YOUR_' | \
    grep -v 'REPLACE_' | \
    grep -v 'INSERT_' || true)
  
  local secrets_found=false
  local secrets_report=""
  local suspicious_lines=""
  
  # Check for AWS credentials - look for actual AKIA keys or key=value patterns
  if echo "$filtered_lines" | grep -qE "AKIA[0-9A-Z]{16}"; then
    secrets_report="${secrets_report}  • AWS Access Key (AKIA...)\n$(_get_matching_files "AKIA[0-9A-Z]{16}")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -B5 -E "AKIA[0-9A-Z]{16}" | head -14)\n"
    secrets_found=true
  fi

  if echo "$filtered_lines" | grep -qiE "(aws_access_key_id|aws_secret_access_key)\s*=\s*['\"][A-Za-z0-9/+=]{20,}"; then
    secrets_report="${secrets_report}  • AWS credentials in config format\n$(_get_matching_files "(aws_access_key_id|aws_secret_access_key)\s*=\s*['\"][A-Za-z0-9/+=]{20,}")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -iB5 -E "(aws_access_key_id|aws_secret_access_key)\s*=\s*['\"]" | head -14)\n"
    secrets_found=true
  fi

  # Check for API keys - must have key= or key: with actual value
  if echo "$filtered_lines" | grep -qiE "(api[_-]?key|apikey)\s*[=:]\s*['\"][0-9a-zA-Z_\-]{32,}"; then
    secrets_report="${secrets_report}  • API key\n$(_get_matching_files "(api[_-]?key|apikey)\s*[=:]\s*['\"][0-9a-zA-Z_-]{32,}")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -iB5 -E "(api[_-]?key|apikey)\s*[=:]\s*['\"][0-9a-zA-Z_\-]{32,}" | head -14)\n"
    secrets_found=true
  fi

  # Check for passwords - must be in assignment format
  # Filter out false positives: all-uppercase placeholder values (env var names/templates),
  # values ending in _PLACEHOLDER/_HASH, and lines with variable references ($VAR)
  local pw_matches=$(echo "$filtered_lines" | \
    grep -iE "(password|passwd)\s*[=:]\s*['\"][^'\"]{8,}['\"]" | \
    grep -v '_PLACEHOLDER' | \
    grep -vE "[=:]\s*['\"][A-Z][A-Z0-9_]{7,}['\"]" | \
    grep -vE "[=:]\s*['\"]?\\\$\{?[A-Za-z_]" | \
    grep -vE "[=:]\s*['\"]?\{\{" | \
    grep -viE "[=:]\s*['\"]?(changeme|change_me|password|passwd|secret|example|placeholder|foobar|test|dummy|fake|sample|your[-_]?password|mypassword|p@ssw0rd|pass1234)['\"]?\s*$")
  if [ -n "$pw_matches" ]; then
    secrets_report="${secrets_report}  • Password\n$(_get_matching_files "(password|passwd)\s*[=:]\s*['\"][^'\"]{8,}['\"]")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -iB5 -E "(password|passwd)\s*[=:]\s*['\"][^'\"]{8,}['\"]" | head -14)\n"
    secrets_found=true
  fi

  # Check for tokens - must be in assignment format with sufficient length
  if echo "$filtered_lines" | grep -qiE "(secret|token|auth[_-]?token)\s*[=:]\s*['\"][0-9a-zA-Z_\-]{40,}"; then
    secrets_report="${secrets_report}  • Secret/Token\n$(_get_matching_files "(secret|token|auth[_-]?token)\s*[=:]\s*['\"][0-9a-zA-Z_-]{40,}")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -iB5 -E "(secret|token|auth[_-]?token)\s*[=:]\s*['\"]" | head -14)\n"
    secrets_found=true
  fi

  # Check for OpenAI/Stripe keys - very specific patterns
  if echo "$filtered_lines" | grep -qE "sk-[a-zA-Z0-9]{32,}|pk-(live|test)_[a-zA-Z0-9]{24,}"; then
    secrets_report="${secrets_report}  • OpenAI/Stripe API key\n$(_get_matching_files "sk-[a-zA-Z0-9]{32,}|pk-(live|test)_[a-zA-Z0-9]{24,}")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -B5 -E "sk-[a-zA-Z0-9]{32,}|pk-(live|test)_" | head -14)\n"
    secrets_found=true
  fi

  # Check for GitHub tokens - very specific patterns
  if echo "$filtered_lines" | grep -qE "ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59}"; then
    secrets_report="${secrets_report}  • GitHub token\n$(_get_matching_files "ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59}")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -B5 -E "ghp_|gho_|github_pat_" | head -14)\n"
    secrets_found=true
  fi

  # Check for private keys - actual PEM format
  if echo "$filtered_lines" | grep -qE -- "-----BEGIN (RSA |DSA |EC )?PRIVATE KEY-----"; then
    secrets_report="${secrets_report}  • Private key\n$(_get_matching_files "-----BEGIN (RSA |DSA |EC )?PRIVATE KEY-----")\n"
    suspicious_lines="${suspicious_lines}$(echo "$added_lines" | grep -B5 -E -- "-----BEGIN.*PRIVATE KEY-----" | head -14)\n"
    secrets_found=true
  fi
  
  if $secrets_found; then
    echo ""
    echo "🚨 SECRETS DETECTED IN STAGED CHANGES! 🚨"
    echo ""
    echo "Potential secrets found:"
    echo -e "$secrets_report"
    echo ""
    echo "ℹ Analyzing detections..."
    echo ""
    local review_result=$(echo "Secrets detection flagged the following in my staged git changes. Review the full context of each match (including nearby comments) and determine whether these are real secrets or false positives.

IMPORTANT: End your analysis with exactly one of these on its own line:
- VERDICT: ALL_CLEAR (if all detections are false positives)
- VERDICT: NEEDS_REVIEW (if any detection is a real secret)

Detections:
$(echo -e "$secrets_report")

Context from diff (matching lines with surrounding lines for context):
$(echo -e "$suspicious_lines")" | _run_ai_plain "sonnet" 2>&1)
    local exit_code=$?
    if [ $exit_code -eq 0 ] && [ -n "$review_result" ]; then
      echo "═══════════════════════════════════════════════════════════"
      echo "$review_result"
      echo "═══════════════════════════════════════════════════════════"

      local verdict=$(echo "$review_result" | grep -oE 'VERDICT: (ALL_CLEAR|NEEDS_REVIEW)' | tail -1)

      if [[ "$verdict" == "VERDICT: ALL_CLEAR" ]]; then
        echo ""
        echo "✓ AI analysis confirms all detections are false positives. Proceeding."
        echo "$review_result" > /tmp/gpa_secrets_verdict.txt
        return 0
      fi

      if $auto_mode; then
        echo ""
        echo "✗ Auto mode: AI analysis could not confirm these are false positives — aborting."
        echo "  Review the detections and AI analysis above, fix the flagged lines, then re-run gpa --auto."
        return 1
      fi

      echo ""
      echo "  [Enter] Open in OpenCode for interactive review"
      echo "  [i]     Ignore and proceed with commit"
      echo "  [esc]   Abort commit"
      echo ""
      echo -n "Your choice: "
      read -r post_review_choice
      case "$post_review_choice" in
        $'\e')
          echo "✗ Commit aborted."
          return 1
          ;;
        [Ii])
          echo "⚠️  Proceeding with commit despite secrets warning!"
          return 0
          ;;
        *)
          echo ""
          local prompt_file="/tmp/gpa_secrets_review_$$.txt"
          {
            echo "Secrets detection flagged the following in my staged git changes. Please review the full context and advise whether these are real secrets or false positives."
            echo ""
            echo "Detections:"
            echo -e "$secrets_report"
            echo ""
            echo "Suspicious lines from diff:"
            echo -e "$suspicious_lines"
            echo ""
            echo "AI initial analysis:"
            echo "$review_result"
          } > "$prompt_file"
          local repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
          local model=$(jq -r '.model // empty' ~/.config/opencode/opencode.json 2>/dev/null)
          (cd "$repo_root" && opencode --model "$model" --prompt "I have staged git changes with potential secrets. Read $prompt_file for the full context and help me review whether these are real secrets or false positives.")
          rm -f "$prompt_file"
          return 1
          ;;
      esac
    else
      echo "⚠ AI review failed. You can proceed manually."
      return 0
    fi
  fi
  
  return 0
}

function gpc() {
  # Validate git repository
  _check_git_repo || return 1

  # Check if there are staged changes
  if ! git diff --cached --quiet; then
    # Commit messages use Haiku when available for efficiency
    # Try llama.cpp first if available, fall back to selected provider
    local active_provider=$(_get_ai_provider)
    local override_provider=""
    
    # Always try llama.cpp first for all providers (saves API costs and uses local resources)
    # Only exception: if already using llama.cpp, don't override
    if [[ "$active_provider" != "llama-cpp" ]] && [[ "$active_provider" != "llama.cpp" ]]; then
      if _validate_llamacpp 2>/dev/null; then
        override_provider="llama-cpp"
        
        # Show different message based on original provider
        case "$active_provider" in
          opencode)
            if _is_opencode_free_model; then
              echo "ℹ Using llama.cpp for commit message (saving OpenCode Zen free tier credits)"
            else
              echo "ℹ Using llama.cpp for commit message (fallback: OpenCode Zen)"
            fi
            ;;
          github-copilot)
            echo "ℹ Using llama.cpp for commit message (fallback: GitHub Copilot)"
            ;;
          claude-code)
            echo "ℹ Using llama.cpp for commit message (fallback: Anthropic)"
            ;;
          *)
            echo "ℹ Using llama.cpp for commit message (fallback: $active_provider)"
            ;;
        esac
      fi
    fi
    
    # Use override provider if set, otherwise use active provider
    local provider_for_commit="${override_provider:-$active_provider}"
    
    # Determine appropriate model tier for commit messages
    local model_tier="haiku"
    
    # Check if provider supports multi-tier (will return false for free models and llama.cpp)
    if ! _supports_multi_tier; then
      # Single model only - use whatever is available
      model_tier="sonnet"  # _get_opencode_model will handle free/llama.cpp cases
    fi
    
    # Check if a specific model is selected via config
    # Only check config if NOT using override provider (llama.cpp fallback)
    local selected_model=""
    if [[ -z "$override_provider" ]]; then
      if [[ "$active_provider" == "opencode" ]] || [[ "$active_provider" == "github-copilot" ]]; then
        local config_file="$HOME/.config/opencode/opencode.json"
        if [[ -f "$config_file" ]] && command -v jq &>/dev/null; then
          local config_model=$(jq -r '.model // empty' "$config_file" 2>/dev/null)
          # Only use the model if it matches the current provider
          if [[ -n "$config_model" && "$config_model" != "null" ]]; then
            if [[ "$active_provider" == "opencode" && "$config_model" == opencode/* ]]; then
              selected_model="$config_model"
            elif [[ "$active_provider" == "github-copilot" && "$config_model" == github-copilot/* ]]; then
              selected_model="$config_model"
            fi
          fi
        fi
      fi
    fi
    
    # Get model name for display purposes
    local model_name
    if [[ -n "$selected_model" && "$selected_model" != "null" ]]; then
      model_name="$selected_model"
    elif [[ "$provider_for_commit" == "llama-cpp" ]] || [[ "$provider_for_commit" == "llama.cpp" ]]; then
      # For llama.cpp, get the short model name directly
      model_name=$(_llamacpp_model_short)
    else
      # For other providers, get the model using the current provider
      model_name=$(_get_opencode_model "$model_tier")
    fi

    echo ""
    # Show provider and model being used
    local provider_display
    case "$provider_for_commit" in
      github-copilot)
        provider_display="GitHub Copilot"
        ;;
      opencode)
        provider_display="OpenCode Zen"
        ;;
      llama-cpp|llama.cpp)
        provider_display="llama.cpp"
        ;;
      claude-code)
        provider_display="Anthropic"
        ;;
      *)
        provider_display="$provider_for_commit"
        ;;
    esac

    if [[ "$provider_for_commit" == "llama-cpp" ]] || [[ "$provider_for_commit" == "llama.cpp" ]]; then
      echo "⚪ $provider_display | $model_name — Generating commit message..."
    elif [[ -n "$selected_model" && "$selected_model" != "null" ]]; then
      echo "🟢 $provider_display | $selected_model — Generating commit message..."
    else
      echo "🟢 $provider_display | $model_name — Generating commit message..."
    fi

    # Get the diff of staged changes
    local diff_output=$(git diff --cached)
    
    # Debug: Show diff size
    local diff_lines=$(echo "$diff_output" | wc -l | tr -d ' ')
    local diff_chars=$(echo "$diff_output" | wc -c | tr -d ' ')
    echo "  Diff size: $diff_lines lines, $diff_chars characters"

    # Retry loop for AI commit message generation
    local max_retries=3
    local retry_count=0
    local commit_msg=""
    local generation_succeeded=false
    
    # Temporarily switch provider if override is set
    local session_file="/tmp/.ai_provider_session_$(id -u)"
    local saved_provider=""
    if [[ -n "$override_provider" ]]; then
      saved_provider=$(cat "$session_file" 2>/dev/null || echo "")
      echo "$override_provider" > "$session_file"
    fi
    
    while [ $retry_count -lt $max_retries ]; do
      # Use AI to generate commit message
      # GitHub Copilot: use sonnet-4.5 (4-6 only available via Claude-Code or OpenCode Zen)
      # Other providers: use haiku for efficiency
      local commit_model_tier="haiku"
      if [[ "$provider_for_commit" == "github-copilot" ]]; then
        commit_model_tier="sonnet"
      fi
      local ai_output=$(echo "Review the following git diff and generate a concise, single-sentence commit message that describes the changes. The message should be in imperative mood (e.g., 'Add feature' not 'Added feature'). Maximum 72 characters. Return ONLY the commit message, nothing else.\n\n$diff_output" | _run_ai_plain "$commit_model_tier" 2>&1)
      local ai_exit=$?
      
      # Check if AI command succeeded
      if [ $ai_exit -ne 0 ]; then
        local error_msg="AI command failed (exit code: $ai_exit)"
        if echo "$ai_output" | grep -qi "timeout"; then
          error_msg="AI request timed out"
        elif echo "$ai_output" | grep -qi "API\|network\|connection"; then
          error_msg="Network or API error"
        fi
        
        # Prompt user for action
        _prompt_ai_error_action "$error_msg" "Commit message generation"
        local action=$?
        
        case $action in
          0)  # Retry
            ((retry_count++))
            if [ $retry_count -lt $max_retries ]; then
              echo "  ⟳ Retrying... (attempt $((retry_count + 1))/$max_retries)" >&2
            fi
            continue
            ;;
          1)  # Continue (skip AI, use manual)
            echo "" >&2
            echo "ℹ Skipping AI generation. Please enter commit message manually:" >&2
            read -r commit_msg
            if [ -n "$commit_msg" ]; then
              generation_succeeded=true
              break
            else
              echo "✗ Empty commit message, aborting" >&2
              return 1
            fi
            ;;
          2)  # Cancel
            echo "✗ Operation cancelled by user" >&2
            return 1
            ;;
        esac
        continue
      fi
      
      # Clean ANSI codes and OpenCode prompts for error checking
      local ai_output_clean=$(_clean_opencode_output "$ai_output")
      
      # Debug output if DEBUG_GPC is set
      if [[ -n "$DEBUG_GPC" ]]; then
        echo "" >&2
        echo "=== DEBUG: Raw AI Output ===" >&2
        echo "$ai_output" | head -10 >&2
        echo "=== DEBUG: Cleaned Output ===" >&2
        echo "$ai_output_clean" | head -10 >&2
        echo "===========================" >&2
        echo "" >&2
      fi
      
      # Check if output contains error messages (case-insensitive)
      if echo "$ai_output_clean" | grep -qi "^Error:"; then
        # Show first few lines of actual error for debugging
        local error_preview=$(echo "$ai_output_clean" | grep -i "^Error:" | head -3)
        _prompt_ai_error_action "AI returned error message: $error_preview" "Commit message generation"
        local action=$?
        
        case $action in
          0)  # Retry
            ((retry_count++))
            if [ $retry_count -lt $max_retries ]; then
              echo "  ⟳ Retrying... (attempt $((retry_count + 1))/$max_retries)" >&2
            fi
            continue
            ;;
          1)  # Continue with manual input
            echo "" >&2
            echo "ℹ Skipping AI generation. Please enter commit message manually:" >&2
            read -r commit_msg
            if [ -n "$commit_msg" ]; then
              generation_succeeded=true
              break
            else
              echo "✗ Empty commit message, aborting" >&2
              return 1
            fi
            ;;
          2)  # Cancel
            echo "✗ Operation cancelled by user" >&2
            return 1
            ;;
        esac
        continue
      fi
      
      # Extract last non-empty line as commit message (use cleaned output)
      commit_msg=$(echo "$ai_output_clean" | grep -v '^$' | tail -1)

      # Check if we got a valid response
      if [ -z "$commit_msg" ]; then
        _prompt_ai_error_action "AI returned empty response" "Commit message generation"
        local action=$?
        
        case $action in
          0)  # Retry
            ((retry_count++))
            if [ $retry_count -lt $max_retries ]; then
              echo "  ⟳ Retrying... (attempt $((retry_count + 1))/$max_retries)" >&2
            fi
            continue
            ;;
          1)  # Continue with manual input
            echo "" >&2
            echo "ℹ Skipping AI generation. Please enter commit message manually:" >&2
            read -r commit_msg
            if [ -n "$commit_msg" ]; then
              generation_succeeded=true
              break
            else
              echo "✗ Empty commit message, aborting" >&2
              return 1
            fi
            ;;
          2)  # Cancel
            echo "✗ Operation cancelled by user" >&2
            return 1
            ;;
        esac
        continue
      fi
      
      # Final check if response looks like an error message (only match at start of string)
      if [[ "$commit_msg" == Error:* ]] || [[ "$commit_msg" == Debug:* ]]; then
        _prompt_ai_error_action "AI response contains error markers" "Commit message generation"
        local action=$?
        
        case $action in
          0)  # Retry
            ((retry_count++))
            if [ $retry_count -lt $max_retries ]; then
              echo "  ⟳ Retrying... (attempt $((retry_count + 1))/$max_retries)" >&2
            fi
            continue
            ;;
          1)  # Continue with manual input
            echo "" >&2
            echo "ℹ Skipping AI generation. Please enter commit message manually:" >&2
            read -r commit_msg
            if [ -n "$commit_msg" ]; then
              generation_succeeded=true
              break
            else
              echo "✗ Empty commit message, aborting" >&2
              return 1
            fi
            ;;
          2)  # Cancel
            echo "✗ Operation cancelled by user" >&2
            return 1
            ;;
        esac
        continue
      fi
      
      # Success!
      generation_succeeded=true
      break
    done
    
    # Restore original provider if it was overridden
    if [[ -n "$override_provider" ]]; then
      if [[ -n "$saved_provider" ]]; then
        echo "$saved_provider" > "$session_file"
      else
        rm -f "$session_file"
      fi
    fi
    
    # Check if we exhausted retries
    if [ "$generation_succeeded" != true ]; then
      echo "" >&2
      echo "✗ Failed to generate commit message after $max_retries attempts" >&2
      return 1
    fi

    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  $commit_msg"
    echo "═══════════════════════════════════════════════════════════"
    echo ""

    # Commit with the generated message
    git commit -m "$commit_msg"

    if [ $? -eq 0 ]; then
      echo ""
      local remote_url=$(git remote get-url origin 2>/dev/null || echo "remote")
      echo "ℹ Pushing to $remote_url..."
      git push
      if [ $? -eq 0 ]; then
        echo "✓ Successfully pushed"
      else
        echo "✗ Push failed"
        return 1
      fi
    else
      echo "✗ Commit failed, skipping push"
      return 1
    fi
  else
    echo "⚠ No staged changes to commit"
    return 1
  fi
}

