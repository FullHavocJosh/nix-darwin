# Helper function: Split staged files into batches for AI review
# Returns batches as a JSON array where each batch is an array of file paths
# Batches are sized to keep diff output around 300 lines per batch
# Usage: _gpa_create_batches
function _gpa_create_batches() {
  local target_lines=300
  local batches="[]"
  local current_batch="[]"
  local current_batch_lines=0
  
  # Get all staged files
  local staged_files=()
  while IFS= read -r file; do
    staged_files+=("$file")
  done < <(git diff --cached --name-only)
  
  if [ ${#staged_files[@]} -eq 0 ]; then
    echo "[]"
    return 0
  fi
  
  # Process each file and group into batches
  for file in "${staged_files[@]}"; do
    # Get line count for this file's diff
    local file_diff_lines=$(git diff --cached -- "$file" | wc -l)
    
    # If adding this file would exceed target, start a new batch
    # (unless current batch is empty - always include at least one file per batch)
    if [ $current_batch_lines -gt 0 ] && [ $((current_batch_lines + file_diff_lines)) -gt $target_lines ]; then
      # Save current batch and start a new one
      batches=$(echo "$batches" | jq --argjson batch "$current_batch" '. += [$batch]')
      current_batch="[]"
      current_batch_lines=0
    fi
    
    # Add file to current batch
    current_batch=$(echo "$current_batch" | jq --arg file "$file" '. += [$file]')
    current_batch_lines=$((current_batch_lines + file_diff_lines))
  done
  
  # Add the last batch if it's not empty
  if [ "$(echo "$current_batch" | jq 'length')" -gt 0 ]; then
    batches=$(echo "$batches" | jq --argjson batch "$current_batch" '. += [$batch]')
  fi
  
  echo "$batches"
}

# Helper function: Review a batch of files and return structured issues
# Usage: _gpa_review_batch <batch_files_json> <batch_number> <total_batches>
function _gpa_review_batch() {
  local batch_files_json="$1"
  local batch_number="$2"
  local total_batches="$3"
  
  # Convert JSON array to regular array
  local batch_files=()
  while IFS= read -r file; do
    batch_files+=("$file")
  done < <(echo "$batch_files_json" | jq -r '.[]')
  
  if [ ${#batch_files[@]} -eq 0 ]; then
    echo "[]"
    return 0
  fi
  
  # Get diff for only these files
  local batch_diff=""
  for file in "${batch_files[@]}"; do
    batch_diff="${batch_diff}$(git diff --cached -- "$file")\n"
  done
  
  # Count lines in this batch
  local batch_lines=$(echo -e "$batch_diff" | wc -l)
  
  # Check if any Terraform files are in this batch
  local has_terraform=false
  for file in "${batch_files[@]}"; do
    if [[ "$file" == *.tf ]]; then
      has_terraform=true
      break
    fi
  done
  
  # Build review prompt
  local review_prompt="Review the following staged git changes for CRITICAL ISSUES AND WARNINGS ONLY:

🔴 **CRITICAL - Must Fix Before Commit:**
1. **SECRETS & CREDENTIALS**: API keys, passwords, tokens, private keys, connection strings, AWS credentials, OAuth secrets, certificates
2. **Bugs**: Syntax errors, runtime errors, null pointer dereferences, infinite loops
3. **Security Vulnerabilities**: SQL injection, command injection, XSS, insecure crypto, path traversal
4. **Data Loss**: Destructive operations without safeguards, missing transactions, race conditions

🟡 **WARNINGS - Should Consider:**
5. **Security Concerns**: Overly permissive permissions, missing input validation, unsafe eval, hardcoded IPs/domains
6. **Logic Flaws**: Off-by-one errors, incorrect conditionals, missing edge cases
7. **Breaking Changes**: API changes, removed functionality, incompatible updates"
  
  if [ "$has_terraform" = true ]; then
    review_prompt="$review_prompt

**TERRAFORM-SPECIFIC CRITICAL/WARNING CHECKS** (detected .tf files):
🔴 **Critical**: Hardcoded secrets/keys, publicly exposed resources, destructive changes without lifecycle protection
🟡 **Warnings**: Overly permissive IAM (wildcards in production), missing encryption, expensive resources without justification"
  fi
  
  # Build full prompt
  local full_prompt="${review_prompt}

Batch ${batch_number} of ${total_batches} (${batch_lines} lines)

Files in this batch:
$(printf '%s\n' "${batch_files[@]}")

Git diff:
${batch_diff}

**IMPORTANT INSTRUCTIONS:**
- ONLY report 🔴 Critical issues and 🟡 Warnings
- IGNORE minor suggestions, style preferences, and code quality opinions
- Focus on things that will actually break, cause security issues, or have serious consequences
- Output ONLY a JSON array of issues in this exact format:
[
  {
    \"file\": \"path/to/file.ext\",
    \"severity\": \"Critical\" or \"Warning\",
    \"issue\": \"Brief issue description\",
    \"recommendation\": \"Detailed fix recommendation\"
  }
]
- If there are no critical/warning issues in this batch, return an empty array: []
- Return ONLY valid JSON, nothing else."
  
  echo "  Batch $batch_number/$total_batches: ${#batch_files[@]} file(s), $batch_lines lines" >&2
  
  # Run AI review using direct API call (much faster than full agent)
  local batch_result=$(echo "$full_prompt" | _run_ai_direct "complex" 2>&1)
  
  # Check if we got an error from the API
  if echo "$batch_result" | grep -q "^Error:"; then
    echo "  API Error: $batch_result" >&2
    echo "[]"
    return 1
  fi
  
  # Validate JSON and return
  if echo "$batch_result" | jq empty 2>/dev/null; then
    echo "$batch_result"
  else
    # If not valid JSON, try to extract JSON array from the response
    local extracted_json=$(echo "$batch_result" | grep -o '\[.*\]' | head -1)
    if echo "$extracted_json" | jq empty 2>/dev/null; then
      echo "$extracted_json"
    else
      # Debug: show what we got
      echo "  ⚠ Could not extract valid JSON from response" >&2
      echo "  Response preview: $(echo "$batch_result" | head -c 150)" >&2
      echo "[]"
    fi
  fi
}

# Helper function: Interactive fix mode for code review suggestions
# Usage: _gpa_interactive_fix <structured_issues_json>
function _gpa_interactive_fix() {
  local structured_issues="$1"
  
  # Validate JSON input
  if ! echo "$structured_issues" | jq empty 2>/dev/null; then
    echo "⚠ Invalid JSON structure for issues."
    echo ""
    echo "Options:"
    echo "  [e] Edit all staged files manually"
    echo "  [c] Continue to commit anyway"
    echo "  [q] Quit and keep changes staged"
    echo ""
    echo -n "Your choice: "
    read -r choice
    
    case "$choice" in
      e | E)
        local files_to_edit=()
        while IFS= read -r file; do
          files_to_edit+=("$file")
        done < <(git diff --cached --name-only)
        
        if command -v nvim &>/dev/null; then
          nvim "${files_to_edit[@]}"
        else
          echo "✗ No editor found."
          return 1
        fi
        echo "✓ Files edited. Run 'gpa' again to review."
        return 0
        ;;
      c | C)
        gpc
        return $?
        ;;
      *)
        echo "ℹ Keeping changes staged."
        return 0
        ;;
    esac
  fi
  
  # Count issues
  local issue_count=$(echo "$structured_issues" | jq 'length' 2>/dev/null)
  
  if [ "$issue_count" -eq 0 ] || [ -z "$issue_count" ]; then
    echo "✓ No issues found. Proceeding to commit."
    gpc
    return $?
  fi
  
  echo ""
  echo "Found $issue_count issue(s) to address."
  echo ""
  
  # Process each issue
  local issue_index=0
  while [ $issue_index -lt $issue_count ]; do
    local issue=$(echo "$structured_issues" | jq -r ".[$issue_index]" 2>/dev/null)
    local file=$(echo "$issue" | jq -r '.file // empty' 2>/dev/null)
    local severity=$(echo "$issue" | jq -r '.severity // empty' 2>/dev/null)
