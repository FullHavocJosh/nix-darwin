function _linter_create_edit_workspace() {
  local -a files_array
  IFS=$'\n' read -rd '' -A files_array <<< "$1"
  local lint_report="$2"
  
  # Get absolute path to repo root
  local repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  
  # Save the prompt to a temp file to avoid quoting issues
  local prompt_file="/tmp/lint_prompt_$$.txt"
  cat > "$prompt_file" <<EOF
Help me fix the following linting issues. The files are already open in the editor above.

Linting Issues:
$(echo -e "$lint_report")

Files to fix: ${files_array[@]}

Please review the issues and suggest fixes. I can make the changes in the editor above or you can help automate the fixes.
EOF
  
  # Get AI model
  local model=$(_get_opencode_model "complex")
  
  # Open first file with issues in nvim
  local first_file="${files_array[1]}"
  # If file path is relative, make it absolute from repo root
  if [[ ! "$first_file" = /* ]]; then
    first_file="$repo_root/$first_file"
  fi
  
  # Create a session name
  local session_name="lint-fix-$$"
  
  # Create a startup script that will run tmux in the new terminal
  local startup_script="/tmp/lint_startup_$$.sh"
  cat > "$startup_script" <<STARTUP
#!/usr/bin/env bash
# Change to repo root
cd '$repo_root'

# Create tmux session with nvim in top pane and OpenCode in bottom
tmux new-session -s '$session_name' -c '$repo_root' "nvim '$first_file'" \\; \\
  split-window -v -p 30 -c '$repo_root' "bash -c 'echo \"=== OpenCode Linting Assistant ===\"; echo \"\"; opencode --model \"$model\" -p \"\\\$(cat \"$prompt_file\")\"; exec \\\$SHELL'" \\; \\
  select-pane -t 0

# Cleanup temp files after tmux session ends
rm -f '$prompt_file' '$startup_script'
STARTUP
  chmod +x "$startup_script"
  
  # Launch in default terminal
  if command -v xdg-terminal-exec &>/dev/null; then
    # Use xdg-terminal-exec to launch default terminal
    nohup xdg-terminal-exec "$startup_script" >/dev/null 2>&1 &
    echo "✓ Launched editing workspace in new terminal window"
  elif [ -n "$TERMINAL" ] && command -v "$TERMINAL" &>/dev/null; then
    # Use $TERMINAL environment variable
    nohup "$TERMINAL" -e "$startup_script" >/dev/null 2>&1 &
    echo "✓ Launched editing workspace in new terminal window"
  else
    echo "✗ Could not determine default terminal"
    echo "  Set \$TERMINAL environment variable or install xdg-terminal-exec"
    rm -f "$prompt_file" "$startup_script"
    return 1
  fi
  
  echo "  Session: $session_name"
  echo "  Files: ${files_array[@]}"
  echo "  Edit the files in the new window, then close it when done."
  echo ""
}
