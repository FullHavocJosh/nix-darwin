function gpr_func() {
  # Validate git repository
  _check_git_repo || return 1

  # Check if there are files in current directory (not subdirectories) and no README.md
  local files_in_dir=$(find . -maxdepth 1 -type f ! -name "README.md" ! -name ".*" | wc -l)

  if [ "$files_in_dir" -gt 0 ] && [ ! -f "README.md" ]; then
    echo "ℹ No README.md found. Generating one with AI..."

    # Generate README.md using helper function
    local readme_content=$(_generate_readme)

    if [ -n "$readme_content" ]; then
      echo "$readme_content" >README.md
      echo "✓ README.md created"
      git add README.md
      git commit -m "docs: Add README.md"
      echo ""
    else
      echo "⚠ Failed to generate README.md"
    fi
  fi

  # Original gpr functionality
  echo "Select type:"
  echo "  1) feat"
  echo "  2) fix"
  echo -n "Enter choice (1 or 2): "
  read type_choice
  case "$type_choice" in
    1) type_prefix="feat" ;;
    2) type_prefix="fix" ;;
    *)
      echo "✗ Invalid choice. Please select 1 or 2"
      return 1
      ;;
  esac
  echo -n "Branch name: "
  read branch_name
  if [ -z "$branch_name" ]; then
    echo "✗ Branch name cannot be empty"
    return 1
  fi
  git checkout -b "$branch_name" &&
    git commit --allow-empty -m "$branch_name" &&
    git push -u origin "$branch_name" &&
    gh pr create --draft --title "$type_prefix: $branch_name" --body "$(
      cat <<EOF
## Description
$type_prefix: $branch_name

## Tickets
$type_prefix: $branch_name
EOF
    )"
}
