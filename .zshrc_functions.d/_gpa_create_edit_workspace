function _gpa_create_edit_workspace() {
  local file_path="$1"
  local recommendation="$2"
  local file_dir=$(dirname "$file_path")
  local file_name=$(basename "$file_path")
  local session_name="gpa-fix-${file_name}-$$"
  
  # Create a temporary file with the recommendation for OpenCode
  local rec_file="/tmp/gpa_recommendation_$$.txt"
  echo "$recommendation" > "$rec_file"
  
  # Get the OpenCode model for complex tasks
  local model=$(_get_opencode_model "complex")
  
  # Create a startup script that will run tmux in the new terminal
  local startup_script="/tmp/gpa_startup_$$.sh"
  cat > "$startup_script" <<STARTUP
#!/usr/bin/env bash
# Change to file directory
cd '$file_dir'

# Create tmux session with nvim in top pane and OpenCode in bottom
tmux new-session -s '$session_name' -c '$file_dir' "nvim '$file_path'" \\; \\
  split-window -v -p 30 -c '$file_dir' "bash -c 'echo \"=== Code Review Fix Assistant ===\"; echo \"\"; echo \"Recommendation:\"; cat \"$rec_file\"; echo \"\"; echo \"Starting OpenCode...\"; echo \"\"; opencode --model \"$model\" -p \"Help me implement this fix: \\\$(cat \\\"$rec_file\\\"). The file to fix is: $file_path\"; exec \\\$SHELL'" \\; \\
  select-pane -t 0

# Cleanup temp files after tmux session ends
rm -f '$rec_file' '$startup_script'
STARTUP
  chmod +x "$startup_script"
  
  # Launch in default terminal
  if command -v xdg-terminal-exec &>/dev/null; then
    # Use xdg-terminal-exec to launch default terminal
    nohup xdg-terminal-exec "$startup_script" >/dev/null 2>&1 &
    echo "✓ Launched editing workspace in new terminal window"
  elif [ -n "$TERMINAL" ] && command -v "$TERMINAL" &>/dev/null; then
    # Use $TERMINAL environment variable
    nohup "$TERMINAL" -e "$startup_script" >/dev/null 2>&1 &
    echo "✓ Launched editing workspace in new terminal window"
  else
    echo "✗ Could not determine default terminal"
    echo "  Set \$TERMINAL environment variable or install xdg-terminal-exec"
    rm -f "$rec_file" "$startup_script"
    return 1
  fi
  
  echo "  Session: $session_name"
  echo "  File: $file_path"
  echo "  Edit the file in the new window, then close it when done."
  echo ""
}
