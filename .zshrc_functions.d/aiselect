function aiselect() {
  local preference_file="$HOME/.ai_provider_preference"
  
  # If called with --show or --status, just display current provider
  if [[ "$1" == "--show" ]] || [[ "$1" == "--status" ]]; then
    local current_provider=$(_get_ai_provider)
    local opencode_model=$(_get_opencode_model "complex")
    local opencode_simple_model=$(_get_opencode_model "simple")
    
    echo "═══════════════════════════════════════════════════════════"
    echo "Current AI Configuration"
    echo "═══════════════════════════════════════════════════════════"
    echo "Active Provider: $current_provider"
    echo ""
    echo "Interactive Sessions (aidev/opencode):"
    echo "  Model: $opencode_model"
    echo "  → Launched with -m flag based on aiselect preference"
    echo ""
    echo "Helper Functions:"
    echo "  Simple tasks  (commit msgs): $opencode_simple_model"
    echo "  Complex tasks (code review): $opencode_model"
    echo ""
    echo "Command → Model Mapping:"
    echo "  • aidev                     → $opencode_model"
    echo "  • gpc (commit messages)     → $opencode_simple_model"
    echo "  • gpa (code review)         → $opencode_model"
    echo "  • README generation         → $opencode_model"
    echo ""
    echo "Note: Run 'aiselect' to change provider. Changes apply immediately"
    echo "      to new 'aidev' sessions (no restart required)."
    echo "═══════════════════════════════════════════════════════════"
    return 0
  fi
  
  # Colors for terminal output
  local RED='\033[0;31m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local NC='\033[0m' # No Color
  
  # Run validations
  echo "Checking AI provider availability..."
  echo ""
  
  local github_valid=false
  local opencode_valid=false
  local openrouter_valid=false
  
  # Validate GitHub Copilot
  if _validate_github_copilot; then
    github_valid=true
  else
    # Offer to authenticate
    echo "${YELLOW}⚠${NC}  GitHub Copilot not authenticated"
    echo ""
    echo -n "Would you like to authenticate now? [Y/n]: "
    read -k1 auth_choice
    echo ""
    
    if [[ "$auth_choice" =~ ^[Yy]$ ]] || [[ -z "$auth_choice" ]]; then
      echo ""
      echo "Opening GitHub device login page..."
      if command -v open &>/dev/null; then
        open "https://github.com/login/device"
      elif command -v xdg-open &>/dev/null; then
        xdg-open "https://github.com/login/device"
      fi
      echo ""
      echo "Starting OpenCode authentication..."
      opencode auth login
      
      # Re-validate
      if _validate_github_copilot; then
        github_valid=true
        echo ""
        echo "${GREEN}✓${NC} GitHub Copilot authenticated successfully!"
      else
        echo ""
        echo "${RED}✗${NC} Authentication failed or was cancelled"
      fi
    fi
    echo ""
  fi
  
  # Validate OpenCode Zen
  if _validate_opencode_zen; then
    opencode_valid=true
  fi
  
  # Validate OpenRouter
  if _validate_openrouter; then
    openrouter_valid=true
  fi
  
  # Display menu with status indicators
  while true; do
    echo "═══════════════════════════════════════════════════════════"
    echo "Select AI Provider:"
    echo "═══════════════════════════════════════════════════════════"
    
    if $github_valid; then
      echo "  [g] GitHub Copilot (default) ${GREEN}✓${NC}"
    else
      echo "  [g] GitHub Copilot (default) ${RED}✗${NC}"
    fi
    
    if $opencode_valid; then
      echo "  [c] OpenCode Zen             ${GREEN}✓${NC}"
    else
      echo "  [c] OpenCode Zen             ${RED}✗${NC}"
    fi
    
    if $openrouter_valid; then
      echo "  [r] OpenRouter               ${GREEN}✓${NC}"
    else
      echo "  [r] OpenRouter               ${RED}✗${NC}"
    fi
    
    echo "  [q] Quit"
    echo "═══════════════════════════════════════════════════════════"
    echo ""
    echo -n "Your choice: "
    
    # Read single character
    local choice
    read -k1 choice
    echo ""
    echo ""
    
    case $choice in
      $'\n' | '' | g | G)
        if $github_valid; then
          echo "github-copilot" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: GitHub Copilot"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "github-copilot" "sonnet")
          local haiku_model=$(_discover_latest_model "github-copilot" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} GitHub Copilot is not available (not authenticated)"
          echo ""
          continue
        fi
        ;;
      c | C)
        if $opencode_valid; then
          echo "opencode" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: OpenCode Zen"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "opencode" "sonnet")
          local haiku_model=$(_discover_latest_model "opencode" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} OpenCode Zen is not available"
          echo "ℹ  Set OPENCODE_API_KEY in ~/.zshrc_envvars (not tracked by git)"
          echo ""
          continue
        fi
        ;;
      r | R)
        if $openrouter_valid; then
          echo "openrouter" > "$preference_file"
          echo ""
          echo "${GREEN}✓${NC} Provider set to: OpenRouter"
          echo ""
          echo "Discovering latest Claude models..."
          local sonnet_model=$(_discover_latest_model "openrouter" "sonnet")
          local haiku_model=$(_discover_latest_model "openrouter" "haiku")
          
          if [[ -n "$sonnet_model" ]] && [[ -n "$haiku_model" ]]; then
            echo "  • Complex tasks (Sonnet): $sonnet_model"
            echo "  • Simple tasks (Haiku):   $haiku_model"
          else
            echo "  ${YELLOW}⚠${NC} Could not discover models, using defaults"
          fi
          echo ""
          echo "ℹ  New OpenCode sessions (via 'aidev') will use this provider"
          return 0
        else
          echo "${RED}✗${NC} OpenRouter is not available"
          echo "ℹ  Set OPENROUTER_API_KEY in ~/.zshrc_envvars (not tracked by git)"
          echo ""
          continue
        fi
        ;;
      q | Q | $'\e')
        echo "✗ Cancelled"
        return 0
        ;;
      *)
        echo "${RED}✗${NC} Invalid choice. Please select a valid option."
        echo ""
        continue
        ;;
    esac
  done
}
