# The daily terminal and AI stack, on tuios.
#
#   dev                  reattach the daemon's sessions; with none, create nix-darwin, terraform-infrastructure and
#                        home-infrastructure where cloned. Layout: workspace 1 holds nvim, aidev's Claude, Lumo
#                        and the builders
#   devim [name]         the same layout for the current directory, always a new session
#   nxvim, psvim, hivim, itvim   the session of one project (skipped where it is not cloned)
#   hiwt <branch>        a new home-infrastructure worktree and branch, with a session of its own
#   peerdev, nxpeer, hipeer, mmdev, himmdev, nxmmdev      sessions of the other Mac opened through the tuios host link
#   aidev [task]         Claude Code as backbone, Lumo for web lookups, a free builder, mailing each other, as extra
#                        workspaces of the current tuios session (outside tuios: session aidev-<repo>;
#                        .config/aistack-tuios/aidev_tuios.py)
#   aidev --resume, aidev_status
#   aidev -p "<change>" [files]   one edit by a free builder (a pane on a free workspace), AIDEV_TEST_CMD checked
#   aidev --handoff <dir>         a run for a plan another session wrote; aidev --rfc <name> plans from an RFC
#   aidev --direct [words]        a free builder, interactive, in this terminal
#   ai_tuios [-c] [msg]  one Claude Code pane in session ai_tuios-<dir>
#
# gpr points this session's nvim and zsh windows at a new worktree (_tuios_sync_dev_panes), and gpa's manual-fix
# choices open nvim and aidev in a free workspace (_tuios_ai_edit_workspace).
#
# Review: ctrl+t v opens tuios's review view of the focused pane's changes, against the branch's upstream (a pushed gpr
# branch shows only unpushed and uncommitted work). c notes a line, C a hunk, S sends the notes to the pane's agent.
# prdiff prints the whole PR's diff against origin's default branch.
#
# Keys (.config/tuios/config.toml): ctrl+t is tuios's prefix. ctrl+1..9 workspaces, ctrl+shift+j/k next/previous
# session, ctrl+shift+p go to an agent, session or pane, ctrl+shift+h sidebar, ctrl+h/l previous/next window, ctrl+j/k
# next/previous agent in every session; ctrl+t i agents and the Inbox, ctrl+t g lazygit, ctrl+t s scratch terminal,
# ctrl+t n/w/W new window/close window/close session, ctrl+t hjkl focus, ctrl+t space workspace prefix, ctrl+t q
# detach, ctrl+t ctrl+t sends ctrl+t to the pane. Without the prefix: ctrl+tab/ctrl+shift+tab cycle windows,
# ctrl+shift+arrows move focus, ctrl+shift+1..9 move the pane to a workspace.
# tuios is ctrl only; alt belongs to aerospace.

# tuios with the stowed config (~/.config/tuios; on macOS tuios otherwise reads ~/Library/Application
# Support/tuios).
_tuios_cmd() {
  (
    XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}" command tuios "$@"
  )
}

_tuios_guard() {
  command -v tuios >/dev/null || { echo "tuios is not installed (darwin-rebuild installs it through brew)." >&2; return 1; }
}

_tuios_session_exists() {
  _tuios_cmd ls --json 2>/dev/null | jq -e --arg n "$1" '.[]? | select(.name==$n)' >/dev/null 2>&1
}

# Inside tuios, switch this client to the session instead of nesting a second client in a pane.
_tuios_attach() {
  if [ -n "$TUIOS_ENV" ]; then
    _tuios_cmd switch-session "$1"
  else
    _tuios_cmd attach "$1"
  fi
}

# Starts the daemon when it is down. `tuios ls` never starts it, so after a reboot every session looked missing, and
# the first `tuios new` started the daemon, which restored the saved sessions, and then failed with "session already
# exists". start-server exits 1 when the daemon already runs; the wait covers the sessions it restores at start.
_tuios_daemon_up() {
  local i=0
  _tuios_cmd ls --json >/dev/null 2>&1 && return 0
  _tuios_cmd start-server >/dev/null 2>&1
  until _tuios_cmd ls --json >/dev/null 2>&1 || [ "$i" -ge 25 ]; do
    sleep 0.2
    i=$((i + 1))
  done
}

# tuios restores a session's window names, directories and history, but each window gets a fresh shell. Types nvim
# into session $1's nvim window when a shell is in its foreground (after a restore, or after you quit nvim there).
# A shell still drawing its prompt shows starship in the foreground, so wait up to 3s for that to settle.
_tuios_restore_nvim() {
  local s="$1" wid tty fg i
  _tuios_cmd list-windows -s "$s" --json 2>/dev/null |
    jq -r '.windows[] | select(.custom_name == "nvim") | "\(.window_id) \(.tty)"' |
    while read -r wid tty; do
      i=0
      fg=$(_tuios_fg "$tty")
      while { [ -z "$fg" ] || [ "$fg" = starship ]; } && [ "$i" -lt 15 ]; do
        sleep 0.2
        fg=$(_tuios_fg "$tty")
        i=$((i + 1))
      done
      case "$fg" in
        zsh | bash | sh) _tuios_cmd send-text -s "$s" -w "$wid" $'nvim\n' >/dev/null ;;
      esac
    done
}

# Session $1 for directory $2, the dev layout: workspace 1 holds nvim, aidev's Claude, Lumo and the builders. The pane
# `tuios new` opens becomes nvim; its command is typed into a shell, so quitting nvim leaves
# the pane at a prompt. A session that exists (still running, or restored by the daemon) keeps its layout and only
# gets nvim, Claude and Lumo back (_tuios_restore).
_tuios_devlayout() {
  local s="$1" dir="$2" first
  _tuios_daemon_up
  if _tuios_session_exists "$s"; then
    _tuios_restore "$s"
    return 0
  fi
  _tuios_cmd new "$s" -d --cwd "$dir" >/dev/null || return 1
  first=$(_tuios_cmd list-windows -s "$s" --json | jq -r '.windows[0].window_id')
  _tuios_cmd set-window -s "$s" -w "$first" --name nvim >/dev/null
  _tuios_cmd send-text -s "$s" -w nvim $'nvim\n' >/dev/null
  # No Claude or Lumo until you choose: the picker pane checks which models are usable and starts the one you pick.
  _tuios_cmd new-window pick -s "$s" --workspace 1 --cwd "$dir" --no-focus \
    --grants read,write,fan,files,respond,admin -- /bin/zsh -c \
    "AIDEV_TUIOS_SESSION=$s python3 \$HOME/.config/aistack-tuios/aidev_pick.py" >/dev/null
  _tuios_cmd select-workspace 1 -s "$s" >/dev/null
  _tuios_cmd focus-window nvim -s "$s" >/dev/null
}

# A restored session's nvim, Claude and Lumo (tuios brings the windows back with fresh shells): nvim is typed in
# again, Claude and Lumo start again from their launchers with their conversations (aidev_tuios.py restore).
_tuios_restore() {
  _tuios_restore_nvim "$1"
  python3 "$HOME/.config/aistack-tuios/aidev_tuios.py" restore "$1"
}

# Reattaches to the sessions the daemon holds (each gets nvim, Claude and Lumo back), to nix-darwin's when there is
# one. With no session at all it creates the dev layout for ~/nix-darwin, ~/pscloudops/terraform-infrastructure and
# ~/home-infrastructure, each only where it is cloned, then attaches to nix-darwin's (else the first one).
dev() {
  _tuios_guard || return 1
  local s first="" spec detached=0
  [ "$1" = "--detached" ] && detached=1 && shift
  _tuios_daemon_up
  for s in $(_tuios_cmd ls --json 2>/dev/null | jq -r '.[]?.name'); do
    _tuios_restore "$s"
    [ -z "$first" ] && first="$s"
  done
  if [ -z "$first" ]; then
    for spec in nix-darwin:"$HOME/nix-darwin" terraform-infrastructure:"$HOME/pscloudops/terraform-infrastructure" \
      home-infrastructure:"$HOME/home-infrastructure"; do
      [ -d "${spec#*:}" ] || continue
      _tuios_devlayout "${spec%%:*}" "${spec#*:}" || continue
      [ -z "$first" ] && first="${spec%%:*}"
    done
  fi
  # Ensure nix-darwin and home-infrastructure sessions exist where directories are cloned
  for spec in nix-darwin:"$HOME/nix-darwin" home-infrastructure:"$HOME/home-infrastructure"; do
    [ -d "${spec#*:}" ] || continue
    _tuios_session_exists "${spec%%:*}" && continue
    _tuios_devlayout "${spec%%:*}" "${spec#*:}" || continue
  done
  # Call _tuios_dev_peer after local sessions exist, but before final attach
  if [ "$detached" -eq 0 ]; then
    _tuios_dev_peer
  fi
  if [ "$detached" -eq 0 ]; then
    if _tuios_session_exists nix-darwin; then
      _tuios_attach nix-darwin
    elif [ -n "$first" ]; then
      _tuios_attach "$first"
    fi
  fi
}

# Like devim: the current directory, named after it (or $1), always a new session (-2, -3... when the name is taken).
devim() {
  _tuios_guard || return 1
  local name="${1:-${PWD:t}}" s n=2
  s="$name"
  while _tuios_session_exists "$s"; do
    s="$name-$n"
    n=$((n + 1))
  done
  _tuios_devlayout "$s" "$PWD" && _tuios_attach "$s"
}

# The session of one project, $1 for directory $2 (nxvim, psvim, hivim, itvim). Skipped on a machine where the
# project is not cloned (~/home-infrastructure is not on the work laptop).
_tuios_project() {
  _tuios_guard || return 1
  local name="$1" dir="$2"
  [ -d "$dir" ] || { echo "tuios: $dir does not exist on this machine, skipping $name" >&2; return 1; }
  cd "$dir" && _tuios_devlayout "$name" "$dir" && _tuios_attach "$name"
}
alias nxvim='_tuios_project nix-darwin ~/nix-darwin'
alias psvim='_tuios_project pscloudops ~/pscloudops'
alias hivim='_tuios_project home-infrastructure ~/home-infrastructure'
alias itvim='_tuios_project Infrastructure-Terrakube ~/Infrastructure-Terrakube'

# hiwt <branch>: a new worktree of the repo on a new branch off its current HEAD, in <repo>/.worktrees/<branch> (where
# gpr puts its worktrees), with a dev session of its own, so in-flight branches never share a working directory.
# Unlike gpr it opens no PR. Run again with the same branch, it reattaches.
_tuios_worktree() {
  _tuios_guard || return 1
  local repo_name="$1" repo_dir="$2" branch="$3"
  [ -n "$branch" ] || { echo "usage: hiwt <branch-name>" >&2; return 1; }
  local wt="$repo_dir/.worktrees/$branch" s="$repo_name-${branch//\//-}"
  if [ ! -d "$wt" ]; then
    git -C "$repo_dir" worktree add -b "$branch" "$wt" HEAD || return 1
  fi
  _tuios_devlayout "$s" "$wt" && _tuios_attach "$s"
}
alias hiwt='_tuios_worktree home-infrastructure ~/home-infrastructure'

# Session $1 whose windows ssh to $2 and work in $3 there: the peer layout uses workspaces 1 and 2 (nvim | zsh on 1, a remote
# shell on 2). Nothing of tuios runs on the remote end. Each command runs through `zsh -ic` there: a plain ssh command is
# not interactive, so the remote .zshrc (and its homebrew PATH) would not load.
_tuios_remote_space_ssh() {
  _tuios_guard || return 1
  local s="$1" host="$2" rdir="$3" first
  local ssh="ssh -t -i ~/.ssh/id_ed25519 $host"
  if ! _tuios_session_exists "$s"; then
    _tuios_cmd new "$s" -d --cwd "$HOME" >/dev/null || return 1
    first=$(_tuios_cmd list-windows -s "$s" --json | jq -r '.windows[0].window_id')
    _tuios_cmd set-window -s "$s" -w "$first" --name nvim >/dev/null
    _tuios_cmd send-text -s "$s" -w nvim "$ssh \"zsh -ic 'cd $rdir && nvim'\""$'\n' >/dev/null
    _tuios_cmd new-window zsh -s "$s" --workspace 1 --cwd "$HOME" --no-focus >/dev/null
    _tuios_cmd send-text -s "$s" -w zsh "$ssh \"zsh -ic 'cd $rdir && git status; exec zsh -l'\""$'\n' >/dev/null
    _tuios_cmd new-window ai -s "$s" --workspace 2 --cwd "$HOME" --no-focus >/dev/null
    _tuios_cmd send-text -s "$s" -w ai "$ssh \"zsh -ic 'cd $rdir; exec zsh -l'\""$'\n' >/dev/null
    _tuios_cmd focus-window nvim -s "$s" >/dev/null
  fi
  _tuios_attach "$s"
}
alias mmdev_ssh='_tuios_remote_space_ssh macmini havoc@macminim1.rollet.family ~'
alias himmdev_ssh='_tuios_remote_space_ssh macmini-home-infrastructure havoc@macminim1.rollet.family ~/home-infrastructure'
alias nxmmdev_ssh='_tuios_remote_space_ssh macmini-nix-darwin havoc@macminim1.rollet.family ~/nix-darwin'

# The foreground program of the terminal $1 (a window's tty, from list-windows): the process ps marks "+".
_tuios_fg() {
  ps -o stat=,comm= -t "${1#/dev/}" 2>/dev/null | awk '$1 ~ /\+/ { sub(".*/", "", $2); sub("^-", "", $2); print $2; exit }'
}

# Points this session's dev windows at $1: gpr passes its new worktree, pr-merged-reset the repo root. nvim gets
# `:cd $1 | Neotree git_status` (open buffers survive), zsh gets `cd $1`. A window is typed into
# only when the program it is named after is in its foreground, so a busy pane or a bare shell never gets keystrokes
# meant for something else.
_tuios_sync_dev_panes() {
  local dir="$1" s="$TUIOS_SESSION" name wid tty
  [ -n "$s" ] || return 0
  _tuios_cmd list-windows -s "$s" --json 2>/dev/null |
    jq -r '.windows[] | select(.custom_name == "nvim" or .custom_name == "zsh")
      | "\(.custom_name) \(.window_id) \(.tty)"' |
    while read -r name wid tty; do
      [ "$wid" = "$TUIOS_PANE_ID" ] && continue
      case "$name" in
        nvim)
          [ "$(_tuios_fg "$tty")" = nvim ] || continue
          # Two escs: one leaves insert mode or a prompt, the second closes a float over it.
          _tuios_cmd send-keys -s "$s" -w "$wid" esc >/dev/null 2>&1
          _tuios_cmd send-keys -s "$s" -w "$wid" esc >/dev/null 2>&1
          _tuios_wait_pane_stable "$wid"
          _tuios_cmd send-text -s "$s" -w "$wid" ":cd $dir | Neotree git_status" >/dev/null 2>&1
          _tuios_cmd send-keys -s "$s" -w "$wid" enter >/dev/null 2>&1
          ;;
        zsh)
          [ "$(_tuios_fg "$tty")" = zsh ] || continue
          _tuios_cmd send-text -s "$s" -w "$wid" "cd $dir"$'\n' >/dev/null 2>&1
          ;;
      esac
    done
}

# gpa's manual-fix choices: nvim with $3 and a shell running $4 (aidev) in directory $2. Inside tuios the two windows
# open on the lowest free workspace of this session; elsewhere in a new session $1, attached in a new terminal
# window (_launch_terminal_window, .zshrc_functions_git).
_tuios_ai_edit_workspace() {
  local name="$1" dir="$2" cmd_nvim="$3" cmd_aidev="$4" s ws first
  if [ -n "$TUIOS_ENV" ]; then
    s="$TUIOS_SESSION"
    ws=$(_tuios_cmd list-windows -s "$s" --json | jq -r '([range(1; 10)] - [.windows[].workspace]) | .[0] // empty')
    [ -n "$ws" ] || { echo "tuios: no free workspace in $s for $name" >&2; return 1; }
    _tuios_cmd new-window "ai-$name" -s "$s" --workspace "$ws" --cwd "$dir" --no-focus >/dev/null || return 1
    _tuios_cmd new-window "nvim-$name" -s "$s" --workspace "$ws" --cwd "$dir" >/dev/null || return 1
    [ -n "$cmd_aidev" ] && _tuios_cmd send-text -s "$s" -w "ai-$name" "$cmd_aidev"$'\n' >/dev/null
    [ -n "$cmd_nvim" ] && _tuios_cmd send-text -s "$s" -w "nvim-$name" "$cmd_nvim"$'\n' >/dev/null
    _tuios_cmd select-workspace "$ws" -s "$s" >/dev/null
    return 0
  fi
  _tuios_cmd new "$name" -d --cwd "$dir" >/dev/null || return 1
  first=$(_tuios_cmd list-windows -s "$name" --json | jq -r '.windows[0].window_id')
  _tuios_cmd set-window -s "$name" -w "$first" --name nvim >/dev/null
  _tuios_cmd new-window ai -s "$name" --workspace 1 --cwd "$dir" --no-focus >/dev/null
  [ -n "$cmd_aidev" ] && _tuios_cmd send-text -s "$name" -w ai "$cmd_aidev"$'\n' >/dev/null
  [ -n "$cmd_nvim" ] && _tuios_cmd send-text -s "$name" -w nvim "$cmd_nvim"$'\n' >/dev/null
  _tuios_cmd focus-window nvim -s "$name" >/dev/null
  local attach_script="/tmp/tuios_attach_$$.sh"
  cat >"$attach_script" <<STARTUP
#!/usr/bin/env bash
XDG_CONFIG_HOME="\${XDG_CONFIG_HOME:-\$HOME/.config}" tuios attach '$name'
rm -f '$attach_script'
STARTUP
  chmod +x "$attach_script"
  _launch_terminal_window "$attach_script" "$name"
}

# aidev [task] opens the tuios panes; aidev_tuios.py also takes the script forms (-p, --handoff, --rfc, --direct).
aidev() {
  _tuios_guard || return 1
  python3 "$HOME/.config/aistack-tuios/aidev_tuios.py" start "$@"
}

aidev_status() {
  python3 "$HOME/.config/aistack-tuios/aidev_tuios.py" status "$@"
}

ai_tuios() {
  _tuios_guard || return 1
  python3 "$HOME/.config/aistack-tuios/aidev_tuios.py" ai "$@"
}

# Waits for window $1's visible content to go still (three identical, non-empty reads; about 6s at most) before keys
# are typed into it.

_tuios_wait_pane_stable() {
  local pane_id="$1" prev_content="" cur_content stable_count=0 tries=0
  while [ "$tries" -lt 40 ]; do
    cur_content=$(_tuios_cmd capture-pane -w "$pane_id" 2>/dev/null)
    if [ "$cur_content" = "$prev_content" ] && [ -n "$cur_content" ]; then
      stable_count=$((stable_count + 1))
      [ "$stable_count" -ge 3 ] && return 0
    else
      stable_count=0
    fi
    prev_content="$cur_content"
    sleep 0.15
    tries=$((tries + 1))
  done
}

# prdiff [tuios review flags]: the whole PR of the current branch, as text. tuios review of this pane against the
# merge base with origin's default branch, where ctrl+t v diffs against the branch's upstream.
prdiff() {
  local base mb
  [ -n "$TUIOS_PANE_ID" ] || { echo "prdiff: run it in a tuios pane" >&2; return 1; }
  base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || base=origin/main
  mb=$(git merge-base HEAD "$base") || return 1
  _tuios_cmd review -w "$TUIOS_PANE_ID" --base "$mb" "$@"
}

# _tuios_peer: prints two words <hostname> <user@address> for the other Mac, chosen by hostname -s
#   MacBookM2Pro prints mini havoc@macminim1.rollet.family
#   MacMiniM1 prints macbook havoc@macbookm2pro.rollet.family
#   any other host prints nothing and returns 1
_tuios_peer() {
  case "$(hostname -s)" in
    MacBookM2Pro) echo "mini havoc@macminim1.rollet.family" ;;
    MacMiniM1) echo "macbook havoc@macbookm2pro.rollet.family" ;;
    *) return 1 ;;
  esac
}

# _tuios_peer_up <user@address>: returns 0 only when ssh succeeds with BatchMode=yes and ConnectTimeout=3
_tuios_peer_up() {
  ssh -o BatchMode=yes -o ConnectTimeout=3 -i ~/.ssh/id_ed25519 "$1" true >/dev/null 2>&1
}

# _tuios_peer_link <name> <user@address>: the host links live in .config/tuios/config.toml, never added from here.
# If _tuios_cmd hosts output does not contain the name as a word, echo one line to stderr about 'tuios config apply'
_tuios_peer_link() {
  local name="$1" address="$2"
  if ! _tuios_cmd hosts 2>/dev/null | grep -qw "$name"; then
    echo "tuios: host $name is not linked yet; run 'tuios config apply' in a terminal outside tuios" >&2
  fi
}

# peerdev <session>: opens a session on the peer Mac through tuios host link
#   with no argument prints usage and returns 1
#   with unknown host returns 1 without calling tuios
#   with reachable host, calls _tuios_cmd switch-session <name>:<session> when $TUIOS_ENV is set
#   else calls _tuios_cmd attach --host <name> <session>
peerdev() {
  _tuios_guard || return 1
  [ -n "$1" ] || { echo "usage: peerdev <session>" >&2; return 1; }
  local peer name address
  peer=$(_tuios_peer) || { echo "tuios: no peer Mac known for this host" >&2; return 1; }
  name=${peer%% *}; address=${peer#* }; _tuios_peer_up "$address" || { echo "tuios: $name not reachable" >&2; return 1; }
  if [ -n "$TUIOS_ENV" ]; then
    _tuios_cmd switch-session "$name:$1";
  else
    _tuios_cmd attach --host "$name" "$1";
  fi
}

# mmdev opens a new session on the peer Mac
mmdev() {
  _tuios_guard || return 1
  local peer name address
  peer=$(_tuios_peer) || { echo "tuios: no peer Mac known for this host" >&2; return 1; }
  name=${peer%% *}; address=${peer#* }; _tuios_peer_up "$address" || { echo "tuios: $name not reachable" >&2; return 1; }
  _tuios_cmd new --host "$name" ${1:+"$1"};
}

alias nxpeer='peerdev nix-darwin'
alias hipeer='peerdev home-infrastructure'
alias nxmmdev=nxpeer
alias himmdev=hipeer

# _tuios_dev_peer: opens the other Mac sessions only when ssh answers, never fails dev;
# TUIOS_DEV_NO_PEER stops the remote dev from ssh-ing back
_tuios_dev_peer() {
  if [ -n "$TUIOS_DEV_NO_PEER" ]; then
    return 0
  fi
  local peer=$(_tuios_peer)
  if [ -z "$peer" ]; then
    return 0
  fi
  local name address
  name=${peer%% *}
  address=${peer#* }
  if ! _tuios_peer_up "$address"; then
    echo "tuios: $name not reachable, skipping" >&2
    return 0
  fi
  ssh -o BatchMode=yes -o ConnectTimeout=5 -i ~/.ssh/id_ed25519 "$address" "TUIOS_DEV_NO_PEER=1 zsh -ic 'dev --detached'" >/dev/null 2>&1 || {
    echo "tuios: $name: dev --detached failed" >&2
  }
  _tuios_peer_link "$name" "$address"
}
