# Linux-Specific Settings #####################################################
if [[ "$(uname)" == "Linux" ]]; then
  # Only print initialization message in interactive non-tmux shells
  [[ -z "$TMUX" ]] && [[ $- == *i* ]] && echo "ZSH Configuration for Linux..."

  # Add local bin directories to PATH
  export PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.npm-global/bin:$PATH"

  # Prepend Homebrew's bin directory to your PATH
  export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"

  . "$HOME/.atuin/bin/env"

  if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
      export MOZ_ENABLE_WAYLAND=1
  fi

  HISTFILE=~/.zsh_history
  HISTSIZE=10000
  SAVEHIST=1000
  setopt SHARE_HISTORY

  # Load Linux shell configs
  [ -f ~/.zshrc_os_linux_omarchy_shell ] && source ~/.zshrc_os_linux_omarchy_shell
  [ -f ~/.zshrc_os_linux_omarchy_aliases ] && source ~/.zshrc_os_linux_omarchy_aliases
  [ -f ~/.zshrc_os_linux_omarchy_functions ] && source ~/.zshrc_os_linux_omarchy_functions
  [ -f ~/.zshrc_os_linux_omarchy_init ] && source ~/.zshrc_os_linux_omarchy_init
  [ -f ~/.zshrc_os_linux_omarchy_keybindings ] && source ~/.zshrc_os_linux_omarchy_keybindings

  # opencode
  export PATH="$HOME/.opencode/bin:$PATH"
fi

