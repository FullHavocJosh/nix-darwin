{
  "lsp": {
    "ansible": {
      "command": "ansible-language-server",
      "args": [
        "--stdio"
      ],
      "rootMarkers": [
        ".git",
        "ansible.cfg",
        "playbook.yml",
        "*.yml"
      ]
    },
    "bash": {
      "command": "bash-language-server",
      "args": [
        "start"
      ],
      "rootMarkers": [
        ".git",
        "*.sh"
      ]
    },
    "dockerfile": {
      "command": "docker-langserver",
      "args": [
        "--stdio"
      ],
      "rootMarkers": [
        ".git",
        "Dockerfile",
        "docker-compose.yml"
      ]
    },
    "go": {
      "command": "gopls",
      "rootMarkers": [
        ".git",
        "go.mod",
        "go.sum"
      ]
    },
    "lua": {
      "command": "lua-language-server",
      "rootMarkers": [
        ".git",
        "*.lua"
      ]
    },
    "python": {
      "command": "pylsp",
      "rootMarkers": [
        ".git",
        "pyproject.toml",
        "setup.py",
        "requirements.txt"
      ]
    },
    "terraform": {
      "command": "terraform-ls",
      "args": [
        "serve"
      ],
      "rootMarkers": [
        ".git",
        "*.tf",
        "terraform.tfvars"
      ]
    },
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "rootMarkers": [
        ".git",
        "package.json",
        "tsconfig.json"
      ]
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": [
        "--stdio"
      ],
      "rootMarkers": [
        ".git",
        "*.yml",
        "*.yaml"
      ]
    }
  },
