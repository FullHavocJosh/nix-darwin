{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "mcp__lumo__lumo_search",
      "mcp__local-edit__local_edit",
      "mcp__bigpickle__bigpickle_edit"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(gpc:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "WebSearch"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\" ] && [ -x \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" ]; then \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\"; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\" ]; then node \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\"; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\" ] && [ -x \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" ]; then \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\"; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\" ]; then node \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\"; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/aistack/edit_router_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/nix-darwin/scripts/herdr-nvim-open-edited.sh\" ]; then \"$HOME/nix-darwin/scripts/herdr-nvim-open-edited.sh\"; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ]; then bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "claudetui statusline --compact",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "fastMode": true,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "timeFormat": "12-hour",
  "disableAutoMode": "disable",
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}
