{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git commit:*)",
      "Bash(gpc:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "model": "opus",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\" ] && [ -x \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" ]; then \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\"; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\" ]; then node \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\"; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\" ] && [ -x \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" ]; then \"$HOME/mcp-stack-fullhavoc/.venv/bin/python\" \"$HOME/mcp-stack-fullhavoc/hooks/pretooluse_gate.py\"; fi"
          },
          {
            "type": "command",
            "command": "if [ -f \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\" ]; then node \"$HOME/mcp-context-guardian-perfectserve/dist/hook.js\"; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "claudetui hook pre-edit-churn"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude-global/hooks/token-optimizer/pretooluse-router.mjs\" ]; then node \"$HOME/.claude-global/hooks/token-optimizer/pretooluse-router.mjs\"; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/nix-darwin/scripts/herdr-nvim-open-edited.sh\" ]; then \"$HOME/nix-darwin/scripts/herdr-nvim-open-edited.sh\"; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "claudetui hook post-edit-deps"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "claudetui hook session-heatmap"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude-global/hooks/token-optimizer/session-start.mjs\" ]; then node \"$HOME/.claude-global/hooks/token-optimizer/session-start.mjs\"; fi"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ]; then bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/jrollet/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude-global/hooks/token-optimizer/precompact-optimize.mjs\" ]; then node \"$HOME/.claude-global/hooks/token-optimizer/precompact-optimize.mjs\"; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claudetui statusline --compact",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "disableAutoMode": "disable",
  "useAutoModeDuringPlan": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  }
}
